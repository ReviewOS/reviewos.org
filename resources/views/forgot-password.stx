<script server>
/**
 * Forgotten passwords, both halves.
 *
 * One page: with no token in the URL it asks for an address, and with one it
 * asks for a new password. The link in the mail lands here carrying `id` and
 * `token`, so the reader never sees the first form twice and never has to paste
 * anything.
 *
 * The reply to the first half is the same whether the address is registered
 * here or not - and this page says so in those words, so the flat answer reads
 * as deliberate rather than as the page failing to notice. Reporting the
 * difference turns a public form into a way to test whether somebody has an
 * account on this forge, which on a forge also answers "does this person work
 * here".
 */
import { setStatus } from '../functions/http'
import { cookieJarFromHeader, viewerFromCookies } from '../functions/identity'

const serveContext = __stxServeContext
const headerBag = typeof headers === 'undefined' ? undefined : headers

const viewer = await viewerFromCookies(serveContext?.cookies ?? cookieJarFromHeader(headerBag?.cookie))

const search: Record<string, string> = useRoute().query ?? {}
const error = String(search.error ?? '')
const token = String(search.token ?? '')

// The token decides which half of the page this is. Its presence, not its
// validity - checking here would mean a second place that decides whether a
// token is good, and the server already refuses on submit.
const resetting = Boolean(token)
</script>

@layout('app')

@section('title', 'Reset your password')

@section('content')
  <div class="shell" style="padding-top: 60px; padding-bottom: 80px;">
    <div class="auth-card panel">
      @if (viewer && !resetting)
        {{--
          Signed in already. Not refused - somebody may genuinely have forgotten
          the password to the account they are sitting in - but pointed at the
          shorter route first.
        --}}
        <h1 class="auth-title">You are signed in</h1>
        <p class="auth-line muted">
          You can change your password in <a href="/settings/profile">your settings</a> without a
          reset link. If you meant to reset a different account, sign out first.
        </p>
      @elseif (resetting)
        <h1 class="auth-title">Choose a new password</h1>

        @if (error)
          <p class="auth-error" role="alert">{{ error }}</p>
        @endif

        <form method="post" action="/api/auth/password/reset" class="auth-form">
          <CsrfField />
          <input type="hidden" name="operation" value="reset">
          <input type="hidden" name="token" value="{{ token }}">

          {{--
            The address travels in the form rather than being looked up from the
            token, because the token is stored hashed against the address and
            the framework's `passwordResets(email)` is keyed on it. Carried in a
            hidden field from the link, so the reader does not retype it.
          --}}
          <input type="hidden" name="email" value="{{ search.email ?? '' }}">

          <label class="key-label" for="password">New password</label>
          <input
            id="password"
            class="key-input"
            type="password"
            name="password"
            required
            minlength="8"
            autocomplete="new-password"
            autofocus>
          <p class="auth-hint muted">At least 8 characters.</p>

          <div class="key-actions">
            <button type="submit" class="btn btn-primary">Change password</button>
          </div>
        </form>

        <p class="auth-line muted">
          Every other session will be signed out. That is the point: the usual reason to reset a
          password is that somebody else may have had it.
        </p>
      @else
        <h1 class="auth-title">Reset your password</h1>

        @if (error)
          <p class="auth-error" role="alert">{{ error }}</p>
        @endif

        <form method="post" action="/api/auth/password/reset" class="auth-form">
          <CsrfField />
          <input type="hidden" name="operation" value="request">

          <label class="key-label" for="email">Email</label>
          <input id="email" class="key-input" type="email" name="email" required autocomplete="username" autofocus>

          <div class="key-actions">
            <button type="submit" class="btn btn-primary">Send a reset link</button>
          </div>
        </form>

        <p class="auth-line muted">
          The answer is the same whether or not that address has an account here, on purpose.
          Otherwise this form would be a way to find out who does.
        </p>

        <p class="auth-line muted">
          Remembered it? <a href="/login">Sign in</a>.
        </p>
      @endif
    </div>
  </div>
@endsection

<style>
.auth-hint { margin: -8px 0 14px; font-size: 12.5px; }
</style>
