<script server>
/**
 * Create an account.
 *
 * The handle is asked for here rather than derived from an email or picked
 * later, because it is the URL segment: `/{handle}` is the profile and the
 * first segment of every repository under it. An account without one is an
 * account with no page, and choosing it afterwards means the page moves.
 *
 * What a reader typed comes back on a refusal - handle, email, name, never the
 * password. Losing four fields because the fifth was wrong is how people
 * abandon a sign-up.
 */
// Asked for here rather than through a helper: `setResponseStatus` is a
// context binding, in scope only inside this script. See the note in
// `resources/components/RepoBrowser.stx`.
const setStatus = typeof setResponseStatus === 'function' ? setResponseStatus : () => {}
import { cookieJarFromHeader, viewerFromCookies } from '../functions/identity'
import { originFor } from '../functions/repo'

const serveContext = __stxServeContext
const headerBag = typeof headers === 'undefined' ? undefined : headers

const viewer = await viewerFromCookies(serveContext?.cookies ?? cookieJarFromHeader(headerBag?.cookie))

const search: Record<string, string> = useRoute().query ?? {}
const error = String(search.error ?? '')
const handle = String(search.handle ?? '')
const email = String(search.email ?? '')
const name = String(search.name ?? '')

const alreadyIn = Boolean(viewer)

/*
 * This instance's host, for the line that shows somebody their future URL.
 *
 * It said `reviewos.org/your-handle` to everybody, including the operator of a
 * forge on their own domain - which is a promise the page cannot keep and, on
 * a product whose argument is that you should host it yourself, an odd thing
 * to say on the account form. `originFor` prefers the request over
 * configuration for the reason written in `app/Actions/Repo/cloneUrl.ts`.
 */
const site = originFor(serveContext, process.env.APP_URL).replace(/^https?:\/\//, '')
</script>

@layout('app')

@section('title', 'Create an account · ReviewOS')
@section('description', 'Create an account on this ReviewOS instance.')

@section('content')
  <div class="auth-page">
    <div class="auth-card panel">
      @if (alreadyIn)
        <h1 class="auth-title">You already have an account</h1>
        <p class="auth-line muted">
          Signed in as <a href="/{{ viewer.handle }}">{{ viewer.handle }}</a>.
        </p>
      @else
        <h1 class="auth-title">Create an account</h1>

        @if (error)
          <p class="auth-error" role="alert">{{ error }}</p>
        @endif

        <form method="post" action="/api/auth/register" class="auth-form">
          <CsrfField />

          <label class="field-label" for="handle">Handle</label>
          <input id="handle" class="field-input mono" type="text" name="handle" required value="{{ handle }}" maxlength="39" autocomplete="username" autofocus>
          {{--
            Said before they type it rather than after they get it wrong. The
            handle is the one field here that cannot be changed without moving
            a page.
          --}}
          <p class="field-hint">Letters, numbers and hyphens. This is your URL: {{ site }}/your-handle</p>

          <label class="field-label" for="name">Name</label>
          <input id="name" class="field-input" type="text" name="name" value="{{ name }}" maxlength="100" autocomplete="name">
          <p class="field-hint">Optional. Your handle is used when this is empty.</p>

          <label class="field-label" for="email">Email</label>
          <input id="email" class="field-input" type="email" name="email" required value="{{ email }}" autocomplete="email">

          <label class="field-label" for="password">Password</label>
          <input id="password" class="field-input" type="password" name="password" required minlength="10" autocomplete="new-password">
          <p class="field-hint">At least 10 characters. Length is the only rule that helps.</p>

          <div class="field-actions">
            <button type="submit" class="btn btn-primary">Create account</button>
          </div>
        </form>

        {{-- The same component as the sign-in page, and the same flow behind
            it: a provider that identifies somebody with no account here makes
            one. So this reads as "create an account with" without needing a
            second set of buttons that say so. --}}
        <SocialSignIn />

        <p class="auth-line muted">
          Already have one? <a href="/login">Sign in</a>.
        </p>
      @endif
    </div>
  </div>
@endsection
