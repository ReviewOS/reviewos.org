<script server>
/**
 * When and how this account hears from the product.
 *
 * Two questions on one screen, because they are one decision from the reader's
 * side: what reaches me, and when is it allowed to. Splitting them into two
 * pages is how somebody turns off email meaning to set quiet hours.
 *
 * **The grid shows what would actually happen, not what is stored.** Most cells
 * have no row behind them, and rendering unset as "off" is how somebody turns
 * something on that was already on and concludes the switches do nothing. Every
 * cell is answered from `preferenceGrid`, and the ones nobody has chosen say so.
 *
 * Every control is a form. The page runs no client script, so it works with
 * JavaScript off and it cannot show a switch in a position the database does
 * not agree with - it reads the grid on every load.
 */
import { PREFERENCE_EVENTS, preferenceGrid } from '../../../app/Actions/Notification/preferences'
import { formatDays, parseDays } from '../../../app/Actions/Notification/clock'
import { deliveryFor } from '../../../app/Actions/Notification/settings'
import { vapidKeys } from '../../../app/Actions/Notification/vapid'
import { cookieJarFromHeader, viewerFromCookies } from '../../functions/identity'
// Asked for here rather than through a helper: `setResponseStatus` is a
// context binding, in scope only inside this script. See the note in
// `resources/components/RepoBrowser.stx`.
const setStatus = typeof setResponseStatus === 'function' ? setResponseStatus : () => {}

/**
 * The request, from whichever pipeline served this page.
 *
 * Both spellings guarded with `typeof`, because each identifier is *undeclared*
 * on the other path and an undeclared identifier is a ReferenceError that
 * optional chaining does not save. It would throw inside the server script's
 * IIFE and take every variable here with it, so a signed-in reader would get
 * the signed-out branch and think auth was broken.
 */
const serveContext = __stxServeContext
const headerBag = typeof headers === 'undefined' ? undefined : headers

const viewer = await viewerFromCookies(serveContext?.cookies ?? cookieJarFromHeader(headerBag?.cookie))

// A settings page for nobody is not a 404 - the page exists, and saying so is
// how somebody knows to sign in rather than that they mistyped the URL.
if (!viewer)
  setStatus(401)

const stored = viewer
  ? await db
      .selectFrom('notification_event_preferences')
      .select(['event', 'channel', 'delivery'])
      .where('user_id', '=', viewer.id)
      .execute()
  : []

const schedule = viewer
  ? await db
      .selectFrom('notification_schedules')
      .select(['days', 'starts_at', 'ends_at', 'timezone'])
      .where('user_id', '=', viewer.id)
      .executeTakeFirst()
  : undefined

const cells = preferenceGrid(stored.map(row => ({
  event: String(row.event),
  channel: String(row.channel),
  delivery: String(row.delivery),
})))

/*
 * What would actually happen to a review request, right now.
 *
 * The single most useful thing this page can say. Quiet hours, a mute, a
 * do-not-disturb and a break-through list interact in ways nobody can hold in
 * their head, and the failure people report is always the same shape: "I did
 * not get told". A sentence that answers it from the same function delivery
 * uses cannot be wrong in a way the switches are right.
 */
const nowMs = Date.now()

const outcome = viewer
  ? await deliveryFor({ userId: viewer.id, channel: 'email', event: 'review:requested', subjects: [], nowMs })
  : null

const OUTCOMES = {
  'open': 'A review request would email you now.',
  'inbox': 'A review request would email you now.',
  'breaks-through': 'A review request would email you now: it is on your break-through list.',
  'quiet-hours': 'A review request would wait until your next window opens.',
  'do-not-disturb': 'A review request would wait until do not disturb ends.',
  'muted': 'A review request would not email you.',
}

const rightNow = outcome ? (OUTCOMES[outcome.because] ?? 'A review request would email you now.') : ''

/*
 * The mutes, with when each one ends.
 *
 * A mute with no visible expiry is one people forget they set, and then the
 * product is quiet for a reason they cannot find - which reads as the
 * notifications being broken rather than as a switch they threw in March.
 */
const muteRows: any[] = viewer
  ? await db
      .selectFrom('notification_mutes')
      .select(['id', 'subject_type', 'subject_id', 'expires_at'])
      .where('user_id', '=', viewer.id)
      .orderBy('id', 'desc')
      .execute()
  : []

const SUBJECT_WORDS = {
  repository: 'A repository',
  organization: 'An organization',
  issue: 'An issue',
  pull_request: 'A pull request',
}

const mutes = muteRows
  .map((row) => {
    const expiresAt = row.expires_at ? Date.parse(String(row.expires_at)) : null
    const expired = expiresAt !== null && !Number.isNaN(expiresAt) && expiresAt <= nowMs

    return {
      subjectType: String(row.subject_type),
      subjectId: Number(row.subject_id),
      label: `${SUBJECT_WORDS[String(row.subject_type)] ?? 'Something'} #${Number(row.subject_id)}`,
      // "Indefinitely" rather than a blank. An empty cell reads as a value
      // nobody has filled in, and this one is a deliberate choice.
      until: expiresAt === null || Number.isNaN(expiresAt)
        ? 'Indefinitely'
        : `Until ${new Date(expiresAt).toISOString().slice(0, 16).replace('T', ' ')}`,
      expired,
    }
  })
  // An expired mute is not a mute. Listing it would have somebody unmuting
  // something that is already sending.
  .filter(mute => !mute.expired)

/**
 * What each event is, in the words somebody would use.
 *
 * The wire name is `review:requested`; nobody scanning a settings page should
 * have to translate that. The order is the one in `PREFERENCE_EVENTS`, which
 * puts the things you are blocked on first.
 */
const EVENT_LABELS = {
  'review:requested': 'Somebody asks for your review',
  'review:submitted': 'Somebody reviews your pull request',
  'pr:opened': 'A pull request is opened',
  'pr:merged': 'A pull request is merged',
  'pr:closed': 'A pull request is closed without merging',
  'issue:opened': 'An issue is opened',
  'issue:closed': 'An issue is closed',
  'comment:created': 'Somebody comments',
  'release:published': 'A release is published',
}

/** Rows shaped for the template, so the template holds no logic. */
const rows = PREFERENCE_EVENTS.map((event) => {
  const forEvent = cells.filter(cell => cell.event === event)

  return {
    event,
    label: EVENT_LABELS[event] ?? event,
    // The inbox column is a word rather than a control. A disabled select that
    // can never change is furniture people try to click.
    inbox: forEvent.find(cell => cell.channel === 'in_app')?.delivery ?? 'immediate',
    channels: forEvent
      .filter(cell => cell.channel !== 'in_app')
      .map(cell => ({
        channel: cell.channel,
        delivery: cell.delivery,
        isDefault: cell.isDefault,
        // Built here rather than as a ternary in the template: shaping belongs
        // in the script, and an attribute is a string.
        offSelected: cell.delivery === 'off' ? 'selected' : '',
        immediateSelected: cell.delivery === 'immediate' ? 'selected' : '',
        digestSelected: cell.delivery === 'digest' ? 'selected' : '',
        note: cell.isDefault ? 'default' : '',
      })),
  }
})

/*
 * The instance's push public key, or an empty string.
 *
 * Safe to render - the browser needs it to subscribe, and it is public by
 * design. An instance that never generated one shows the section saying so
 * rather than a button that fails: "run buddy push:keys" is an answer an
 * operator can act on, and a silent failure is not.
 */
const pushKey = vapidKeys()?.publicKey ?? ''

/*
 * The browsers already registered.
 *
 * Listed with what each said it was, so somebody can tell the laptop at the
 * office from the desktop at home. Without that the list is three identical
 * rows and revoking one becomes a guess - which is how people end up revoking
 * all of them and turning the feature off.
 */
const browsers: any[] = viewer
  ? await db
      .selectFrom('push_subscriptions')
      .select(['id', 'user_agent', 'last_seen_at'])
      .where('user_id', '=', viewer.id)
      .orderBy('id', 'desc')
      .execute()
  : []

const pushBrowsers = browsers.map(row => ({
  label: shortAgent(String(row.user_agent ?? '')),
  when: row.last_seen_at ? new Date(String(row.last_seen_at)).toISOString().slice(0, 10) : '',
}))

/** A user agent as something a person recognises. */
function shortAgent(agent) {
  if (!agent)
    return 'A browser'

  const browser = /Firefox\/(\d+)/.test(agent)
    ? 'Firefox'
    : /Edg\//.test(agent)
      ? 'Edge'
      : /Chrome\//.test(agent)
        ? 'Chrome'
        : /Safari\//.test(agent) ? 'Safari' : 'A browser'

  const platform = /Macintosh/.test(agent)
    ? 'macOS'
    : /Windows/.test(agent)
      ? 'Windows'
      : /Android/.test(agent)
        ? 'Android'
        : /iPhone|iPad/.test(agent) ? 'iOS' : ''

  return platform ? `${browser} on ${platform}` : browser
}

const days = formatDays(parseDays(String(schedule?.days ?? '1,2,3,4,5')))
const startsAt = clockOf(Number(schedule?.starts_at ?? 540))
const endsAt = clockOf(Number(schedule?.ends_at ?? 1080))
const timezone = String(schedule?.timezone ?? 'UTC')

/** Minutes from local midnight, as an `<input type="time">` wants them. */
function clockOf(minutes) {
  const safe = Number.isFinite(minutes) ? Math.max(0, Math.min(1439, minutes)) : 0

  return `${String(Math.floor(safe / 60)).padStart(2, '0')}:${String(safe % 60).padStart(2, '0')}`
}

const dayBoxes = [
  { value: 1, label: 'Mon' },
  { value: 2, label: 'Tue' },
  { value: 3, label: 'Wed' },
  { value: 4, label: 'Thu' },
  { value: 5, label: 'Fri' },
  { value: 6, label: 'Sat' },
  { value: 0, label: 'Sun' },
].map(day => ({
  ...day,
  checked: days.split(',').includes(String(day.value)) ? 'checked' : '',
}))
</script>

@layout('app')

@section('title', 'Notification settings · ReviewOS')
@section('description', 'Choose which events reach you, and by which channel.')

@section('content')
  <div class="shell" style="padding-top: 22px; padding-bottom: 64px;">
    <SettingsNav current="notifications" />

    @if (!viewer)
      <div class="panel" style="padding: 32px; text-align: center;">
        <h1 style="font-size: 20px;">Sign in to change how you are notified</h1>
        <p class="muted" style="margin-top: 6px;">
          <a href="/login">Sign in</a> to set what reaches you, and when.
        </p>
      </div>
    @else
      <header class="keys-head">
        <h1 class="keys-title">Notifications</h1>
        <p class="muted">
          What reaches you, and when it is allowed to. The inbox always has everything - these
          settings are about what interrupts you.
        </p>

        {{--
          Answered from the same function delivery uses, so it cannot be wrong
          in a way the switches are right. Four rules interact here and nobody
          can hold them in their head at once; the failure people report is
          always "I did not get told", and this is the line that answers it.
        --}}
        <p class="prefs-now">{{ rightNow }}</p>
      </header>

      <section class="keys-section">
        <h2 class="keys-heading">What you hear about</h2>

        <ul class="panel prefs-list">
          @foreach (rows as row)
            <li class="prefs-row">
              <span class="prefs-event">{{ row.label }}</span>

              <span class="muted prefs-inbox" title="The inbox is the record and cannot be turned off">
                Inbox: {{ row.inbox }}
              </span>

              @foreach (row.channels as cell)
                <form class="prefs-control" method="post" action="/api/user/notifications/preferences">
                  <CsrfField />
                  <input type="hidden" name="event" value="{{ row.event }}">
                  <input type="hidden" name="channel" value="{{ cell.channel }}">

                  <label class="muted prefs-label" for="{{ row.event }}-{{ cell.channel }}">
                    {{ cell.channel }}
                  </label>

                  {{--
                    A select rather than three radios, because the three answers
                    are exclusive and a row of nine radios per event is a wall.
                    Submitting on change would need script; the button is one
                    click and works with none.
                  --}}
                  <select id="{{ row.event }}-{{ cell.channel }}" class="prefs-select" name="delivery">
                    <option value="off" {{ cell.offSelected }}>Off</option>
                    <option value="immediate" {{ cell.immediateSelected }}>Immediately</option>
                    <option value="digest" {{ cell.digestSelected }}>In a digest</option>
                  </select>

                  @if (cell.note)
                    <span class="muted prefs-note">{{ cell.note }}</span>
                  @endif

                  <button type="submit" class="prefs-save">Save</button>
                </form>
              @endforeach
            </li>
          @endforeach
        </ul>
      </section>

      <section class="keys-section">
        <h2 class="keys-heading">When you can be interrupted</h2>
        <p class="muted prefs-explainer">
          Outside these hours, email and push wait rather than being dropped, and arrive together
          when the window opens. The inbox is never held.
        </p>

        <form class="panel prefs-schedule" method="post" action="/api/user/notifications/schedule">
          <CsrfField />
          <input type="hidden" name="_method" value="PUT">

          <fieldset class="prefs-days">
            <legend class="muted prefs-label">Days</legend>
            @foreach (dayBoxes as day)
              <label class="prefs-day">
                <input type="checkbox" name="days" value="{{ day.value }}" {{ day.checked }}>
                {{ day.label }}
              </label>
            @endforeach
          </fieldset>

          <div class="prefs-window">
            <label class="muted prefs-label" for="starts-at">From</label>
            <input id="starts-at" class="field-input prefs-time" type="time" name="starts_at" value="{{ startsAt }}">

            <label class="muted prefs-label" for="ends-at">Until</label>
            <input id="ends-at" class="field-input prefs-time" type="time" name="ends_at" value="{{ endsAt }}">

            <label class="muted prefs-label" for="timezone">Timezone</label>
            <input id="timezone" class="field-input mono prefs-tz" type="text" name="timezone" value="{{ timezone }}" placeholder="Europe/Berlin">
          </div>

          <div class="field-actions">
            <button type="submit" class="btn btn-primary">Save hours</button>
          </div>
        </form>
      </section>

      {{--
        Browser notifications.

        The only section on this page that runs client script, because the Push
        API is a browser capability with no server side: a permission, a service
        worker, and a subscription the browser mints. The work is in
        `resources/functions/push.ts` and this holds the answer.

        **The permission is asked on the button, never on load.** A browser
        asked once and refused cannot be asked again - the promise resolves
        `denied` forever, and the only undo is buried in browser site settings
        almost nobody finds. Spending that one prompt on a page load costs the
        feature permanently for that reader.
      --}}
      <section class="keys-section" x-data="{ push: { supported: true, permission: 'default', subscribed: false, message: '' }, note: '', busy: false }" x-init="push = await pushState()">
        <h2 class="keys-heading">This browser</h2>

        @if (!pushKey)
          <p class="keys-empty muted">
            Push is not configured on this instance. Run <span class="mono">buddy push:keys</span> and
            put the pair in the environment.
          </p>
        @else
          <div class="panel prefs-schedule">
            <p class="muted prefs-explainer" x-show="!push.supported" x-cloak>
              This browser cannot show notifications.
            </p>

            <template x-if="push.supported">
              <div>
                <p class="muted prefs-explainer">
                  A notification arrives whether or not this tab is open. It carries the same
                  sentence as your inbox and nothing more, and it obeys the same quiet hours and
                  mutes as email.
                </p>

                <div class="push-actions">
                  <button
                    type="button"
                    class="btn btn-primary"
                    x-show="!push.subscribed"
                    :disabled="busy"
                    @click="busy = true; push = await enablePush('{{ pushKey }}'); busy = false">Turn on for this browser</button>

                  <button
                    type="button"
                    class="btn"
                    x-show="push.subscribed"
                    :disabled="busy"
                    @click="busy = true; push = await disablePush(); busy = false">Turn off for this browser</button>

                  {{--
                    The test button, and the reason it exists: every way push
                    breaks - a downgraded permission, a key that does not match,
                    a worker that never activated - produces exactly the same
                    symptom, which is nothing arriving. There is no way to tell
                    them apart from the outside.
                  --}}
                  <button
                    type="button"
                    class="btn"
                    x-show="push.subscribed"
                    :disabled="busy"
                    @click="busy = true; note = await testPush(); busy = false">Send a test</button>
                </div>

                <p class="muted prefs-explainer" x-show="push.message" x-cloak x-text="push.message"></p>
                <p class="muted prefs-explainer" x-show="note" x-cloak x-text="note"></p>
              </div>
            </template>
          </div>

          @if (pushBrowsers.length > 0)
            <ul class="panel prefs-list">
              @foreach (pushBrowsers as browser)
                <li class="prefs-row">
                  <span class="prefs-event">{{ browser.label }}</span>
                  @if (browser.when)
                    <span class="muted prefs-inbox">Registered {{ browser.when }}</span>
                  @endif
                </li>
              @endforeach
            </ul>
          @endif
        @endif
      </section>

      <section class="keys-section">
        <h2 class="keys-heading">Muted</h2>

        @if (mutes.length === 0)
          <p class="keys-empty muted">Nothing is muted. Mute a repository or a thread from its own page.</p>
        @else
          <p class="muted prefs-explainer">
            A muted thing still lands in your inbox. Muting silences the channels that interrupt, and
            that is what makes it safe to use instead of leaving.
          </p>

          <ul class="panel prefs-list">
            @foreach (mutes as mute)
              <li class="prefs-row">
                <span class="prefs-event">{{ mute.label }}</span>
                {{--
                  The expiry, always. A mute with no visible end is one people
                  forget they set, and then the product is quiet for a reason
                  they cannot find - which reads as notifications being broken
                  rather than as a switch they threw in March.
                --}}
                <span class="muted prefs-inbox">{{ mute.until }}</span>

                <form class="prefs-control" method="post" action="/api/user/notifications/mutes">
                  <CsrfField />
                  <input type="hidden" name="subject_type" value="{{ mute.subjectType }}">
                  <input type="hidden" name="subject_id" value="{{ mute.subjectId }}">
                  <input type="hidden" name="muted" value="false">
                  <button type="submit" class="prefs-save">Unmute</button>
                </form>
              </li>
            @endforeach
          </ul>
        @endif
      </section>
    @endif
  </div>
@endsection
