<script server>
import { FEATURES } from '../../functions/marketing'

const pageTitle = 'Notifications worth reading · ReviewOS'
const pageDescription = 'Every message says why it reached you, nobody is told about their own action, and a burst arrives as one.'
const related = FEATURES.filter(feature => feature.slug !== 'notifications').slice(0, 3)

// The rail's summary, beside the page rather than inside its markup: an
// array does not survive an stx attribute as itself, so it is passed as JSON
// - the same reason `StackNav` takes one.
const summary = [
  'The reason is shown, and mutable on its own',
  'Never notified about your own action',
  'Bursts batched per person and per subject',
  'Unsubscribing beats every reason',
]

// What to do next, and the layout that shows it - see `PageCta.stx`.
const actions = [
  {'href': '/docs/install', 'label': 'Self-host ReviewOS', 'primary': true},
  {'href': '/features', 'label': 'All features', 'primary': false},
]
</script>

@layout('marketing')

@section('title', pageTitle)
@section('description', pageDescription)

@section('content')
  <div class="shell">
    <header class="page-head">
      <p class="page-eyebrow">Automation</p>
      <h1 class="page-title">Notifications you do not have to mute</h1>
      <p class="page-lede">The bar is that a reviewer can rely on them without also watching a chat channel, and that nobody has to turn them off to get work done.</p>
    </header>

    <div class="grid grid-cols-1 gap-[44px] items-start md:grid-cols-[minmax(0,1fr)_280px]">
      <div class="prose">
        <h2>Every notification carries its reason</h2>
        <p>Being asked to review something is a request addressed to you. Watching a repository is a standing interest. Telling a requested reviewer they are receiving a message "because you are watching" is how people learn to ignore notifications.</p>
        <p>When several reasons apply, the strongest wins, and the reason is shown so it can be switched off on its own rather than all at once.</p>

        <h2>Nobody hears about their own action</h2>
        <p>This single rule decides more than any other whether notifications feel like noise.</p>

        <h2>A burst is one message</h2>
        <p>Ten comments on one pull request in five minutes is one email. The window is per person and per subject, so activity on an unrelated issue is still its own message, and a conversation that runs all afternoon does not arrive as one enormous digest at the end of the day.</p>

        <h2>Subscription is implicit, and unsubscribing is absolute</h2>
        <p>Opening, commenting on, or being assigned to something subscribes you. Unsubscribing from a thread outranks every reason, so a later mention does not quietly bring you back.</p>
      </div>

      <PageRail
        summaryLabel="In short"
        summaryJson="{{ JSON.stringify(summary) }}"
        relatedLabel="Related"
        relatedPrefix="/features"
        relatedJson="{{ JSON.stringify(related) }}"
      />
    </div>

    <PageCta
      heading="Notifications people keep switched on"
      line="Routing rules are pure functions, tested against the combinations that produce noise."
      actionsJson="{{ JSON.stringify(actions) }}"
    />
  </div>
@endsection

<style>
  @media (max-width: 940px) {
    .shell > div[style*="grid-template-columns"] { grid-template-columns: minmax(0, 1fr) !important; }
  }
</style>
