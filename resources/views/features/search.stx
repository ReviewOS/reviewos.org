<script server>
import { FEATURES } from '../../functions/marketing'

const pageTitle = 'Search that reads like a query · ReviewOS'
const pageDescription = 'Qualifiers, quoting, and negation, parsed with a real tokenizer rather than a regex.'
const related = FEATURES.filter(feature => feature.slug !== 'search').slice(0, 3)

// The rail's summary, beside the page rather than inside its markup: an
// array does not survive an stx attribute as itself, so it is passed as JSON
// - the same reason `StackNav` takes one.
const summary = [
  'Real quoting and escaping',
  'Negation on any qualifier',
  'Comparisons and sorting',
  'Permissions enforced outside the query',
]

// What to do next, and the layout that shows it - see `PageCta.stx`.
const actions = [
  {'href': '/docs/install', 'label': 'Self-host ReviewOS', 'primary': true},
  {'href': '/features', 'label': 'All features', 'primary': false},
]
</script>

@layout('marketing')

@section('title', pageTitle)
@section('description', pageDescription)

@section('content')
  <div class="shell">
    <header class="page-head">
      <p class="page-eyebrow">Repositories</p>
      <h1 class="page-title">A search box that understands what you typed</h1>
      <p class="page-lede">`is:open author:chris label:"needs design" -label:wontfix rebase` is what people actually type. Most search boxes handle about half of it.</p>
    </header>

    <div class="grid grid-cols-[minmax(0,1fr)_280px] gap-[44px] items-start">
      <div class="prose">
        <h2>A tokenizer, not a regular expression</h2>
        <p>The two things people do that break a regex-based parser are quoting a value with a space in it and negating a qualifier. Both fail silently: the query degrades into a literal text search that matches nothing, which reads as "no results" rather than "not understood".</p>

        <h2>What the syntax supports</h2>
        <p></p>
        <ul>
          <li>Qualifiers such as `is:`, `author:`, `label:`, `milestone:`, and `repo:`</li>
          <li>Quoting, with single or double quotes, and backslash escapes</li>
          <li>Negation with a leading hyphen, on any qualifier</li>
          <li>Comparisons such as `comments:>10` and `stars:>=100`</li>
          <li>Sorting with `sort:` and a direction</li>
        </ul>

        <h2>Unknown qualifiers stay text</h2>
        <p>A pasted URL is not read as a filter on `https`. Anything the forge does not recognise is searched for literally, and quoting is how you search for a literal `is:open`.</p>

        <h2>Visibility is never left to the query</h2>
        <p>What a reader may see is enforced from their permissions, separately, every time. A query is user input, and a search index that decides visibility is a search index that leaks a private repository the first time somebody crafts a clever filter.</p>
      </div>

      <PageRail
        summaryLabel="In short"
        summaryJson="{{ JSON.stringify(summary) }}"
        relatedLabel="Related"
        relatedPrefix="/features"
        relatedJson="{{ JSON.stringify(related) }}"
      />
    </div>

    <PageCta
      heading="Find the pull request you are thinking of"
      line="The parser round-trips: what you typed can be rebuilt from what it parsed."
      actionsJson="{{ JSON.stringify(actions) }}"
    />
  </div>
@endsection

<style>
  @media (max-width: 940px) {
    .shell > div[style*="grid-template-columns"] { grid-template-columns: minmax(0, 1fr) !important; }
  }
</style>
