<script server>
import { FEATURES } from '../../functions/marketing'

const pageTitle = 'Merge strategies and rules · ReviewOS'
const pageDescription = 'Merge, squash, or rebase, gated by approvals, review threads, and checks, with every blocker reported at once.'
const related = FEATURES.filter(feature => feature.slug !== 'merge-strategies').slice(0, 3)

// The rail's summary, beside the page rather than inside its markup: an
// array does not survive an stx attribute as itself, so it is passed as JSON
// - the same reason `StackNav` takes one.
const summary = [
  'Merge, squash, and rebase, all without a checkout',
  'Every blocker reported in one pass',
  'Guarded ref updates, so a concurrent push survives',
  'One change request outweighs any number of approvals',
]

// What to do next, and the layout that shows it - see `PageCta.stx`.
const actions = [
  {'href': '/docs/install', 'label': 'Self-host ReviewOS', 'primary': true},
  {'href': '/features', 'label': 'All features', 'primary': false},
]
</script>

@layout('marketing')

@section('title', pageTitle)
@section('description', pageDescription)

@section('content')
  <div class="shell">
    <header class="page-head">
      <p class="page-eyebrow">Review</p>
      <h1 class="page-title">Merging is the one irreversible thing, so it says no clearly</h1>
      <p class="page-lede">Every reason a pull request cannot merge is collected and shown together. Being sent round the loop one blocker at a time is the thing contributors hate most.</p>
    </header>

    <div class="grid grid-cols-[minmax(0,1fr)_280px] gap-[44px] items-start">
      <div class="prose">
        <h2>Three strategies, done properly</h2>
        <p>A merge commit keeps both histories. A squash produces one commit whose parent is the base, carrying the pull request title and the individual commit subjects as notes. A rebase replays each commit, so the branch keeps its shape.</p>
        <ul>
          <li>All three run as git plumbing against the bare repository</li>
          <li>No working tree is checked out to merge anything</li>
          <li>A rebase replays commits rather than collapsing them</li>
        </ul>

        <h2>The rules a branch can require</h2>
        <p>Protected branches carry the gates, and each is checked before git is touched.</p>
        <ul>
          <li>A number of approvals, optionally dismissed when the branch moves</li>
          <li>All review threads resolved</li>
          <li>Named checks reporting success on the current head</li>
          <li>A linear history, which refuses a merge commit and allows squash or rebase</li>
        </ul>

        <h2>A push that arrives mid-merge is not overwritten</h2>
        <p>Every strategy ends in a ref update guarded by the branch's expected old value. If somebody pushed between the checks and the merge, the update fails and nothing is lost, rather than the merge quietly discarding their commit.</p>

        <h2>Changes requested outranks arithmetic</h2>
        <p>One reviewer asking for changes blocks the merge regardless of how many approvals sit next to it. Only the latest review from each reviewer counts, so an approval after a change request is a change of mind rather than a second vote.</p>
      </div>

      <PageRail
        summaryLabel="In short"
        summaryJson="{{ JSON.stringify(summary) }}"
        relatedLabel="Related"
        relatedPrefix="/features"
        relatedJson="{{ JSON.stringify(related) }}"
      />
    </div>

    <PageCta
      heading="Make the merge button mean something"
      line="The rules are pure functions with tests, so a rule that says no can be reasoned about."
      actionsJson="{{ JSON.stringify(actions) }}"
    />
  </div>
@endsection

<style>
  @media (max-width: 940px) {
    .shell > div[style*="grid-template-columns"] { grid-template-columns: minmax(0, 1fr) !important; }
  }
</style>
