<script server>
import { FEATURES } from '../../functions/marketing'

const pageTitle = 'Plain git hosting · ReviewOS'
const pageDescription = 'Ordinary bare repositories on your disk, served over the git smart HTTP protocol by the git binary itself.'
const related = FEATURES.filter(feature => feature.slug !== 'git-hosting').slice(0, 3)

// The rail's summary, beside the page rather than inside its markup: an
// array does not survive an stx attribute as itself, so it is passed as JSON
// - the same reason `StackNav` takes one.
const summary = [
  'Bare repositories under a predictable path',
  'Served by the system git binary',
  'Packfiles streamed, not buffered',
  'Token authentication, never passwords',
]

// What to do next, and the layout that shows it - see `PageCta.stx`.
const actions = [
  {'href': '/docs/install', 'label': 'Self-host ReviewOS', 'primary': true},
  {'href': '/features', 'label': 'All features', 'primary': false},
]
</script>

@layout('marketing')

@section('title', pageTitle)
@section('description', pageDescription)

@section('content')
  <div class="shell">
    <header class="page-head">
      <p class="page-eyebrow">Repositories</p>
      <h1 class="page-title">Ordinary bare repositories, on your disk</h1>
      <p class="page-lede">Nothing about your history is locked inside this application. Stop the server and your repositories are still repositories.</p>
    </header>

    <div class="grid grid-cols-1 gap-[44px] items-start md:grid-cols-[minmax(0,1fr)_280px]">
      <div class="prose">
        <h2>The git binary does the git work</h2>
        <p>Repositories live at a predictable path and are driven by spawned git plumbing commands. There is no reimplementation of git in TypeScript and no library standing between your objects and the tool that understands them.</p>
        <p>That means a repository can be cloned, inspected, backed up, or migrated with the same commands you already use, and a bug in this application cannot corrupt an object store it never writes to directly.</p>

        <h2>Smart HTTP, streamed</h2>
        <p>Clone, fetch, and push work over the standard protocol. Packfiles are streamed rather than buffered, which is the difference between working on a real repository and working on a demo.</p>
        <ul>
          <li>Reference discovery and both pack services</li>
          <li>HTTP basic authentication with a personal access token</li>
          <li>Passwords are not accepted over git, since they end up in shell history and config files</li>
        </ul>

        <h2>Path safety is not an afterthought</h2>
        <p>Owner and repository names are validated before they reach the filesystem, and every resolved path is checked to be inside the storage root. A repository name is user input that becomes a path, which is the shape of most directory traversal bugs.</p>

        <h2>Backups are a file copy</h2>
        <p>Because the storage layout is ordinary, so is the backup story. Copy the directory, dump the database, done.</p>
      </div>

      <PageRail
        summaryLabel="In short"
        summaryJson="{{ JSON.stringify(summary) }}"
        relatedLabel="Related"
        relatedPrefix="/features"
        relatedJson="{{ JSON.stringify(related) }}"
      />
    </div>

    <PageCta
      heading="Keep your history portable"
      line="An open format on your own disk, with no export step to plan for."
      actionsJson="{{ JSON.stringify(actions) }}"
    />
  </div>
@endsection

<style>
  @media (max-width: 940px) {
    .shell > div[style*="grid-template-columns"] { grid-template-columns: minmax(0, 1fr) !important; }
  }
</style>
