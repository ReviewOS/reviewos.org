<script server>
import { COMPARISONS } from '../../functions/marketing'

const pageTitle = 'Comparisons · ReviewOS'
const pageDescription = 'How ReviewOS compares to GitHub, GitLab, and Forgejo, written to be fair rather than flattering.'

// What to do next, and the layout that shows it - see `PageCta.stx`.
const actions = [
  {'href': '/docs/install', 'label': 'Self-host ReviewOS', 'primary': true},
]
</script>

@layout('marketing')

@section('title', pageTitle)
@section('description', pageDescription)

@section('content')
  <div class="shell">
    <header class="page-head">
      <p class="page-eyebrow">Comparisons</p>
      <h1 class="page-title">Where this fits, and where it does not</h1>
      <p class="page-lede">Each of these says plainly what the alternative does better. A comparison page that only flatters its own product tells you nothing you can use.</p>
    </header>

    <div class="card-grid">
      @foreach (COMPARISONS as item)
        <a class="card panel" href="/compare/{{ item.slug }}">
          <span class="card-title">{{ item.name }}</span>
          <span class="card-text">{{ item.summary }}</span>
        </a>
      @endforeach
    </div>

    <PageCta
      heading="Still deciding?"
      line="Mirror one busy repository and review a week of real work in it. That answers more than any table."
      gap="44"
      actionsJson="{{ JSON.stringify(actions) }}"
    />
  </div>
@endsection
