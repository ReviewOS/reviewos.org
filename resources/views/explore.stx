<script server>
/**
 * Explore, as a page.
 *
 * Rendered on the server from the same reads the JSON endpoint calls, for the
 * reason `search.stx` gives: a page that reimplemented the visibility filter
 * would be a second answer to "who may see this", and only one of the two would
 * ever be audited. Here it matters more than usual - explore is the one surface
 * where a mistake is a listing rather than a leak to one person.
 *
 * No client-side fetching. The lists are in the HTML, so the page works with
 * JavaScript off, a filtered view can be linked to, and the back button returns
 * to what somebody was looking at.
 */
import { cookieJarFromHeader, viewerFromCookies } from '../functions/identity'
import { relativeTime } from '../functions/browse'
import { byLanguage, byTopic, languageIndex, recentlyActive, trending } from '../../app/Actions/Explore/explore'

// Both spellings of the request, because each is undeclared on the other
// rendering path and an undeclared identifier is a ReferenceError that takes
// every variable below it down with it.
const serveContext = typeof __stxServeContext === 'undefined' ? undefined : __stxServeContext
const headerBag = typeof headers === 'undefined' ? undefined : headers

const viewer = await viewerFromCookies(serveContext?.cookies ?? cookieJarFromHeader(headerBag?.cookie))
const params = serveContext?.query ?? (typeof query === 'undefined' ? {} : query) ?? {}

const topic = String(params.topic ?? '').trim()
const language = String(params.language ?? '').trim()

/*
 * The window, bounded the same way the endpoint bounds it. A week is right for
 * a busy instance and empty on a company one, where a month is the smallest
 * window with anything in it - and "trending over three years" is the all-time
 * list wearing a disguise.
 */
const days = Math.max(1, Math.min(90, Number(params.days) || 7))

const filtered = topic || language
const filteredRepositories = topic ? await byTopic(topic) : language ? await byLanguage(language) : []

// Both lists on the unfiltered page, and neither standing in for the other: on
// a young instance nothing has gained a star this week, and showing "recently
// active" under a heading that says "trending" would be lying about what the
// instance knows.
const gaining = filtered ? [] : await trending(days)
const active = filtered ? [] : await recentlyActive()
const languages = await languageIndex(18)

const windows = [
  { days: 1, label: 'Today' },
  { days: 7, label: 'This week' },
  { days: 30, label: 'This month' },
]

/** A repository's page. Every card links to one, or it is decoration. */
function repositoryHref(entry) {
  return `/${entry.owner}/${entry.name}`
}

/*
 * A row the way `RepositoryCard` reads one, so this page and a profile render
 * the same repository the same way. They did not: the same card carried a
 * different type scale, a different order and its own class names on each
 * page, and a field added to one - forks, the archived pill - reached only
 * that one.
 *
 * `owner/name` is the label here because explore mixes owners. A profile
 * passes the bare name, having already said whose these are.
 */
const asCard = entry => ({
  label: `${entry.owner}/${entry.name}`,
  href: repositoryHref(entry),
  description: entry.description ?? '',
  language: entry.language ?? '',
  stars: entry.stars ?? 0,
  gained: entry.gained ?? 0,
  updated: entry.pushedAt ? relativeTime(entry.pushedAt) : '',
})

const filteredCards = filteredRepositories.map(asCard)
const gainingCards = gaining.map(asCard)
const activeCards = active.map(asCard)

function windowHref(value) {
  return `/explore?days=${value}`
}
</script>

@layout('app')

@section('title', 'Explore · ReviewOS')
@section('description', 'Every public repository on this instance, by language, activity, and recent review.')

@section('content')
  <div class="page">
    <header class="explore-head">
      <h1 class="explore-title">Explore</h1>
      <p class="muted explore-subtitle">
        What is being worked on here. Public repositories only.
      </p>
    </header>

    @if (filtered)
      <nav class="explore-crumbs" aria-label="Filter">
        <a href="/explore" class="explore-crumb">Explore</a>
        <span class="muted">/</span>
        <span class="explore-crumb is-current">{{ topic ? `#${topic}` : language }}</span>
      </nav>

      @if (filteredRepositories.length === 0)
        <div class="panel explore-empty">
          <p>Nothing here yet.</p>
          <p class="muted">
            No public repository on this instance
            {{ topic ? `carries the topic ${topic}` : `is written in ${language}` }}.
          </p>
        </div>
      @else
        <ul class="explore-grid">
          @foreach (filteredCards as card)
            <RepositoryCard :row="card" />
          @endforeach
        </ul>
      @endif
    @else
      <section class="explore-section" aria-labelledby="trending-heading">
        <div class="explore-section-head">
          <h2 id="trending-heading" class="explore-section-title">Trending</h2>

          {{--
            Stars gained in a window, not total stars. A list by total is the
            same list every week and shows nobody anything they did not know.
          --}}
          <nav class="explore-windows" aria-label="Trending window">
            @foreach (windows as option)
              <a
                href="{{ windowHref(option.days) }}"
                class="explore-window {{ option.days === days ? 'is-current' : '' }}"
                @if (option.days === days) aria-current="page" @endif>{{ option.label }}</a>
            @endforeach
          </nav>
        </div>

        @if (gaining.length === 0)
          <div class="panel explore-empty">
            <p class="muted">
              No public repository has gained a star in this window. Try a longer one, or look at
              what has been pushed to below.
            </p>
          </div>
        @else
          <ul class="explore-grid">
            @foreach (gainingCards as card)
              <RepositoryCard :row="card" />
            @endforeach
          </ul>
        @endif
      </section>

      <section class="explore-section" aria-labelledby="active-heading">
        <h2 id="active-heading" class="explore-section-title">Recently active</h2>

        @if (active.length === 0)
          <div class="panel explore-empty">
            <p class="muted">Nothing has been pushed to a public repository here yet.</p>
          </div>
        @else
          <ul class="explore-grid">
            @foreach (activeCards as card)
              <RepositoryCard :row="card" />
            @endforeach
          </ul>
        @endif
      </section>
    @endif

    @if (languages.length > 0)
      <section class="explore-section" aria-labelledby="languages-heading">
        <h2 id="languages-heading" class="explore-section-title">Languages</h2>

        <ul class="explore-languages">
          @foreach (languages as entry)
            <li>
              <a class="explore-language-link" href="/explore?language={{ encodeURIComponent(entry.language) }}">
                {{ entry.language }}
                <span class="muted">{{ entry.repositories }}</span>
              </a>
            </li>
          @endforeach
        </ul>
      </section>
    @endif
  </div>
@endsection

<style>
  /*
   * Styled here rather than in a global sheet, the way `search.stx` is: the
   * page owns its own vocabulary. What it no longer owns is the repository
   * card - that is `RepositoryCard`, because three pages drawing the same
   * object four different ways is not vocabulary, it is drift.
   *
   * Every colour and radius is a variable from the theme. A page that hard-codes
   * one is a page that is wrong in dark mode, and wrong in a way nobody notices
   * until somebody opens it at night.
   */
  .explore-head { margin-bottom: 22px; }
  .explore-title { font-size: 22px; font-weight: 600; margin-bottom: 4px; }
  .explore-subtitle { font-size: 13.5px; }

  .explore-crumbs {
    display: flex;
    gap: 8px;
    align-items: baseline;
    margin-bottom: 16px;
    font-size: 13.5px;
  }

  .explore-crumb { color: var(--muted); text-decoration: none; }
  .explore-crumb:hover { color: var(--text); }
  .explore-crumb.is-current { color: var(--text); font-weight: 600; }

  .explore-section { margin-bottom: 34px; }

  .explore-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .explore-section-title { font-size: 15px; font-weight: 600; margin-bottom: 12px; }
  .explore-section-head .explore-section-title { margin-bottom: 0; }

  .explore-windows { display: flex; gap: 2px; }

  .explore-window {
    padding: 4px 9px;
    font-size: 12.5px;
    color: var(--muted);
    text-decoration: none;
    border-radius: var(--r-control, 8px);
  }

  .explore-window:hover { color: var(--text); background: var(--bg-subtle, rgba(127, 127, 127, 0.08)); }
  .explore-window.is-current { color: var(--text); background: var(--bg-subtle, rgba(127, 127, 127, 0.12)); font-weight: 600; }

  /*
   * `auto-fill` with a minimum, so the grid is one column on a phone and as
   * many as fit on a wide screen without a breakpoint per size. `minmax` is what
   * stops a long repository name from widening its column past the others.
   */
  .explore-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* The cards themselves are `RepositoryCard`, which carries its own styles -
     what is left here is the grid they sit in. The three lists on this page
     used to declare a card of their own, and a profile declared a fourth. */

  .explore-empty { padding: 16px 18px; font-size: 13.5px; }
  .explore-empty p { margin: 0; }
  .explore-empty p + p { margin-top: 6px; }

  .explore-languages {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .explore-language-link {
    display: inline-flex;
    gap: 6px;
    padding: 5px 10px;
    font-size: 12.5px;
    color: var(--text);
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .explore-language-link:hover { background: var(--bg-subtle, rgba(127, 127, 127, 0.08)); }
</style>
