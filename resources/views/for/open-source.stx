<script server>
import { USE_CASES } from '../../functions/marketing'

const pageTitle = 'For open source maintainers · ReviewOS'
const pageDescription = 'Drive-by contributions, long-running forks, and a review queue you can actually keep up with.'
const related = USE_CASES.filter(item => item.slug !== 'open-source').slice(0, 3)

// The rail's summary, beside the page rather than inside its markup: an
// array does not survive an stx attribute as itself, so it is passed as JSON
// - the same reason `StackNav` takes one.
const summary = [
  'Threads survive contributor force pushes',
  'Merge-base diffs',
  'Generated files collapsed',
  'Branch rules without a bot',
]

// What to do next, and the layout that shows it - see `PageCta.stx`.
const actions = [
  {'href': '/docs/install', 'label': 'Self-host ReviewOS', 'primary': true},
  {'href': '/features', 'label': 'See the features', 'primary': false},
]
</script>

@layout('marketing')

@section('title', pageTitle)
@section('description', pageDescription)

@section('content')
  <div class="shell">
    <header class="page-head">
      <p class="page-eyebrow">Use case</p>
      <h1 class="page-title">A review queue a maintainer can keep up with</h1>
      <p class="page-lede">Maintaining is mostly reviewing, usually in the evening, often on a change from somebody you have never met.</p>
    </header>

    <div class="grid grid-cols-[minmax(0,1fr)_280px] gap-[44px] items-start">
      <div class="prose">
        <h2>The queue is the job</h2>
        <p>A contributor opens a pull request, you ask for two changes, they force push, and the thread you wrote is gone. That interaction costs a maintainer their evening and a contributor their enthusiasm, and it is entirely avoidable.</p>

        <h2>What helps most</h2>
        <ul>
          <li>Threads that survive the force push a first-time contributor will inevitably do</li>
          <li>A diff against the merge base, so unrelated commits from main are not in the review</li>
          <li>Lockfiles and build output collapsed, so the actual change is on the first screen</li>
          <li>Closing keywords that cannot fire from a code sample in the documentation</li>
        </ul>

        <h2>Rules that hold without a bot</h2>
        <p>Protected branches enforce approvals, resolved conversations, and checks from your existing CI. There is no separate bot to install, configure, and keep running.</p>

        <h2>It stays yours</h2>
        <p>MIT licensed, self-hosted, ordinary bare repositories on disk. If the project outgrows this forge or the project ends, the history is portable because it was never anywhere else.</p>
      </div>

      <PageRail
        summaryLabel="Why it fits"
        summaryJson="{{ JSON.stringify(summary) }}"
        relatedLabel="Also read"
        relatedPrefix="/for"
        relatedJson="{{ JSON.stringify(related) }}"
      />
    </div>

    <PageCta
      heading="Host your project on your own terms"
      line="Open source, and specific about the part of the workflow maintainers spend their time in."
      actionsJson="{{ JSON.stringify(actions) }}"
    />
  </div>
@endsection
