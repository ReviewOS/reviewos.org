<script server>
import { USE_CASES } from '../../functions/marketing'

const pageTitle = 'For regulated and audited work · ReviewOS'
const pageDescription = 'Who approved what, against which commit, kept as a record rather than inferred after the fact.'
const related = USE_CASES.filter(item => item.slug !== 'regulated').slice(0, 3)

// The rail's summary, beside the page rather than inside its markup: an
// array does not survive an stx attribute as itself, so it is passed as JSON
// - the same reason `StackNav` takes one.
const summary = [
  'Approvals record their commit',
  'Threads are never deleted',
  'Stale approvals dismissed by rule',
  'Everything inside your boundary',
]

// What to do next, and the layout that shows it - see `PageCta.stx`.
const actions = [
  {'href': '/docs/install', 'label': 'Self-host ReviewOS', 'primary': true},
  {'href': '/features', 'label': 'See the features', 'primary': false},
]
</script>

@layout('marketing')

@section('title', pageTitle)
@section('description', pageDescription)

@section('content')
  <div class="shell">
    <header class="page-head">
      <p class="page-eyebrow">Use case</p>
      <h1 class="page-title">An approval that says what it approved</h1>
      <p class="page-lede">In an audit, "this pull request was approved" is not an answer. The question is which code was approved, by whom, and whether it is the code that shipped.</p>
    </header>

    <div class="grid grid-cols-1 gap-[44px] items-start md:grid-cols-[minmax(0,1fr)_280px]">
      <div class="prose">
        <h2>Approvals are bound to a commit</h2>
        <p>Every review records the exact commit it was submitted against. When the branch moves, the forge knows the approval is stale, and a branch rule can dismiss it automatically rather than leaving a human to notice.</p>

        <h2>The conversation is part of the record</h2>
        <p>Review threads are never deleted. A thread whose line has since changed is marked outdated and stays readable with the code it was written about, because the discussion that produced a change is the evidence of why the change was made.</p>

        <h2>Gates that are enforced, not documented</h2>
        <ul>
          <li>Required approvals, with stale ones dismissed when the branch rule says so</li>
          <li>All review conversations resolved before merge, when required</li>
          <li>Named checks passing on the exact head being merged</li>
          <li>A linear history, when a merge commit would obscure the sequence</li>
        </ul>

        <h2>Self-hosted, so the boundary is yours</h2>
        <p>Source code, review history, and identity all sit inside your own network boundary, which is usually simpler to argue about than a third party's compliance posture.</p>
      </div>

      <PageRail
        summaryLabel="Why it fits"
        summaryJson="{{ JSON.stringify(summary) }}"
        relatedLabel="Also read"
        relatedPrefix="/for"
        relatedJson="{{ JSON.stringify(related) }}"
      />
    </div>

    <PageCta
      heading="Make the audit trail a by-product of the workflow"
      line="Nothing here has to be reconstructed later, because it was recorded at the time."
      actionsJson="{{ JSON.stringify(actions) }}"
    />
  </div>
@endsection
