<script server>
/**
 * The shell every page inside the product uses.
 *
 * Separate from the marketing page on purpose: that page argues, this one
 * gets out of the way. Same tokens, denser scale, and the accent is reserved
 * for one thing per screen so review state (green, red, amber) reads as
 * state rather than decoration.
 *
 * The `<head>` used to carry a title and nothing else - no description, no
 * canonical URL, no card, no robots policy. Every link to a repository, a
 * pull request or an issue posted anywhere therefore unfurled as a grey box
 * with a URL in it, which is most of the links this project's users ever
 * share. `pageMeta` resolves the rest from the request path; see
 * `resources/functions/meta.ts`.
 */
import { CARD_HEIGHT, CARD_MIME, CARD_WIDTH, pageMeta } from '../../functions/meta'

// The identifier is bound on the path that serves a request and on no other,
// and an undeclared identifier is a ReferenceError that would take every other
// variable in this file with it - which in stx renders the page blank rather
// than reporting anything.
const serveContext = typeof __stxServeContext === 'undefined' ? undefined : __stxServeContext
const ambientContext = (globalThis as any).__stxServeContext
const meta = pageMeta({ path: String(serveContext?.path ?? ambientContext?.path ?? '/') })
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {{--
      `@yield`, like the marketing layout, and not an interpolation.

      This read `{{ title ?? 'ReviewOS' }}`, which needs a *variable* called
      title, and `@section('title', …)` sets a section - so the seven pages that
      declared one were ignored and every other page named an identifier that
      does not exist. On most pages that resolved to the fallback; on every page
      carrying a component with a client script - the clone box, which is on
      every repository page - the interpolation was not evaluated at all and the
      template source went into the tab, the bookmark, and any link preview that
      scraped one.

      The default is the second argument, so a page that says nothing is called
      ReviewOS rather than nothing.
    --}}
    <title>@yield('title', 'ReviewOS')</title>
    <meta name="description" content="@yield('description', 'An open source, self-hostable git forge built around code review.')">

    {{-- Query strings stripped: a repository's file list at three sort orders
        is one page, and an issue list is not a new page per filter. --}}
    <link rel="canonical" href="{{ meta.canonical }}">

    {{-- Most of the product is deliberately kept out of an index - somebody's
        settings and notifications have nothing to offer a stranger arriving
        from a search result, and the deep repository views (a tree at a ref,
        a compare range) are an unbounded URL space a crawler would walk
        forever. `meta.robots` decides from the path; see `noIndex` in
        resources/functions/meta.ts. --}}
    <meta name="robots" content="{{ meta.robots }}">

    {{-- The link preview.

        `meta.image` is an on-demand card for anything named after an owner,
        a repository, a pull request or an issue, and the site card otherwise.
        The endpoint decides for itself whether what the path names is public
        before it draws anything, so a private repository's page can carry
        this tag and still give a scraper nothing but the generic card. --}}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="ReviewOS">
    <meta property="og:url" content="{{ meta.canonical }}">
    <meta property="og:title" content="@yield('title', 'ReviewOS')">
    <meta property="og:description" content="@yield('description', 'An open source, self-hostable git forge built around code review.')">
    <meta property="og:image" content="{{ meta.image }}">
    <meta property="og:image:type" content="{{ CARD_MIME }}">
    <meta property="og:image:width" content="{{ CARD_WIDTH }}">
    <meta property="og:image:height" content="{{ CARD_HEIGHT }}">
    <meta property="og:image:alt" content="@yield('title', 'ReviewOS')">

    {{-- `summary_large_image`, or X renders a small square thumbnail no
        matter how good the card is. --}}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="@yield('title', 'ReviewOS')">
    <meta name="twitter:description" content="@yield('description', 'An open source, self-hostable git forge built around code review.')">
    <meta name="twitter:image" content="{{ meta.image }}">
    <meta name="twitter:image:alt" content="@yield('title', 'ReviewOS')">

    <meta name="color-scheme" content="light dark">

    {{--
      The reader's colour scheme, applied before anything is painted.

      Inline, in the head, and blocking on purpose. This is the one thing on the
      page that cannot wait for a module to load: read it a frame late and the
      reader watches a light page turn dark, which is worse than not offering
      the choice. `system` is the default and is what the media queries below
      answer to, so a reader who has never chosen sees exactly what they saw
      before this existed.

      It reads the same key `resources/functions/diffprefs.ts` writes, and sets
      the same attribute it sets. If those two ever disagree, the page flashes -
      which is the whole reason this is three lines rather than an import.
    --}}
    <script>
      try {
        var stored = JSON.parse(localStorage.getItem('reviewos:diff') || '{}')
        var scheme = stored && stored.scheme
        document.documentElement.dataset.theme = scheme === 'light' || scheme === 'dark' ? scheme : 'system'
      }
      catch (error) {
        document.documentElement.dataset.theme = 'system'
      }
    </script>
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0c1113" media="(prefers-color-scheme: dark)">
    {{-- The tab, the home screen, and the bookmark bar.

        Four declarations because browsers disagree about what they want, and
        each one is the shortest answer for somebody: the SVG is what a modern
        browser prefers and is crisp at every size, the ICO is what an old one
        and Windows ask for by name, the 180px PNG is what iOS puts on a home
        screen, and the manifest is what Android reads to do the same. All of
        them are `buddy generate:images` output from one mark - see
        `config/images.ts` and `scripts/brand-mark.ts`.

        There was none of this at all until now: every tab carried the
        browser's blank-page glyph and every request for `/favicon.ico` was a
        404 in the log. --}}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">


    <!-- Served from this instance rather than from Google: a page arguing for
         infrastructure you own should not hand every visitor's address to a
         third party, and a forge on a private network cannot reach one at all.
         Preloaded because the browser otherwise learns which files to fetch
         only after a stylesheet has arrived and parsed. -->
    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/geist-mono-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/fonts/fonts.css">

    <style>
      :root {
        --bg: #fbfbfa;
        --surface: #ffffff;
        --surface-tint: #f2f4f4;
        --line: #e2e4e3;
        --line-strong: #cdd1d0;
        --text: #12191b;
        --muted: #5d6b6e;
        --accent: #0f6d72;
        --accent-quiet: #e2f0f0;
        --accent-text: #0b565a;
        --on-accent: #ffffff;
        --pill-text: #4c585b;

        /* Review states. These three are never used for anything else. */
        --ok: #14663c;
        --ok-bg: #e4f3ea;
        --bad: #9b2c2c;
        --bad-bg: #fbe9e9;
        --warn: #8a5a09;
        --warn-bg: #fdf1dc;

        /* Diff surfaces, tinted enough to read at a glance and light enough
          that syntax colours still carry. */
        --add-bg: #e6f5ec;
        --add-line: #bfe4cd;
        --del-bg: #fdeaea;
        --del-line: #f2c9c9;
        --gutter: #f6f8f8;

        --r-panel: 14px;
        --r-control: 10px;
        --shadow: 0 1px 2px rgb(18 25 27 / 0.05);
        --mono: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
      }

      /* The system's preference, when the reader has not chosen. */
      @media (prefers-color-scheme: dark) {
        :root[data-theme='system'] {
          --bg: #0c1113;
          --surface: #121a1c;
          --surface-tint: #162023;
          --line: #222e31;
          --line-strong: #334247;
          --text: #eef2f2;
          --muted: #9aa9ac;
          --accent: #4ec5c9;
          --accent-quiet: #14292b;
          --accent-text: #7fd8db;
          --on-accent: #08201f;
          --pill-text: #a7b5b8;

          --ok: #55c48a;
          --ok-bg: #15291f;
          --bad: #f08585;
          --bad-bg: #2a1717;
          --warn: #e0b25f;
          --warn-bg: #2a2113;

          --add-bg: #12261b;
          --add-line: #1f4530;
          --del-bg: #2a1618;
          --del-line: #4d2529;
          --gutter: #101719;

          --shadow: none;
        }
      }

      /* The same palette, when they have. */
      :root[data-theme='dark'] {
          --bg: #0c1113;
          --surface: #121a1c;
          --surface-tint: #162023;
          --line: #222e31;
          --line-strong: #334247;
          --text: #eef2f2;
          --muted: #9aa9ac;
          --accent: #4ec5c9;
          --accent-quiet: #14292b;
          --accent-text: #7fd8db;
          --on-accent: #08201f;
          --pill-text: #a7b5b8;

          --ok: #55c48a;
          --ok-bg: #15291f;
          --bad: #f08585;
          --bad-bg: #2a1717;
          --warn: #e0b25f;
          --warn-bg: #2a2113;

          --add-bg: #12261b;
          --add-line: #1f4530;
          --del-bg: #2a1618;
          --del-line: #4d2529;
          --gutter: #101719;

          --shadow: none;
        }


      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: Geist, ui-sans-serif, system-ui, sans-serif;
        font-size: 15px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }

      a { color: inherit; }

      /*
       * A link that looks like one.
       *
       * `color: inherit` above is deliberate and right for the many anchors
       * that are a whole row, card or tab - colouring those would light up
       * half the product. It was wrong for the other kind, and this codebase
       * happens to distinguish them already: an anchor with no class is an
       * anchor inside a sentence. There are seventy of them, and every one was
       * rendering in the surrounding grey with no underline. "Sign in to see
       * what is waiting on you" on an empty review queue was a dead end for
       * anybody who did not think to click the words.
       *
       * Colour and, on hover, an underline. Not underlined at rest because
       * these run several to a paragraph in the pull request pages, and the
       * contrast between the accent and the body text carries it.
       */
      a:not([class]) { color: var(--accent-text); }
      a:not([class]):hover { text-decoration: underline; }
      h1, h2, h3 { margin: 0; letter-spacing: -0.02em; line-height: 1.2; font-weight: 600; }
      p { margin: 0; }
      ul { margin: 0; padding: 0; list-style: none; }

      .shell { width: 100%; max-width: 1320px; margin: 0 auto; padding: 0 20px; }

      .panel {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-panel);
        box-shadow: var(--shadow);
      }

      .muted { color: var(--muted); }
      .mono { font-family: var(--mono); font-size: 0.875em; }

      /* A control that sits in a line of running text rather than in a row of
        its own, so it matches the type around it instead of towering over it. */
      .btn-small {
        height: 24px;
        padding: 0 8px;
        font-size: 12.5px;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        height: 34px;
        padding: 0 13px;
        border: 1px solid var(--line-strong);
        border-radius: var(--r-control);
        background: var(--surface);
        color: var(--text);
        font: inherit;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
      }

      .btn:hover { background: var(--surface-tint); }

      .btn-primary {
        background: var(--accent);
        border-color: var(--accent);
        color: var(--on-accent);
      }

      .btn-primary:hover { filter: brightness(1.06); background: var(--accent); }

      .btn:disabled, .btn[aria-disabled='true'] {
        opacity: 0.55;
        cursor: not-allowed;
      }

      /* Status pills are the only fully round thing in the system. */
      .pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 24px;
        padding: 0 10px;
        border-radius: 999px;
        font-size: 12.5px;
        font-weight: 500;
        white-space: nowrap;
      }

      .pill-open { background: var(--ok-bg); color: var(--ok); }
      .pill-merged { background: var(--accent-quiet); color: var(--accent-text); }
      .pill-closed { background: var(--bad-bg); color: var(--bad); }
      .pill-draft { background: var(--surface-tint); color: var(--pill-text); }
      .pill-pending { background: var(--warn-bg); color: var(--warn); }

      /*
       * A machine account, marked but not flagged.
       *
       * Quiet on purpose: an agent is a contributor here, and a red badge next
       * to its name would read as a warning about the change rather than as a
       * fact about the author. Small, lowercase, and the same weight as the
       * text around it.
       */
      .pill-machine {
        height: 18px;
        padding: 0 7px;
        font-size: 11px;
        letter-spacing: 0.02em;
        background: var(--surface-tint);
        color: var(--muted);
        border: 1px solid var(--line);
      }

      .tabs {
        display: flex;
        gap: 4px;
        border-bottom: 1px solid var(--line);
      }

      .tab {
        padding: 10px 12px;
        border-bottom: 2px solid transparent;
        color: var(--muted);
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
      }

      .tab[aria-current='page'] {
        color: var(--text);
        border-bottom-color: var(--accent);
      }

      @media (prefers-reduced-motion: reduce) {
        * { animation: none !important; transition: none !important; }
      }

      /* Rendered user markdown: READMEs, issue bodies, comments, reviews.

        In the layout rather than in any one component, because the same HTML
        comes out of the same renderer everywhere, and a README that looks like
        one thing in the file browser and another in a pull request is a bug
        nobody would think to look for. */
      .markdown { line-height: 1.65; overflow-wrap: break-word; }
      .markdown > :first-child { margin-top: 0; }
      .markdown > :last-child { margin-bottom: 0; }

      .markdown h1, .markdown h2, .markdown h3,
      .markdown h4, .markdown h5, .markdown h6 {
        margin: 26px 0 12px;
        font-weight: 600;
        line-height: 1.3;
      }

      .markdown h1 { font-size: 26px; padding-bottom: 8px; border-bottom: 1px solid var(--line); }
      .markdown h2 { font-size: 21px; padding-bottom: 7px; border-bottom: 1px solid var(--line); }
      .markdown h3 { font-size: 17px; }
      .markdown h4 { font-size: 15px; }
      .markdown h5, .markdown h6 { font-size: 14px; color: var(--muted); }

      .markdown p, .markdown ul, .markdown ol, .markdown blockquote, .markdown table, .markdown pre {
        margin: 0 0 14px;
      }

      /* The reset strips list markers site-wide, which is right for navigation
        and wrong here: in prose a bullet is the only thing telling a reader
        these lines are a list. */
      .markdown ul { padding-left: 24px; list-style: disc; }
      .markdown ol { padding-left: 24px; list-style: decimal; }
      .markdown li { margin: 4px 0; }
      .markdown li > ul, .markdown li > ol { margin: 4px 0; }

      /* A mermaid fence, before and after it is drawn.

        Before, it is the definition in a monospace box, which is exactly what
        a fence looked like before diagrams existed and is the state a reader
        is left in if the script never arrives. After, the box is gone and the
        SVG stands on its own. */
      .markdown pre.mermaid {
        padding: 14px 16px;
        overflow-x: auto;
        font-family: var(--mono);
        font-size: 12.5px;
        line-height: 1.55;
        background: var(--surface-tint);
        border: 1px solid var(--line);
        border-radius: var(--r-panel);
        white-space: pre;
      }

      .markdown pre.mermaid[data-processed] {
        padding: 4px 0;
        text-align: center;
        background: none;
        border: 0;
      }

      .markdown pre.mermaid[data-processed] svg { max-width: 100%; height: auto; }

      .markdown li.task-item { list-style: none; margin-left: -20px; }
      .markdown li.task-item input { margin-right: 7px; vertical-align: middle; }

      /* A tickable item is a one-button form, because the page runs no
        client-side JavaScript and a checkbox cannot submit on its own. The
        button is drawn as the checkbox rather than sitting next to one, so
        there is exactly one thing to click. */
      .markdown .task-form { display: inline; }
      .markdown .task-box {
        width: 13px;
        height: 13px;
        margin-right: 7px;
        padding: 0;
        vertical-align: middle;
        border: 1px solid var(--line-strong);
        border-radius: 3px;
        background: var(--surface);
        cursor: pointer;
      }
      .markdown .task-box:hover { border-color: var(--fg); }
      .markdown .task-box.is-checked {
        border-color: var(--fg);
        background: var(--fg);
        /* The tick, drawn rather than shipped as an icon: it has to sit inside
          13 pixels and match the border radius above. */
        background-image: linear-gradient(45deg, transparent 44%, var(--bg) 44%, var(--bg) 56%, transparent 56%),
                          linear-gradient(-45deg, transparent 44%, var(--bg) 44%, var(--bg) 56%, transparent 56%);
        background-size: 8px 2px, 5px 2px;
        background-position: 4px 7px, 2px 6px;
        background-repeat: no-repeat;
      }

      .markdown blockquote {
        padding: 2px 0 2px 14px;
        border-left: 3px solid var(--line-strong);
        color: var(--muted);
      }

      .markdown code {
        padding: 2px 5px;
        border-radius: 5px;
        background: var(--surface-tint);
        font-size: 0.9em;
      }

      .markdown pre {
        padding: 14px 16px;
        border-radius: var(--r-control);
        background: var(--surface-tint);
        overflow-x: auto;
      }

      /* Inside a block the padding belongs to the block, not to every token. */
      .markdown pre code { padding: 0; background: none; font-size: 12.5px; line-height: 1.55; }

      .markdown table { border-collapse: collapse; display: block; overflow-x: auto; }
      .markdown th, .markdown td { padding: 6px 12px; border: 1px solid var(--line); }
      .markdown th { background: var(--surface-tint); font-weight: 600; }

      .markdown img { max-width: 100%; height: auto; }
      .markdown hr { height: 1px; margin: 22px 0; border: 0; background: var(--line); }
      .markdown a { color: var(--accent-text); }

      /* Syntax colours, shared by the diff and the file view.
        Deliberately low-saturation: in a diff they sit on top of green and red
        backgrounds, and a vivid palette turns a reviewed line into a fruit
        salad. Hue carries the meaning, not intensity.

        They live in the layout rather than in either component so the two
        cannot drift into disagreeing about what a keyword looks like. */
      .t-keyword { color: #8250df; }
      .t-string { color: #0a6640; }
      .t-comment { color: var(--muted); font-style: italic; }
      .t-numeric { color: #0550ae; }
      .t-function { color: #6639ba; }
      .t-type { color: #953800; }
      .t-tag { color: #0a6640; }
      .t-attribute { color: #6639ba; }
      .t-operator, .t-punctuation { color: var(--muted); }
      .t-variable, .t-text { color: inherit; }

      @media (prefers-color-scheme: dark) {
        .t-keyword { color: #d2a8ff; }
        .t-string { color: #7ee787; }
        .t-numeric { color: #79c0ff; }
        .t-function { color: #d2a8ff; }
        .t-type { color: #ffa657; }
        .t-tag { color: #7ee787; }
        .t-attribute { color: #d2a8ff; }
            }

      /* The same palette, when they have. */
      :root[data-theme='dark'] .t-keyword { color: #d2a8ff; }
        :root[data-theme='dark'] .t-string { color: #7ee787; }
        :root[data-theme='dark'] .t-numeric { color: #79c0ff; }
        :root[data-theme='dark'] .t-function { color: #d2a8ff; }
        :root[data-theme='dark'] .t-type { color: #ffa657; }
        :root[data-theme='dark'] .t-tag { color: #7ee787; }
        :root[data-theme='dark'] .t-attribute { color: #d2a8ff; }


      /* ---- The diff ----

        Shared by the two things that produce diff markup: `DiffView.stx` for
        the first screen, and `app/Actions/Pull/rows.ts` for every row streamed
        into the virtualized list. Kept here rather than in either one so they
        cannot disagree about what a diff looks like. */
      /* `clip` rather than `hidden`, and the difference matters: `hidden` makes
        the panel a scroll container, and a scroll container between a sticky
        element and the real scroller is the one thing that stops sticky
        working at all. The file header sat here doing nothing for exactly that
        reason. `clip` clips the same way and scrolls nothing. */
      .diff-file { overflow: clip; margin-bottom: 16px; }

      /* A folded file on a page with no script. The summary *is* the fold
        control, so the marker takes the place of the button the streamed
        viewer draws, and it points the same way. */
      details.diff-file > summary { cursor: pointer; list-style: none; }
      details.diff-file > summary::-webkit-details-marker { display: none; }

      details.diff-file > summary::before {
        display: inline-block;
        flex: none;
        width: 22px;
        color: var(--muted);
        content: '›';
        font-size: 15px;
        text-align: center;
        transition: transform 0.12s ease;
      }

      details.diff-file[open] > summary::before { transform: rotate(90deg); }

      .diff-head {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 12px;
        background: var(--surface-tint);
        border-bottom: 1px solid var(--line);
      }

      .diff-toggle {
        display: inline-flex;
        width: 22px;
        height: 22px;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: 0;
        border-radius: 6px;
        background: transparent;
        color: var(--muted);
        cursor: pointer;
      }

      .diff-toggle:hover { background: var(--line); }
      .diff-toggle[aria-expanded='false'] span { transform: rotate(-90deg); }

      .diff-path { flex: 1; min-width: 0; overflow-wrap: anywhere; font-weight: 500; }

      /* The review queue. A list of links and nothing else: the page runs no
        script, and every row carries its own reason so the order never has to
        be taken on trust. */
      /* The queue and the inbox start where every other page starts.
        
        Both were a 900px column centred in the window, so the two screens the
        navigation lists first began 30px in at a small window and 250px in at a
        large one, while every other page - and the navigation above them - began
        at the shell's gutter. The reading measure is worth keeping and the
        left edge is not the place to spend it: the container is the shell now,
        and the 900px cap moved onto the content inside it. */
      .queue-head h1 { margin: 0 0 4px; font-size: 22px; }
      .queue-head p { margin: 0 0 28px; font-size: 14px; }
      .queue-section { margin-bottom: 36px; }
      .queue-section h2 { margin: 0 0 12px; font-size: 15px; font-weight: 600; }
      .queue-empty { margin: 0; font-size: 14px; }
      .queue-list { margin: 0; padding: 0; list-style: none; }

      .queue-row {
        display: flex;
        align-items: baseline;
        gap: 12px;
        padding: 10px 12px;
        border: 1px solid var(--line);
        border-radius: 8px;
        margin-bottom: 6px;
      }

      .queue-row:hover { border-color: var(--line-strong); }

      /* A draft is at the bottom of the order and looks like it. Dimmed rather
        than hidden: it is still somebody's work and still worth finding. */
      .queue-row.is-draft { opacity: 0.6; }

      .queue-link {
        display: flex;
        flex: 1;
        align-items: baseline;
        gap: 10px;
        min-width: 0;
        color: inherit;
        text-decoration: none;
      }

      .queue-where { flex-shrink: 0; color: var(--muted); font-size: 12px; }
      .queue-number { flex-shrink: 0; color: var(--muted); font-size: 12px; }
      .queue-title { overflow: hidden; font-size: 14px; text-overflow: ellipsis; white-space: nowrap; }
      .queue-link:hover .queue-title { text-decoration: underline; }
      .queue-meta { flex-shrink: 0; font-size: 12px; }

      /* The inbox. Built on the queue's row so the two read as the same
        product: a list of links, no script, every row carrying its own
        reason. */
      .inbox-head h1 { margin: 0 0 4px; font-size: 22px; }
      .inbox-head p { margin: 0 0 20px; font-size: 14px; }
      .inbox-empty { margin: 0; font-size: 14px; }
      .inbox-list { margin: 0; padding: 0; list-style: none; }

      .inbox-filters { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }

      .inbox-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 9px;
        border: 1px solid var(--line);
        border-radius: 999px;
        color: var(--muted);
        font-size: 12px;
        text-decoration: none;
      }

      .inbox-chip:hover { border-color: var(--line-strong); color: var(--text); }

      /* An active filter inverts rather than tinting. A chip that is only a
        shade different from its neighbours is a filter people forget is on,
        and then the empty inbox reads as "nothing happened". */
      .inbox-chip.is-on { background: var(--text); border-color: var(--text); color: var(--bg); }
      .inbox-chip.is-clear { border-style: dashed; }
      .inbox-chip-count { font-variant-numeric: tabular-nums; font-weight: 600; }

      .inbox-bulk { margin: 0 0 10px; }

      .inbox-bulk-button {
        padding: 3px 9px;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: transparent;
        color: var(--muted);
        font: inherit;
        font-size: 12px;
        cursor: pointer;
      }

      .inbox-bulk-button:hover { border-color: var(--line-strong); color: var(--text); }

      .inbox-row {
        display: flex;
        align-items: baseline;
        gap: 12px;
        padding: 10px 12px;
        border: 1px solid var(--line);
        border-radius: 8px;
        margin-bottom: 6px;
      }

      .inbox-row:hover { border-color: var(--line-strong); }

      /* Read is dimmed, not hidden. Somebody looking for the thing they read an
        hour ago is the second most common visit an inbox gets, and a list that
        drops rows on read makes that trip impossible. */
      .inbox-row.is-read { opacity: 0.55; }

      /* The unread marker is the left edge rather than a dot, so it reads down
        a column of forty rows without the eye having to find it on each one. */
      .inbox-row:not(.is-read) { border-left: 2px solid var(--text); }

      .inbox-link {
        display: flex;
        flex: 1;
        align-items: baseline;
        gap: 10px;
        min-width: 0;
        color: inherit;
        text-decoration: none;
      }

      .inbox-where { flex-shrink: 0; color: var(--muted); font-size: 12px; }
      .inbox-number { flex-shrink: 0; color: var(--muted); font-size: 12px; }
      .inbox-title { overflow: hidden; font-size: 14px; text-overflow: ellipsis; white-space: nowrap; }
      .inbox-link:hover .inbox-title { text-decoration: underline; }
      .inbox-meta { flex-shrink: 0; font-size: 12px; }
      .inbox-mark { flex-shrink: 0; margin: 0; }

      /* Quiet until the row is hovered. Forty of these at full strength turn
        the list into a column of buttons, and the row itself is the thing
        people came to click. */
      .inbox-mark-button {
        padding: 1px 6px;
        border: 1px solid transparent;
        border-radius: 5px;
        background: transparent;
        color: var(--muted);
        font: inherit;
        font-size: 11px;
        opacity: 0;
        cursor: pointer;
      }

      .inbox-row:hover .inbox-mark-button { opacity: 1; border-color: var(--line); }
      .inbox-mark-button:focus { opacity: 1; border-color: var(--line-strong); }
      .inbox-row.is-read .inbox-mark-button { display: none; }

      /* Notification settings. A list of rows rather than a table: the event is
        a sentence, and a table would set it in a column narrow enough to wrap
        every one of them. */
      .prefs-list { margin: 0; padding: 0; list-style: none; }

      .prefs-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px 16px;
        padding: 12px 16px;
        border-bottom: 1px solid var(--line);
      }

      .prefs-row:last-child { border-bottom: 0; }
      .prefs-event { flex: 1 1 240px; min-width: 0; font-size: 14px; }
      .prefs-inbox { flex-shrink: 0; font-size: 12px; }
      .prefs-control { display: flex; align-items: center; gap: 6px; margin: 0; }
      .prefs-label { font-size: 12px; text-transform: capitalize; }

      .prefs-select {
        padding: 3px 6px;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: var(--bg);
        color: var(--text);
        font: inherit;
        font-size: 12px;
      }

      /* Says the value is what ships rather than what somebody chose. Without
        it a settings page cannot distinguish "I picked this" from "nobody has
        touched it", and the two mean different things when the default moves. */
      .prefs-note { font-size: 11px; font-style: italic; }

      .prefs-save {
        padding: 2px 8px;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: transparent;
        color: var(--muted);
        font: inherit;
        font-size: 12px;
        cursor: pointer;
      }

      .prefs-save:hover { border-color: var(--line-strong); color: var(--text); }

      .prefs-explainer { margin: -4px 0 12px; font-size: 13px; }

      /* The one line on this page somebody actually reads. Set apart, because
        four rules interact behind it and the answer is not derivable from the
        switches above without doing the interaction in your head. */
      /* Sign in, sign up, and anything else that is one card and one form. */
      /* A settings screen: a heading, sections, and a form in a panel.
        
        These were declared inside `settings/keys.stx`, and four other pages -
        profile, notification settings, a repository's webhooks, and the token
        list - used the same names. On those pages the form had no padding at
        all, so every input ran into the edge of its own panel.

        The width is the other half. A settings form is a column of short
        fields, and at the shell's full 1320 pixels a handle box is a metre
        wide and the label above it is a long way from the value it names. */
      .keys-head { margin-bottom: 26px; }
      .keys-title { font-size: 22px; font-weight: 600; margin-bottom: 4px; }

      .keys-section { margin-bottom: 34px; }

      .keys-section-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
      }

      .keys-heading { font-size: 16px; font-weight: 600; }

      .key-form {
        max-width: 640px;
        padding: 18px;
        margin-bottom: 14px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-panel, 14px);
      }

      .keys-empty { padding: 26px; text-align: center; }

      /* A form field, anywhere in the product.
        
        These lived in `settings/keys.stx`, inside that page's own `<style>`
        block, and six other pages used the same class names - including
        `login` and `register`. So the front door of the product rendered its
        email and password boxes with no border, no padding and the browser's
        default font, and the only page where they looked like fields was the
        one nobody sees until they already have an account.

        `font: inherit` is the rule the old copy was missing on top of that: an
        input does not inherit type from the page, so every value people typed
        was set in a different family from the label above it. */
      .field-label {
        display: block;
        font-size: 12.5px;
        font-weight: 500;
        margin-bottom: 6px;
      }

      .field-input {
        display: block;
        width: 100%;
        padding: 8px 10px;
        margin-bottom: 14px;
        font: inherit;
        font-size: 13.5px;
        color: var(--text);
        background: var(--bg);
        border: 1px solid var(--line-strong);
        border-radius: var(--r-control);
      }

      .field-input:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 1px;
        border-color: var(--accent);
      }

      /* A textarea keeps its own height and stays resizable vertically; a
        select needs the arrow the platform draws. */
      textarea.field-input { min-height: 84px; resize: vertical; }
      select.field-input { appearance: auto; }

      /* Pulled up under the input it belongs to. At the field's own spacing it
        sits exactly between two fields and reads as a caption for the next
        one, which is how "letters, numbers and hyphens" ends up looking like
        the rule for the name box. */
      .field-hint { margin: -8px 0 14px; font-size: 12px; line-height: 1.5; color: var(--muted); }

      .field-actions { display: flex; justify-content: flex-end; gap: 10px; }

      /* One card, one form, one thing to do: on the auth screens the button is
        the width of the fields above it rather than a small control tucked
        into a corner. */
      .card-page .field-actions { display: block; }
      .card-page .field-actions .btn { width: 100%; justify-content: center; }

      /* The two page shapes this product has, as two classes rather than as
        the same inline `style` copied into thirty-two views.
        
        `.page` is the working shape: everything with a heading and a list
        under it. `.card-page` is the other one - a single card and nothing
        else, which is every page somebody arrives at from outside (sign in,
        register, reset, unsubscribe).
        
        The card is centred in what is left of the viewport under the bar,
        because a 420px card pinned to the top of a 900px screen reads as a
        page that failed to finish loading. `align-content` rather than
        `place-items`, so a tall card - registration has four fields and three
        hints - grows downward and scrolls instead of being clipped at both
        ends. */
      .page { width: 100%; max-width: 1320px; margin: 0 auto; padding: 22px 20px 64px; }

      /* Pages that are a list to read rather than a surface to work on: the
        review queue, the inbox, search results. A repository name and a line
        of description stretched across 1225px is a line the eye has to travel,
        and nothing is gained by the travelling. The wrapper keeps the full
        measure so a wide table inside one can still opt out. */
      .page-reading > * { max-width: 900px; }

      .card-page {
        display: grid;
        align-content: center;
        justify-items: center;
        min-height: calc(100vh - 56px);
        padding: 48px 20px 72px;
      }

      .auth-card { width: 100%; max-width: 420px; padding: 28px; }
      .auth-title { margin: 0 0 14px; font-size: 20px; }
      .auth-line { margin: 14px 0 0; font-size: 14px; }
      .auth-line + .auth-line { margin-top: 4px; }
      .auth-form { margin: 0; }

      /* Loud enough to find without scrolling, quiet enough that a mistyped
        password does not read as a system failure. */
      .auth-error {
        margin: 0 0 14px;
        padding: 8px 12px;
        border-left: 2px solid var(--bad);
        border-radius: 0 8px 8px 0;
        background: var(--bad-bg);
        color: var(--bad);
        font-size: 13px;
      }

      /* The same shape as .auth-error in the neutral colour. Something worked,
         and it is worth saying so on the page it lands on rather than leaving
         the reader to infer it from a form they no longer need. */
      .auth-notice {
        margin: 0 0 14px;
        padding: 8px 12px;
        border-left: 2px solid var(--accent);
        border-radius: 0 8px 8px 0;
        background: var(--panel-2, transparent);
        font-size: 13px;
      }

      /* A mirror says so, above the code rather than below it: the reader's
         question is whether to trust what they are about to read, and they
         have it before they start. */
      .mirror-banner {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-top: 14px;
        padding: 12px 16px;
        border: 1px solid var(--line);
        border-left-width: 2px;
        border-radius: 8px;
        font-size: 13.5px;
      }
      .mirror-icon { font-size: 16px; margin-top: 1px; opacity: 0.7; flex: none; }
      .mirror-main { flex: 1; min-width: 0; }
      .mirror-line { margin: 0; }
      .mirror-problem { margin: 6px 0 0; color: var(--bad); }
      .mirror-sync { flex: none; }

      /* Syncing is the ordinary state and gets no colour at all - a banner that
         is always tinted is a banner nobody reads by the time it matters. */
      .mirror-syncing, .mirror-never { border-left-color: var(--line); }
      .mirror-stale { border-left-color: var(--warn, var(--accent)); }
      .mirror-failing { border-left-color: var(--bad); }
      .mirror-disabled { border-left-color: var(--line); opacity: 0.75; }

      @media (max-width: 640px) {
        .mirror-banner { flex-wrap: wrap; }
        .mirror-sync { width: 100%; }
      }

      /* A profile, and the feed on it. Two columns: who this is, and what they
        have. The identity column is the one that stays put, so the page reads
        the same on somebody with two repositories and somebody with two
        hundred. */
      .profile { display: grid; grid-template-columns: 272px 1fr; gap: 40px; align-items: start; }
      @media (max-width: 900px) { .profile { grid-template-columns: 1fr; gap: 24px; } }

      .profile-identity { display: flex; align-items: center; gap: 14px; }

      /* Round for a person, rounded-square for an organization, which is the
        distinction every forge reader already reads without being told. */
      .profile-avatar {
        width: 64px;
        height: 64px;
        flex: none;
        border-radius: 50%;
        object-fit: cover;
        background: var(--surface-tint);
        border: 1px solid var(--line);
      }

      .profile-avatar.is-organization { border-radius: 14px; }

      /* No avatar, so the initial - in the neutral palette rather than a
        coloured identicon. The accent is reserved for one thing per screen and
        a tinted tile would take it for decoration. */
      .profile-avatar-letter {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--muted);
        user-select: none;
      }

      .profile-name { margin: 0; font-size: 21px; }
      .profile-handle { margin: 1px 0 0; font-size: 13px; }
      .profile-bio { margin: 14px 0 0; font-size: 14px; }
      .profile-action { margin-top: 16px; width: 100%; justify-content: center; }

      .profile-facts {
        margin: 18px 0 0;
        padding: 16px 0 0;
        border-top: 1px solid var(--line);
        list-style: none;
        font-size: 13px;
      }

      .profile-facts li { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; overflow-wrap: anywhere; }
      .profile-facts li:last-child { margin-bottom: 0; }
      .profile-facts [class^='i-'] { flex: none; color: var(--muted); font-size: 15px; }

      .profile-counts {
        margin: 16px 0 0;
        padding: 16px 0 0;
        border-top: 1px solid var(--line);
        list-style: none;
        font-size: 13px;
      }

      .profile-counts li { margin-bottom: 4px; }
      .profile-counts strong { font-variant-numeric: tabular-nums; }

      .profile-people { margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--line); }

      .profile-side-heading {
        display: flex;
        align-items: center;
        gap: 7px;
        margin: 0 0 10px;
        font-size: 13.5px;
        font-weight: 600;
      }

      .profile-side-heading a { text-decoration: none; }
      .profile-side-heading a:hover { color: var(--accent-text); }

      .profile-side-count {
        padding: 0 7px;
        border: 1px solid var(--line);
        border-radius: 999px;
        font-size: 11.5px;
        font-weight: 500;
        line-height: 17px;
        color: var(--pill-text, var(--muted));
        font-variant-numeric: tabular-nums;
      }

      .profile-faces { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
      .profile-faces img, .profile-face-letter {
        display: block;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        object-fit: cover;
        background: var(--surface-tint);
        border: 1px solid var(--line);
      }

      .profile-face-letter {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 600;
        color: var(--muted);
      }

      /* The tabs, for an organization: the only owner with somewhere else to
        go. A bar with one tab on it is a claim that there is a second page. */
      .profile-tabs { display: flex; gap: 2px; margin-bottom: 20px; border-bottom: 1px solid var(--line); }

      .profile-tab {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 13px;
        font-size: 13.5px;
        color: var(--muted);
        text-decoration: none;
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
      }

      .profile-tab:hover { color: var(--text); }
      .profile-tab.is-current { color: var(--text); font-weight: 500; border-bottom-color: var(--accent); }

      .profile-tab-count {
        padding: 0 6px;
        border: 1px solid var(--line);
        border-radius: 999px;
        font-size: 11px;
        line-height: 16px;
        font-variant-numeric: tabular-nums;
      }

      .profile-hint { margin: 0 0 24px; font-size: 13.5px; }
      .profile-hint code { font-family: var(--mono); font-size: 12.5px; }

      /*
       * The column's rhythm, set once here rather than by each block choosing
       * its own margin.
       *
       * The profile README arrives as `MarkdownContent`, which carries an
       * 18px top margin for the repository pages where something always
       * precedes it. On a profile it is usually the first thing in the column,
       * so that margin pushed it 18px below the avatar beside it - two columns
       * of the same page starting at different heights - and then the
       * repositories section, which had no top margin at all, began flush
       * against the bottom of it.
       */
      .profile-main { display: flex; flex-direction: column; gap: 28px; }
      .profile-main > .markdown-panel { margin-top: 0; }

      .profile-section { margin-bottom: 34px; }
      .profile-section:last-child { margin-bottom: 0; }

      .profile-section-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 14px;
      }

      .profile-heading { display: flex; align-items: center; gap: 8px; margin: 0 0 14px; font-size: 15px; }
      .profile-section-head .profile-heading { margin: 0; }

      .profile-search { display: flex; align-items: center; gap: 8px; }

      .profile-search-input {
        height: 30px;
        width: 220px;
        max-width: 46vw;
        padding: 0 10px;
        border: 1px solid var(--line-strong);
        border-radius: var(--r-control);
        background: var(--bg);
        color: var(--text);
        font: inherit;
        font-size: 13.5px;
      }

      .profile-search-input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }

      /* Cards rather than rows. A repository is a name, a sentence and two
        numbers, and in one column per line that sentence had nowhere to go. */
      .profile-repos {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      @media (max-width: 700px) { .profile-repos { grid-template-columns: 1fr; } }

      /* What a repository page is showing, under its tabs: "Commits on main",
        and whatever the next screen needs. Below the tabs rather than in the
        header, because it describes the page rather than the repository. */
      .repo-page-caption { margin: 14px 0 0; font-size: 13px; }

      /* An empty repository: the commands, because there is nothing else to
        show and somebody is standing there with a checkout and no idea what
        this instance wants them to type. */
      .empty-repo { padding: 24px 26px; margin-top: 18px; max-width: 680px; }
      .empty-repo-title { font-size: 17px; margin-bottom: 6px; }
      .empty-repo-heading { margin: 20px 0 8px; font-size: 13.5px; font-weight: 600; }

      .empty-repo-commands {
        margin: 0;
        padding: 12px 14px;
        border: 1px solid var(--line);
        border-radius: var(--r-control);
        background: var(--bg);
        font-size: 12.5px;
        line-height: 1.7;
        overflow-x: auto;
      }

      .empty-repo-note { margin-top: 16px; font-size: 13px; }

      /* One repository, as a card: `resources/components/RepositoryCard.stx`,
        which the profile and both explore lists render. They used to draw four
        of these between them.

        The rules live here rather than in the component because stx emits a
        component's `<style>` once per instance, and a profile renders
        twenty-four cards. */
      .repo-card {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 14px 16px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-panel);
      }

      .repo-card:hover { border-color: var(--line-strong); }
      .repo-card-head { display: flex; align-items: center; flex-wrap: wrap; gap: 7px; }

      .repo-card-name {
        font-weight: 600;
        font-size: 14.5px;
        text-decoration: none;
        overflow-wrap: anywhere;
      }

      .repo-card-name:hover { color: var(--accent-text); }

      .repo-card-pill {
        padding: 0 7px;
        border: 1px solid var(--line);
        border-radius: 999px;
        font-size: 11px;
        line-height: 17px;
        color: var(--pill-text, var(--muted));
      }

      /* Two lines and then an ellipsis: a grid whose rows are different heights
        reads as a broken layout rather than as a long description. */
      .repo-card-about {
        margin: 0;
        font-size: 13px;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .repo-card-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin: auto 0 0;
        padding-top: 4px;
        font-size: 12px;
      }

      .repo-card-stat {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-variant-numeric: tabular-nums;
      }

      .repo-card-language::before {
        content: '';
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: currentColor;
        opacity: 0.55;
      }

      /* The one number on the card that is the reason the list exists, so it is
        the one that gets the accent. */
      .repo-card-gained { color: var(--accent-text); font-weight: 500; }

      .profile-pager { display: flex; align-items: center; gap: 12px; margin-top: 18px; font-size: 13px; }

      /* The feed. One sentence per row, with the link on the target rather
        than the whole row: a row-wide link makes the actor unclickable, and
        going to somebody profile from a feed entry is the second most common
        thing anybody does here. */
      .feed { margin: 0; padding: 0; list-style: none; }
      .feed-empty { margin: 0; font-size: 14px; }

      .feed-row {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 5px 7px;
        padding: 8px 0;
        border-bottom: 1px solid var(--line);
        font-size: 14px;
      }

      .feed-row:last-child { border-bottom: 0; }
      .feed-actor { font-weight: 500; }
      .feed-phrase { color: var(--muted); }
      .feed-target { font-size: 13px; }

      /* Truncates rather than wrapping the row to four lines. A title can be
        three hundred characters, and a feed is scanned. */
      .feed-title { flex: 1; min-width: 0; overflow: hidden; font-size: 13px; text-overflow: ellipsis; white-space: nowrap; }
      .feed-when { flex-shrink: 0; margin-left: auto; font-size: 12px; }

      /* The live banner. Above the header, because it is the one thing on the
        page that can make everything below it wrong. */
      .live { margin-bottom: 12px; }

      .live-banner {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        border: 1px solid var(--line);
        border-left: 2px solid var(--accent);
        border-radius: 0 8px 8px 0;
        background: var(--surface-tint);
        font-size: 13px;
      }

      /* A new comment leaves the diff correct and adds to it. A new head
        commit does not, and the two must not look the same. */
      .live-banner.is-stale { border-left-color: var(--warn); background: var(--warn-bg); }
      .live-reload { margin-left: auto; flex-shrink: 0; font-weight: 500; }
      .live-presence { margin: 6px 0 0; font-size: 12px; }

      .push-actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0 0; }

      .prefs-now {
        margin: 10px 0 0;
        padding: 8px 12px;
        border-left: 2px solid var(--accent);
        background: var(--surface-tint);
        border-radius: 0 8px 8px 0;
        font-size: 13px;
      }
      .prefs-schedule { padding: 16px; }
      .prefs-days { display: flex; flex-wrap: wrap; gap: 12px; margin: 0 0 14px; padding: 0; border: 0; }
      .prefs-day { display: inline-flex; align-items: center; gap: 5px; font-size: 13px; }
      .prefs-window { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
      .prefs-time { width: 120px; }
      .prefs-tz { width: 200px; }

      /* The unsubscribe page. Reached from an email with no session, so it is
        one card and one button and nothing else to decide. */
      .unsub-card { width: 100%; max-width: 520px; padding: 28px; text-align: center; }
      .unsub-title { margin: 0 0 10px; font-size: 20px; }
      .unsub-line { margin: 0 0 8px; font-size: 14px; }
      .unsub-form { margin: 18px 0; }

      /* Webhooks. The delivery log is the page: a webhook that works needs no
        interface, and the reason anybody opens this is that something did not
        arrive. */
      .hook-hint { margin: 10px 0 0; font-size: 12px; }
      .hook-card { margin-bottom: 16px; padding: 16px; }
      .hook-head { display: flex; align-items: baseline; gap: 10px; }
      .hook-url { flex: 1; min-width: 0; overflow-wrap: anywhere; font-size: 13px; }

      .hook-state {
        flex-shrink: 0;
        padding: 1px 8px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 600;
      }

      .hook-state.is-on { background: var(--ok-bg); color: var(--ok); }
      .hook-state.is-off { background: var(--warn-bg); color: var(--warn); }
      .hook-meta { margin: 6px 0 0; font-size: 12px; }
      .hook-note { margin: 6px 0 0; font-size: 12px; }
      .hook-deliveries { margin: 12px 0 0; padding: 0; list-style: none; }

      .hook-delivery {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 6px 10px;
        padding: 6px 0;
        border-top: 1px solid var(--line);
        font-size: 12px;
      }

      /* The left edge carries the outcome, so a column of twenty reads without
        the eye having to find a badge on each row. */
      .hook-delivery.is-ok { border-left: 2px solid var(--ok); padding-left: 8px; }
      .hook-delivery.is-bad { border-left: 2px solid var(--bad); padding-left: 8px; }
      .hook-event { flex-shrink: 0; color: var(--muted); }
      .hook-summary { flex: 1; min-width: 0; }
      .hook-detail { flex-shrink: 0; }
      .hook-redeliver { flex-shrink: 0; margin: 0; }

      .hook-redeliver-button,
      .hook-delete {
        padding: 1px 7px;
        border: 1px solid transparent;
        border-radius: 5px;
        background: transparent;
        color: var(--muted);
        font: inherit;
        font-size: 11px;
        cursor: pointer;
      }

      .hook-delivery:hover .hook-redeliver-button { border-color: var(--line); }
      .hook-redeliver-button:hover { color: var(--text); border-color: var(--line-strong); }
      .hook-actions { margin: 14px 0 0; }
      .hook-delete { border-color: var(--line); }
      .hook-delete:hover { color: var(--bad); border-color: var(--bad); }

      .diff-status { text-transform: capitalize; }

      /* Deliberately quiet. This badge is a reason, not a warning: the file is
        folded and the reviewer is being told why, so it should read the way a
        footnote reads. Loud enough to notice while scrolling past, quiet
        enough that a diff of ninety renamed files is not ninety alarms. */
      .diff-mechanical {
        border: 1px dashed var(--line-strong);
        background: transparent;
        color: var(--muted);
        font-weight: 400;
      }

      /* The same claim in the sidebar, where the reviewer decides what to open.
        Dimmed rather than struck through: struck through means viewed, and
        two states that look alike is worse than one that is easy to miss. */
      .file-row.is-mechanical .file-name { color: var(--muted); }

      /* On the hunk separator, for a file that is half formatting and half
        logic. That file gets no badge of its own - the honest summary of it is
        the diff - so this is the only place a reviewer is told which half is
        which, and it sits on the row their eye already stops at. */
      .hunk-mechanical {
        margin-left: 8px;
        padding: 1px 6px;
        border: 1px dashed var(--line-strong);
        border-radius: 999px;
        color: var(--muted);
        font-size: 11px;
      }
      .pill-added { background: var(--ok-bg); color: var(--ok); }
      .pill-deleted { background: var(--bad-bg); color: var(--bad); }
      .pill-modified { background: var(--surface); color: var(--pill-text); }
      .pill-renamed, .pill-copied { background: var(--accent-quiet); color: var(--accent-text); }

      .diff-counts { display: inline-flex; gap: 8px; font-weight: 500; }
      .count-add { color: var(--ok); }
      .count-del { color: var(--bad); }

      .diff-note { padding: 14px 16px; font-size: 14px; }

      /* Standing in for the rows of a very large file that are not in the
        document. Sized in pixels by the viewer, so the scrollbar means the
        whole file rather than the part of it currently mounted. */
      .row-spacer td { padding: 0; border: 0; }

      /* The table scrolls inside itself. A long line must never push the page
        sideways, because then every other file scrolls with it. */
      .diff-body { overflow-x: auto; }
      .diff-body.is-collapsed { display: none; }

      /* The header stays while its own file scrolls past.

        Sticky within the file rather than within the list, which is what the
        `contain: paint` on each mounted host gives for free: the header of the
        file being read is pinned, and it leaves with its file rather than
        stacking up with every header above it. */
      .diff-file .diff-head {
        position: sticky;
        z-index: 2;
        top: 0;
        background: var(--surface);
        /* Queried below to tell "pinned" from "sitting where it belongs". A
          scroll listener would answer the same question at sixty times the
          cost, and get it wrong during momentum scrolling. */
        container-type: scroll-state;
      }

      /* Only while actually stuck, so a file at rest has no shadow under its
        header. Browsers without scroll-state queries simply never match, and
        the header is still sticky - which is the part that matters. */
      @container scroll-state(stuck: top) {
        .diff-head::after {
          position: absolute;
          right: 0;
          bottom: -5px;
          left: 0;
          height: 4px;
          background: linear-gradient(to bottom, rgb(0 0 0 / 8%), transparent);
          content: '';
          pointer-events: none;
        }
      }

      .diff-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
        line-height: 1.5;
      }

      /* Split: the two code columns are scrolled together, by being in one
        scrolling box rather than by two of them being kept in step.

        A pair of scrollers synchronised by script is the obvious reading of
        "scroll-synced", and it is the wrong one here: it costs a scroll
        listener per file, it drifts by a pixel under momentum scrolling, and
        it has nothing to say about what happens while a row is being
        recycled. One scroller cannot drift from itself.

        The two columns must be the same width for that to be worth anything,
        and equal width is what `table-layout: fixed` promises - but it also
        freezes the columns at the width of the first row, which clipped every
        long line and left the two halves overlapping. So the columns are
        sized from content and the *minimum* width is what keeps them even. */
      .diff-table[data-columns='4'] .code { min-width: 44%; }
      .diff-table[data-columns='4'] .gutter { width: 1px; white-space: nowrap; }

      .gutter {
        width: 1%;
        min-width: 46px;
        padding: 0 10px;
        background: var(--gutter);
        border-right: 1px solid var(--line);
        color: var(--muted);
        font-family: var(--mono);
        font-size: 12px;
        text-align: right;
        user-select: none;
        vertical-align: top;
      }

      .code {
        padding: 0 12px;
        white-space: pre;
        vertical-align: top;
      }

      .marker { display: inline-block; width: 1ch; color: var(--muted); }

      /* A line that ends the file without a newline. Dim, because it is a
        property of the line rather than part of it, and present, because
        adding a trailing newline is otherwise a change nobody can see. */
      .no-newline { margin-left: 6px; color: var(--muted); opacity: 0.7; }

      .line-added { background: var(--add-bg); }
      .line-added .gutter { border-right-color: var(--add-line); }
      .line-removed { background: var(--del-bg); }
      .line-removed .gutter { border-right-color: var(--del-line); }

      /* What the reader has asked a diff to look like.

        All of it is attributes on an ancestor and selectors here, which is
        the point: a row is created and destroyed as the list scrolls, so a
        setting applied per row would have to be re-applied on every mount.
        Applied to the container it is true of every row that ever appears
        under it, and switching one costs a style recalculation rather than a
        refetch. */

      /* A coloured edge instead of the +/- column. Reads better beside syntax
        colours, because a glyph in the text flow competes with the code and
        an edge does not. */
      [data-diff-indicators='bar'] .marker { visibility: hidden; }
      [data-diff-indicators='bar'] .line-added .code,
      [data-diff-indicators='bar'] .has-added .code:last-child {
        box-shadow: inset 3px 0 0 var(--add-line);
      }
      [data-diff-indicators='bar'] .line-removed .code,
      [data-diff-indicators='bar'] .has-removed .code:nth-child(2) {
        box-shadow: inset 3px 0 0 var(--del-line);
      }

      /* Nothing but the background. Only offered alongside the background,
        and the pair of them off is prevented in the panel rather than here. */
      [data-diff-indicators='none'] .marker { visibility: hidden; }

      /* Colour pairs that survive colour vision deficiency.

        Not a simulation of what those readers see - pairs chosen to stay
        distinguishable *for* them. Roughly one in twelve men cannot reliably
        tell the red from the green, and a diff whose only cue is that pair is
        failing them completely. The glyph and the bar carry the same
        information in shape, which is why they stay on by default. */

      /* Red-green: blue against orange, which survives both protanopia and
        deuteranopia and is the pair every accessible chart palette reaches
        for first.

        The two tints are deliberately further apart in *brightness* than the
        classic pair, and that is the part that matters. Red and green differ
        almost entirely in hue, which is exactly the channel these readers do
        not have - so an alternative palette that also differed only in hue
        would be a different pair of colours and the same failure. The first
        version of this was precisely that, and a contrast test caught it. */
      [data-diff-palette='deuteranopia'] {
        --add-bg: #c0d1e7;
        --add-line: #93b3d8;
        --del-bg: #f1e5d8;
        --del-line: #e2c9a8;
        --ok: #10457f;
        --bad: #8a4b06;
      }

      /* Blue-yellow: teal against magenta, because blue and yellow are the
        pair tritanopia flattens. */
      [data-diff-palette='tritanopia'] {
        --add-bg: #bbd5d3;
        --add-line: #8ec0bc;
        --del-bg: #f2e4ec;
        --del-line: #ddbdd0;
        --ok: #0d5852;
        --bad: #8c2062;
      }

      /* Neither hue nor tint: a heavy edge and a near-neutral wash, for a
        reader who wants contrast rather than colour. */
      [data-diff-palette='contrast'] {
        --add-bg: #f4f4f4;
        --add-line: #111111;
        --del-bg: #ffffff;
        --del-line: #767676;
      }

      [data-diff-palette='contrast'] .line-added .code { box-shadow: inset 3px 0 0 var(--add-line); }
      [data-diff-palette='contrast'] .line-removed .code { box-shadow: inset 3px 0 0 var(--del-line); }

      @media (prefers-color-scheme: dark) {
        [data-diff-palette='deuteranopia'] {
          --add-bg: #061222;
          --add-line: #17365f;
          --del-bg: #382206;
          --del-line: #6b4410;
        }

        [data-diff-palette='tritanopia'] {
          --add-bg: #062a27;
          --add-line: #12554e;
          --del-bg: #26081a;
          --del-line: #5a1339;
        }

        [data-diff-palette='contrast'] {
          --add-bg: #1a1a1a;
          --add-line: #f2f2f2;
          --del-bg: #0c0c0c;
          --del-line: #9a9a9a;
        }
            }

      /* The same palette, when they have. */
      :root[data-theme='dark'] [data-diff-palette='deuteranopia'] {
          --add-bg: #10203a;
          --add-line: #1e3c66;
          --del-bg: #2e2110;
          --del-line: #5b3f16;
        }

        :root[data-theme='dark'] [data-diff-palette='tritanopia'] {
          --add-bg: #0d2725;
          --add-line: #16463f;
          --del-bg: #2c1122;
          --del-line: #5a2044;
        }

        :root[data-theme='dark'] [data-diff-palette='contrast'] {
          --add-bg: #1a1a1a;
          --add-line: #f2f2f2;
          --del-bg: #0c0c0c;
          --del-line: #9a9a9a;
        }


      /* The wash behind changed lines, off. The gutter edge stays, and so does
        whichever indicator is in force, so which side a line belongs to is
        still legible without it. */
      [data-diff-backgrounds='off'] .line-added,
      [data-diff-backgrounds='off'] .line-removed { background: transparent; }

      [data-diff-numbers='off'] .gutter.num { display: none; }

      /* Wrapping. `anywhere` rather than `break-word` because a minified line
        has no break opportunities at all and `break-word` would leave it
        overflowing exactly as before. */
      [data-diff-wrap='on'] .code { white-space: pre-wrap; overflow-wrap: anywhere; }
      [data-diff-wrap='on'] .diff-body { overflow-x: hidden; }

      /* What changed within a line.

        A wash behind the characters that differ, rather than a colour on
        them: the syntax colour is already carrying meaning, and a second
        foreground colour on top would fight it. Strong enough to find at a
        glance on top of the line's own add or remove tint, and weak enough
        that a line where most of it is marked still reads as code. */
      .line-removed .w { background: var(--del-line); border-radius: 2px; }
      .line-added .w { background: var(--add-line); border-radius: 2px; }
      .has-removed .w { background: var(--del-line); border-radius: 2px; }
      .has-added .w { background: var(--add-line); border-radius: 2px; }

      /* Asking for the lines a hunk left out. Sits inside the hunk header,
        which is where the gap it fills is. */
      /* A line number is the handle for selecting the line and the link to it,
        so it looks like neither until it is reached for. */
      .line-anchor {
        display: block;
        color: inherit;
        text-decoration: none;
      }

      .gutter.num:hover { background: var(--line); cursor: pointer; }

      /* The selected lines. A left edge rather than a wash, so it survives on
        top of the add and remove tints without becoming a third colour. */
      tr.is-selected .gutter.num { box-shadow: inset 2px 0 0 var(--accent); }
      tr.is-selected .code { background: var(--accent-quiet); }

      /* The list of files beside a diff. Windowed, so the rows are absolutely
        positioned inside a sizer standing in for the whole list. */
      .file-list-head {
        display: flex;
        align-items: center;
        gap: 8px;
        height: 34px;
        padding: 0 10px;
        border-bottom: 1px solid var(--line);
        font-size: 12px;
      }

      .file-list-count { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

      /* The count gives up its space to the filter rather than being clipped
        to `100 files, 1 vie…`, which is worse than not being there. */
      .file-list-head:has(.file-list-search:not([hidden])) .file-list-count { display: none; }

      .file-list-search-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        padding: 0;
        border: 0;
        border-radius: 5px;
        background: transparent;
        color: var(--muted);
        cursor: pointer;
      }

      .file-list-search-toggle:hover { background: var(--surface-tint); color: var(--text); }
      .file-list-search-toggle[aria-expanded='true'] { color: var(--accent); }

      /* Takes the whole row when it is open, and no space at all when it is
        not. A filter is worth a row of vertical space on a four thousand file
        compare and not on a fifteen file pull request. */
      .file-list-search {
        flex: 1;
        min-width: 0;
        height: 22px;
        padding: 0 8px;
        border: 1px solid var(--line-strong);
        border-radius: 6px;
        background: var(--bg);
        color: var(--text);
        font: inherit;
        font-size: 12px;
      }

      /* "Since I last looked". Above the list rather than inside the header
        row, because it is a statement about the whole list and it only exists
        on a return visit - a control that appears and disappears inside a row
        would reflow the header every time. Pressed state is carried by
        aria-pressed, which is what a screen reader reads and what the style
        keys off, so the two cannot disagree. */
      .file-list-since {
        display: block;
        width: 100%;
        padding: 6px 10px;
        border: 0;
        border-bottom: 1px solid var(--line);
        background: transparent;
        color: var(--muted);
        font: inherit;
        font-size: 12px;
        text-align: left;
        cursor: pointer;
      }

      .file-list-since:hover { background: var(--surface-tint); color: var(--text); }

      .file-list-since[aria-pressed='true'] {
        background: var(--surface-tint);
        color: var(--accent);
        font-weight: 600;
      }

      /* The list gives up a row to it, so the viewport gives one up too. */
      .diff-files:has(.file-list-since) .file-list-viewport { height: calc(100% - 63px); }

      .file-list-viewport { height: calc(100% - 34px); overflow-y: auto; overscroll-behavior: contain; }
      .file-list-sizer { position: relative; }
      .file-list-rows { position: absolute; top: 0; right: 0; left: 0; }

      .file-row {
        display: flex;
        align-items: center;
        gap: 7px;
        width: 100%;
        height: 26px;
        padding: 0 10px;
      }

      .file-open {
        display: flex;
        flex: 1;
        align-items: center;
        gap: 8px;
        min-width: 0;
        height: 100%;
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--text);
        font: inherit;
        font-size: 12.5px;
        text-align: left;
        cursor: pointer;
      }

      .file-viewed { flex: none; margin: 0; cursor: pointer; }

      .file-row:hover { background: var(--surface-tint); }
      .file-row.is-current { background: var(--accent-quiet); }

      /* A file the reader has finished with. Dimmed rather than removed: they
        may want to go back to it, and a list that shortens as you work is a
        list you cannot find your place in. */
      .file-row.is-viewed .file-open { opacity: 0.5; }
      .file-row.is-viewed .file-name { text-decoration: line-through; }

      /* A tick that has stopped being true: the file changed after it was read.
        The strike-through comes off - it no longer describes the file - and the
        row comes back to full strength, because this is one of the few files in
        a long list that still wants reading. Marked, never unticked: which
        files somebody has got through is theirs to keep. */
      .file-row.is-stale .file-open { opacity: 1; }
      .file-row.is-stale .file-name { text-decoration: none; }
      .file-row.is-stale .file-viewed {
        accent-color: var(--warning, #b7791f);
        outline: 2px solid var(--warning, #b7791f);
        outline-offset: 1px;
        border-radius: 2px;
      }

      /* And one nobody can check, because the commit it was read at is gone -
        a force push, usually. Dotted rather than solid: "cannot tell" is a
        different claim from "changed", and rendering them the same way would
        make the honest one look like the certain one. */
      .file-row.is-unverifiable .file-open { opacity: 0.75; }
      .file-row.is-unverifiable .file-name { text-decoration-style: dotted; }
      .file-row.is-unverifiable .file-viewed {
        outline: 1px dashed var(--muted);
        outline-offset: 1px;
        border-radius: 2px;
      }

      .file-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; direction: rtl; }
      /* The directory dimmed and the filename bright, which is what a reader
        scans to tell two files called index.ts apart. `direction: rtl` keeps
        the filename visible when the path is too long, and the span below puts
        the text back the right way round. */
      .file-name > * { direction: ltr; unicode-bidi: embed; }
      .file-dir { color: var(--muted); }

      .file-counts { display: inline-flex; gap: 5px; font-size: 11px; }

      /* A dot rather than a word: the status of forty files reads at a glance
        as colour and not at all as text. */
      .file-status { width: 6px; height: 6px; border-radius: 50%; flex: none; }
      .file-status-added { background: var(--ok); }
      .file-status-deleted { background: var(--bad); }
      .file-status-modified { background: var(--line-strong); }
      .file-status-renamed, .file-status-copied { background: var(--accent); }

      .hunk-expand {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        min-width: 26px;
        height: 18px;
        margin-right: 8px;
        padding: 0 6px;
        border: 1px solid var(--line-strong);
        border-radius: 4px;
        background: var(--surface);
        color: var(--muted);
        font: inherit;
        font-size: 12px;
        line-height: 1;
        cursor: pointer;
        vertical-align: middle;
      }

      .hunk-expand:hover { border-color: var(--accent); color: var(--accent); }
      .hunk-expand[data-busy='true'] { opacity: 0.5; cursor: progress; }
      /* How much is behind the control. Says four lines or four hundred, which
        is the judgement a reviewer is making when they look at it. */
      .hunk-skipped { font-size: 11px; font-variant-numeric: tabular-nums; }

      /* The display panel. A details element rather than a menu widget: it
        opens, it closes, it is keyboard reachable, and it needed no code. */
      .diff-settings { position: relative; }
      .diff-settings > summary {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 3px 10px;
        border: 1px solid var(--line-strong);
        border-radius: 6px;
        background: var(--surface);
        color: var(--text);
        font-size: 12.5px;
        cursor: pointer;
        list-style: none;
      }

      .diff-settings > summary::-webkit-details-marker { display: none; }
      .diff-settings[open] > summary { border-color: var(--accent); color: var(--accent); }

      .diff-settings-panel {
        position: absolute;
        z-index: 20;
        top: calc(100% + 6px);
        right: 0;
        width: 232px;
        padding: 12px 14px;
        border: 1px solid var(--line);
        border-radius: var(--r-panel);
        background: var(--surface);
        box-shadow: 0 12px 30px rgb(0 0 0 / 12%);
        font-size: 12.5px;
        text-align: left;
      }

      .diff-settings-panel fieldset { margin: 0 0 10px; padding: 0; border: 0; }
      .diff-settings-panel fieldset:last-child { margin-bottom: 0; }
      .diff-settings-panel legend { padding: 0 0 5px; color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; }
      .diff-settings-panel label { display: flex; align-items: center; gap: 7px; padding: 3px 0; cursor: pointer; }

      .hunk-head td { background: var(--surface-tint); border-top: 1px solid var(--line); }
      .hunk-label { padding: 4px 12px; color: var(--muted); font-size: 12px; }

      /* A changed line the coverage report says no test executes. An amber
        inset edge plus a spelled-out flag, so the claim survives every
        palette and background setting - and absence of data renders
        nothing, never "covered". */
      .line.is-uncovered > .code, td.code.is-uncovered {
        box-shadow: inset 3px 0 0 var(--warn, #b8860b);
      }

      .coverage-flag {
        margin-left: 10px;
        padding: 0 6px;
        font-size: 10.5px;
        color: var(--warn, #b8860b);
        border: 1px solid var(--warn, #b8860b);
        border-radius: 999px;
        vertical-align: 1px;
      }

      /* A mechanical hunk, folded. The summary is the whole hunk until it is
        opened, so it carries the label and the count out loud - a reviewer
        silently shown less has been lied to about what they approved. */
      .hunk-fold { border-top: 1px solid var(--line); }

      .hunk-fold-summary {
        padding: 4px 12px;
        color: var(--muted);
        font-size: 12px;
        background: var(--surface-tint);
        cursor: pointer;
        list-style: none;
      }

      .hunk-fold-summary::-webkit-details-marker { display: none; }
      .hunk-fold-summary::before { content: '\25B8  '; }
      .hunk-fold[open] > .hunk-fold-summary::before { content: '\25BE  '; }

      /* The streamed screen's unfold affordance, on the separator row. */
      .hunk-unfold {
        margin-left: 8px;
        padding: 0 6px;
        font: inherit;
        font-size: 11.5px;
        color: var(--muted);
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: 999px;
        cursor: pointer;
      }

      .hunk-unfold:hover { color: var(--text); }

      .thread-cell { padding: 10px 12px; background: var(--surface); border-top: 1px solid var(--line); }

      /* A conflicted file. Two versions of the same lines, and the reader is
        being asked for an answer rather than an opinion - so the sides are
        tinted like a diff's, and the labels git wrote are shown, because they
        are the only thing saying which side is which. */
      .conflict-head td { padding: 4px 12px; font-size: 12px; }
      .conflict-head-ours td { background: var(--del-bg); color: var(--bad); }
      .conflict-head-base td { background: var(--surface-tint); color: var(--muted); }
      .conflict-head-theirs td { background: var(--add-bg); color: var(--ok); }

      .conflict-ours { background: var(--del-bg); }
      .conflict-base { background: var(--surface-tint); color: var(--muted); }
      .conflict-theirs { background: var(--add-bg); }

      .conflict-actions td { padding: 8px 12px; border-bottom: 1px solid var(--line); }
      .conflict-actions .btn + .btn { margin-left: 6px; }

      /* Starting a comment on a line.

        Sits inside the number gutter and appears on hover or on keyboard
        focus, so a diff at rest is code and line numbers rather than a column
        of buttons. Absolutely positioned so it does not widen the gutter when
        it appears and shift every line of the file sideways. */
      .gutter.num { position: relative; }

      .line-comment {
        position: absolute;
        top: 50%;
        left: 2px;
        display: none;
        width: 17px;
        height: 17px;
        margin-top: -9px;
        padding: 0;
        border: 0;
        border-radius: 4px;
        background: var(--accent);
        color: var(--on-accent);
        font: inherit;
        font-size: 13px;
        line-height: 1;
        cursor: pointer;
      }

      .gutter.num:hover .line-comment,
      .line-comment:focus-visible { display: block; }

      /* The comment being written. A row in the diff rather than a modal, so
        the code it is about stays on screen while it is written. */
      .draft { display: flex; flex-direction: column; gap: 8px; }
      .draft-input {
        width: 100%;
        padding: 8px 10px;
        border: 1px solid var(--line-strong);
        border-radius: var(--r-control);
        background: var(--bg);
        color: var(--text);
        font: inherit;
        font-size: 14px;
        resize: vertical;
      }

      .draft-actions { display: flex; align-items: center; gap: 8px; }
      .draft-status { font-size: 12.5px; }

      /* A resolved conversation, folded to one line. */
      .thread-summary {
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        list-style: none;
        font-size: 12.5px;
      }

      .thread-summary::-webkit-details-marker { display: none; }
      details.thread > .thread-comments, details.thread > .thread-reply { margin-top: 10px; }

      /* What a reader can do with the lines they have selected. Beside the
        selection rather than in a menu somewhere else on the page. */
      .selection-surface {
        position: absolute;
        z-index: 5;
        top: 0;
        right: 14px;
        display: flex;
        gap: 6px;
        padding: 5px;
        border: 1px solid var(--line);
        border-radius: var(--r-control);
        background: var(--surface);
        box-shadow: 0 6px 18px rgb(0 0 0 / 12%);
      }

      .selection-surface[data-copied='true'] { border-color: var(--ok); }
      .selection-surface[data-copied='false'] { border-color: var(--bad); }

      /* Syntax colours. Deliberately low-saturation: they sit on top of the green
        and red diff backgrounds, and a vivid palette turns a reviewed line into a
        fruit salad. Hue carries the meaning, not intensity. */
      .t-keyword { color: #8250df; }
      .t-string { color: #0a6640; }
      .t-comment { color: var(--muted); font-style: italic; }
      .t-numeric { color: #0550ae; }
      .t-function { color: #6639ba; }
      .t-type { color: #953800; }
      .t-tag { color: #0a6640; }
      .t-attribute { color: #6639ba; }
      .t-operator, .t-punctuation { color: var(--muted); }
      .t-variable, .t-text { color: inherit; }

      @media (prefers-color-scheme: dark) {
        .t-keyword { color: #d2a8ff; }
        .t-string { color: #7ee787; }
        .t-numeric { color: #79c0ff; }
        .t-function { color: #d2a8ff; }
        .t-type { color: #ffa657; }
        .t-tag { color: #7ee787; }
        .t-attribute { color: #d2a8ff; }
            }

      /* The same palette, when they have. */
      :root[data-theme='dark'] .t-keyword { color: #d2a8ff; }
        :root[data-theme='dark'] .t-string { color: #7ee787; }
        :root[data-theme='dark'] .t-numeric { color: #79c0ff; }
        :root[data-theme='dark'] .t-function { color: #d2a8ff; }
        :root[data-theme='dark'] .t-type { color: #ffa657; }
        :root[data-theme='dark'] .t-tag { color: #7ee787; }
        :root[data-theme='dark'] .t-attribute { color: #d2a8ff; }


      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
      }

      /* ---- Review threads ----

        Shared by `ReviewThread.stx` on the conversation page and by
        `app/Actions/Pull/threads.ts` for every thread streamed into the review
        screen, for the same reason the diff styles are here. */
      .thread {
        border: 1px solid var(--line);
        border-radius: var(--r-panel);
        background: var(--surface);
        overflow: hidden;
      }

      .thread.is-resolved { opacity: 0.72; }

      .thread-head {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        background: var(--surface-tint);
        border-bottom: 1px solid var(--line);
      }

      .thread-anchor { margin-left: auto; font-size: 12px; }

      .thread-comments { padding: 0; }

      .comment { padding: 11px 13px; border-bottom: 1px solid var(--line); }
      .comment:last-child { border-bottom: 0; }

      .comment-head {
        display: flex;
        align-items: baseline;
        gap: 8px;
        margin-bottom: 3px;
      }

      .comment-author { font-weight: 600; font-size: 14px; }
      .comment-time { font-size: 12.5px; }

      .comment-body {
        font-size: 14px;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }

      .thread-reply { padding: 11px 13px; border-top: 1px solid var(--line); }

      .reply-input {
        width: 100%;
        padding: 8px 10px;
        border: 1px solid var(--line-strong);
        border-radius: var(--r-control);
        background: var(--bg);
        color: var(--text);
        font: inherit;
        font-size: 14px;
        resize: vertical;
      }

      .reply-input:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 1px;
      }

      .thread-actions { display: flex; gap: 8px; margin-top: 8px; }
    </style>
    {!! head ?? '' !!}
  </head>

  <body>
    <SiteNav />

    <main>
      @yield('content')
    </main>

    {{-- Drawing the mermaid fences, and the only script in the product.

        Every other interaction here is a form or a link, and that is a
        deliberate property: an issue page with two hundred comments should
        arrive as a page. A diagram is the one thing that cannot follow the
        rule, because mermaid is a layout engine and there is no server-side
        form of it short of running a browser per page view.

        So it is contained. Nothing loads unless the page already has a
        diagram on it; the import is dynamic, so a page without one costs
        nothing; the bundle is served from here rather than from a CDN, so a
        forge with no route out still works and a reader of an issue is not
        announced to a third party; and every failure leaves the definition
        on screen, which is what a fence showed before this existed.

        `strict` is not the default and matters: diagram text is written by
        whoever opened the issue, and the looser levels let a label carry
        markup and a node carry a click handler. --}}
    <script type="module">
      const diagrams = document.querySelectorAll('pre.mermaid')

      if (diagrams.length > 0) {
        try {
          const { default: mermaid } = await import('/js/mermaid.js')

          mermaid.initialize({
            startOnLoad: false,
            securityLevel: 'strict',
            theme: matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'default',
            fontFamily: 'inherit',
          })

          await mermaid.run({ nodes: diagrams })
        }
        catch {
          // The definition is still on the page, and a definition somebody can
          // read beats an error where their diagram was.
        }
      }
    </script>
  </body>
</html>
