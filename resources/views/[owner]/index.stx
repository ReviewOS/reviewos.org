<script server>
/**
 * Somebody's profile: who they are, what they own, and what they have done.
 *
 * **Fourteen links in this product already pointed here and there was no page.**
 * Every commit author, every issue author, every reviewer on a pull request -
 * all of them rendered `/{handle}` and all of them 404'd. That is the whole
 * reason this exists ahead of anything prettier.
 *
 * One route for two kinds of owner. `/{handle}` is a user or an organization,
 * because a repository's URL does not distinguish them either - `acme/api` is
 * the same shape whoever owns it, and a product where you have to know which
 * before you can link to somebody is one where people link to nothing.
 *
 * The shape is the one every forge reader already knows: an identity column on
 * the left, the page the owner wrote about themselves at the top of the right,
 * then their repositories as cards. What it is *not* is a flat list of thirty
 * names in no order, which is what this was - see `app/Actions/Profile/read.ts`
 * for why the order was nothing at all.
 *
 * Rendered entirely on the server. A profile is a list of links.
 */
import { profileFeed, withHandles } from '../../../app/Actions/Feed/read'
import { ownerRepositories, profileReadme } from '../../../app/Actions/Profile/read'
import { cookieJarFromHeader, organizationRoleOf, peopleIn, viewerFromCookies } from '../../functions/identity'
import { relativeTime } from '../../functions/browse'
import { aliasTarget, pathUnderOwner } from '../../functions/aliases'
// Asked for here rather than through a helper: `setResponseStatus` is a
// context binding, in scope only inside this script. See the note in
// `resources/components/RepoBrowser.stx`.
const setStatus = typeof setResponseStatus === 'function' ? setResponseStatus : () => {}
const setHeader = typeof setResponseHeader === 'function' ? setResponseHeader : () => {}

const serveContext = __stxServeContext
const headerBag = typeof headers === 'undefined' ? undefined : headers

/*
 * The query string, read the way this serve actually supplies it.
 *
 * `query` is a *context binding* - the parsed parameters, put in this script's
 * scope by name - while `__stxServeContext` carries the raw `search` and no
 * `query` at all. Reading `serveContext.query` therefore returns undefined and
 * every parameter on the page is silently empty, which for a search box means
 * it answers every submission with the unfiltered first page.
 *
 * `params` is already taken here: it is the route's own bag, and `params.owner`
 * is the handle - so this is read under its own name rather than shadowing it.
 */
const queryBag: any = (typeof query === 'undefined' ? undefined : query) ?? {}

const viewer = await viewerFromCookies(serveContext?.cookies ?? cookieJarFromHeader(headerBag?.cookie))
const handle = String(params.owner ?? '').toLowerCase()

const account: any = handle
  ? await db
      .selectFrom('users')
      .select(['id', 'handle', 'name', 'bio', 'avatar_url', 'location', 'website', 'created_at'])
      .where('handle', '=', handle)
      .executeTakeFirst()
  : null

const organization: any = account
  ? null
  : handle
    ? await db
        .selectFrom('organizations')
        // `handle` is the URL segment; `name` is the display name and is
        // nullable. Looking one up by `name` finds nothing for every
        // organization that never set one.
        .select(['id', 'handle', 'name', 'description', 'avatar_url', 'website', 'created_at'])
        .where('handle', '=', handle)
        .executeTakeFirst()
    : null

/*
 * A handle that is taken and points somewhere else.
 *
 * Only on a miss, so a live account always wins and an alias can never shadow
 * one - and the query costs nothing on the common path, because it runs only
 * where the page was about to 404 anyway. 301 rather than 302: the canonical
 * handle is the answer, and every cache and crawler should learn it once.
 */
const movedTo = (!account && !organization) ? await aliasTarget(handle) : null
const movedPath = movedTo ? pathUnderOwner(String(serveContext?.path ?? `/${handle}`), movedTo) : ''


/*
 * A real redirect: 301, with somewhere to go.
 *
 * This rendered a page with `rel=canonical` on it for a while, because
 * `setResponseHeader` was declared by stx and never assigned to the context by
 * its serve - so calling it threw a ReferenceError, took the rest of this
 * script down with it, and the page rendered its not-found branch for a handle
 * it had just resolved. Fixed in stx 0.2.190 (`fix(serve): put
 * setResponseHeader in scope`), which is what this depends on.
 *
 * 301 rather than 302: the canonical handle is the answer, and every cache and
 * crawler should learn it once.
 */
if (movedTo) {
  setStatus(301)
  setHeader('Location', movedPath)
  setHeader('Cache-Control', 'public, max-age=3600')
}

// A page that renders "no such account" under a 200 tells a crawler, a cache
// and an uptime check that the page is fine. Only the render knows. An aliased
// handle is not missing - it has moved - so it keeps its 200 and says so.
if (!account && !organization && !movedTo)
  setStatus(404)

const isSelf = Boolean(viewer && account && Number(viewer.id) === Number(account.id))

/*
 * Their repositories, as this reader may see them.
 *
 * Public always; private only to the owner themselves. There is deliberately no
 * middle case where a collaborator sees a private repository on somebody's
 * profile: a profile whose contents depend on a permission graph is one whose
 * first bug is a disclosure, and the repository is reachable from its own URL
 * anyway.
 *
 * The search box and the pager narrow it. Both are plain query parameters on a
 * GET form, so the page they produce is a link somebody can send.
 */
const ownerId = Number(account?.id ?? organization?.id ?? 0)
const ownerType = account ? 'user' : 'organization'
const search = String(queryBag.q ?? '').slice(0, 100)

const repositories = ownerId
  ? await ownerRepositories({ ownerId, ownerType, includePrivate: isSelf, query: search, page: queryBag.page })
  : { rows: [], total: 0, matched: 0, page: 1, pages: 1, perPage: 24, query: '' }

const now = new Date()

const repoRows = repositories.rows.map(row => ({
  ...row,
  // `label` is what the card prints. The bare name here, because the heading it
  // sits under has already said whose repositories these are; explore passes
  // `owner/name` for the same card, because it mixes owners.
  label: row.name,
  href: `/${handle}/${row.name}`,
  updated: row.activeAt ? relativeTime(row.activeAt, now) : '',
}))

// A pager that keeps whatever was typed in the search box, because a page 2
// that silently drops the filter is a page 2 of something else.
const pageHref = (page: number) => `/${handle}?${search ? `q=${encodeURIComponent(search)}&` : ''}page=${page}`
const previousHref = repositories.page > 1 ? pageHref(repositories.page - 1) : ''
const nextHref = repositories.page < repositories.pages ? pageHref(repositories.page + 1) : ''

/*
 * The page the owner wrote about themselves, from the repository named after
 * the handle. `app/Actions/Profile/read.ts` has the convention and why it is
 * not GitHub's `.github` repository - a name that starts with a dot cannot be a
 * directory here, on purpose.
 */
const isOrganization = Boolean(organization)
const readme = ownerId ? await profileReadme(handle, isOrganization, serveContext?.cookies ?? cookieJarFromHeader(headerBag?.cookie)) : null

// One interpolation per attribute. A component prop written as
// `title="{{ a }}/{{ b }}"` is not evaluated at all - the literal braces
// render - so the string is built here and passed whole.
const readmeTitle = readme ? `${readme.repository}/${readme.path}` : ''

/*
 * Who is in the organization.
 *
 * Members only, exactly as `/{handle}/people` is: `members:view` is a member's
 * right, and the membership list of a private company is a target list. A
 * stranger sees no count and no faces rather than a locked door, because "you
 * cannot see this" has already confirmed the interesting half.
 */
const role = organization && viewer ? await organizationRoleOf(Number(organization.id), viewer.id) : null
const maySeePeople = Boolean(organization && role)
const everybody = maySeePeople ? await peopleIn(Number(organization.id)) : []
const people = everybody.filter(person => !person.machine)
const shownPeople = people.slice(0, 12)
const mayManage = role === 'owner' || role === 'admin'

/*
 * What they have done.
 *
 * Only a user has a feed. An organization does not act - its members do - and a
 * feed on an organization page would be a list of other people's names under a
 * heading that implies the organization did it.
 */
const feed = account
  ? await withHandles(await profileFeed({
      actorId: Number(account.id),
      viewerId: viewer ? Number(viewer.id) : null,
      limit: 15,
    }))
  : { entries: [], cursor: null }

const feedRows = feed.entries.map(entry => ({
  ...entry,
  when: relativeTime(new Date(entry.at).toISOString(), now),
}))

/*
 * The contribution summary: a count, not a grid of squares.
 *
 * A year of coloured squares is the thing people expect and it measures the
 * wrong thing - it rewards showing up daily rather than doing anything, and on
 * a self-hosted forge for one team it is a wall of empty boxes. Three counts
 * that say what somebody actually did are more information in less space.
 */
const summary = account
  ? await db
      .selectFrom('activity_events')
      .select(['verb'])
      .where('actor_id', '=', Number(account.id))
      .where(...(isSelf ? ['id', '>', 0] as const : ['is_public', '=', true] as const))
      .limit(2000)
      .execute()
  : []

const counts = {
  pullRequests: summary.filter((row: any) => String(row.verb) === 'opened_pull_request').length,
  reviews: summary.filter((row: any) => String(row.verb) === 'reviewed').length,
  issues: summary.filter((row: any) => String(row.verb) === 'opened_issue').length,
}

const displayName = String(account?.name || organization?.name || handle)
const bio = String(account?.bio ?? organization?.description ?? '')
const joined = (account?.created_at ?? organization?.created_at)
  ? new Date(String(account?.created_at ?? organization?.created_at)).toISOString().slice(0, 10)
  : ''
const website = String(account?.website ?? organization?.website ?? '')
const location = String(account?.location ?? '')
const found = Boolean(account || organization)

// The avatar, or the letter that stands in for one. Neutral rather than a
// coloured identicon: the accent is reserved for one thing per screen, and a
// wall of tinted squares would take it for decoration.
const avatarUrl = String(account?.avatar_url ?? organization?.avatar_url ?? '')
const initial = (displayName.trim() || handle).charAt(0).toUpperCase()

// Somebody who could write the profile page and has not. Shown to them only:
// a reader who cannot edit it does not need to know the file is missing.
const mayWriteProfile = isSelf || mayManage
// The repository this forge asks for, which is the first one `profileReadme`
// reads. It used to name the handle's own repository, and kept saying so after
// the convention moved - so the one line telling somebody how to write their
// profile page sent them to the wrong repository.
const profileRepository = `${handle}/.profile`
const profileRepositoryPath = `/${handle}/.profile`
</script>

@layout('app')

@section('title', found ? `${displayName} (${handle})` : 'Not found')
@section('description', found ? `${displayName} on ReviewOS: repositories, activity, and what they have been reviewing.` : 'No account with that handle exists on this instance.')

@section('content')
  <div class="page">
    @if (movedTo)
      <div class="panel" style="padding: 32px; text-align: center;">
        <h1 style="font-size: 20px;">Moved</h1>
        <p class="muted" style="margin-top: 6px;">
          <code>{{ handle }}</code> is now <a href="{{ movedPath }}">{{ movedTo }}</a>.
        </p>
      </div>
    @elseif (!found)
      <div class="panel" style="padding: 32px; text-align: center;">
        <h1 style="font-size: 20px;">Not found</h1>
        <p class="muted" style="margin-top: 6px;">There is no account called {{ handle }} here.</p>
      </div>
    @else
      <div class="profile">
        <aside class="profile-side">
          <div class="profile-identity">
            @if (avatarUrl)
              <img class="profile-avatar {{ isOrganization ? 'is-organization' : '' }}" src="{{ avatarUrl }}" alt="" width="96" height="96">
            @else
              <span class="profile-avatar profile-avatar-letter {{ isOrganization ? 'is-organization' : '' }}" aria-hidden="true">{{ initial }}</span>
            @endif

            <div>
              <h1 class="profile-name">{{ displayName }}</h1>
              <p class="mono muted profile-handle">{{ handle }}</p>
            </div>
          </div>

          @if (bio)
            <p class="profile-bio">{{ bio }}</p>
          @endif

          @if (isSelf)
            <a class="btn profile-action" href="/settings/profile">Edit your profile</a>
          @elseif (mayManage)
            <a class="btn profile-action" href="/{{ handle }}/people">Manage people</a>
          @endif

          <ul class="profile-facts">
            <li>
              <span class="{{ isOrganization ? 'i-hugeicons-building-03' : 'i-hugeicons-user' }}" aria-hidden="true"></span>
              <span class="muted">{{ isOrganization ? 'An organization' : 'A person' }}</span>
            </li>
            @if (location)
              <li>
                <span class="i-hugeicons-location-01" aria-hidden="true"></span>
                <span class="muted">{{ location }}</span>
              </li>
            @endif
            @if (website)
              <li>
                <span class="i-hugeicons-link-02" aria-hidden="true"></span>
                <a href="{{ website }}" rel="nofollow noopener">{{ website }}</a>
              </li>
            @endif
            <li>
              <span class="i-hugeicons-book-02" aria-hidden="true"></span>
              <span class="muted">{{ repositories.total }} {{ repositories.total === 1 ? 'repository' : 'repositories' }}</span>
            </li>
            @if (joined)
              <li>
                <span class="i-hugeicons-calendar-03" aria-hidden="true"></span>
                <span class="muted">Here since {{ joined }}</span>
              </li>
            @endif
          </ul>

          @if (!isOrganization)
            {{--
              Counts rather than a grid of squares. A year of coloured boxes
              rewards showing up daily rather than doing anything, and on a
              self-hosted forge for one team it is mostly empty.
            --}}
            <ul class="profile-counts">
              <li><strong>{{ counts.pullRequests }}</strong> <span class="muted">pull requests opened</span></li>
              <li><strong>{{ counts.reviews }}</strong> <span class="muted">reviews</span></li>
              <li><strong>{{ counts.issues }}</strong> <span class="muted">issues opened</span></li>
            </ul>
          @endif

          @if (maySeePeople && people.length > 0)
            {{-- Faces rather than a number, and only for somebody who is
                already inside: the list is a member's right, not a public
                fact. --}}
            <section class="profile-people">
              <h2 class="profile-side-heading">
                <a href="/{{ handle }}/people">People</a>
                <span class="profile-side-count">{{ people.length }}</span>
              </h2>
              <ul class="profile-faces">
                @foreach (shownPeople as person)
                  <li>
                    <a href="/{{ person.handle }}" title="{{ person.name }}">
                      @if (person.avatarUrl)
                        <img src="{{ person.avatarUrl }}" alt="{{ person.handle }}" width="32" height="32">
                      @else
                        <span class="profile-face-letter" aria-hidden="true">{{ person.handle.charAt(0).toUpperCase() }}</span>
                      @endif
                    </a>
                  </li>
                @endforeach
              </ul>
            </section>
          @endif
        </aside>

        <main class="profile-main">
          @if (isOrganization && maySeePeople)
            {{-- Two destinations, so a bar that names them. A user profile has
                one page and gets no tabs: a tab bar with a single tab is a
                claim that there is somewhere else to go. --}}
            <nav class="profile-tabs" aria-label="Profile">
              <a class="profile-tab is-current" href="/{{ handle }}">Overview</a>
              <a class="profile-tab" href="/{{ handle }}/people">People <span class="profile-tab-count">{{ people.length }}</span></a>
            </nav>
          @endif

          @if (readme)
            <MarkdownContent title="{{ readmeTitle }}" :html="readme.html" />
          @elseif (mayWriteProfile)
            {{-- How the convention is learned. Only for somebody who could act
                on it - a reader who cannot write the file does not need to know
                it is missing. --}}
            <p class="profile-hint muted">
              Write this page: put a <code>README.md</code> in a repository called
              <a href="{{ profileRepositoryPath }}">{{ profileRepository }}</a> and it renders here.
            </p>
          @endif

          <section class="profile-section">
            <header class="profile-section-head">
              {{-- The count is what is being listed, not what exists: with a
                  search in the box, a `114` over eleven cards reads as a page
                  that failed to render the rest. --}}
              <h2 class="profile-heading">
                Repositories
                @if (repositories.total > 0)
                  <span class="profile-side-count">{{ repositories.matched }}</span>
                @endif
              </h2>

              @if (repositories.total > repositories.perPage || repositories.query)
                {{-- A GET form, so what it finds is a URL somebody can send.
                    `page` is deliberately not carried: a new search starts on
                    its own first page. --}}
                <form class="profile-search" method="get" action="/{{ handle }}">
                  <input type="search" name="q" value="{{ repositories.query }}" placeholder="Find a repository" aria-label="Find a repository" class="profile-search-input">
                  <button class="btn btn-small" type="submit">Find</button>
                </form>
              @endif
            </header>

            @if (repoRows.length === 0)
              <p class="feed-empty muted">
                @if (repositories.query)
                  Nothing here matches {{ repositories.query }}.
                @elseif (isSelf)
                  Nothing here yet. <a href="/new">Create your first repository</a>.
                @else
                  Nothing here yet.
                @endif
              </p>
            @else
              {{-- `RepositoryCard`, the same one explore renders, so the two
                  pages cannot disagree about what a repository has. The label
                  is the bare name here because the heading above has already
                  said whose these are. --}}
              <ul class="profile-repos">
                @foreach (repoRows as repo)
                  <RepositoryCard :row="repo" />
                @endforeach
              </ul>

              @if (repositories.pages > 1)
                <nav class="profile-pager" aria-label="Repositories">
                  @if (previousHref)
                    <a class="btn btn-small" href="{{ previousHref }}">Previous</a>
                  @endif
                  <span class="muted">Page {{ repositories.page }} of {{ repositories.pages }}</span>
                  @if (nextHref)
                    <a class="btn btn-small" href="{{ nextHref }}">Next</a>
                  @endif
                </nav>
              @endif
            @endif
          </section>

          @if (!isOrganization)
            <section class="profile-section">
              <h2 class="profile-heading">Activity</h2>
              {{--
                `:rows`, not `rows="{{ }}"`. The interpolation form is string
                interpolation into an attribute, so an array arrives
                comma-joined and the loop reports "is not iterable" into an
                HTML comment nobody reads.
              --}}
              <ActivityFeed :rows="feedRows" :showActor="false" empty="Nothing public yet." />
            </section>
          @endif
        </main>
      </div>
    @endif
  </div>
@endsection
