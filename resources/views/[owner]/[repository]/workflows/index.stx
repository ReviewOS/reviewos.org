<script server>
/**
 * A repository's workflows: what is registered, and what will never run.
 *
 * The runs list answers "did my commit pass". This page answers the question
 * that comes before it and had nowhere to be asked: **why did nothing happen at
 * all**. A workflow whose file was deleted, one somebody disabled, one whose
 * only trigger is an event this instance does not dispatch, and one that failed
 * to parse all look identical from the runs list - which shows nothing in every
 * case.
 *
 * So every workflow says which events it fires on, and every reason it will not
 * run is written out in words. `unsupported_events` was recorded at parse time
 * for exactly this and had never been shown anywhere.
 *
 * The `workflow_dispatch` form is generated from the inputs the workflow
 * declared, and posts to the same public action the API and the CLI use.
 */
import { repositoryForView, repositoryHeaderActions } from '../../../../functions/repo'
import { relativeTime } from '../../../../functions/browse'
import { startersFor } from '../../../../functions/runs'
import { isTrue } from '../../../../functions/truth'
// Asked for here rather than through a helper: `setResponseStatus` is a
// context binding, in scope only inside this script.
const setStatus = typeof setResponseStatus === 'function' ? setResponseStatus : () => {}

const ownerHandle = String(params.owner)
const repositoryName = String(params.repository)
const serveContext = __stxServeContext

const repoAccess = await repositoryForView(ownerHandle, repositoryName, serveContext?.cookies)
const repoRow = repoAccess?.repository ?? null
// Star and watch, for the header. One line here rather than each screen
// re-deriving the viewer, the counts and the labels - see
// `app/Actions/Repo/standing.ts`.
const repoActions = await repositoryHeaderActions(repoAccess, ownerHandle, repositoryName)


if (!repoRow)
  setStatus(404)

const base = `/${ownerHandle}/${repositoryName}`

// Said in the badge note, because "&branch=" only matters for a branch that is
// not this one and a reader has to know which that is.
const defaultBranch = String(repoRow?.default_branch ?? 'main')

const workflows = repoRow
  ? await db
      .selectFrom('workflows')
      .selectAll()
      .where('repository_id', '=', Number(repoRow.id))
      .orderBy('path')
      .execute()
  : []

/*
 * The newest version of each, in one query rather than one per workflow.
 *
 * A repository with thirty workflows is ordinary, and a query per row is how a
 * list page becomes the slowest thing in a product.
 */
const workflowIds = workflows.map(row => Number(row.id))

const versions = workflowIds.length > 0
  ? await db
      .selectFrom('workflow_versions')
      .selectAll()
      .where('workflow_id', 'in', workflowIds)
      .orderBy('id', 'desc')
      .execute()
  : []

const newest = new Map()

for (const version of versions) {
  const key = Number(version.workflow_id)

  if (!newest.has(key))
    newest.set(key, version)
}

/** `push`, `pull request`, `schedule`, ... in the words the interface uses. */
function triggersOf(version) {
  if (!version)
    return []

  const names = []

  if (version.on_push)
    names.push('push')
  if (version.on_pull_request)
    names.push('pull request')
  if (version.on_pull_request_target)
    names.push('pull request target')
  if (String(version.schedules ?? '').trim())
    names.push('schedule')
  if (version.on_dispatch)
    names.push('manual')
  if (version.reusable)
    names.push('called by another workflow')

  return names
}

/**
 * Why this workflow will not run, in words, or an empty list when it will.
 *
 * Every one of these renders as nothing on the runs list, which is the whole
 * reason this page exists.
 */
function problemsOf(workflow, version) {
  const problems = []

  if (String(workflow.state) === 'removed')
    problems.push('Its file is no longer on the default branch, so it has been retired. Restore the file and it runs again.')

  if (String(workflow.state) === 'disabled')
    problems.push('Somebody switched this workflow off. It stays off until it is switched back on, even if the file changes.')

  if (!version)
    problems.push('Nothing readable has been registered for it yet.')

  const unsupported = String(version?.unsupported_events ?? '')
    .split('\n')
    .map(line => line.trim())
    .filter(Boolean)

  if (unsupported.length > 0) {
    problems.push(
      `It also fires on ${unsupported.join(', ')}, which this instance recognises but does not dispatch yet. `
      + 'Those events start nothing here.',
    )
  }

  if (version && triggersOf(version).length === 0)
    problems.push('None of its triggers start a run on this instance, so it will never run on its own.')

  return problems
}

const rows = workflows.map((workflow) => {
  const version = newest.get(Number(workflow.id)) ?? null

  let inputs = []

  try {
    const declared = version?.dispatch_inputs ? JSON.parse(String(version.dispatch_inputs)) : []
    inputs = Array.isArray(declared) ? declared : []
  }
  catch {
    // A version whose inputs cannot be read still offers the button; the action
    // accepts none, which runs the workflow with its own defaults.
    inputs = []
  }

  /*
   * What this instance does differently with this file.
   *
   * Not problems - the workflow is registered and runs - which is why they are
   * shown apart from the reasons it will not. The rule the roadmap sets is that
   * a deliberate difference is documented *and* said where somebody is looking,
   * rather than left on a page they have to find.
   */
  let differences = []

  try {
    const stored = version?.warnings ? JSON.parse(String(version.warnings)) : []
    differences = Array.isArray(stored) ? stored : []
  }
  catch {
    differences = []
  }

  return {
    id: Number(workflow.id),
    differences,
    name: String(workflow.name ?? workflow.path ?? ''),
    path: String(workflow.path ?? ''),
    state: String(workflow.state ?? 'active'),
    triggers: triggersOf(version),
    problems: problemsOf(workflow, version),
    dispatchable: String(workflow.state) === 'active' && isTrue(version?.on_dispatch),
    inputs,
    updated: workflow.updated_at ? relativeTime(String(workflow.updated_at)) : '',
    concurrency: String(version?.concurrency_group ?? ''),
    /*
     * The badge for this workflow's default branch. Named by path rather than
     * by name: two workflows may share a name, and the path is the thing that
     * is unique - a badge pointing at the wrong one of a pair is wrong in the
     * way nobody checks.
     */
    badgePath: `/api/repos/badge?owner=${encodeURIComponent(ownerHandle)}&repo=${encodeURIComponent(repositoryName)}&workflow=${encodeURIComponent(String(workflow.path ?? ''))}`,
  }
})

/*
 * Running one spends the instance's runners, so the button is shown to the
 * people who may actually use it. The same ability the action checks, asked
 * here rather than guessed: a page that offers a control the endpoint refuses
 * teaches people the product is broken.
 */
const canDispatch = typeof repoAccess?.can === 'function' && repoAccess.can('workflow:dispatch')

/*
 * What to offer a repository that has none.
 *
 * "No workflows are registered" is true and useless: this is where somebody
 * decides whether CI here is worth the afternoon, and a file they can copy that
 * actually runs is the difference between trying it and closing the tab.
 *
 * Ordered by the languages this instance already measured, and nothing is
 * hidden - a suggestion that removes options is one that is wrong at somebody's
 * expense.
 */
const languages = repoRow
  ? (await db
      .selectFrom('repository_languages')
      .select(['name'])
      .where('repository_id', '=', Number(repoRow.id))
      .orderBy('bytes', 'desc')
      .limit(4)
      .execute()
      .catch(() => []))
      .map(row => String(row.name ?? '').toLowerCase())
  : []

const starters = rows.length === 0 ? startersFor(languages) : []

/*
 * The environments this repository has, for an `environment:` input.
 *
 * Actions' fourth input type is a choice over the repository's environments
 * rather than a free string, and it exists because typing the name of a
 * protected environment wrong is a deploy that silently goes somewhere else.
 * A repository with none gets a text field and a line saying why, rather than
 * an empty select nobody can submit.
 */
const environments = repoRow
  ? (await db
      .selectFrom('environments')
      .select(['name'])
      .where('repository_id', '=', Number(repoRow.id))
      .orderBy('name')
      .execute()
      .catch(() => []))
      .map(row => String(row.name ?? ''))
      .filter(name => name.length > 0)
  : []
</script>

@layout('app')

@section('title', `Workflows · ${params.owner}/${params.repository}`)
@section('description', `The workflows defined in ${params.owner}/${params.repository}, and when each one runs.`)

@section('content')
  <div class="page">
    @if (!repoRow)
      <PageEmpty
        title="No such repository"
        detail="Nothing is published at {{ ownerHandle }}/{{ repositoryName }}."
        linksJson="{{ JSON.stringify([{ href: `/${ownerHandle}`, label: `Back to ${ownerHandle}` }, { href: '/explore', label: 'Explore' }]) }}"
      />
    @else
      {{-- `RepoHeader`, like every other repository screen. --}}
      <RepoHeader
        owner="{{ ownerHandle }}"
        repository="{{ repositoryName }}"
        visibility="{{ repoRow.visibility }}"
        description="{{ repoRow.description ?? '' }}"
        refName=""
        size=""
        sizeKb="0"
        commits=""
        :actions="repoActions"
        :branches="[]"
        :tags="[]" />

      <RepoTabs owner="{{ ownerHandle }}" repository="{{ repositoryName }}" active="runs" />

      <p class="muted repo-page-caption">{{ rows.length }} {{ rows.length === 1 ? 'workflow' : 'workflows' }}</p>

      <p class="muted" style="margin-top: 14px; font-size: 12.5px;">
        <a href="{{ base }}/runs">Runs</a> shows what has happened. This page shows what is
        registered, and why anything that will not run does not.
      </p>

      @if (rows.length === 0)
        <div class="panel" style="padding: 28px; margin-top: 16px;">
          <p class="muted" style="text-align: center;">No workflows are registered.</p>
          <p class="muted" style="margin-top: 6px; font-size: 13px; text-align: center;">
            Add one under <code>.github/workflows</code> or <code>.reviewos/workflows</code> and push
            it. They are read from the default branch, and <code>.reviewos/workflows</code> wins when
            both exist.
          </p>
        </div>

        <h2 class="starters-title">Start with one of these</h2>
        <p class="muted starters-note">
          Every one is a real GitHub Actions workflow. Copy it into your repository, push, and it
          runs here - and it would run there too, which is the point.
        </p>

        <div class="starters">
          @foreach (starters as template)
            <details class="starter panel">
              <summary class="starter-head">
                <span class="starter-name">{{ template.name }}</span>
                <span class="muted starter-path"><code>{{ template.path }}</code></span>
              </summary>
              <p class="muted starter-description">{{ template.description }}</p>
              <pre class="starter-code"><code>{{ template.content }}</code></pre>
            </details>
          @endforeach
        </div>
      @else
        <div class="workflows">
          @foreach (rows as workflow)
            <section class="workflow panel">
              <div class="workflow-head">
                <div class="workflow-main">
                  <h2 class="workflow-name">{{ workflow.name }}</h2>
                  <p class="workflow-path muted"><code>{{ workflow.path }}</code></p>
                </div>

                <span class="badge badge-{{ workflow.state }}">{{ workflow.state }}</span>
              </div>

              <p class="workflow-meta muted">
                @if (workflow.triggers.length > 0)
                  Runs on {{ workflow.triggers.join(', ') }}
                @else
                  No trigger this instance dispatches
                @endif
                @if (workflow.concurrency)
                  · concurrency <code>{{ workflow.concurrency }}</code>
                @endif
                @if (workflow.updated)
                  · updated {{ workflow.updated }}
                @endif
              </p>

              @foreach (workflow.problems as problem)
                <p class="workflow-problem">{{ problem }}</p>
              @endforeach

              {{--
                The badge, shown rather than described. A snippet somebody has
                to assemble from a reference page is one they assemble wrongly
                once and then never again, so the line to paste is here with the
                picture it produces beside it.

                The path is relative on purpose: this instance is not
                reviewos.org, and a snippet carrying somebody else's hostname is
                the one bug a badge can have that nobody notices until the
                README is public.
              --}}
              <details class="workflow-badge">
                <summary class="muted">Badge</summary>

                <p class="workflow-badge-preview">
                  <img src="{{ workflow.badgePath }}" alt="{{ workflow.name }} status" width="112" height="20">
                </p>

                <pre class="workflow-badge-snippet"><code>![{{ workflow.name }}]({{ workflow.badgePath }})</code></pre>

                <p class="muted workflow-badge-note">
                  Relative, so it works in this repository's README. Reading it anywhere else needs
                  this instance's address in front of it, and <code>&amp;branch=</code> for a branch
                  other than <code>{{ defaultBranch }}</code>.
                </p>
              </details>

              @if (workflow.differences.length > 0)
                <details class="workflow-differences">
                  <summary class="muted">
                    {{ workflow.differences.length }}
                    {{ workflow.differences.length === 1 ? 'key behaves' : 'keys behave' }}
                    differently here
                  </summary>
                  @foreach (workflow.differences as difference)
                    <p class="workflow-difference">
                      <code>{{ difference.key }}</code>: {{ difference.message }}
                    </p>
                  @endforeach
                  <p class="muted workflow-difference-note">
                    The full table is in <a href="/docs/conformance">the conformance reference</a>.
                  </p>
                </details>
              @endif

              @if (workflow.dispatchable && canDispatch)
                {{--
                  Posted to the same public action the API and the CLI call. A
                  control the interface has and the API does not is how a
                  product grows a second, undocumented way to change its state.
                --}}
                <form method="post" action="/api/repos/workflows/dispatch" class="workflow-run">
                  <CsrfField />
                  <input type="hidden" name="owner" value="{{ ownerHandle }}">
                  <input type="hidden" name="repo" value="{{ repositoryName }}">
                  <input type="hidden" name="workflow" value="{{ workflow.path }}">

                  @foreach (workflow.inputs as input)
                    <label class="workflow-input">
                      <span class="workflow-input-name">
                        {{ input.name }}
                        @if (input.required)
                          <span class="muted">required</span>
                        @endif
                      </span>

                      @if (input.description)
                        <span class="workflow-input-help muted">{{ input.description }}</span>
                      @endif

                      @if (input.type === 'choice')
                        <select name="inputs[{{ input.name }}]">
                          @foreach (input.options as option)
                            <option value="{{ option }}" {{ option === input.default ? 'selected' : '' }}>{{ option }}</option>
                          @endforeach
                        </select>
                      @elseif (input.type === 'environment' && environments.length > 0)
                        <select name="inputs[{{ input.name }}]">
                          @foreach (environments as environment)
                            <option value="{{ environment }}" {{ environment === input.default ? 'selected' : '' }}>{{ environment }}</option>
                          @endforeach
                        </select>
                      @elseif (input.type === 'environment')
                        {{-- No environments configured, so a select would be one nobody can submit. --}}
                        <input type="text" name="inputs[{{ input.name }}]" value="{{ input.default ?? '' }}">
                        <span class="workflow-input-help muted">This repository has no environments yet, so this is a plain name.</span>
                      @elseif (input.type === 'boolean')
                        <select name="inputs[{{ input.name }}]">
                          <option value="false" {{ input.default === 'true' ? '' : 'selected' }}>false</option>
                          <option value="true" {{ input.default === 'true' ? 'selected' : '' }}>true</option>
                        </select>
                      @else
                        <input type="text" name="inputs[{{ input.name }}]" value="{{ input.default ?? '' }}">
                      @endif
                    </label>
                  @endforeach

                  <button class="button" type="submit">Run workflow</button>
                </form>
              @endif
            </section>
          @endforeach
        </div>

        <p class="muted" style="margin-top: 14px; font-size: 12.5px;">
          Runs are recorded here and carried out by runners you provide. This instance does not
          execute repository code itself.
        </p>
      @endif
    @endif
  </div>
@endsection

<style>
  .workflows { display: grid; gap: 10px; margin-top: 16px; }
  .workflow { padding: 16px 18px; }

  .workflow-head { display: flex; align-items: flex-start; gap: 12px; }
  .workflow-main { flex: 1; min-width: 0; }
  .workflow-name { font-size: 15px; font-weight: 600; margin: 0; }
  .workflow-path { font-size: 12.5px; margin: 3px 0 0; }
  .workflow-meta { font-size: 12.5px; margin: 8px 0 0; }

  /*
   * The state as a word, not only as a colour: a reader who cannot tell two
   * colours apart still has to be able to see that a workflow is off.
   */
  .badge {
    flex: none;
    font-size: 11.5px;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--muted);
  }

  .badge-active { color: var(--ok); border-color: var(--ok); }
  .badge-disabled { color: var(--warn); border-color: var(--warn); }
  .badge-removed { color: var(--muted); }

  .workflow-problem {
    margin: 8px 0 0;
    font-size: 12.5px;
    padding: 8px 12px;
    border-left: 2px solid var(--warn);
    background: var(--panel-2, transparent);
  }

  .workflow-differences { margin-top: 10px; font-size: 12.5px; }
  .workflow-differences summary { cursor: pointer; }
  .workflow-difference { margin: 8px 0 0; padding-left: 12px; border-left: 2px solid var(--line); }
  .workflow-difference-note { margin: 8px 0 0; padding-left: 12px; }

  .workflow-badge { margin-top: 10px; font-size: 12.5px; }
  .workflow-badge summary { cursor: pointer; }
  .workflow-badge-preview { margin: 10px 0 0; }
  .workflow-badge-snippet {
    margin: 8px 0 0;
    padding: 8px 10px;
    overflow-x: auto;
    font-size: 12px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--panel-2, transparent);
  }
  .workflow-badge-note { margin: 8px 0 0; font-size: 12px; }

  .workflow-run { display: grid; gap: 10px; margin-top: 14px; max-width: 420px; }
  .workflow-input { display: grid; gap: 4px; font-size: 12.5px; }
  .workflow-input-name { font-weight: 550; }
  .workflow-input-help { font-size: 12px; }

  .workflow-run input[type="text"],
  .workflow-run select {
    padding: 7px 10px;
    border: 1px solid var(--line);
    border-radius: var(--r-field, 8px);
    background: var(--bg);
    color: inherit;
    font: inherit;
    font-size: 13px;
  }

  .workflow-run button { justify-self: start; }

  .starters-title { font-size: 15px; font-weight: 600; margin: 24px 0 4px; }
  .starters-note { font-size: 12.5px; margin: 0 0 12px; }
  .starters { display: grid; gap: 8px; }
  .starter { padding: 12px 16px; }

  .starter-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 550;
  }

  .starter-path { font-size: 12px; font-weight: 400; }
  .starter-description { font-size: 12.5px; margin: 8px 0 0; }

  .starter-code {
    margin: 10px 0 0;
    padding: 12px;
    overflow-x: auto;
    font-size: 12.5px;
    line-height: 1.5;
    border: 1px solid var(--line);
    border-radius: var(--r-field, 8px);
    background: var(--bg);
  }
</style>
