<script server>
/**
 * One issue: its body, its labels, and the conversation under it.
 *
 * Server-rendered, like the review screen. An issue with two hundred comments
 * is a page, not an application, and it should arrive as one.
 *
 * The rules come from tested modules - `app/Actions/Issue/state` for what a
 * state reads as, `app/Actions/Issue/reactions` for the row of buttons,
 * `app/Actions/Markdown/render` for turning bodies into HTML - because rules
 * written in a template cannot be tested. What is left here is the reading and
 * the shaping, and the shaping is handed to components: `IssueThread` renders
 * the conversation, and the pull request page will render the same one rather
 * than a copy of it that drifts.
 */
import { repositoryForView } from '../../../../functions/repo'
import { authorIsLocal, authorLabel, relativeTime } from '../../../../functions/browse'
import { entryIcon, entrySentence, issueStateLabel, issueStatePill, labelColor, labelTextColor } from '../../../../functions/issues'
import { pressed, subjectKey, summarize, summarizeAll } from '../../../../functions/reactions'
import { loadConversation } from '../../../../functions/conversation'
import { viewerFromCookies } from '../../../../functions/identity'
// Asked for here rather than through a helper: `setResponseStatus` is a
// context binding, in scope only inside this script. See the note in
// `resources/components/RepoBrowser.stx`.
const setStatus = typeof setResponseStatus === 'function' ? setResponseStatus : () => {}

const ownerHandle = String(params.owner)
const repositoryName = String(params.repository)
const number = Number(params.number)

/**
 * The query string.
 *
 * Through `useRoute()`, because a server script has no bare `query`: reaching
 * for one throws, stx catches the throw and falls back to static extraction,
 * and the page renders with every variable undefined and no error anywhere a
 * person would look. That failure is silent by design and cost this file a
 * not-found page that looked exactly like a missing issue.
 */
const search: Record<string, string> = useRoute().query ?? {}

// Resolving the owner first is what stops `/someone/stacks` finding a
// repository that belongs to somebody else.
// Resolved and permission-checked together. A repository the reader may not
// see comes back null, exactly as a repository that does not exist does, so a
// private one does not announce itself by answering differently.
/**
 * The request, when there is one, without naming a binding that may not exist.
 *
 * stx declares `__stxServeContext` on the path that serves a request and on no
 * other, and an *undeclared* identifier is a ReferenceError - which optional
 * chaining does not save, because `x?.y` throws on `x` before the chain is
 * reached. It throws inside the server script's IIFE, so it takes every other
 * variable in this file down with it and the page renders its not-found branch
 * as though the answer were no.
 *
 * The globalThis mirror is not the fix: it is shared between concurrent
 * requests, so reading cookies off it could hand one reader another reader's
 * session.
 */
const serveContext = __stxServeContext

const repoAccess = await repositoryForView(ownerHandle, repositoryName, serveContext?.cookies)
const repoRow: any = repoAccess?.repository ?? null

// Issues and pull requests share the number sequence and the same table carries
// both, so the flag is what keeps `/issue/12` from opening a pull request.
const issue: any = repoRow && Number.isFinite(number)
  ? await db
      .selectFrom('issues')
      .selectAll()
      .where('repository_id', '=', Number(repoRow.id))
      .where('number', '=', number)
      .where('is_pull_request', '=', false)
      .executeTakeFirst()
  : undefined

// A missing issue is a missing page. Rendering "no such issue" under a 200
// tells a crawler every number in the sequence exists.
if (!issue)
  setStatus(404)

/*
 * Where somebody who followed a stale link was going anyway. Built here rather
 * than in the attribute: an expression with a `${}` in it does not survive one.
 */
const notFoundLinks = JSON.stringify([
  { href: `/${ownerHandle}/${repositoryName}/issues`, label: 'All issues' },
  { href: `/${ownerHandle}/${repositoryName}`, label: `${ownerHandle}/${repositoryName}` },
])

/**
 * The author's name to show.
 *
 * A local user when there is one, and the upstream login when there is not.
 * Mirrored issues are the common case for the second: whoever opened it on the
 * other host usually has no account here.
 */
const authorRow: any = issue && issue.author_id
  ? await db.selectFrom('users').select(['handle']).where('id', '=', Number(issue.author_id)).executeTakeFirst()
  : undefined

const authorHandle = authorRow?.handle ? String(authorRow.handle) : null
const externalAuthor = issue?.external_author ? String(issue.external_author) : null

const labelRows: any[] = issue
  ? await db
      .selectFrom('issue_labels')
      .innerJoin('repository_labels', 'repository_labels.id', '=', 'issue_labels.label_id')
      .select(['repository_labels.name as name', 'repository_labels.color as color'])
      .where('issue_labels.issue_id', '=', Number(issue.id))
      .execute()
  : []

// Deduplicated by name: the join table has no unique constraint on the pair,
// and the same label applied twice renders as the same pill twice.
const labels = [...new Map(labelRows.map((row: any) => [String(row.name), {
  name: String(row.name),
  color: labelColor(row.color),
  textColor: labelTextColor(labelColor(row.color)),
}])).values()]

const assignees: any[] = issue
  ? await db
      .selectFrom('issue_assignees')
      .innerJoin('users', 'users.id', '=', 'issue_assignees.user_id')
      .select(['users.handle as handle'])
      .where('issue_assignees.issue_id', '=', Number(issue.id))
      .execute()
  : []

const milestone: any = issue?.milestone_id
  ? await db.selectFrom('milestones').selectAll().where('id', '=', Number(issue.milestone_id)).executeTakeFirst()
  : undefined

// Who is reading, so their own reactions can be shown as already pressed. A
// server script has no `request`; what it has is the parsed cookies on
// `serveContext`, and `viewerFromCookies` reads the same two cookies the
// auth middleware accepts, in the same order, so the page and the endpoint its
// forms post to cannot disagree about who is signed in.
const viewer = await viewerFromCookies(serveContext?.cookies)
const viewerId = viewer ? Number(viewer.id) : null

// Where to come back to after signing in, for the prompt that replaces the
// comment box. A path on this host only - see `AccountNav.stx` for why an
// absolute one is an open redirect.
const here = String(serveContext?.path ?? `/${ownerHandle}/${repositoryName}/issue/${issue?.number ?? ''}`)

// Reactions, in two queries for the whole page rather than one per comment. An
// issue with three hundred comments is exactly where the per-comment version
// would be felt, and it is the same issue somebody most wants to read.

/**
 * Which reaction picker is open, from the query string.
 *
 * A picker is a link rather than a control: `?react=body` or
 * `?react=<comment id>` is the same page with the eight buttons showing on one
 * post. That means it survives a bookmark, a new tab and the back button, and
 * it needs no script - the two properties this page is built around.
 */
const picking = String(search.react ?? '')
const taskAction = '/api/repos/issues/tasks'
const reactionAction = '/api/repos/issues/reactions'

/*
 * The reading and the shaping, in `resources/functions/conversation.ts`.
 *
 * It used to be eighty lines here. The pull request page renders the same
 * `IssueThread`, and `IssueThread.stx` says in its own header that the pull
 * request page is the reason it is a component at all - so leaving the half in
 * front of it here would have handed that page a copy of exactly the kind the
 * component exists to prevent.
 *
 * For an issue both subjects are the same row. They are named separately
 * because for a change they are not: its comments hang off the `issues` row
 * behind it and its history hangs off the change itself.
 */
const { opening, items: conversation } = issue
  ? await loadConversation(
      {
        comments: { type: 'issue', id: Number(issue.id) },
        timeline: { type: 'issue', id: Number(issue.id) },
        reactions: { type: 'issue', id: Number(issue.id) },
        opening: {
          body: issue.body ? String(issue.body) : null,
          createdAt: String(issue.created_at ?? ''),
          authorHandle,
          externalAuthor,
        },
        locked: Boolean(issue.locked),
      },
      {
        owner: ownerHandle,
        repository: repositoryName,
        number: Number(issue.number ?? 0),
        viewerId,
        picking,
        reactionAction,
        taskAction,
      },
    )
  : { opening: {}, items: [] }

const stateLabel = issue ? issueStateLabel(String(issue.state), issue.state_reason) : ''
const statePill = issue ? issueStatePill(String(issue.state), issue.state_reason) : 'draft'
</script>

@layout('app')

@section('title', `#${params.number} · ${params.owner}/${params.repository}`)
@section('description', `Issue #${params.number} in ${params.owner}/${params.repository}, with its discussion and its cross-references.`)

@section('content')
  <div class="page">
    @if (!issue)
      {{-- With somewhere to go, for the reason written on the pull request
          page: a panel that only says no leaves the back button as the only
          way on. --}}
      <PageEmpty
        title="No such issue"
        detail="{{ ownerHandle }}/{{ repositoryName }} has no issue numbered {{ params.number }}."
        linksJson="{{ notFoundLinks }}"
      />
    @else
      <header class="issue-head">
        {{-- Which repository this is, and the way back to it. The page named it
            nowhere: a reader arriving from a search, a notification or a
            cross-reference had no link to the repository the issue belongs
            to. --}}
        <p class="issue-where mono">
          <a href="/{{ ownerHandle }}">{{ ownerHandle }}</a><span class="muted">/</span><a href="/{{ ownerHandle }}/{{ repositoryName }}">{{ repositoryName }}</a>
        </p>

        <div class="issue-title-row">
          <h1 class="issue-title">{{ issue.title }}</h1>
          <span class="issue-number mono muted">#{{ issue.number }}</span>
        </div>

        <div class="issue-meta">
          <span class="pill pill-{{ statePill }}">{{ stateLabel }}</span>
          <span class="muted">
            @if (authorIsLocal(authorHandle))
              <a href="/{{ authorHandle }}">{{ authorLabel(authorHandle, externalAuthor) }}</a>
            @else
              {{-- No local account to link to. The name is still shown, because
                  the author being unlinked is a fact about this forge, not
                  about them. --}}
              <span>{{ authorLabel(authorHandle, externalAuthor) }}</span>
            @endif
            opened this {{ relativeTime(String(issue.created_at ?? '')) }}
            &middot;
            {{ comments.length }} {{ comments.length === 1 ? 'comment' : 'comments' }}
          </span>
        </div>
      </header>

      <div class="issue-body">
        <div class="issue-main">
          <IssueThread
            :opening="opening"
            :items="conversation"
            reactionAction="{{ reactionAction }}"
          />

          @if (issue.locked)
            <p class="issue-locked muted">
              This conversation is locked. Only people maintaining the repository can comment.
            </p>
          @elseif (!viewer)
            {{-- Signed out. The box was rendered anyway, so the way to find
                out that a comment needs an account was to write one and watch
                the endpoint refuse it. --}}
            <p class="issue-locked muted">
              <a href="/login?next={{ encodeURIComponent(here) }}">Sign in</a> to comment on this issue.
            </p>
          @else
            {{-- `multipart/form-data`, because a file picked next to the box is
                stored when the comment is submitted: the page runs no
                client-side JavaScript, so there is no editor to insert a link
                into and this is the whole upload flow. --}}
            <form class="issue-reply panel" method="post" action="/api/repos/issues/comments" enctype="multipart/form-data">
              <CsrfField />
              <input type="hidden" name="owner" value="{{ ownerHandle }}">
              <input type="hidden" name="repo" value="{{ repositoryName }}">
              <input type="hidden" name="number" value="{{ issue.number }}">
              <label class="visually-hidden" for="issue-comment">Comment on this issue</label>
              <textarea id="issue-comment" name="body" rows="4" placeholder="Leave a comment" class="reply-input"></textarea>
              <div class="reply-actions">
                <label class="reply-attach">
                  <span class="i-hugeicons-attachment-01" aria-hidden="true"></span>
                  <span>Attach files</span>
                  <input class="visually-hidden" type="file" name="attachments" multiple>
                </label>
                <button type="submit" class="reply-submit">Comment</button>
              </div>
            </form>
          @endif
        </div>

        <aside class="issue-side">
          <section class="panel side-block">
            <h2 class="side-title">Labels</h2>
            @if (labels.length === 0)
              <p class="muted side-empty">None yet.</p>
            @else
              <div class="label-row">
                @foreach (labels as label)
                  <LabelPill :label="label" />
                @endforeach
              </div>
            @endif
          </section>

          <section class="panel side-block">
            <h2 class="side-title">Assignees</h2>
            @if (assignees.length === 0)
              <p class="muted side-empty">Nobody is assigned.</p>
            @else
              <ul class="side-list">
                @foreach (assignees as assignee)
                  <li><a href="/{{ assignee.handle }}">{{ assignee.handle }}</a></li>
                @endforeach
              </ul>
            @endif
          </section>

          <section class="panel side-block">
            <h2 class="side-title">Milestone</h2>
            @if (!milestone)
              <p class="muted side-empty">None.</p>
            @else
              <p class="side-milestone">{{ milestone.title }}</p>
              @if (milestone.due_on)
                <p class="muted side-note">Due {{ String(milestone.due_on).slice(0, 10) }}</p>
              @endif
            @endif
          </section>
        </aside>
      </div>
    @endif
  </div>
@endsection

<style>
  .issue-head { padding-bottom: 16px; border-bottom: 1px solid var(--line); }
  .issue-where { margin-bottom: 6px; font-size: 13px; }
  .issue-where a { text-decoration: none; }
  .issue-where a:hover { text-decoration: underline; }
  .issue-title-row { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .issue-title { font-size: 25px; font-weight: 600; line-height: 1.25; }
  .issue-number { font-size: 20px; }
  .issue-meta { display: flex; align-items: center; gap: 10px; margin-top: 10px; flex-wrap: wrap; font-size: 13.5px; }

  .issue-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 20px;
    margin-top: 20px;
    align-items: start;
  }

  .issue-locked { padding: 14px 2px; font-size: 13.5px; }

  .issue-reply { padding: 14px 16px; }

  .reply-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 10px;
  }

  /* The file input is hidden and the label is the control, because a bare file
    input cannot be styled and looks like nothing else on the page. It is still
    focusable through the input it wraps. */
  .reply-attach {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    font-size: 12.5px;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: var(--r-control);
    cursor: pointer;
  }

  .reply-attach:hover { border-color: var(--line-strong); color: var(--text); }
  .reply-attach:focus-within { outline: 2px solid var(--accent); outline-offset: 1px; }

  .reply-submit {
    padding: 7px 14px;
    border: 0;
    border-radius: var(--r-control);
    background: var(--accent);
    color: var(--on-accent);
    font: inherit;
    font-size: 13.5px;
    font-weight: 500;
    cursor: pointer;
  }

  .side-block { padding: 14px 16px; margin-bottom: 12px; }
  .side-title { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
  .side-empty, .side-note { margin-top: 7px; font-size: 13px; }
  .side-list { margin-top: 8px; font-size: 13.5px; }
  .side-list li { margin: 3px 0; }
  .side-milestone { margin-top: 8px; font-size: 13.5px; }

  .label-row { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 9px; }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .issue-body { grid-template-columns: minmax(0, 1fr); }
  }
</style>
