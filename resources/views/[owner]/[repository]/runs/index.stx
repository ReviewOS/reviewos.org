<script server>
/**
 * A repository's workflow runs, newest first.
 *
 * The page somebody opens to answer one question: did my commit pass. So the
 * commit and the branch are on every row, and the state is a word rather than a
 * colour alone - a tick and a cross are the same shape to a reader who cannot
 * tell the two colours apart, which is why `runLabel` puts the state in text
 * beside the dot.
 *
 * Nothing on this page executes anything, and it says so where a reader would
 * otherwise wonder why every run is queued: this instance has no execution
 * plane unless an operator has provided one, which is the decision in
 * `docs/ci-threat-model.md`.
 */
import { repositoryForView } from '../../../../functions/repo'
import { relativeTime, shortSha } from '../../../../functions/browse'
import { runDuration, runLabel, runTone } from '../../../../functions/runs'
// Asked for here rather than through a helper: `setResponseStatus` is a
// context binding, in scope only inside this script. See the note in
// `resources/components/RepoBrowser.stx`.
const setStatus = typeof setResponseStatus === 'function' ? setResponseStatus : () => {}

const ownerHandle = String(params.owner)
const repositoryName = String(params.repository)

// Declared on the request path and on no other, so it is read through the
// binding rather than named directly: an undeclared identifier is a
// ReferenceError that takes every other variable in this script with it, and
// the page then renders its not-found branch as though the answer were no.
const serveContext = __stxServeContext

const repoAccess = await repositoryForView(ownerHandle, repositoryName, serveContext?.cookies)
const repoRow: any = repoAccess?.repository ?? null

if (!repoRow)
  setStatus(404)

const runs: any[] = repoRow
  ? await db
      .selectFrom('workflow_runs')
      .selectAll()
      .where('repository_id', '=', Number(repoRow.id))
      .orderBy('created_at', 'desc')
      .orderBy('id', 'desc')
      .limit(50)
      .execute()
  : []

/*
 * The workflow each run belongs to, in two queries rather than two per run.
 * A run list is the page most likely to be opened on a repository that has
 * hundreds of them, and a query per row is how a list page becomes the slowest
 * thing in a product.
 */
const versionIds = [...new Set(runs.map(run => Number(run.workflow_version_id)))]

const versions: any[] = versionIds.length > 0
  ? await db
      .selectFrom('workflow_versions')
      .select(['id', 'workflow_id'])
      .where('id', 'in', versionIds)
      .execute()
  : []

const workflowIds = [...new Set(versions.map(version => Number(version.workflow_id)))]

const workflows: any[] = workflowIds.length > 0
  ? await db
      .selectFrom('workflows')
      .select(['id', 'name', 'path'])
      .where('id', 'in', workflowIds)
      .execute()
  : []

const workflowById = new Map(workflows.map(workflow => [Number(workflow.id), workflow]))
const workflowForVersion = new Map(
  versions.map(version => [Number(version.id), workflowById.get(Number(version.workflow_id)) ?? null]),
)

const rows = runs.map((run) => {
  const workflow = workflowForVersion.get(Number(run.workflow_version_id)) ?? null
  const ref = String(run.event_ref ?? '')

  return {
    number: Number(run.number),
    state: String(run.state),
    label: runLabel(String(run.state)),
    tone: runTone(String(run.state)),
    event: String(run.event ?? ''),
    // `refs/heads/main` is not what a person calls a branch.
    branch: ref.startsWith('refs/heads/')
      ? ref.slice('refs/heads/'.length)
      : ref.startsWith('refs/tags/') ? ref.slice('refs/tags/'.length) : ref,
    isTag: ref.startsWith('refs/tags/'),
    sha: run.head_sha ? shortSha(String(run.head_sha)) : '',
    workflowName: workflow ? String(workflow.name) : 'Workflow',
    duration: runDuration(run.started_at, run.finished_at),
    when: run.created_at ? relativeTime(String(run.created_at)) : '',
  }
})

const base = `/${ownerHandle}/${repositoryName}`
</script>

@layout('app')

@section('content')
  <div class="shell" style="padding-top: 22px; padding-bottom: 64px;">
    @if (!repoRow)
      <div class="panel" style="padding: 32px; text-align: center;">
        <h1 style="font-size: 20px;">No such repository</h1>
      </div>
    @else
      <header class="repo-head">
        <h1 class="repo-title">
          <a href="/{{ ownerHandle }}">{{ ownerHandle }}</a><span class="muted">/</span><a href="{{ base }}">{{ repositoryName }}</a>
        </h1>
        <p class="muted" style="margin-top: 6px;">
          {{ rows.length }} {{ rows.length === 1 ? 'workflow run' : 'workflow runs' }}
        </p>
      </header>

      <RepoTabs owner="{{ ownerHandle }}" repository="{{ repositoryName }}" active="runs" />

      @if (rows.length === 0)
        <div class="panel" style="padding: 28px; text-align: center; margin-top: 16px;">
          <p class="muted">No workflow runs yet.</p>
          <p class="muted" style="margin-top: 6px; font-size: 13px;">
            Add a workflow under <code>.github/workflows</code> and push it. It is registered from the
            default branch, and a run appears here the next time anything is pushed.
          </p>
        </div>
      @else
        <div class="runs">
          @foreach (rows as run)
            <a class="run" href="{{ base }}/run/{{ run.number }}">
              <span class="run-dot run-{{ run.tone }}" aria-hidden="true"></span>

              <span class="run-main">
                <span class="run-name">{{ run.workflowName }} <span class="muted">#{{ run.number }}</span></span>
                <span class="run-meta muted">
                  {{ run.label }}
                  @if (run.branch)
                    · {{ run.isTag ? 'tag' : 'branch' }} {{ run.branch }}
                  @endif
                  @if (run.sha)
                    · <code>{{ run.sha }}</code>
                  @endif
                </span>
              </span>

              <span class="run-when muted">
                @if (run.duration)
                  {{ run.duration }} ·
                @endif
                {{ run.when }}
              </span>
            </a>
          @endforeach
        </div>

        <p class="muted" style="margin-top: 14px; font-size: 12.5px;">
          Runs are recorded here and carried out by runners you provide. This instance does not
          execute repository code itself.
        </p>
      @endif
    @endif
  </div>
@endsection

<style>
  .runs { display: grid; gap: 8px; margin-top: 16px; }

  .run {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: var(--r-field, 10px);
    background: var(--panel, transparent);
    color: inherit;
    text-decoration: none;
  }

  .run:hover { border-color: var(--muted); }

  .run-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    flex: none;
    background: var(--muted);
  }

  /*
   * Colour is the second signal, never the only one: the state is written out
   * beside it in `run-meta`, because a green dot and a red dot are the same
   * shape.
   */
  .run-good { background: var(--good, #2da44e); }
  .run-bad { background: var(--bad, #cf222e); }
  .run-warn { background: var(--warn, #bf8700); }
  .run-running { background: var(--accent); }

  .run-main { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
  .run-name { font-size: 14px; font-weight: 550; }
  .run-meta { font-size: 12.5px; }
  .run-when { font-size: 12.5px; white-space: nowrap; }
</style>
