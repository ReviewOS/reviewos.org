<script server>
import { projectsForView } from '../../../../functions/forge'
const tool = await projectsForView(String(params.owner), String(params.repository), __stxServeContext?.cookies, String(params.project), useRoute().query ?? {})
if (tool.status !== 200) setResponseStatus(tool.status)
const projectRow = tool.board?.project
const endpoint = `${tool.api}/projects/${params.project}`
</script>

@layout('app')
@section('title', `Project · ${params.owner}/${params.repository}`)
@section('description', 'A project board connected to repository issues and pull requests.')
@section('content')
<div class="forge-tools page project-page">
<ForgeToolsStyle />
  @if (tool.status !== 200)
    <PageEmpty title="No such project" detail="The project is unavailable." />
  @else
    <RepoTabs owner="{{ tool.owner }}" repository="{{ tool.repository }}" active="projects" />
    <header class="py-6"><a class="text-sm muted" href="{{ tool.base }}/projects">Projects</a><div class="flex flex-wrap gap-3 items-center mt-2"><h1 class="font-semibold text-2xl">{{ projectRow.title }}</h1><span class="muted">{{ projectRow.state }}</span></div><p class="mt-2 muted">{{ projectRow.description }}</p></header>
    <form class="flex flex-wrap gap-3 items-end mb-5" method="get">
      <label class="grid gap-2 grow">Find a card<input class="field" type="search" name="q" value="{{ tool.search }}" placeholder="Title or #number"></label>
      <label class="grid gap-2">Issue state<select class="field" name="state"><option value="">All states</option value="open" :selected="tool.state === 'open'">Open</option><option value="closed" :selected="tool.state === 'closed'">Closed</option></select></label>
      <input type="hidden" name="view" value="{{ tool.listView ? 'list' : 'board' }}">
      <button class="btn" type="submit">Filter</button>
      <a class="btn" href="{{ tool.base }}/projects/{{ projectRow.id }}?view={{ tool.listView ? 'board' : 'list' }}">{{ tool.listView ? 'Board view' : 'List view' }}</a>
    </form>
    @if (tool.mayMove)
      <form class="flex flex-wrap gap-3 items-end mb-5 p-4 panel" method="post" action="{{ endpoint }}/items">
        <CsrfField />
        <label class="grid gap-2 grow">Issue or pull request number<input class="field" type="number" name="number" min="1" step="1" required placeholder="42"></label>
        <label class="grid gap-2">Column<select class="field" name="column_id">@foreach (tool.board.columns as column)<option value="{{ column.id }}">{{ column.title }}</option>@endforeach</select></label>
        <button class="btn btn-primary" type="submit">Add to project</button>
      </form>
    @endif
    <div class="{{ tool.listView ? 'project-list' : 'project-board' }}" aria-label="Project board">
      @foreach (tool.board.columns as column)
        <section class="panel project-column" aria-label="{{ column.title }}">
          <header class="flex gap-3 items-center justify-between p-4"><h2 class="font-semibold">{{ column.title }}</h2><span class="text-sm muted">{{ column.cards.length }} shown</span></header>
          <div class="grid gap-3 pb-3 px-3 project-cards">
            @if (column.cards.length === 0)
              <p class="p-3 text-sm muted">{{ tool.search || tool.state ? 'No matching cards on this page.' : tool.board.offset || tool.board.next_offset ? 'No cards on this page.' : 'No cards yet.' }}</p>
            @endif
            @foreach (column.cards as card)
              <article class="p-4 project-card">
                <p class="mb-2 text-xs muted">{{ card.is_pull_request ? 'Pull request' : 'Issue' }} #{{ card.number }} · {{ card.state }}</p>
                <h3 class="font-medium"><a href="{{ tool.base }}/{{ card.is_pull_request ? 'pull' : 'issue' }}/{{ card.number }}">{{ card.title }}</a></h3>
                @if (tool.mayMove)
                  <details class="mt-3"><summary class="text-sm muted">Move or remove</summary>
                    <form class="grid gap-3 mt-3" method="post" action="{{ endpoint }}/items/{{ card.id }}/move">
                      <CsrfField /><input type="hidden" name="revision" value="{{ card.revision }}">
                      <label class="grid gap-1 text-sm">Move to<select class="w-full field" name="column_id">@foreach (tool.board.columns as destination)<option value="{{ destination.id }}" :selected="Number(destination.id) === Number(column.id)">{{ destination.title }}</option>@endforeach</select></label>
                      <label class="grid gap-1 text-sm">Position<select class="w-full field" name="placement"><option value="last">At the end</option><option value="first">At the top</option></select></label>
                      <button class="btn" type="submit">Move card</button>
                    </form>
                    <form class="mt-2" method="post" action="{{ endpoint }}/items/{{ card.id }}/remove"><CsrfField /><input type="hidden" name="revision" value="{{ card.revision }}"><button class="btn" type="submit">Remove from project</button></form>
                  </details>
                @endif
              </article>
            @endforeach
          </div>
          @if (tool.mayEditBoard)
            <details class="p-4"><summary class="text-sm muted">Column settings</summary>
              <form class="grid gap-2 mt-3" action="{{ endpoint }}/columns" method="post"><CsrfField /><input type="hidden" name="column_id" value="{{ column.id }}"><input type="hidden" name="operation" value="rename"><label class="grid gap-1 text-sm">Column title<input class="w-full field" name="title" value="{{ column.title }}" maxlength="160" required></label><button class="btn" type="submit">Rename</button></form>
              <form class="flex flex-wrap gap-2 mt-3" action="{{ endpoint }}/columns" method="post"><CsrfField /><input type="hidden" name="column_id" value="{{ column.id }}"><button class="btn" type="submit" name="operation" value="left" aria-label="Move {{ column.title }} left">Left</button><button class="btn" type="submit" name="operation" value="right" aria-label="Move {{ column.title }} right">Right</button>@if (column.cards.length === 0 && tool.board.columns.length > 1)<button class="btn" type="submit" name="operation" value="delete">Delete column</button>@endif</form>
            </details>
          @endif
        </section>
      @endforeach
    </div>
    @if (tool.mayEditBoard)
      <form class="flex flex-wrap gap-3 items-end mt-6 p-4 panel" method="post" action="{{ endpoint }}/columns"><CsrfField /><input type="hidden" name="operation" value="create"><label class="grid gap-2 grow">New column<input class="field" name="title" required maxlength="160" placeholder="In review"></label><button class="btn" type="submit">Add column</button></form>
    @endif
    <ForgePagination base="{{ tool.base }}/projects/{{ projectRow.id }}" :offset="tool.board.offset" :nextOffset="tool.board.next_offset" :pageSize="tool.board.page_size" :query="{ q: tool.search, state: tool.state, view: tool.listView ? 'list' : 'board' }" />
    @if (tool.mayManageProject)
      <details class="mt-6 p-5 panel"><summary class="font-semibold">Project settings</summary>
        <form class="grid gap-4 mt-5" method="post" action="{{ endpoint }}"><CsrfField /><input type="hidden" name="revision" value="{{ projectRow.revision }}"><label class="grid gap-2">Title<input class="field" name="title" value="{{ projectRow.title }}" maxlength="160" required></label><label class="grid gap-2">Description<textarea class="field" name="description" rows="3">{{ projectRow.description }}</textarea></label><label class="grid gap-2">Project state<select class="field" name="state"><option value="open" :selected="projectRow.state === 'open'">Open</option><option value="closed" :selected="projectRow.state === 'closed'">Closed</option></select></label><p class="text-sm muted">Closing freezes this board and keeps its issues intact. Reopen it here to continue.</p><div><button class="btn btn-primary" type="submit">Save project</button></div></form>
      </details>
    @endif
  @endif
</div>
@endsection
<style>
.project-board { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(280px, 340px); gap: 16px; overflow-x: auto; align-items: start; padding-bottom: 12px; }
.project-column { min-width: 0; }
.project-card { background: var(--surface); border: 1px solid var(--line); border-radius: 6px; overflow-wrap: anywhere; }
.project-card .btn { white-space: nowrap; }
.project-list { display: grid; gap: 20px; }
.project-list .project-cards { grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); }
@media (max-width: 640px) { .project-board { grid-auto-flow: row; grid-template-columns: minmax(0, 1fr); grid-auto-columns: auto; overflow-x: visible; } }
</style>
