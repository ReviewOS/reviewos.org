<script server>
/**
 * The review screen. The flagship of the product.
 *
 * Everything decided here comes from the tested modules in `app/Actions/Pull`:
 * the diff parser, the thread re-anchoring, the approval count, and the merge
 * blockers. The view's whole job is to read those and lay them out — no rules
 * live in this file, because rules in a template cannot be tested.
 *
 * Server-rendered on purpose. A hundred-file diff assembled in the browser is
 * where forges get slow, and it is slowest exactly when the review matters.
 */
import { repositoryForView, repositoryPath } from '../../../../functions/repo'
import { cookieJarFromHeader } from '../../../../functions/identity'
import { startsCollapsed } from '../../../../../app/Actions/Pull/manifest'
import { approvalsSatisfied, machineAccountsAmong, commitDiff, commitsOnBranch, crossFileMoves, diffTotals, loadCoverage, moveNotes, isGenerated, mergeBlockers, parseDiff, pullRequestDiff, blockedBy, buildStack, orphanMessage, orphanReason, stackSummary, refreshMergeability, renderDiffFile, highlightDiffFile, loadReviewThreads, anchorThreads, threadSlotFor, branchExists, checksPanel, annotationsByLine, annotationsForLine, renderAnnotations } from '../../../../functions/review'
import { renderMarkdownHighlighted } from '../../../../functions/markdown'

const owner = String(params.owner)
const repositoryName = String(params.repository)
const number = Number(params.number)

/*
 * Which tab, from the query string - read from both serving pipelines,
 * because they disagree here the way they do about cookies. The frontend
 * server answers through `useRoute()`, and a bare `query` there is the
 * documented silent failure that renders the page as not-found. A
 * `route.serve()` boot is the mirror image: `useRoute()` has no context and
 * answers empty, and `query` is a real binding carrying the parsed search.
 * The `typeof` guard is what makes naming it safe on the pipeline where it
 * does not exist.
 */
const routeQuery: Record<string, string> = useRoute().query ?? {}
const boundQuery: Record<string, string> = typeof query === 'undefined' ? {} : (query ?? {})
const search: Record<string, string> = { ...routeQuery, ...boundQuery }
const tab = ['conversation', 'commits', 'checks', 'files'].includes(String(search.tab ?? ''))
  ? String(search.tab)
  : 'conversation'

/*
 * The files tab's two modes: one file at a time, or one commit at a time.
 * Both are URLs, so a reader's place survives a reload and can be sent to
 * somebody. Mutually exclusive, file winning: a URL carrying both is asking
 * two questions, and answering one is better than a blank stare.
 */
const fileMode = tab === 'files' ? String(search.file ?? '') : ''
const commitMode = tab === 'files' && !fileMode ? String(search.commit ?? '') : ''

// Every body on this page is rendered against the same repository, so `#12`
// means the same thing in a description as it does in a review comment.
const markdownContext = { owner, repository: repositoryName }

// Resolved and permission-checked together. A repository the reader may not
// see comes back null, exactly as a repository that does not exist does, so a
// private one does not announce itself by answering differently.
/**
 * The request, when there is one, without naming a binding that may not exist.
 *
 * stx declares `__stxServeContext` on the path that serves a request and on no
 * other, and an *undeclared* identifier is a ReferenceError - which optional
 * chaining does not save, because `x?.y` throws on `x` before the chain is
 * reached. It throws inside the server script's IIFE, so it takes every other
 * variable in this file down with it and the page renders its not-found branch
 * as though the answer were no.
 *
 * The globalThis mirror is not the fix: it is shared between concurrent
 * requests, so reading cookies off it could hand one reader another reader's
 * session.
 */
const serveContext = __stxServeContext

/*
 * Two pipelines serve this page and they disagree about what a request looks
 * like. The frontend server hands views `__stxServeContext` with the cookies
 * already parsed; a `route.serve()` boot - production, the e2e suite - hands
 * them the raw headers instead and no serve context at all. Ask whichever
 * arrived: a page that only reads the jar renders every reader on the other
 * pipeline as a stranger, which is how `currentUser` never looking at a
 * cookie shipped, and this is the same lesson one layer up.
 */
const headerBag = typeof headers === 'undefined' ? undefined : headers
const viewerCookies = serveContext?.cookies ?? cookieJarFromHeader(headerBag?.cookie)

const access = await repositoryForView(owner, repositoryName, viewerCookies)
const repoRow: any = access?.repository ?? null

const pullRequest = repoRow
  ? await db
      .selectFrom('pull_requests')
      .selectAll()
      .where('repository_id', '=', Number(repoRow.id))
      .where('number', '=', number)
      .executeTakeFirst()
  : undefined

/**
 * The author's name to show.
 *
 * A local user when there is one, and the upstream login when there is not.
 * Mirrored pull requests are the common case for the second: their author is
 * whoever opened it on the other host, who usually has no account here.
 */
const localAuthor = pullRequest && pullRequest.author_id
  ? await db.selectFrom('users').select(['handle', 'machine_for_organization_id']).where('id', '=', Number(pullRequest.author_id)).executeTakeFirst()
  : undefined

const authorName = localAuthor?.handle ?? (pullRequest?.external_author ? String(pullRequest.external_author) : null)

/**
 * Whether the author is a machine account.
 *
 * Said plainly on the page, and not to shame it. A reader's standard for
 * "somebody looked at this" depends on who looked, and an agent's pull request
 * that is indistinguishable from a colleague's borrows a trust it has not
 * earned yet. The label is the cheapest possible way to stop that, and it costs
 * one column on a query that was already running.
 */
const authorIsMachine = Boolean(localAuthor?.machine_for_organization_id)

const reviews = pullRequest
  ? await db
      .selectFrom('pull_request_reviews')
      .select(['id', 'reviewer_id', 'state', 'commit_sha', 'body', 'submitted_at'])
      .where('pull_request_id', '=', Number(pullRequest.id))
      .orderBy('id', 'asc')
      .execute()
  : []

/**
 * The review threads, loaded once and rendered with the diff.
 *
 * The query and the re-anchoring both live in `app/Actions/Pull/loadThreads.ts`
 * now, because the streamed review screen needs exactly the same two and a
 * second copy would have drifted from this one.
 */
/** Where this repository is on disk, for carrying threads onto the head. */
const onDisk = repositoryPath(owner, repositoryName)

const storedThreads = pullRequest
  ? await loadReviewThreads({
      pullRequestId: Number(pullRequest.id),
      renderBody: (body: string) => renderMarkdownHighlighted(body, markdownContext),
      // The same carrying the streamed screen does, so a thread does not sit on
      // one line here and another there.
      trackTo: onDisk.ok && onDisk.path
        ? { diskPath: onDisk.path, headSha: String(pullRequest.head_sha) }
        : undefined,
    })
  : []

/**
 * The diff, from the merge base rather than the base tip.
 *
 * Against the tip, a reviewer is shown every change somebody else landed on the
 * base while this branch was open, and asked to approve them too.
 */
const raw = pullRequest
  ? await pullRequestDiff(owner, repositoryName, String(pullRequest.base_sha), String(pullRequest.head_sha))
  : ''
const files = parseDiff(raw)
const totals = diffTotals(files)

/*
 * Blocks that moved between files, found over the whole diff - which this
 * page is the one place to hold. Each end of a move gets a sentence on its
 * hunk separator: the same lines, named on both ends, instead of a hundred
 * deletions here and a hundred additions there.
 */
const crossMoves = crossFileMoves(files)
const crossNotes = moveNotes(crossMoves)

/*
 * Coverage for the head commit, when CI has said anything. Guarded to
 * nothing on any failure: a throw here would blank the whole page, and no
 * report must render as no markers, never as "covered".
 */
let coverageByPath: Map<string, Set<number>> = new Map()
try {
  if (pullRequest)
    coverageByPath = await loadCoverage(Number(repoRow.id), String(pullRequest.head_sha))
}
catch {
  coverageByPath = new Map()
}

const protection = repoRow && pullRequest
  ? await db
      .selectFrom('protected_branches')
      .selectAll()
      .where('repository_id', '=', Number(repoRow.id))
      .where('pattern', '=', pullRequest.base_branch)
      .executeTakeFirst()
  : undefined

let requiredChecks: string[] = []
try {
  const parsed = JSON.parse(String(protection?.required_checks ?? '[]'))
  if (Array.isArray(parsed))
    requiredChecks = parsed.map(String)
}
catch {
  requiredChecks = []
}

/*
 * Every check on this head, and what each of them found.
 *
 * One read for two places: the checks tab lists them, and the diff hangs the
 * annotations on the lines they are about. An annotation shown only in a log is
 * a link nobody clicks - the tool already said which file and which lines, so
 * it belongs where the reviewer is looking.
 *
 * Guarded to an empty panel on any failure, for the reason the coverage read
 * above is: a throw in this script renders the whole page with every binding
 * undefined, and a review screen that vanishes because CI reported oddly is a
 * worse outcome than one with no checks section.
 */
let checks: any = null
try {
  if (pullRequest && repoRow) {
    checks = await checksPanel({
      repositoryId: Number(repoRow.id),
      headSha: String(pullRequest.head_sha),
      required: requiredChecks,
    })
  }
}
catch {
  checks = null
}

// Keyed by file, side and line, so a row does not scan the whole list.
const annotationIndex = annotationsByLine(checks?.annotations ?? [])
const annotatedPaths = new Set((checks?.annotations ?? []).map((one: any) => String(one.path)))

/*
 * The rollup, as a sentence and a colour.
 *
 * Built here rather than in the template: an expression in a branch that throws
 * takes the whole block into an HTML comment nobody reads, and the interesting
 * case - no checks at all - is the one a template is most likely to get wrong.
 *
 * Neutral, not green. A commit nothing has looked at is the state a
 * misconfigured CI leaves every commit in, and rendering it the same as one
 * that passed is how nobody notices for a month.
 */
const checkEntries = checks?.entries ?? []
const checksState = String(checks?.state ?? 'neutral')

const checksTone = checksState === 'success'
  ? 'good'
  : checksState === 'failure' ? 'bad' : checksState === 'pending' ? 'warn' : 'muted'

const checksHeadline = checksState === 'success'
  ? 'Every check passed'
  : checksState === 'failure'
    ? `${checks?.counts?.failure ?? 0} of ${checkEntries.length} failed`
    : checksState === 'pending'
      ? `${checks?.counts?.pending ?? 0} still running`
      : 'Nothing has reported on this commit'

/*
 * Syntax highlighting, per file, keyed by side and line number.
 *
 * Done here rather than in the component so each file is tokenized once for
 * the whole page, and so a hundred-file diff does not re-enter the highlighter
 * per rendered row. A file the highlighter declines simply renders plain.
 */
/**
 * Each file's diff, rendered.
 *
 * The same call the streamed review screen makes, so the two cannot disagree
 * about what a diff looks like. Rendered here rather than in a component
 * because a component imports nothing of its own: a helper called inside one
 * comes back undefined and the `@foreach` over it fails into an HTML comment
 * that nobody reads.
 */
const threadsByPath: Record<string, any[]> = {}
const diffHtmlByPath: Record<string, string> = {}

// Threads were written against an earlier commit. Follow each one through the
// diff so it sits on the line it is about now, or is marked outdated.
const threads = anchorThreads(storedThreads, files)

// Render each file once, with its tokens and the threads that belong in it.
// Serially rather than in parallel: highlighting is CPU-bound, so racing every
// file only shortens the time before the event loop is saturated.
//
// Only on the files tab. The parse above runs everywhere - the totals and the
// thread count are in the header and sidebar of every tab - but highlighting
// and rendering a hundred files to answer a conversation-tab request would be
// paying the page's whole cost to show a description.
if (tab === 'files' && !commitMode) {
  for (const file of files) {
    // Single-file mode renders exactly one; everything else about the page -
    // totals, thread counts, the file list - still reads the whole parse,
    // because the mode changes what is on screen, not what the pull request
    // is. The saving is the expensive half: highlighting and rendering.
    if (fileMode && file.path !== fileMode)
      continue

    const fileThreads = threads.filter((thread: any) => thread.path === file.path)
    threadsByPath[file.path] = fileThreads

    diffHtmlByPath[file.path] = renderDiffFile(file, {
      expandable: true,
      tokens: await highlightDiffFile(file),
      // `fold` rather than the streamed viewer's `fetch`: the diff on this page
      // runs no client script, so nothing is going to ask for the rows of a
      // folded file and a header on its own would be a file nobody can ever
      // read. The one script the page carries belongs to the suggested-reviewers
      // panel and touches nothing in the diff. A single file is never folded:
      // the reader asked for this one by name.
      collapsed: fileMode ? false : (startsCollapsed(file) ? 'fold' : false),
      // Mechanical hunks of mixed files fold as closed details, each saying
      // what it hides. The renderer only applies it where the classifier is
      // confident; everything else renders exactly as before.
      hunkFolds: 'details',
      hunkNotes: crossNotes.get(files.indexOf(file)),
      uncoveredLines: coverageByPath.get(file.path),
      // A check's findings, on the lines they name. Skipped entirely for a file
      // nothing reported about, so the common case pays for one set lookup
      // rather than a closure per line.
      annotationsAt: annotatedPaths.has(file.path)
        ? (line: any) => renderAnnotations(annotationsForLine(annotationIndex, file.path, line))
        : undefined,
      threadsAt: threadSlotFor(fileThreads, file.path),
    })
  }
}

/*
 * Single-file navigation: where this file sits, and its neighbours.
 */
const filePaths = files.map((file: any) => String(file.path))
const fileIndex = fileMode ? filePaths.indexOf(fileMode) : -1
const previousFile = fileIndex > 0 ? filePaths[fileIndex - 1] : null
const nextFile = fileIndex >= 0 && fileIndex < filePaths.length - 1 ? filePaths[fileIndex + 1] : null

// URLs built here, not in the template: an interpolation that throws - and a
// helper the template scope does not carry, like encodeURIComponent, throws -
// swallows its whole block into an HTML comment nobody reads.
const previousFileUrl = previousFile ? `?tab=files&file=${encodeURIComponent(previousFile)}` : null
const nextFileUrl = nextFile ? `?tab=files&file=${encodeURIComponent(nextFile)}` : null

/*
 * Commit-by-commit review: one commit's own diff against its first parent,
 * threads deliberately absent. A thread's line and side are positions in the
 * base...head diff; painting them into a mid-branch commit's diff would put
 * comments on lines they were never about - the reanchor lesson, avoided by
 * not asking.
 *
 * Membership on the branch is the safety gate, not just sha syntax: without
 * it this page would render any reachable commit's diff under a pull
 * request's framing.
 */
const modeCommits = (commitMode || tab === 'commits') && pullRequest
  ? await commitsOnBranch(owner, repositoryName, String(pullRequest.base_sha), String(pullRequest.head_sha))
  : []

const commitIndex = commitMode ? modeCommits.findIndex((entry: any) => entry.sha === commitMode) : -1
const currentCommit = commitIndex >= 0 ? modeCommits[commitIndex] : null
const previousCommit = commitIndex > 0 ? modeCommits[commitIndex - 1] : null
const nextCommit = commitIndex >= 0 && commitIndex < modeCommits.length - 1 ? modeCommits[commitIndex + 1] : null

const commitFiles = currentCommit
  ? parseDiff(await commitDiff(owner, repositoryName, currentCommit.sha))
  : []

const commitHtml: string[] = []
for (const file of commitFiles) {
  commitHtml.push(renderDiffFile(file, {
    expandable: true,
    tokens: await highlightDiffFile(file),
    collapsed: false,
  }))
}

/*
 * Flat flags for the template. Deeply nested @if/@else inside the files tab
 * swallowed whole blocks - siblings of an inner branch simply did not render
 * - so each region tests exactly one boolean at one level.
 */
const showCommitMissing = Boolean(tab === 'files' && commitMode && !currentCommit)
const showCommitDiff = Boolean(tab === 'files' && commitMode && currentCommit)
const showFileMissing = Boolean(tab === 'files' && !commitMode && fileMode && fileIndex === -1)
const showFileBar = Boolean(tab === 'files' && !commitMode && fileMode && fileIndex >= 0)
const showWholeFiles = Boolean(tab === 'files' && !commitMode)

/*
 * The branch's commits: loaded above for the tabs and modes that ask, and a
 * `git log` nobody on another tab pays for.
 */
const branchCommits = modeCommits

const descriptionHtml = pullRequest?.body
  ? await renderMarkdownHighlighted(String(pullRequest.body), markdownContext)
  : ''

/*
 * The branch rule's verdict, from the panel loaded above rather than from a
 * second pair of queries.
 *
 * It is computed there with `requirementsSatisfied` over both reporting APIs,
 * which is exactly what the merge endpoint does - the page and the button have
 * to agree about whether something is ready, and this is the disagreement that
 * matters most because the page is where somebody decides to press it.
 *
 * The fallback is deliberately *not satisfied*: if the panel failed to load,
 * this page knows nothing about the checks, and "nothing is known" must not
 * render as "everything passed".
 */
const checkResult = checks?.required
  ?? (requiredChecks.length === 0
    ? { satisfied: true, failing: [], pending: [], missing: [] }
    : { satisfied: false, failing: [], pending: [], missing: requiredChecks })

/*
 * Which reviewers are machine accounts.
 *
 * Needed twice below: the count this page shows must agree with the count the
 * merge endpoint computes, and the summary strip labels them. Computing it once
 * here is what keeps the page and the endpoint from disagreeing about whether
 * something is ready - the worst possible disagreement, because the page is
 * where somebody decides to press the button.
 */
const machineReviewers = await machineAccountsAmong(reviews.map((review: any) => Number(review.reviewer_id)))

const approval = approvalsSatisfied({
  reviews: reviews.map((review: any) => ({
    reviewerId: Number(review.reviewer_id),
    state: String(review.state),
    commitSha: review.commit_sha as string | null,
    machine: machineReviewers.has(Number(review.reviewer_id)),
  })),
  headSha: pullRequest ? (pullRequest.head_sha as string | null) : null,
  requiredApprovals: Number(protection?.required_approvals ?? 0),
  dismissStaleReviews: Boolean(protection?.dismiss_stale_reviews),
  countMachineApprovals: Boolean(repoRow?.count_machine_approvals),
})

const unresolvedThreads = threads.filter((thread: any) => !thread.resolved).length

/*
 * Mergeability, cached against the two commits it was computed from.
 *
 * The roadmap wants this computed in the background; it is computed here for
 * now, and the cache is what makes that acceptable: the answer is recomputed
 * only when one of the branches has moved, so a hundred people opening this
 * page cost one merge between them rather than a hundred. Nothing here can move
 * a ref, because `git merge-tree` merges in memory.
 */
const mergeability = pullRequest
  ? await refreshMergeability(owner, repositoryName, {
      id: Number(pullRequest.id),
      base_sha: String(pullRequest.base_sha),
      head_sha: String(pullRequest.head_sha),
      mergeable_state: pullRequest.mergeable_state as string | null,
      mergeable_base_sha: pullRequest.mergeable_base_sha as string | null,
      mergeable_head_sha: pullRequest.mergeable_head_sha as string | null,
      mergeable_conflicts: pullRequest.mergeable_conflicts as string | null,
    })
  : { state: 'unknown' as const, treeSha: null, conflictingPaths: [], recomputed: false }

const blockers = pullRequest
  ? mergeBlockers(
      {
        state: pullRequest.state as 'open' | 'closed' | 'merged',
        draft: Boolean(pullRequest.draft),
        mergeable: mergeability.state === 'clean'
          ? true
          : (mergeability.state === 'unknown' ? null : false),
        stackParent: null,
      },
      {
        requiredApprovals: Number(protection?.required_approvals ?? 0),
        requireThreadsResolved: Boolean(protection?.require_conversation_resolution),
        requireLinearHistory: Boolean(protection?.require_linear_history),
        allowedStrategies: ['merge', 'squash', 'rebase'],
        requiredChecks,
      },
      {
        approvals: approval.approvals,
        blockingReviews: approval.blocking,
        unresolvedThreads,
        checks: checkResult,
      },
      'merge',
    )
  : []

/*
 * The stack this pull request belongs to.
 *
 * Loaded for the whole repository in one query rather than by walking parent
 * links a level at a time: a stack is small, and a round trip per level is the
 * shape that makes a deep stack slow to open.
 */
const stackRows = pullRequest
  ? await db
      .selectFrom('pull_requests')
      .select(['id', 'number', 'title', 'state', 'head_branch', 'base_branch', 'stack_parent_id', 'draft'])
      .where('repository_id', '=', Number(repoRow.id))
      .execute()
  : []

const stackMembers = stackRows.map((row: any) => ({
  id: Number(row.id),
  number: Number(row.number),
  title: String(row.title),
  state: String(row.state),
  headBranch: String(row.head_branch),
  baseBranch: String(row.base_branch),
  stackParentId: row.stack_parent_id ? Number(row.stack_parent_id) : null,
  draft: Boolean(row.draft),
}))

const currentMember = pullRequest ? stackMembers.find((entry: any) => entry.id === Number(pullRequest.id)) : undefined
const stack = currentMember ? buildStack(stackMembers, currentMember.id) : []
const stackText = stackSummary(stack)
const stackOrphan = currentMember ? orphanMessage(orphanReason(currentMember, stackMembers)) : null

/*
 * Only this pull request's own blockers are known here, so the rest of the
 * stack is judged on what can be checked cheaply. A member whose readiness is
 * unknown counts as not ready, which errs toward saying "waiting on" rather
 * than promising a merge that would then be refused.
 */
const stackReadiness = stack.map((entry: any) => ({
  id: entry.id,
  blockers: currentMember && entry.id === currentMember.id ? blockers : (entry.state === 'open' && !entry.draft ? [] : ['not ready']),
}))

const stackBlocker = currentMember ? blockedBy(stack, currentMember.id, stackReadiness) : null

/*
 * The suggested-reviewers panel is offered, not filled: the endpoint behind it
 * costs a `git log` over the changed paths, so the page hands the component a
 * URL and the component asks only when the reader opens it. Built here because
 * the page knows how a pull request is addressed and the component should not.
 *
 * Offered to signed-in readers who may review, on open pull requests only: an
 * anonymous reader cannot ask anybody for a review, and a suggestion on a
 * merged or closed pull request is dead weight. The endpoint answers public
 * repositories more loosely than this gate implies - keying the gate on
 * `can('pull:review')` keeps the two aligned if that ability's rung ever moves.
 *
 * Nothing here can throw: both lines only string-format values already loaded,
 * and in this file that property is load-bearing - a server script that throws
 * renders the page as not found.
 */
const suggestUrl = `/api/repos/pulls/suggested-reviewers?owner=${encodeURIComponent(owner)}&repo=${encodeURIComponent(repositoryName)}&number=${number}`

/** A signed-in reader who may review, on a pull request that is still asking. */
const viewerMayReview = Boolean(pullRequest && pullRequest.state === 'open' && access?.viewer && access.can('pull:review'))
const offerSuggestions = viewerMayReview

/*
 * Auto-merge, in the merge box. Armed is a fact about the pull request shown
 * to everybody; the arm and disarm forms are for people who could press the
 * merge button themselves, because arming is scheduling exactly that press.
 */
const autoMergeArmed = pullRequest?.auto_merge_strategy ? String(pullRequest.auto_merge_strategy) : null
const autoMergeArmedBy = pullRequest?.auto_merge_by_id
  ? await db.selectFrom('users').select(['handle']).where('id', '=', Number(pullRequest.auto_merge_by_id)).executeTakeFirst()
  : undefined
const viewerMayMerge = Boolean(pullRequest && pullRequest.state === 'open' && access?.viewer && access.can('pull:merge'))

/*
 * Offer to put a deleted head branch back, on merged pull requests only.
 * `branchExists` is one rev-parse and never throws, and it only runs for the
 * merged case, so the open pull request - the page's hot path - pays nothing.
 * Gated on `repository:push` because the button creates a branch, and the
 * endpoint checks the same ability.
 */
const offerRestore = Boolean(
  pullRequest
  && pullRequest.state === 'merged'
  && pullRequest.head_branch
  && pullRequest.head_sha
  && access?.viewer
  && access.can('repository:push')
  && onDisk.ok
  && onDisk.path
  && !(await branchExists(onDisk.path, String(pullRequest.head_branch))),
)

const title = pullRequest
  ? `${pullRequest.title} by ${authorName ?? 'someone'} · ${owner}/${repositoryName} #${number}`
  : 'Pull request not found'

const stateLabel = pullRequest
  ? (pullRequest.state === 'merged' ? 'Merged' : (pullRequest.state === 'closed' ? 'Closed' : (pullRequest.draft ? 'Draft' : 'Open')))
  : ''

/*
 * Shapes for the components, built here because a component parses its own
 * JSON and should be handed exactly what it renders - the page knows the
 * rows, the component knows the markup.
 */
const reviewSummaries = reviews.map((review: any) => ({
  state: String(review.state),
  stale: pullRequest ? review.commit_sha !== pullRequest.head_sha : false,
  // Labelled in the strip for the same reason the author is labelled in the
  // header: an approval from an agent and one from a colleague are not the
  // same evidence, and a reader cannot weigh them if they look identical.
  machine: machineReviewers.has(Number(review.reviewer_id)),
}))

const fileSummaries = files.map((file: any) => ({
  path: String(file.path),
  additions: Number(file.additions ?? 0),
  deletions: Number(file.deletions ?? 0),
}))

const statePill = pullRequest
  ? (pullRequest.state === 'merged' ? 'merged' : (pullRequest.state === 'closed' ? 'closed' : (pullRequest.draft ? 'draft' : 'open')))
  : 'draft'
</script>

@layout('app')

@section('content')
  <div class="shell" style="padding-top: 22px; padding-bottom: 64px;">
    @if (!pullRequest)
      <div class="panel" style="padding: 32px; text-align: center;">
        <h1 style="font-size: 20px;">No such pull request</h1>
        <p class="muted" style="margin-top: 6px;">
          {{ owner }}/{{ repositoryName }} has no pull request numbered {{ number }}.
        </p>
      </div>
    @else
      {{--
        What changed while you were reading this, and who else is here.

        Above the header on purpose: it is the one thing on the page that can
        make everything below it wrong, and a banner under a diff is one nobody
        scrolls back up to find.
      --}}
      <LiveBanner owner="{{ owner }}" repository="{{ repositoryName }}" number="{{ number }}" />

      <PullRequestHeader
        title="{{ pullRequest.title }}"
        number="{{ number }}"
        statePill="{{ statePill }}"
        stateLabel="{{ stateLabel }}"
        authorName="{{ authorName ?? 'someone' }}"
        :authorIsMachine="authorIsMachine"
        headBranch="{{ pullRequest.head_branch }}"
        baseBranch="{{ pullRequest.base_branch }}"
        fileCount="{{ totals.files }}"
        additions="{{ totals.additions }}"
        deletions="{{ totals.deletions }}"
        tab="{{ tab }}"
        owner="{{ owner }}"
        repository="{{ repositoryName }}"
      />

      <div class="pr-body">
        <div class="pr-main" id="files">
          @if (tab === 'conversation')
            @if (descriptionHtml)
              <section class="pr-description markdown panel">{!! descriptionHtml !!}</section>
            @else
              <p class="muted" style="padding: 24px 0;">No description was written.</p>
            @endif

            <p class="muted side-note">
              {{ totals.files }} changed {{ totals.files === 1 ? 'file' : 'files' }} on the
              <a href="?tab=files">files tab</a>, with {{ threads.length }}
              review {{ threads.length === 1 ? 'thread' : 'threads' }}.
            </p>
          @endif

          @if (tab === 'commits')
            @if (branchCommits.length === 0)
              <p class="muted" style="padding: 24px 0;">This branch carries no commits of its own.</p>
            @else
              {{-- Oldest first: a branch whose history was written to be read
                  is read in the order it was written. --}}
              <ul class="pr-commits">
                @foreach (branchCommits as commit)
                  <li class="pr-commit">
                    <a class="mono" href="/{{ owner }}/{{ repositoryName }}/commit/{{ commit.sha }}">{{ commit.sha.slice(0, 10) }}</a>
                    <span class="pr-commit-subject">{{ commit.subject }}</span>
                    <span class="muted">{{ commit.author }}</span>
                    <a class="muted" href="?tab=files&commit={{ commit.sha }}">review this step</a>
                  </li>
                @endforeach
              </ul>
            @endif
          @endif

          @if (tab === 'checks')
            <section class="panel" style="padding: 15px 17px;">
              <h2 class="side-heading">Checks</h2>

              {{-- The rollup, said in a sentence. "No checks" is its own answer
                  and not a green one: a commit nothing has looked at is the
                  state a misconfigured CI leaves every commit in, and it must
                  not read the same as one that passed. --}}
              <p class="checks-rollup checks-{{ checksTone }}">
                <span class="run-dot run-{{ checksTone }}" aria-hidden="true"></span>
                {{ checksHeadline }}
              </p>

              @if (checkEntries.length === 0)
                <p class="muted side-empty">Nothing has reported on this commit.</p>
              @else
                <ul class="checks-detail">
                  @foreach (checkEntries as entry)
                    <li class="checks-entry">
                      <div class="checks-entry-head">
                        <span class="run-dot run-{{ entry.tone }}" aria-hidden="true"></span>
                        <span class="checks-name">{{ entry.name }}</span>
                        @if (entry.required)
                          <span class="checks-badge">Required</span>
                        @endif
                        <span class="muted checks-state">{{ entry.label }}</span>
                      </div>

                      <p class="muted checks-meta">
                        @if (entry.duration)
                          <span>{{ entry.duration }}</span>
                        @endif
                        @if (entry.attempt > 1)
                          <span>attempt {{ entry.attempt }}</span>
                        @endif
                        @if (entry.stale)
                          <span class="mono">{{ entry.staleSha.slice(0, 10) }}</span>
                        @endif
                        @if (entry.annotationCount > 0)
                          <a href="?tab=files">{{ entry.annotationCount }} annotation@if (entry.annotationCount !== 1)s@endif in the diff</a>
                        @endif
                        @if (entry.detailsUrl)
                          <a href="{{ entry.detailsUrl }}" rel="noreferrer nofollow noopener">Details</a>
                        @endif
                      </p>

                      @if (entry.summary)
                        <p class="checks-summary">{{ entry.summary }}</p>
                      @endif
                    </li>
                  @endforeach
                </ul>
              @endif

              @if (requiredChecks.length === 0)
                <p class="muted checks-note">No checks are required on this branch, so none of this blocks a merge.</p>
              @endif
            </section>
          @endif

          {{-- The files tab's regions, each behind one flat flag: nesting
              @if/@else here swallowed whole sibling blocks, so every branch
              tests one precomputed boolean at one level. --}}

          @if (showCommitMissing)
            <p class="muted" style="padding: 24px 0;">
              That commit is not on this branch.
              <a href="?tab=files">Back to the whole diff.</a>
            </p>
          @endif

          @if (showCommitDiff)
            <nav class="mode-bar panel" aria-label="Commit navigation">
              <span class="muted">
                Commit {{ commitIndex + 1 }} of {{ modeCommits.length }}:
                <span class="mono">{{ currentCommit.sha.slice(0, 10) }}</span>
                {{ currentCommit.subject }}
              </span>
              <span class="mode-links">
                @if (previousCommit)
                  <a href="?tab=files&commit={{ previousCommit.sha }}">previous</a>
                @endif
                @if (nextCommit)
                  <a href="?tab=files&commit={{ nextCommit.sha }}">next</a>
                @endif
                <a href="?tab=files">whole branch</a>
              </span>
            </nav>

            <p class="muted side-note">
              Review threads live on the whole diff, not on one commit, so
              none are shown here - a thread's line means something in the
              branch's final form, and painting it into an intermediate
              step would put it on code it is not about.
            </p>

            @foreach (commitHtml as html)
              {!! html !!}
            @endforeach
          @endif

          @if (showFileMissing)
            <p class="muted" style="padding: 24px 0;">
              This diff has no file called <span class="mono">{{ fileMode }}</span>.
              <a href="?tab=files">Back to the whole diff.</a>
            </p>
          @endif

          @if (showFileBar)
            {{-- One file at a time: the mode for the reviewer working a
                long diff to completion rather than scrolling it. --}}
            <nav class="mode-bar panel" aria-label="File navigation">
              <span class="muted">File {{ fileIndex + 1 }} of {{ filePaths.length }}</span>
              <span class="mode-links">
                @if (previousFileUrl)
                  <a href="{{ previousFileUrl }}">previous</a>
                @endif
                @if (nextFileUrl)
                  <a href="{{ nextFileUrl }}">next</a>
                @endif
                <a href="?tab=files">all files</a>
              </span>
            </nav>
          @endif

          @if (showWholeFiles)
            @if (files.length === 0)
              <p class="muted" style="padding: 24px 0;">
                This branch has no changes against
                <span class="mono">{{ pullRequest.base_branch }}</span>.
              </p>
            @endif

            {{--
              The markup comes from `app/Actions/Pull/rows.ts`, which is what the
              streamed review screen renders too. It used to be a component here
              and a string builder there, and two renderers producing nearly the
              same rows is how a diff ends up looking one way on this page and
              another on the screen built for reading it.
            --}}
            @foreach (files as file)
              {!! diffHtmlByPath[file.path] ?? '' !!}
            @endforeach
          @endif
        </div>

        <aside class="pr-side">
          {{-- The changed files as links, on the tab where the diff is. --}}
          @if (tab === 'files')
            <FileTreeSidebar filesJson="{{ JSON.stringify(fileSummaries) }}" />
          @endif

          <StackNav
            stackJson="{{ JSON.stringify(stack) }}"
            currentId="{{ currentMember ? currentMember.id : 0 }}"
            summary="{{ stackText }}"
            orphan="{{ stackOrphan }}"
            blockerJson="{{ JSON.stringify(stackBlocker) }}"
            owner="{{ owner }}"
            repository="{{ repositoryName }}"
          />




          <MergeBox
            owner="{{ owner }}"
            repository="{{ repositoryName }}"
            number="{{ number }}"
            blockersJson="{{ JSON.stringify(blockers) }}"
            conflictsJson="{{ JSON.stringify(mergeability.conflictingPaths) }}"
            autoStrategy="{{ autoMergeArmed ?? '' }}"
            autoArmedBy="{{ autoMergeArmedBy?.handle ?? '' }}"
            mayMerge="{{ viewerMayMerge ? '1' : '' }}"
          />

          {{-- Who should look, above who has looked. Hidden rather than empty
              for readers who cannot ask anybody: see the gate in the script. --}}
          @if (offerSuggestions)
            <SuggestedReviewers url="{{ suggestUrl }}" />
          @endif

          {{-- The branch the merge deleted, offered back. The endpoint's
              create is guarded, so a branch that reappeared under the old
              name is refused rather than overwritten. --}}
          @if (offerRestore)
            <section class="panel side-panel">
              <h2 class="side-heading">Head branch</h2>
              <p class="muted side-note">
                <span class="mono">{{ pullRequest.head_branch }}</span> was deleted after the merge.
              </p>
              <form method="post" action="/api/repos/pulls/restore-branch">
                <CsrfField />
                <input type="hidden" name="owner" value="{{ owner }}">
                <input type="hidden" name="repo" value="{{ repositoryName }}">
                <input type="hidden" name="number" value="{{ number }}">
                <button type="submit" class="btn merge-button">Restore branch</button>
              </form>
            </section>
          @endif

          <ReviewPanel
            owner="{{ owner }}"
            repository="{{ repositoryName }}"
            number="{{ number }}"
            reviewsJson="{{ JSON.stringify(reviewSummaries) }}"
            approvals="{{ approval.approvals }}"
            required="{{ protection?.required_approvals ?? 0 }}"
            uncounted="{{ approval.uncounted }}"
            mayReview="{{ viewerMayReview ? '1' : '' }}"
          />

          <section class="panel side-panel" id="checks">
            <h2 class="side-heading">Checks</h2>
            @if (requiredChecks.length === 0)
              <p class="muted side-empty">No checks are required on this branch.</p>
            @else
              <ul class="check-list">
                @foreach (checkResult.failing as name)
                  <li class="bad check"><span class="i-hugeicons-cancel-01" aria-hidden="true"></span>{{ name }}</li>
                @endforeach
                @foreach (checkResult.pending as name)
                  <li class="check warn"><span class="i-hugeicons-time-quarter" aria-hidden="true"></span>{{ name }}</li>
                @endforeach
                @foreach (checkResult.missing as name)
                  <li class="check warn"><span class="i-hugeicons-help-circle" aria-hidden="true"></span>{{ name }} has never reported</li>
                @endforeach
                @if (checkResult.satisfied)
                  <li class="check ok"><span class="i-hugeicons-checkmark-circle-02" aria-hidden="true"></span>All required checks passed</li>
                @endif
              </ul>
            @endif
          </section>

          <section class="panel side-panel">
            <h2 class="side-heading">Conversations</h2>
            <p class="muted side-note">
              {{ unresolvedThreads }} unresolved of {{ threads.length }}.
            </p>

            {{-- "I have read this round." The reviewer who read everything
                and had nothing to add leaves no review and ticks no file,
                and without this the incremental diff keeps offering them a
                round they already read. The endpoint records the head as it
                is then, not as this page rendered it. --}}
            @if (viewerMayReview)
              <form method="post" action="/api/repos/pulls/last-look" style="margin-top: 10px;">
                <CsrfField />
                <input type="hidden" name="owner" value="{{ owner }}">
                <input type="hidden" name="repo" value="{{ repositoryName }}">
                <input type="hidden" name="number" value="{{ number }}">
                <button type="submit" class="btn caught-up-button">Mark as caught up</button>
              </form>
            @endif
          </section>
        </aside>
      </div>
    @endif
  </div>
@endsection

<style>
  .pr-head { padding-bottom: 14px; }

  .pr-title-row { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .pr-title { font-size: 25px; }
  .pr-number { font-size: 20px; font-weight: 400; }

  .pr-meta { display: flex; align-items: center; gap: 10px; margin-top: 9px; flex-wrap: wrap; font-size: 14px; }
  .pr-counts { margin-top: 7px; font-size: 13px; display: flex; gap: 8px; }

  .pr-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 296px;
    gap: 22px;
    margin-top: 20px;
    align-items: start;
  }

  @media (max-width: 1040px) {
    .pr-body { grid-template-columns: minmax(0, 1fr); }
    .pr-side { order: -1; }
  }

  .pr-main { min-width: 0; }

  .pr-description {
    padding: 15px 17px;
    margin-bottom: 16px;
    font-size: 14.5px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .pr-side { display: flex; flex-direction: column; gap: 14px; position: sticky; top: 72px; }

  .side-heading {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted);
    font-weight: 600;
  }

  .merge-box, .side-panel { padding: 15px 17px; }
  .side-empty, .side-note { margin-top: 8px; font-size: 13.5px; }

  .merge-state { margin-top: 9px; font-size: 14.5px; font-weight: 500; }
  .merge-state.ok { color: var(--ok); }
  .merge-state.bad { color: var(--bad); }

  .blockers { margin-top: 10px; display: flex; flex-direction: column; gap: 7px; }
  .conflict-heading { margin-top: 12px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
  .conflict-list { margin-top: 5px; display: flex; flex-direction: column; gap: 3px; font-size: 13px; word-break: break-all; }

  .blocker {
    display: flex;
    gap: 8px;
    align-items: start;
    font-size: 13.5px;
    color: var(--muted);
  }

  .blocker span { color: var(--bad); flex: none; margin-top: 3px; }

  .select {
    width: 100%;
    height: 34px;
    margin-top: 11px;
    padding: 0 10px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-control);
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 14px;
  }

  .merge-button { width: 100%; justify-content: center; margin-top: 9px; }
  .caught-up-button { width: 100%; justify-content: center; font-size: 13px; }

  .review-list, .check-list { margin-top: 9px; display: flex; flex-direction: column; gap: 7px; }
  .review-item { display: flex; align-items: center; gap: 8px; }
  .review-stale { font-size: 12.5px; }
  /* On its own line: it explains the count above it, and inline it reads as
     part of the sentence rather than as the reason for it. */
  .review-uncounted { display: block; margin-top: 3px; font-size: 12.5px; }

  .check { display: flex; gap: 8px; align-items: center; font-size: 13.5px; }
  .check.ok span { color: var(--ok); }
  .check.bad span { color: var(--bad); }
  .check.warn span { color: var(--warn); }

  /* The checks tab. The dot vocabulary is the run screen's, deliberately: a
     reader who has learned what a colour means on one CI screen should not
     have to learn it again on the other. */
  .run-dot { width: 9px; height: 9px; border-radius: 999px; flex: none; background: var(--muted); display: inline-block; }
  .run-good { background: var(--ok); }
  .run-bad { background: var(--bad); }
  .run-warn { background: var(--warn); }

  .checks-rollup { display: flex; align-items: center; gap: 8px; margin: 10px 0 0; font-size: 14px; font-weight: 600; }
  .checks-detail { margin-top: 12px; display: flex; flex-direction: column; gap: 12px; }
  .checks-entry { padding-top: 12px; border-top: 1px solid var(--line); }
  .checks-entry:first-child { padding-top: 0; border-top: 0; }
  .checks-entry-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .checks-name { font-weight: 600; font-size: 13.5px; }
  .checks-state { font-size: 13px; }
  .checks-badge {
    font-size: 11px;
    padding: 1px 6px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--muted);
  }
  .checks-meta { display: flex; gap: 10px; flex-wrap: wrap; font-size: 12.5px; margin: 4px 0 0 17px; }
  .checks-summary { font-size: 13px; margin: 5px 0 0 17px; }
  .checks-note { font-size: 12.5px; margin-top: 12px; }

  /* A check's findings, in the diff. Bordered on the left rather than boxed:
     it sits under a line of code, and a box there reads as a second file. */
  .annotations { display: flex; flex-direction: column; gap: 8px; padding: 8px 4px; }
  .annotation { border-left: 3px solid var(--warn); padding-left: 10px; }
  .annotation-bad { border-left-color: var(--bad); }
  .annotation-muted { border-left-color: var(--line-strong); }
  .annotation-head { display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; margin: 0; font-size: 12.5px; }
  .annotation-level { font-weight: 600; }
  .annotation-title { font-weight: 600; }
  .annotation-message { margin: 3px 0 0; font-size: 13px; white-space: pre-wrap; }

  .count-add { color: var(--ok); }
  .count-del { color: var(--bad); }

  .mode-bar {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: baseline;
    padding: 10px 14px;
    margin-bottom: 14px;
    font-size: 13.5px;
  }

  .mode-links { display: flex; gap: 12px; flex: none; }

  .pr-commits { display: flex; flex-direction: column; gap: 8px; }
  .pr-commit { display: flex; gap: 10px; align-items: baseline; font-size: 13.5px; }
  .pr-commit-subject { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
