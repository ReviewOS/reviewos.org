<script server>
/**
 * The review screen, on its own route.
 *
 * The diff already lived behind a tab on the conversation page, which meant
 * there was no way to link somebody to the thing this product is about. This is
 * that link.
 *
 * It is also where the streamed engine is used rather than the whole-page
 * render. The page arrives with a header and an empty, correctly sized scroll
 * region; the manifest fills in the file list, and rows arrive with it. Nothing
 * here parses a diff, because by the time the reader is looking at this the
 * server has already started.
 */
import { repositoryForView } from '../../../../../functions/repo'
const owner = String(params.owner)
const repositoryName = String(params.repository)
const number = Number(params.number)

// Resolved and permission-checked together. A repository the reader may not
// see comes back null, exactly as a repository that does not exist does, so a
// private one does not announce itself by answering differently.
const access = await repositoryForView(owner, repositoryName, __stxServeContext?.cookies)
const repoRow: any = access?.repository ?? null

const pullRequest: any = repoRow
  ? await db
      .selectFrom('pull_requests')
      .selectAll()
      .where('repository_id', '=', Number(repoRow.id))
      .where('number', '=', number)
      .executeTakeFirst()
  : undefined

const title = pullRequest
  ? `Files changed · ${pullRequest.title} · ${owner}/${repositoryName} #${number}`
  : 'Pull request not found'

const stateLabel = pullRequest
  ? (pullRequest.state === 'merged' ? 'Merged' : (pullRequest.state === 'closed' ? 'Closed' : (pullRequest.draft ? 'Draft' : 'Open')))
  : ''

const statePill = pullRequest
  ? (pullRequest.state === 'merged' ? 'merged' : (pullRequest.state === 'closed' ? 'closed' : (pullRequest.draft ? 'draft' : 'open')))
  : 'draft'

/**
 * Where the browser fetches the file list from.
 *
 * Built here rather than in the client script so the client never has to know
 * how a pull request is addressed, and so a change to the route is a change in
 * one place.
 */
const diffQuery = `owner=${encodeURIComponent(owner)}&repo=${encodeURIComponent(repositoryName)}&number=${number}`
const manifestUrl = `/api/repos/pulls/diff/manifest?${diffQuery}`

/**
 * Where the browser asks for rows it was not sent.
 *
 * Only reached on a diff large enough that rows stopped partway through. The
 * viewer appends the paths it wants, so the server can hand git a pathspec
 * rather than walking a large diff to an offset.
 */
const rowsUrl = `/api/repos/pulls/diff/rows?${diffQuery}`

/** Where the browser asks for the lines a hunk left out. */
const contextUrl = `/api/repos/pulls/diff/context?${diffQuery}`
</script>

@layout('app')

@section('title', title)

@section('content')
  <div class="shell files-shell">
    @if (!pullRequest)
      <div class="panel" style="padding: 32px; text-align: center;">
        <h1 style="font-size: 20px;">No such pull request</h1>
        <p class="muted" style="margin-top: 6px;">
          {{ owner }}/{{ repositoryName }} has no pull request numbered {{ number }}.
        </p>
      </div>
    @else
      <header class="files-head">
        <div class="pr-title-row">
          <h1 class="pr-title">{{ pullRequest.title }}</h1>
          <span class="mono muted pr-number">#{{ number }}</span>
        </div>

        <div class="pr-meta">
          <span class="pill pill-{{ statePill }}">{{ stateLabel }}</span>
          <span class="muted">
            <span class="mono">{{ pullRequest.head_branch }}</span>
            into
            <span class="mono">{{ pullRequest.base_branch }}</span>
          </span>
          <span class="muted" data-diff-status data-tone="working">Loading the diff…</span>

          {{--
            Filled in and wired by `mountDiffFiles`. Rendered as a button rather
            than as two links so switching does not reload the page: the
            manifest already carries the row counts for both layouts, so only
            the markup has to come again.
          --}}
          <button type="button" class="btn btn-small" data-diff-layout-toggle aria-pressed="false">
            Unified
          </button>

          <button type="button" class="btn btn-small" data-diff-collapse-all aria-pressed="false">
            Collapse all
          </button>

          {{--
            Presentation only. Every control here is read by CSS off an
            attribute on the diff root, so switching one costs a style
            recalculation and never a refetch, whatever the diff is.
          --}}
          <details class="diff-settings">
            <summary>
              <span class="i-hugeicons-settings-01" aria-hidden="true"></span>
              Display
            </summary>

            <div class="diff-settings-panel" data-diff-settings>
              <fieldset>
                <legend>Change indicator</legend>
                <label><input type="radio" name="diff-indicators" value="glyph" data-diff-pref="indicators"> Plus and minus</label>
                <label><input type="radio" name="diff-indicators" value="bar" data-diff-pref="indicators"> Colour bar</label>
                <label><input type="radio" name="diff-indicators" value="none" data-diff-pref="indicators"> None</label>
              </fieldset>

              <fieldset>
                <legend>Show</legend>
                <label><input type="checkbox" data-diff-pref="lineNumbers"> Line numbers</label>
                <label><input type="checkbox" data-diff-pref="changeBackground"> Change backgrounds</label>
                <label><input type="checkbox" data-diff-pref="wrap"> Wrap long lines</label>
              </fieldset>
            </div>
          </details>
        </div>
      </header>

      <nav class="tabs" aria-label="Pull request sections">
        <a class="tab" href="/{{ owner }}/{{ repositoryName }}/pull/{{ number }}">Conversation</a>
        <a class="tab" aria-current="page" href="/{{ owner }}/{{ repositoryName }}/pull/{{ number }}/files">Files changed</a>
      </nav>

      {{--
        The scroll region is sized by the page rather than by its contents: it
        is the virtualizer's viewport, and a region that grows with what is
        inside it would defeat the whole arrangement. `data-` attributes rather
        than props, because the reader of them is a browser module and not a
        component.
      --}}
      <div
        class="diff-stream"
        data-diff-stream
        data-layout="unified"
        data-manifest-url="{{ manifestUrl }}"
        data-rows-url="{{ rowsUrl }}"
        data-context-url="{{ contextUrl }}"
      >
        {{--
          The list is filled in by `mountDiffFiles` from the manifest, which is
          the same data the diff is laid out from. Rendering it on the server
          would mean parsing the diff twice and sending the file list down
          twice with it.
        --}}
        <aside class="diff-files" data-diff-file-list aria-label="Files changed"></aside>

        <div class="diff-scroller" data-diff-scroller>
          <div data-diff-content></div>
        </div>
      </div>

      <noscript>
        <p class="muted" style="padding: 16px 0;">
          The streamed view needs JavaScript.
          <a href="/{{ owner }}/{{ repositoryName }}/pull/{{ number }}">Read the diff on the conversation page</a>,
          which renders in full on the server.
        </p>
      </noscript>
    @endif
  </div>
@endsection

{{--
  Imported by its path from the project root, not relatively. A `<script client>`
  block is composed into the layout before it is bundled, so a relative import
  is resolved against `resources/views/layouts/`, not against this file, and
  lands somewhere outside the project entirely. The `@/` form has no such
  ambiguity because it does not depend on where the block ends up.
--}}
<script client>
import { mountDiffFiles } from '@/resources/functions/diffviewer'

mountDiffFiles()
</script>

<style>
  .files-shell { display: flex; flex-direction: column; min-height: 0; padding-top: 22px; }

  .files-head { padding-bottom: 12px; }

  /* The viewport the list virtualizes against. Sized by the page, never by its
     contents: a region that grew with what is inside it would put every file in
     the document and there would be nothing left to virtualize. */
  /* The list beside the diff rather than above it, so a reader can see where
     they are in the change while reading part of it. */
  .diff-stream {
    display: grid;
    min-height: 0;
    flex: 1;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 14px;
  }

  @media (max-width: 900px) {
    /* Not enough width for both. The diff is the point, so the list goes. */
    .diff-stream { grid-template-columns: minmax(0, 1fr); }
    .diff-files { display: none; }
  }

  .diff-files {
    height: calc(100vh - 210px);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-panel);
    background: var(--surface);
    contain: strict;
  }

  .diff-scroller {
    height: calc(100vh - 210px);
    overflow-y: auto;
    overscroll-behavior: contain;
    /* Layout, paint and style all stop at this boundary, so a file mounting
       cannot invalidate the page around it. */
    contain: strict;
    /* The browser's own scroll anchoring fights ours. */
    overflow-anchor: none;
  }

  /* No padding of its own. The space between files is the layout's `gap`, and
     a host that padded itself would have that space counted twice: once in the
     height the viewer measures, and once when it adds the gap. */
  .diff-file-host { padding-bottom: 0; }

  .is-pending .diff-head { opacity: 0.6; }

  [data-diff-status][data-tone='error'] { color: var(--bad); }
  [data-diff-status][data-tone='warn'] { color: var(--warn, var(--bad)); }
</style>
