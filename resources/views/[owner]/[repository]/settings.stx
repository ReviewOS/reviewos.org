<script server>
/**
 * Repository settings.
 *
 * Every field here is a decision with consequences outside its row: a rename
 * moves a directory and breaks every clone URL somebody wrote down, a
 * visibility change can expose work, a transfer moves the repository into a
 * permission structure it has never been under, and a delete is the one thing
 * nobody gets to undo. The rules are in `app/Actions/Repo/settings.ts` and the
 * endpoints enforce them; this page's job is to say what each one costs before
 * somebody presses it.
 *
 * The page runs no client-side JavaScript, so every control is a form that
 * posts to the same endpoint the API uses. That is why the destructive ones ask
 * for the repository's name typed back: it is the only confirmation that
 * survives a misdirected click, a stale tab, or a script pointed at the wrong
 * repository, and none of those are things a permission check can catch.
 */
import { deployKeysFor, parseRestrictions, repositoryForView, repositoryHeaderActions } from '../../../functions/repo'
// A yes/no column read the same way on either engine. MySQL hands a boolean
// back as 0 or 1, and a checkbox rendered from `=== true` is a rule the page
// says is enforced and is not.
import { isNotFalse, isTrue } from '../../../functions/truth'
import { resolveVariables, settingsFor } from '../../../functions/variables'
import { branchNames, relativeTime } from '../../../functions/browse'
// Asked for here rather than through a helper: `setResponseStatus` is a
// context binding, in scope only inside this script. See the note in
// `resources/components/RepoBrowser.stx`.
const setStatus = typeof setResponseStatus === 'function' ? setResponseStatus : () => {}

const ownerHandle = String(params.owner)
const repositoryName = String(params.repository)

/**
 * The request, when there is one, without naming a binding that may not exist.
 *
 * stx declares `__stxServeContext` on the path that serves a request and on no
 * other, and an *undeclared* identifier is a ReferenceError - which optional
 * chaining does not save, because `x?.y` throws on `x` before the chain is
 * reached. It throws inside the server script's IIFE, so it takes every other
 * variable in this file down with it and the page renders its not-found branch
 * as though the answer were no.
 *
 * The globalThis mirror is not the fix: it is shared between concurrent
 * requests, so reading cookies off it could hand one reader another reader's
 * session.
 */
const serveContext = __stxServeContext

const repoAccess = await repositoryForView(ownerHandle, repositoryName, serveContext?.cookies)
const repoRow: any = repoAccess?.repository ?? null
// Star and watch, for the header. One line here rather than each screen
// re-deriving the viewer, the counts and the labels - see
// `app/Actions/Repo/standing.ts`.
const repoActions = await repositoryHeaderActions(repoAccess, ownerHandle, repositoryName)


// Reading the repository is not enough to see this page. Somebody who cannot
// change anything gets the same answer a stranger gets, because a settings page
// that renders read-only is a settings page people file bugs about.
const mayEdit = Boolean(repoAccess?.can('repository:settings'))
const mayDelete = Boolean(repoAccess?.can('repository:delete'))
const mayTransfer = Boolean(repoAccess?.can('repository:transfer'))

// The same answer a stranger gets, all the way down to the status. A 200 on
// this page would tell a crawler the settings of every repository exist.
if (!repoRow || !mayEdit)
  setStatus(404)

const branches = repoRow && mayEdit ? await branchNames(String(repoAccess?.diskPath ?? '')) : []

// A repository's own keys, for the machines that clone it.
const deployKeys = repoRow ? await deployKeysFor(Number(repoRow.id)) : []

/*
 * Variables, and the part that makes the section worth having: what each
 * effective value overrode.
 *
 * Four levels can set one key, so a value can be wrong at a level nobody is
 * looking at. "It is us-east-1" is not the answer somebody needs at that
 * point - "it is us-east-1, set by the organization, and this repository's
 * eu-west-1 is underneath it" is.
 *
 * Guarded like every other read on a settings screen: a throw here renders the
 * page with every binding undefined, and a repository whose settings vanish
 * because of a variable row is worse than one with no variables section.
 */
let variables: any[] = []
try {
  if (repoRow)
    variables = resolveVariables(await settingsFor(Number(repoRow.id)))
}
catch {
  variables = []
}

const variableRows = variables.map((one: any) => ({
  key: String(one.key),
  value: String(one.value ?? ''),
  scope: String(one.scope),
  from: String(one.from ?? ''),
  // Flattened for the template: a nested loop over `one.shadowed` inside a
  // loop over rows renders nothing at all in stx, silently.
  overrides: (one.shadowed ?? [])
    .map((under: any) => `${String(under.scope)} (${String(under.from)}): ${String(under.value ?? '')}`)
    .join(' · '),
}))

/*
 * The branch rules, for the section that writes them.
 *
 * Gated on `branch:protect` rather than on `repository:settings`. They are the
 * same rung today, and writing the check the endpoint writes is what keeps them
 * the same rung tomorrow: a page that renders a form its endpoint will refuse
 * is worse than one that renders nothing.
 *
 * Guarded like every other read on this page. A throw here renders the whole
 * settings screen with every binding undefined, and losing the rename form to a
 * branch rule row is not a trade anybody would make.
 */
const mayProtect = Boolean(repoAccess?.can('branch:protect'))

let protectedBranches: any[] = []
try {
  if (repoRow && mayProtect) {
    protectedBranches = await db
      .selectFrom('protected_branches')
      .selectAll()
      .where('repository_id', '=', Number(repoRow.id))
      .orderBy('pattern', 'asc')
      .execute()
  }
}
catch {
  protectedBranches = []
}

/*
 * Flattened to strings, because that is all an stx attribute carries.
 *
 * Flags become '1' or '', never 'true' or 'false': an attribute is a string and
 * 'false' is a truthy one, so a checkbox fed the second reads as ticked. On a
 * branch protection page that is not a cosmetic bug - it is a rule that the
 * screen says is enforced and is not.
 */
const branchRules = protectedBranches.map((rule: any) => {
  const flag = (value: unknown) => (isTrue(value) ? '1' : '')
  const restrictions = parseRestrictions(rule.push_restrictions)

  let checks: string[] = []
  try {
    const parsed = JSON.parse(String(rule.required_checks ?? '[]'))
    checks = Array.isArray(parsed) ? parsed.map(String) : []
  }
  catch {
    checks = []
  }

  return {
    pattern: String(rule.pattern),
    requiredApprovals: String(rule.required_approvals ?? 0),
    requiredChecks: checks.join(', '),
    dismissStale: flag(rule.dismiss_stale_reviews),
    requireConversation: flag(rule.require_conversation_resolution),
    requireLinear: flag(rule.require_linear_history),
    requireHumanApproval: flag(rule.require_human_approval_for_agents),
    requireUpToDate: flag(rule.require_up_to_date),
    allowForcePush: flag(rule.allow_force_push),
    allowDeletion: flag(rule.allow_deletion),
    // Absent reads as bound, never as exempt: a row written before the column
    // existed has null here, and rendering that as an unticked box would show
    // every existing rule as one administrators are exempt from.
    enforceAdmins: isNotFalse(rule.enforce_admins) ? '1' : '',
    restrictUsers: (restrictions?.users ?? []).join(', '),
    restrictTeams: (restrictions?.teams ?? []).join(', '),
  }
})

const topics: any[] = repoRow && mayEdit
  ? await db
      .selectFrom('repo_topics')
      .select(['topic'])
      .where('repository_id', '=', Number(repoRow.id))
      .execute()
  : []

const topicList = topics.map(row => String(row.topic)).join(', ')

/*
 * The published site, and whether this instance can serve one at all.
 *
 * Read here rather than fetched by the panel, for the reason every other
 * section on this page is: a settings screen that renders and then fills itself
 * in is a screen that shows the wrong answer for a moment, and the wrong answer
 * here is "your documentation is public".
 *
 * Guarded like the rest. A repository whose Pages row cannot be read still gets
 * its rename form.
 */
const mayPublish = Boolean(repoAccess?.can('repository:settings'))
const pagesConfig = (await import('../../../../config/pages')).default

let pagesSite: any = null
try {
  if (repoRow && mayPublish) {
    pagesSite = await db
      .selectFrom('pages_sites')
      .select(['enabled', 'source_branch', 'domain', 'visibility', 'live_sha', 'live_at', 'last_error'])
      .where('repository_id', '=', Number(repoRow.id))
      .executeTakeFirst()
  }
}
catch {
  // The table may not exist on an instance that has not migrated. Pages is off
  // there, which is what a null row already means.
  pagesSite = null
}

const pagesUrl = pagesSite?.domain
  ? `https://${pagesSite.domain}/`
  : pagesConfig.domain
    ? `https://${ownerHandle}.${pagesConfig.domain}/${repositoryName}/`
    : ''
const base = `/${ownerHandle}/${repositoryName}`
const isArchived = Boolean(repoRow?.is_archived)
const fullName = `${ownerHandle}/${repositoryName}`
</script>

@layout('app')

@section('title', `Settings · ${params.owner}/${params.repository}`)
@section('description', `Settings for ${params.owner}/${params.repository}: visibility, merge strategies, branch protection, and collaborators.`)

@section('content')
  <div class="page">
    @if (!repoRow || !mayEdit)
      <PageEmpty
        title="No such repository"
        detail="Nothing is published at {{ ownerHandle }}/{{ repositoryName }}."
        linksJson="{{ JSON.stringify([{ href: `/${ownerHandle}`, label: `Back to ${ownerHandle}` }, { href: '/explore', label: 'Explore' }]) }}"
      />
    @else
      {{-- `RepoHeader`, like every other repository screen. --}}
      <RepoHeader
        owner="{{ ownerHandle }}"
        repository="{{ repositoryName }}"
        visibility="{{ repoRow.visibility }}"
        description="{{ repoRow.description ?? '' }}"
        refName=""
        size=""
        sizeKb="0"
        commits=""
        :actions="repoActions"
        :branches="[]"
        :tags="[]" />

      <RepoTabs owner="{{ ownerHandle }}" repository="{{ repositoryName }}" active="code" />

      <p class="muted repo-page-caption">Settings</p>

      @if (isArchived)
        <div class="notice panel">
          <strong>This repository is archived.</strong>
          It is readable and frozen: no pushes, no new issues, no comments. Unarchiving is the
          only change it accepts, which is what keeps archiving reversible.
        </div>
      @endif

      <section class="card panel">
        <h2 class="card-title">Details</h2>

        <form class="grid" method="post" action="/api/repos/settings">
          <CsrfField />
          <input type="hidden" name="owner" value="{{ ownerHandle }}">
          <input type="hidden" name="repo" value="{{ repositoryName }}">

          <label class="field">
            <span class="label">Name</span>
            <input class="input" name="name" value="{{ repositoryName }}" maxlength="100" required>
            <span class="hint muted">
              Renaming moves the repository on disk. Every clone URL somebody has written down
              stops working.
            </span>
          </label>

          <label class="field">
            <span class="label">Description</span>
            <input class="input" name="description" value="{{ repoRow.description ?? '' }}" maxlength="500">
            <span class="hint muted">Submitting this empty clears it.</span>
          </label>

          <label class="field">
            <span class="label">Homepage</span>
            <input class="input" name="homepage" value="{{ repoRow.homepage ?? '' }}" maxlength="255" placeholder="stacksjs.com">
            <span class="hint muted">
              The project's own site, shown beside the description. http and https only, and
              a bare host is completed to https. Submitting this empty clears it.
            </span>
          </label>

          <label class="field">
            <span class="label">Default branch</span>
            <select class="input" name="default_branch">
              @foreach (branches as branch)
                <option value="{{ branch }}" {{ branch === repoRow.default_branch ? 'selected' : '' }}>{{ branch }}</option>
              @endforeach
            </select>
            <span class="hint muted">What a clone checks out, and what a pull request targets.</span>
          </label>

          <label class="field">
            <span class="label">Visibility</span>
            <select class="input" name="visibility">
              <option value="public" {{ repoRow.visibility === 'public' ? 'selected' : '' }}>Public - anybody can read and clone it</option>
              <option value="internal" {{ repoRow.visibility === 'internal' ? 'selected' : '' }}>Internal - anybody signed in to this instance</option>
              <option value="private" {{ repoRow.visibility === 'private' ? 'selected' : '' }}>Private - only people you give access to</option>
            </select>
          </label>

          <div class="actions">
            <button class="btn btn-primary" type="submit">Save</button>
          </div>
        </form>
      </section>

      <section class="card panel">
        <h2 class="card-title">Merging</h2>

        {{--
          Each checkbox is preceded by a hidden field with the same name and
          the value false, and the order is load-bearing: the router keeps the
          last value it sees for a repeated key, so a ticked box sends
          false-then-true and reads true, an unticked one sends only false.
          Without the hidden field an unticked box sends nothing, and nothing
          means "leave it alone" - a form that could never turn a strategy off.
        --}}
        <form class="grid" method="post" action="/api/repos/settings">
          <CsrfField />
          <input type="hidden" name="owner" value="{{ ownerHandle }}">
          <input type="hidden" name="repo" value="{{ repositoryName }}">

          <label class="merge-choice">
            <input type="hidden" name="allow_merge_commit" value="false">
            <input type="checkbox" name="allow_merge_commit" value="true" {{ repoRow.allow_merge_commit ? 'checked' : '' }}>
            <span>
              <strong>Merge commit</strong>
              <span class="hint muted">Keeps both histories, joined by a commit with two parents.</span>
            </span>
          </label>

          <label class="merge-choice">
            <input type="hidden" name="allow_squash_merge" value="false">
            <input type="checkbox" name="allow_squash_merge" value="true" {{ repoRow.allow_squash_merge ? 'checked' : '' }}>
            <span>
              <strong>Squash and merge</strong>
              <span class="hint muted">One commit on the base, whatever the branch looked like.</span>
            </span>
          </label>

          <label class="merge-choice">
            <input type="hidden" name="allow_rebase_merge" value="false">
            <input type="checkbox" name="allow_rebase_merge" value="true" {{ repoRow.allow_rebase_merge ? 'checked' : '' }}>
            <span>
              <strong>Rebase and merge</strong>
              <span class="hint muted">Every commit replayed onto the base, no merge commit.</span>
            </span>
          </label>

          <label class="field">
            <span class="label">Default strategy</span>
            <select class="input" name="default_merge_strategy">
              <option value="merge" {{ repoRow.default_merge_strategy === 'merge' ? 'selected' : '' }}>Merge commit</option>
              <option value="squash" {{ repoRow.default_merge_strategy === 'squash' ? 'selected' : '' }}>Squash and merge</option>
              <option value="rebase" {{ repoRow.default_merge_strategy === 'rebase' ? 'selected' : '' }}>Rebase and merge</option>
            </select>
            <span class="hint muted">
              What the merge button offers first. A default the boxes above disallow is refused at
              merge time rather than swapped for something nobody chose.
            </span>
          </label>

          <label class="merge-choice">
            <input type="hidden" name="delete_branch_on_merge" value="false">
            <input type="checkbox" name="delete_branch_on_merge" value="true" {{ repoRow.delete_branch_on_merge ? 'checked' : '' }}>
            <span>
              <strong>Delete the head branch after merging</strong>
              <span class="hint muted">
                Skipped while another open pull request is built on the branch. A deleted branch
                can be restored from its merged pull request.
              </span>
            </span>
          </label>

          <div class="actions">
            <button class="btn btn-primary" type="submit">Save</button>
          </div>
        </form>
      </section>

      <section class="card panel">
        <h2 class="card-title">Topics</h2>

        <form class="grid" method="post" action="/api/repos/topics">
          <CsrfField />
          <input type="hidden" name="owner" value="{{ ownerHandle }}">
          <input type="hidden" name="repo" value="{{ repositoryName }}">

          <label class="field">
            <span class="label">Topics</span>
            <input class="input" name="topics" value="{{ topicList }}" placeholder="typescript, git, code-review">
            <span class="hint muted">
              Comma separated, up to twenty. Lower case with dashes, so <span class="mono">TypeScript</span>
              and <span class="mono">typescript</span> are one topic.
            </span>
          </label>

          <div class="actions">
            <button class="btn" type="submit">Save topics</button>
          </div>
        </form>
      </section>

      @if (mayPublish)
        <section class="card panel">
          <h2 class="card-title">Pages</h2>

          @if (!pagesConfig.domain)
            {{-- Said here rather than offering a switch that does nothing. An
                 operator has to give the instance a Pages hostname first, and a
                 form that accepted the setting anyway would leave somebody
                 waiting for a URL that was never going to answer. --}}
            <p class="muted">
              This instance serves no Pages host, so nothing can be published yet.
              An operator sets <span class="mono">PAGES_DOMAIN</span> — see
              <a href="/docs/pages">the Pages documentation</a>.
            </p>
          @else
            <form class="grid" method="post" action="/api/repos/pages">
              <CsrfField />
              <input type="hidden" name="owner" value="{{ ownerHandle }}">
              <input type="hidden" name="repo" value="{{ repositoryName }}">
              <input type="hidden" name="operation" value="update">

              <label class="field">
                <span class="label">Publish this repository</span>
                <select class="input" name="enabled">
                  <option value="false" @if (!pagesSite?.enabled) selected @endif>Off</option>
                  <option value="true" @if (pagesSite?.enabled) selected @endif>On</option>
                </select>
                <span class="hint muted">
                  A run on the source branch that uploads an artifact named
                  <span class="mono">pages</span> becomes the site. Nothing is built here;
                  the build happens wherever your CI runs.
                </span>
              </label>

              <label class="field">
                <span class="label">Who can read it</span>
                <select class="input" name="visibility">
                  <option value="repository" @if ((pagesSite?.visibility ?? 'repository') === 'repository') selected @endif>
                    Whoever can read the repository
                  </option>
                  <option value="public" @if (pagesSite?.visibility === 'public') selected @endif>
                    Anybody
                  </option>
                </select>
                <span class="hint muted">
                  A private repository's site stays private on the first setting. On the
                  second it is readable by strangers, whatever the repository is.
                </span>
              </label>

              <label class="field">
                <span class="label">Source branch</span>
                <input class="input" name="source_branch" value="{{ pagesSite?.source_branch ?? '' }}" placeholder="{{ repoRow?.default_branch ?? 'main' }}">
                <span class="hint muted">
                  Blank means the default branch. Only runs on this branch publish, so a
                  pull request cannot replace the site.
                </span>
              </label>

              @if (pagesConfig.customDomains)
                <label class="field">
                  <span class="label">Custom domain</span>
                  <input class="input" name="domain" value="{{ pagesSite?.domain ?? '' }}" placeholder="docs.example.com">
                  <span class="hint muted">
                    Point a <span class="mono">CNAME</span> at
                    <span class="mono">{{ ownerHandle }}.{{ pagesConfig.domain }}</span> and set it here.
                  </span>
                </label>
              @endif

              <div class="actions">
                <button class="btn" type="submit">Save Pages</button>
              </div>
            </form>

            @if (pagesSite?.enabled && pagesUrl)
              <p class="muted">
                @if (pagesSite?.live_sha)
                  Live at <a href="{{ pagesUrl }}">{{ pagesUrl }}</a>, from
                  <span class="mono">{{ String(pagesSite.live_sha).slice(0, 7) }}</span>.
                @else
                  Nothing published yet. It will appear at <a href="{{ pagesUrl }}">{{ pagesUrl }}</a>
                  after the first run uploads a <span class="mono">pages</span> artifact.
                @endif
              </p>
            @endif

            @if (pagesSite?.last_error)
              {{-- The last attempt that failed, in the sentence the publisher
                   wrote. "My docs did not update" is answered here and nowhere
                   else. --}}
              <p class="notice">{{ pagesSite.last_error }}</p>
            @endif
          @endif
        </section>
      @endif

      @if (mayProtect)
        <section class="card panel">
          <h2 class="card-title">Branch protection</h2>

          {{--
            The one page on the instance where a rule can be written. Until it
            existed the enforcement had no door: the receive hook refused force
            pushes and the merge action held pull requests, against rules that
            could only be inserted into the database by hand.
          --}}
          <p class="card-note muted">
            What a branch requires before a change lands on it, and what it refuses outright. Every
            rule here is enforced at the push as well as at the merge - a protection that only the
            merge button honours is one a <span class="mono">git push</span> walks straight past.
          </p>

          @if (branchRules.length > 0)
            @foreach (branchRules as rule)
              <div class="rule">
                <h3 class="rule-title mono">{{ rule.pattern }}</h3>
                <BranchRuleForm
                  owner="{{ ownerHandle }}"
                  repo="{{ repositoryName }}"
                  pattern="{{ rule.pattern }}"
                  requiredApprovals="{{ rule.requiredApprovals }}"
                  requiredChecks="{{ rule.requiredChecks }}"
                  dismissStale="{{ rule.dismissStale }}"
                  requireConversation="{{ rule.requireConversation }}"
                  requireLinear="{{ rule.requireLinear }}"
                  requireHumanApproval="{{ rule.requireHumanApproval }}"
                  requireUpToDate="{{ rule.requireUpToDate }}"
                  allowForcePush="{{ rule.allowForcePush }}"
                  allowDeletion="{{ rule.allowDeletion }}"
                  enforceAdmins="{{ rule.enforceAdmins }}"
                  restrictUsers="{{ rule.restrictUsers }}"
                  restrictTeams="{{ rule.restrictTeams }}"
                  fresh=""
                />
              </div>
            @endforeach
          @else
            <p class="hint muted">
              No branch is protected. Anybody with push access can force push over
              <span class="mono">{{ repoRow.default_branch }}</span> and delete it.
            </p>
          @endif

          <div class="rule">
            <h3 class="rule-title">New rule</h3>
            {{--
              Every attribute, including the empty ones.

              stx injects only the props a caller passes, and an *undeclared*
              identifier is a ReferenceError - which takes the component's whole
              server script down and renders it with every binding undefined.
              So a prop left off here is not a default; it is the form failing
              silently, which on this page means a rule somebody thinks they
              wrote.

              `enforceAdmins` starts ticked, which is the endpoint's own
              default. A form that offered the exemption by default would be a
              form that hands it out to people who never read the label.
            --}}
            <BranchRuleForm
              owner="{{ ownerHandle }}"
              repo="{{ repositoryName }}"
              pattern=""
              requiredApprovals="0"
              requiredChecks=""
              dismissStale=""
              requireConversation=""
              requireLinear=""
              requireHumanApproval=""
              requireUpToDate=""
              allowForcePush=""
              allowDeletion=""
              enforceAdmins="1"
              restrictUsers=""
              restrictTeams=""
              fresh="1"
            />
          </div>
        </section>
      @endif

      <section class="card panel">
        <h2 class="card-title">Deploy keys</h2>

        {{--
          A key that reaches this repository and nothing else, for a machine.
          A personal key would give a build server everything its owner can
          reach, and a token belongs to a person - it expires on their schedule
          and dies with their account.
        --}}
        <p class="card-note muted">
          For a CI runner or a server that needs to clone this repository. Read-only unless you
          say otherwise, because a key that can push is a key that can rewrite history from a
          machine nobody is watching.
        </p>

        <form class="grid" method="post" action="/api/repos/deploy-keys">
          <CsrfField />
          <input type="hidden" name="owner" value="{{ ownerHandle }}">
          <input type="hidden" name="repo" value="{{ repositoryName }}">
          <input type="hidden" name="operation" value="create">

          <label class="field">
            <span class="label">Title</span>
            <input class="input" name="title" placeholder="CI runner" maxlength="100">
          </label>

          <label class="field">
            <span class="label">Key</span>
            <textarea
              class="input mono"
              name="key"
              rows="3"
              required
              spellcheck="false"
              placeholder="ssh-ed25519 AAAA… (a key of its own: ssh-keygen -t ed25519 -f deploy_key)"></textarea>
            <span class="hint muted">
              Generate one for this repository rather than reusing a key. A key already registered
              to an account, or already a deploy key elsewhere, is refused - one key means one
              identity, and the transport has only the fingerprint to go on.
            </span>
          </label>

          <label class="check">
            <input type="checkbox" name="can_write" value="1">
            <span>Allow this key to push</span>
          </label>

          <div class="actions">
            <button class="btn" type="submit">Add deploy key</button>
          </div>
        </form>

        @if (deployKeys.length > 0)
          <ul class="deploy-list">
            @foreach (deployKeys as key)
              <li class="deploy-row">
                <div class="deploy-main">
                  <span class="deploy-name">{{ key.title }}</span>
                  <span class="deploy-fingerprint mono muted">{{ key.fingerprint }}</span>
                  <span class="deploy-meta muted">
                    {{ key.canWrite ? 'read and write' : 'read-only' }}
                    &middot; {{ key.lastUsedAt ? `last used ${relativeTime(key.lastUsedAt)}` : 'never used' }}
                  </span>
                </div>

                <form class="inline" method="post" action="/api/repos/deploy-keys">
                  <CsrfField />
                  <input type="hidden" name="owner" value="{{ ownerHandle }}">
                  <input type="hidden" name="repo" value="{{ repositoryName }}">
                  <input type="hidden" name="operation" value="delete">
                  <input type="hidden" name="id" value="{{ key.id }}">
                  <button class="btn" type="submit">Remove</button>
                </form>
              </li>
            @endforeach
          </ul>
        @endif
      </section>

      <section class="card panel">
        <h2 class="card-title">Variables</h2>

        {{--
          Not secrets, and the note says so where somebody is about to type
          one: these reach every job, a fork's included, and they are in the
          logs.
        --}}
        <p class="card-note muted">
          Values workflows read as <code>${{ '{{' }} vars.NAME {{ '}}' }}</code>. They are not secrets: every job can read
          them, including a job from a fork, and they appear in logs. A workflow file's
          <code>env:</code> beats all of them, then this repository, then the owner, then the
          instance.
        </p>

        <form class="grid" method="post" action="/api/repos/variables">
          <CsrfField />
          <input type="hidden" name="owner" value="{{ ownerHandle }}">
          <input type="hidden" name="repo" value="{{ repositoryName }}">
          <input type="hidden" name="operation" value="set">
          <input type="hidden" name="scope" value="repository">

          <label class="field">
            <span class="label">Name</span>
            <input class="input mono" name="key" placeholder="REGISTRY" maxlength="200" required>
          </label>

          <label class="field">
            <span class="label">Value</span>
            <input class="input mono" name="value" placeholder="ghcr.io" maxlength="4000">
          </label>

          <div class="actions">
            <button class="btn" type="submit">Set for this repository</button>
          </div>
        </form>

        @if (variableRows.length > 0)
          <ul class="deploy-list">
            @foreach (variableRows as row)
              <li class="deploy-row">
                <div class="deploy-main">
                  <span class="deploy-name mono">{{ row.key }} = {{ row.value }}</span>
                  <span class="deploy-meta muted">set at the {{ row.scope }} level, by {{ row.from }}</span>
                  @if (row.overrides)
                    {{-- The sentence that ends the argument about why a deploy
                        went to the wrong region. --}}
                    <span class="deploy-meta muted">overriding {{ row.overrides }}</span>
                  @endif
                </div>

                @if (row.scope === 'repository')
                  <form class="inline" method="post" action="/api/repos/variables">
                    <CsrfField />
                    <input type="hidden" name="owner" value="{{ ownerHandle }}">
                    <input type="hidden" name="repo" value="{{ repositoryName }}">
                    <input type="hidden" name="operation" value="unset">
                    <input type="hidden" name="scope" value="repository">
                    <input type="hidden" name="key" value="{{ row.key }}">
                    <button class="btn" type="submit">Remove</button>
                  </form>
                @endif
              </li>
            @endforeach
          </ul>
        @endif
      </section>

      <section class="card danger panel">
        <h2 class="card-title">Danger zone</h2>

        <div class="row">
          <div class="row-text">
            <strong>{{ isArchived ? 'Unarchive this repository' : 'Archive this repository' }}</strong>
            <span class="muted">
              {{ isArchived
                ? 'It starts accepting pushes, issues and comments again.'
                : 'It becomes readable and frozen. Nothing is lost, and you can undo this.' }}
            </span>
          </div>

          <form method="post" action="/api/repos/settings">
            <CsrfField />
            <input type="hidden" name="owner" value="{{ ownerHandle }}">
            <input type="hidden" name="repo" value="{{ repositoryName }}">
            <input type="hidden" name="is_archived" value="{{ isArchived ? 'false' : 'true' }}">
            <button class="btn" type="submit">{{ isArchived ? 'Unarchive' : 'Archive' }}</button>
          </form>
        </div>

        @if (mayTransfer)
          <div class="row">
            <div class="row-text">
              <strong>Transfer ownership</strong>
              <span class="muted">
                Every clone URL changes, and the collaborators you granted here stop applying -
                the new owner's own structure takes over. An archived repository cannot be
                transferred.
              </span>
            </div>

            <form class="inline" method="post" action="/api/repos/transfer">
              <CsrfField />
              <input type="hidden" name="owner" value="{{ ownerHandle }}">
              <input type="hidden" name="repo" value="{{ repositoryName }}">
              <input class="input input-small" name="to" placeholder="new owner" required>
              <button class="btn btn-danger" type="submit">Transfer</button>
            </form>
          </div>
        @endif

        @if (mayDelete)
          <div class="row">
            <div class="row-text">
              <strong>Delete this repository</strong>
              <span class="muted">
                The repository is moved aside rather than erased, so a mistake is recoverable for
                thirty days. Its issues, pull requests and reviews are not: those go now.
              </span>
            </div>

            {{--
              A form cannot send DELETE, so this posts to the endpoint's POST
              twin. The name is typed back for the reason the endpoint asks for
              it: a permission check cannot tell a deliberate delete from a
              misdirected one.
            --}}
            <form class="inline" method="post" action="/api/repos/delete">
              <CsrfField />
              <input type="hidden" name="owner" value="{{ ownerHandle }}">
              <input type="hidden" name="repo" value="{{ repositoryName }}">
              <input class="input input-small" name="confirm" placeholder="{{ fullName }}" required>
              <button class="btn btn-danger" type="submit">Delete</button>
            </form>
          </div>
        @endif
      </section>
    @endif
  </div>
@endsection

<style>
  .card-note { font-size: 12.5px; line-height: 1.5; margin-bottom: 14px; }

  .deploy-list { margin-top: 16px; border-top: 1px solid var(--line); }

  .deploy-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  .deploy-row:last-child { border-bottom: 0; }
  .deploy-main { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
  .deploy-name { font-weight: 500; }

  .deploy-fingerprint,
  .deploy-meta {
    font-size: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .check { display: flex; align-items: center; gap: 8px; font-size: 13px; }

  .rule { padding: 16px 0; border-top: 1px solid var(--line); }
  .rule:first-of-type { border-top: 0; }
  .rule-title { font-size: 13.5px; font-weight: 600; margin: 0 0 12px; }

  /* A reading width, like the account settings have. Every card on this page
     is a column of short fields - a name, a branch, a checkbox and its
     sentence - and at the shell's full width the label ends up a long way from
     the box it names, with the value floating alone in the middle of a metre
     of panel. */
  .card { max-width: 760px; padding: 18px 20px; margin-top: 16px; }
  .card-title { font-size: 15px; font-weight: 600; margin: 0 0 14px; }

  .notice {
    padding: 12px 16px;
    margin-top: 16px;
    font-size: 13px;
    line-height: 1.5;
    border-left: 3px solid var(--accent);
  }

  .grid { display: grid; gap: 16px; }
  .field { display: grid; gap: 6px; }
  .label { font-size: 13px; font-weight: 500; }

  .input {
    width: 100%;
    padding: 8px 11px;
    font: inherit;
    font-size: 13.5px;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--r-field, 10px);
  }

  .input:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
  .input-small { width: 220px; }

  .hint { font-size: 12.5px; line-height: 1.45; }
  .actions { display: flex; gap: 8px; }

  .danger { border-color: var(--del, #b3261e); }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
  }

  .row:first-of-type { border-top: 0; padding-top: 0; }
  .row-text { display: grid; gap: 4px; max-width: 62ch; font-size: 13px; }
  .row-text .muted { font-size: 12.5px; line-height: 1.45; }

  .inline { display: flex; gap: 8px; align-items: center; }

  .merge-choice {
    display: flex;
    gap: 10px;
    align-items: start;
    cursor: pointer;
  }

  .merge-choice input[type='checkbox'] { margin-top: 3px; flex: none; }
  .merge-choice span { display: grid; gap: 2px; font-size: 13.5px; }

  .btn-danger { border-color: var(--del, #b3261e); color: var(--del, #b3261e); }
  .btn-danger:hover { background: var(--del, #b3261e); color: #fff; }

  @media (max-width: 720px) {
    .row { flex-direction: column; align-items: stretch; }
    .input-small { width: 100%; }
  }
</style>
