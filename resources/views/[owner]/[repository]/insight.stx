<script server>
/**
 * A repository's pipelines over a window: how often they pass, how long they
 * take, how long they wait, and what they cost.
 *
 * The tests screen answers "which test is the problem". This answers the
 * questions above it - is CI slow because the jobs are slow or because nothing
 * can get a machine, and is the red on this branch a real failure or the same
 * flake as last week - and both are questions people currently answer by
 * feeling.
 *
 * **It states its own evidence.** Every rate here is withheld until there is
 * enough behind it, and a withheld number shows as a dash with the sample count
 * beside it rather than as a confident zero. A dashboard that rounds two runs
 * up to a percentage is one somebody screenshots into a planning meeting.
 */
import { insightFor } from '../../../functions/insight'
import { repositoryForView } from '../../../functions/repo'

// Asked for here rather than through a helper: `setResponseStatus` is a
// context binding, in scope only inside this script.
const setStatus = typeof setResponseStatus === 'function' ? setResponseStatus : () => {}

const ownerHandle = String(params.owner)
const repositoryName = String(params.repository)
const serveContext = __stxServeContext

const repoAccess = await repositoryForView(ownerHandle, repositoryName, serveContext?.cookies)
const repoRow: any = repoAccess?.repository ?? null

if (!repoRow)
  setStatus(404)

/*
 * The window, through `useRoute()` rather than the `search` binding, which is
 * declared on some request paths and not others - and an undeclared identifier
 * takes every variable in this script with it, rendering the not-found branch
 * as though the repository were gone.
 */
const query: Record<string, string> = useRoute().query ?? {}
const asked = Number(query.days)
const days = Number.isFinite(asked) && asked > 0 ? Math.min(90, Math.floor(asked)) : 7

/*
 * Guarded, like every read on a repository screen: a throw in this script
 * renders the whole page with every binding undefined, so an instance with odd
 * data would produce a blank page rather than an empty one.
 */
let insight: any = null
try {
  if (repoRow)
    insight = await insightFor({ repositoryId: Number(repoRow.id), days })
}
catch {
  insight = null
}

/**
 * A duration, in the units somebody reads at a glance.
 *
 * The unit changes with the size because these columns hold both a
 * four-second job and a week of idle time, and `10007m 0s` is a number a
 * reader has to do arithmetic on before it means anything.
 */
function duration(value: number | null): string {
  if (value === null || !Number.isFinite(value))
    return '-'

  if (value < 1000)
    return `${Math.round(value)}ms`

  if (value < 60_000)
    return `${(value / 1000).toFixed(1)}s`

  if (value < 3_600_000)
    return `${Math.floor(value / 60_000)}m ${Math.round((value % 60_000) / 1000)}s`

  if (value < 86_400_000)
    return `${Math.floor(value / 3_600_000)}h ${Math.round((value % 3_600_000) / 60_000)}m`

  return `${Math.floor(value / 86_400_000)}d ${Math.round((value % 86_400_000) / 3_600_000)}h`
}

/** A share as a percentage, or a dash when there was not enough to measure. */
function share(value: number | null): string {
  return value === null || !Number.isFinite(value) ? '-' : `${(value * 100).toFixed(1)}%`
}

/*
 * Formatted here rather than in the template. A template that calls a function
 * is a template that renders nothing when the function is not in scope, and stx
 * reports that as an HTML comment nobody reads.
 */
const overall = insight?.overall ?? null
const summary = {
  runs: Number(overall?.runs ?? 0),
  samples: Number(overall?.samples ?? 0),
  success: share(overall?.successRate ?? null),
  p50: duration(overall?.p50 ?? null),
  p95: duration(overall?.p95 ?? null),
  retries: share(overall?.retryRate ?? null),
}

const workflows = (insight?.workflows ?? []).map((one: any) => ({
  workflow: String(one.workflow ?? one.path ?? ''),
  path: String(one.path ?? ''),
  runs: Number(one.runs ?? 0),
  success: share(one.successRate ?? null),
  p50: duration(one.p50 ?? null),
  p95: duration(one.p95 ?? null),
  retries: share(one.retryRate ?? null),
}))

const failures = (insight?.failuresByJob ?? []).slice(0, 12).map((one: any) => ({
  name: String(one.name ?? ''),
  failures: Number(one.failures ?? 0),
  runs: Number(one.runs ?? 0),
  rate: share(one.runs > 0 ? one.failures / one.runs : null),
}))

const waits = (insight?.wait ?? []).map((one: any) => ({
  queue: String(one.queue ?? ''),
  pool: String(one.pool ?? ''),
  samples: Number(one.samples ?? 0),
  p50: duration(one.p50 ?? null),
  p95: duration(one.p95 ?? null),
}))

const runners = (insight?.runners ?? []).map((one: any) => ({
  runner: String(one.runner ?? ''),
  busy: duration(Number(one.busyMs ?? 0)),
  used: share(one.share ?? null),
  idle: duration(Math.max(0, days * 86_400_000 - Number(one.busyMs ?? 0))),
}))

const queueCost = (insight?.cost?.queues ?? []).map((one: any) => ({
  key: String(one.key ?? ''),
  minutes: Number(one.minutes ?? 0),
}))

const flaky = insight?.flaky ?? null
const flakyShare = share(flaky?.share ?? null)
const reported = Number(overall?.runs ?? 0) > 0
const base = `/${ownerHandle}/${repositoryName}`
</script>

@layout('app')

@section('title', `Insight · ${params.owner}/${params.repository}`)
@section('description', `Review throughput, queue depth, and where changes wait in ${params.owner}/${params.repository}.`)

@section('content')
  <div class="shell" style="padding-top: 22px; padding-bottom: 64px;">
    @if (!repoRow)
      <div class="panel" style="padding: 32px; text-align: center;">
        <h1 style="font-size: 20px;">No such repository</h1>
      </div>
    @else
      <header class="repo-head">
        <h1 class="repo-title">
          <a href="/{{ ownerHandle }}">{{ ownerHandle }}</a><span class="muted">/</span><a href="{{ base }}">{{ repositoryName }}</a>
        </h1>
        <p class="muted" style="margin-top: 6px;">Pipelines over the last {{ days }} days</p>
      </header>

      <RepoTabs owner="{{ ownerHandle }}" repository="{{ repositoryName }}" active="insight" />

      <nav class="insight-windows" aria-label="Window">
        <a class="insight-window {{ days === 1 ? 'is-current' : '' }}" href="{{ base }}/insight?days=1">24 hours</a>
        <a class="insight-window {{ days === 7 ? 'is-current' : '' }}" href="{{ base }}/insight?days=7">7 days</a>
        <a class="insight-window {{ days === 30 ? 'is-current' : '' }}" href="{{ base }}/insight?days=30">30 days</a>
        <a class="insight-window {{ days === 90 ? 'is-current' : '' }}" href="{{ base }}/insight?days=90">90 days</a>
      </nav>

      @if (!reported)
        <div class="panel" style="padding: 28px; margin-top: 16px;">
          <p class="muted">No runs in this window.</p>
          <p class="muted" style="margin-top: 8px; font-size: 13px;">
            These numbers are computed from workflow runs on this repository. The same figures are
            available through <code>/api/insight?owner={{ ownerHandle }}&amp;repo={{ repositoryName }}</code>,
            in the shape this page renders.
          </p>
        </div>
      @else
        <section class="panel" style="padding: 15px 17px; margin-top: 16px;">
          <h2 class="side-heading">Runs</h2>

          <div class="insight-figures">
            <div class="insight-figure">
              <span class="insight-value">{{ summary.runs }}</span>
              <span class="muted">runs</span>
            </div>
            <div class="insight-figure">
              <span class="insight-value">{{ summary.success }}</span>
              <span class="muted">passed, of {{ summary.samples }} finished</span>
            </div>
            <div class="insight-figure">
              <span class="insight-value">{{ summary.p50 }}</span>
              <span class="muted">median</span>
            </div>
            <div class="insight-figure">
              <span class="insight-value">{{ summary.p95 }}</span>
              <span class="muted">p95</span>
            </div>
            <div class="insight-figure">
              <span class="insight-value">{{ summary.retries }}</span>
              <span class="muted">of jobs retried</span>
            </div>
          </div>

          {{-- Said once, here, rather than as a footnote under every dash: a
              rate over four runs is the last four runs, not a rate, and a page
              that prints one teaches people to distrust the rest of it. --}}
          <p class="muted checks-note">A dash means too few runs in this window to measure, not zero.</p>
        </section>

        <section class="panel" style="padding: 15px 17px; margin-top: 16px;">
          <h2 class="side-heading">By workflow</h2>

          <table class="insight-table">
            <thead>
              <tr><th>Workflow</th><th>Runs</th><th>Passed</th><th>Median</th><th>p95</th><th>Retried</th></tr>
            </thead>
            <tbody>
              @foreach (workflows as one)
                <tr>
                  <td>{{ one.workflow }} <span class="mono muted">{{ one.path }}</span></td>
                  <td>{{ one.runs }}</td>
                  <td>{{ one.success }}</td>
                  <td>{{ one.p50 }}</td>
                  <td>{{ one.p95 }}</td>
                  <td>{{ one.retries }}</td>
                </tr>
              @endforeach
            </tbody>
          </table>
        </section>

        @if (failures.length > 0)
          <section class="panel" style="padding: 15px 17px; margin-top: 16px;">
            <h2 class="side-heading">Where the failures are</h2>

            {{-- Ranked by count rather than by rate: a job that fails a tenth
                of four hundred runs costs forty red builds, and a job that
                failed its only run has a rate of one. --}}
            <p class="muted checks-note">Ranked by how many builds went red, not by rate.</p>

            <table class="insight-table">
              <thead>
                <tr><th>Job</th><th>Failures</th><th>Runs</th><th>Rate</th></tr>
              </thead>
              <tbody>
                @foreach (failures as one)
                  <tr>
                    <td class="mono">{{ one.name }}</td>
                    <td>{{ one.failures }}</td>
                    <td>{{ one.runs }}</td>
                    <td>{{ one.rate }}</td>
                  </tr>
                @endforeach
              </tbody>
            </table>
          </section>
        @endif

        <section class="panel" style="padding: 15px 17px; margin-top: 16px;">
          <h2 class="side-heading">Waiting for a machine</h2>

          @if (waits.length === 0)
            <p class="muted side-empty">No job in this window waited on a runner this instance manages.</p>
          @else
            {{-- The wait and the utilization sit together on purpose: a long
                wait beside an idle fleet is a routing problem, and a long wait
                beside a busy one is a shopping list. Split across two pages,
                every long wait looks like the second. --}}
            <p class="muted checks-note">Measured from when a runner could have taken the job, not from when the run started.</p>

            <table class="insight-table">
              <thead>
                <tr><th>Queue</th><th>Pool</th><th>Jobs</th><th>Median wait</th><th>p95 wait</th></tr>
              </thead>
              <tbody>
                @foreach (waits as one)
                  <tr>
                    <td class="mono">{{ one.queue }}</td>
                    <td class="muted">{{ one.pool }}</td>
                    <td>{{ one.samples }}</td>
                    <td>{{ one.p50 }}</td>
                    <td>{{ one.p95 }}</td>
                  </tr>
                @endforeach
              </tbody>
            </table>
          @endif

          @if (runners.length > 0)
            <table class="insight-table" style="margin-top: 14px;">
              <thead>
                <tr><th>Runner</th><th>Busy</th><th>Idle</th><th>Used</th></tr>
              </thead>
              <tbody>
                @foreach (runners as one)
                  <tr>
                    <td class="mono">{{ one.runner }}</td>
                    <td>{{ one.busy }}</td>
                    <td>{{ one.idle }}</td>
                    <td>{{ one.used }}</td>
                  </tr>
                @endforeach
              </tbody>
            </table>
          @endif
        </section>

        @if (queueCost.length > 0)
          <section class="panel" style="padding: 15px 17px; margin-top: 16px;">
            <h2 class="side-heading">Where the minutes went</h2>

            {{-- Nobody is billed here, which is exactly why this is worth
                showing: the machines are somebody's line item and nothing else
                itemises them. --}}
            <p class="muted checks-note">Run minutes by queue. Nothing is billed; this is what the machines were doing.</p>

            <table class="insight-table">
              <thead>
                <tr><th>Queue</th><th>Minutes</th></tr>
              </thead>
              <tbody>
                @foreach (queueCost as one)
                  <tr>
                    <td class="mono">{{ one.key }}</td>
                    <td>{{ one.minutes }}</td>
                  </tr>
                @endforeach
              </tbody>
            </table>
          </section>
        @endif

        @if (flaky && flaky.runsFailedByFlaky > 0)
          <section class="panel" style="padding: 15px 17px; margin-top: 16px;">
            <h2 class="side-heading">What the flakes cost</h2>

            <p class="checks-rollup checks-warn">
              <span class="run-dot run-warn" aria-hidden="true"></span>
              {{ flaky.runsFailedByFlaky }} of {{ flaky.failedRuns }} failed run@if (flaky.failedRuns !== 1)s@endif
              ({{ flakyShare }}) failed on a test already known to be flaky
            </p>

            {{-- "Already known" is the load-bearing half: a test this run
                discovered was not costing anybody anything before it, and
                counting it would make flakiness look worse every time
                detection got better. --}}
            <p class="muted checks-note">
              Counted only for tests marked flaky before the results arrived.
              <a href="{{ base }}/tests">See which ones</a>.
            </p>
          </section>
        @endif
      @endif
    @endif
  </div>
@endsection

<style>
  .insight-windows {
    display: flex;
    gap: 6px;
    margin-top: 14px;
  }

  .insight-window {
    font-size: 12px;
    color: var(--muted);
    text-decoration: none;
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .insight-window:hover { color: var(--text); }

  .insight-window.is-current {
    color: var(--text);
    border-color: var(--accent);
  }

  .insight-figures {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 10px;
  }

  .insight-figure {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 12px;
  }

  .insight-value {
    font-size: 20px;
    font-weight: 550;
    font-variant-numeric: tabular-nums;
  }

  .insight-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
    font-size: 13px;
  }

  .insight-table th {
    text-align: left;
    font-weight: 550;
    color: var(--muted);
    font-size: 12px;
    padding: 6px 8px;
    border-bottom: 1px solid var(--line);
  }

  .insight-table td {
    padding: 7px 8px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  /* Numbers read as a column when they are the same width, and a duration
    column that jitters is one nobody scans. */
  .insight-table td:not(:first-child) { font-variant-numeric: tabular-nums; white-space: nowrap; }

  .insight-table tr:last-child td { border-bottom: none; }
</style>
