<script server>
/**
 * Which line of a large file to show.
 *
 * A file past a window is rendered a window at a time, and `?from=` is how the
 * rest of it is reached with nothing running. Read here, where the request is,
 * and handed to the component as a prop - a component cannot reach the query
 * itself, and `{{ query.from }}` in an attribute looks like it reads the query
 * string and does not.
 *
 * Both spellings, because the two ways this application serves a page supply it
 * differently: the dev server binds `query`, and `route.serve()` supplies it
 * through `useRoute()` and binds nothing.
 */
const search: Record<string, string> = useRoute().query ?? {}
const fromLine = String(search.from ?? '')
</script>

{{--
  A directory or file at an explicit ref.

  `[...path]` is a catch-all because a repository path has any number of
  segments; a single dynamic segment would only ever match the first.
--}}
@layout('app')

@section('title', `${params.path ? `${params.path} · ` : ''}${params.owner}/${params.repository}`)

{{--
  Imported by its path from the project root rather than relatively: a
  `<script client>` block is composed into the layout before it is bundled, so
  a relative import resolves against `resources/views/layouts/`.

  It does nothing on a directory, on a small file, or without a rows endpoint -
  the module returns before it touches anything - so this costs a page that is
  not a large file one function call.
--}}
<script client>
import { mountBlobWindow } from '@/resources/functions/blobviewer'

mountBlobWindow()
</script>

@section('content')
  <RepoBrowser
    owner="{{ params.owner }}"
    repository="{{ params.repository }}"
    refName="{{ params.ref }}"
    path="{{ params.path }}"
    fromLine="{{ fromLine }}" />
@endsection
