<script server>
/**
 * One workflow run: its jobs, and what each of them is waiting for.
 *
 * The graph is the interesting part of this screen. A job that is blocked says
 * *what it is blocked on*, because "blocked" on its own sends somebody to read
 * the workflow file to find out - and the answer is already in the row.
 *
 * Two commits are shown when they differ. `head_sha` is what the run is about
 * and `definition_sha` is where the workflow came from, and they are the same
 * for an ordinary push and deliberately not for a fork's pull request. A reader
 * who cannot see the difference cannot tell a run of their code from a run of
 * their code by somebody else's workflow.
 */
import { repositoryForView } from '../../../../functions/repo'
import { relativeTime, shortSha } from '../../../../functions/browse'
import { artifactSize, runDuration, runIsFinished, runLabel, runTone } from '../../../../functions/runs'
import { eventsFromText, renderLog } from '../../../../functions/runs'
import { explainWaiting } from '../../../../functions/runs'
// Asked for here rather than through a helper: `setResponseStatus` is a
// context binding, in scope only inside this script. See the note in
// `resources/components/RepoBrowser.stx`.
const setStatus = typeof setResponseStatus === 'function' ? setResponseStatus : () => {}
import { cookieJarFromHeader } from '../../../../functions/identity'
import { renderMarkdown } from '../../../../functions/markdown'

const ownerHandle = String(params.owner)
const repositoryName = String(params.repository)
const runNumber = Number(params.number)

const serveContext = __stxServeContext

/*
 * The reader, from whichever of the two shapes this page was served with.
 *
 * The frontend server hands a view its cookies already parsed; a page rendered
 * through `route.serve()`'s file routing gets the raw headers and nothing else,
 * and asking only for the jar renders every reader there as a stranger. On this
 * page that is not a blank region - it is a signed-in maintainer being shown
 * the run with no way to stop it, which looks like a missing feature rather
 * than a missing identity.
 */
// `typeof` rather than a plain read: an identifier that does not exist throws
// before optional chaining is reached, and a throw here renders the page with
// every variable undefined and no error anywhere.
const headerBag = typeof headers === 'undefined' ? undefined : headers
const viewerCookies = serveContext?.cookies ?? cookieJarFromHeader(headerBag?.cookie)

const repoAccess = await repositoryForView(ownerHandle, repositoryName, viewerCookies)
const repoRow: any = repoAccess?.repository ?? null

if (!repoRow)
  setStatus(404)

const run: any = repoRow && Number.isFinite(runNumber)
  ? await db
      .selectFrom('workflow_runs')
      .selectAll()
      .where('repository_id', '=', Number(repoRow.id))
      .where('number', '=', runNumber)
      .executeTakeFirst()
  : null

// A missing run under a 200 tells a crawler and a cache the page is fine.
if (repoRow && !run)
  setStatus(404)

const jobRows: any[] = run
  ? await db
      .selectFrom('workflow_jobs')
      .selectAll()
      .where('workflow_run_id', '=', Number(run.id))
      .orderBy('position')
      .execute()
  : []

/*
 * What each job wrote to `GITHUB_STEP_SUMMARY`.
 *
 * A step summary is markdown a job wrote about itself - the table of what it
 * built, the diff of what changed, the three numbers somebody actually wanted -
 * and it is the one part of a run that is *written for a reader* rather than
 * printed for a log. Leaving it only on the check meant a run page that showed
 * ten thousand lines of output and not the paragraph the job wrote to be read.
 *
 * Keyed by job name against this run's commit, which is how the annotation
 * endpoint files it.
 */
const summaryRows: any[] = run && jobRows.length > 0
  ? await db
      .selectFrom('check_runs')
      .select(['name', 'summary'])
      .where('repository_id', '=', Number(repoRow?.id ?? 0))
      .where('head_sha', '=', String(run.head_sha))
      .execute()
  : []

const summaryByName = new Map<string, string>(
  summaryRows
    .filter(row => String(row.summary ?? '').trim())
    .map(row => [String(row.name), String(row.summary)]),
)

// Every step in the run in one query rather than one per job.
const stepRows: any[] = jobRows.length > 0
  ? await db
      .selectFrom('workflow_steps')
      .selectAll()
      .where('workflow_job_id', 'in', jobRows.map(job => Number(job.id)))
      .orderBy('position')
      .execute()
  : []

const stepsByJob = new Map<number, any[]>()
for (const step of stepRows) {
  const jobId = Number(step.workflow_job_id)
  const held = stepsByJob.get(jobId)
  if (held)
    held.push(step)
  else
    stepsByJob.set(jobId, [step])
}

/**
 * The output each job produced.
 *
 * Read here rather than fetched, because a log that arrives after the page does
 * is a log somebody watches appear - and the run is usually over by the time
 * anybody opens this. The live case is worth a fetch later; the ordinary case
 * is worth being on the page.
 *
 * One query for the run rather than one per job. Bounded by the ceiling the
 * append side enforces, so "everything" is at most a couple of megabytes and
 * the tail is what a reader wants anyway.
 */
const logRows: any[] = jobRows.length > 0
  ? await db
      .selectFrom('workflow_job_logs')
      .select(['workflow_job_id', 'sequence', 'stream', 'content', 'events'])
      .where('workflow_job_id', 'in', jobRows.map(job => Number(job.id)))
      .orderBy('sequence')
      .execute()
  : []

const logByJob = new Map<number, string>()

/*
 * The same output as events, for the jobs whose runner sent them.
 *
 * Four things cannot be recovered from the text afterwards - which lines were
 * grouped, when each was printed, which stream it came from, and where colour
 * started - so a job that sent structure gets the richer rendering and one that
 * sent bytes gets the same renderer over lines derived from them. Two renderers
 * would mean the half of a log stored before events existed looked different
 * from the half after.
 */
const eventsByJob = new Map<number, any[]>()
/*
 * The last sequence each job's output reached, which is where a follower picks
 * up. Without it the live tail would either re-send everything the page already
 * has - megabytes, to draw a screen that is drawn - or guess, and a guess here
 * shows the reader a line twice or drops one.
 */
const cursorByJob = new Map<number, number>()

for (const chunk of logRows) {
  const jobId = Number(chunk.workflow_job_id)
  logByJob.set(jobId, (logByJob.get(jobId) ?? '') + String(chunk.content ?? ''))

  if (chunk.events) {
    try {
      const parsed = JSON.parse(String(chunk.events))

      if (Array.isArray(parsed))
        eventsByJob.set(jobId, [...(eventsByJob.get(jobId) ?? []), ...parsed])
    }
    catch {
      // A row whose JSON will not parse still has its text above, which is
      // correct - so the structure is dropped rather than the output.
    }
  }
  cursorByJob.set(jobId, Math.max(cursorByJob.get(jobId) ?? 0, Number(chunk.sequence) || 0))
}

/*
 * What this run produced, for whoever came to collect it.
 *
 * Read here rather than fetched, like the log above: a screen that shows the
 * jobs and then asks a second time for the files is two round trips to draw one
 * page. Guarded to an empty list on any failure - a throw in this script
 * renders the whole page with every binding undefined, and losing the run
 * because an artifact query was unhappy is a poor trade.
 */
let artifactRows: any[] = []
try {
  if (run) {
    artifactRows = await db
      .selectFrom('workflow_artifacts')
      .select(['id', 'name', 'size_bytes', 'expires_at'])
      .where('workflow_run_id', '=', Number(run.id))
      .orderBy('name')
      .execute()
  }
}
catch {
  artifactRows = []
}

const artifactList = artifactRows.map(one => ({
  id: Number(one.id),
  name: String(one.name),
  size: artifactSize(Number(one.size_bytes) || 0),
  // A date rather than "in 89 days": somebody deciding whether to download this
  // now is comparing it against a calendar.
  expires: one.expires_at ? String(one.expires_at).slice(0, 10) : '',
}))

const version: any = run
  ? await db
      .selectFrom('workflow_versions')
      .select(['id', 'workflow_id', 'source_path', 'source_sha'])
      .where('id', '=', Number(run.workflow_version_id))
      .executeTakeFirst()
  : null

const workflow: any = version
  ? await db
      .selectFrom('workflows')
      .select(['id', 'name', 'path'])
      .where('id', '=', Number(version.workflow_id))
      .executeTakeFirst()
  : null

/**
 * Whether this reader may stop this run.
 *
 * Asked with `workflow:cancel`, which is the ability the action itself checks,
 * rather than the broader `repository:write` it happens to sit at today. The
 * two are the same level now and are separate on purpose - a person who can
 * cancel a run need not be able to report a passing check - and a button whose
 * visibility is decided by a different rule than the one enforcing it is a
 * button that either lies or hides.
 *
 * Read access is not enough: a public repository is readable by everybody, and
 * a cancel button everybody can press is a denial of service with an
 * affordance.
 */
/*
 * Who is shown the remedy for a stuck run.
 *
 * The same ability the cancel control asks for. Somebody who can stop a run is
 * somebody who is responsible for this repository's CI, which is the closest
 * this page can get to "would know what to do with a command".
 */
const canAdminister = Boolean(repoAccess?.can?.('workflow:cancel'))

const canCancel = Boolean(run)
  && !runIsFinished(String(run.state))
  && Boolean(repoAccess?.can?.('workflow:cancel'))

/*
 * The runners this instance has, read only when something is actually waiting.
 *
 * A run whose jobs have all finished has nothing to explain, and a query per
 * page view for a screen nobody is puzzled by is a query nobody asked for.
 */
const anyQueued = jobRows.some(job => String(job.state) === 'queued')

/*
 * The queues runners serve, so the explanation below can tell a drained queue
 * from a machine that is switched off. Read once for the page rather than per
 * job: a run with forty queued jobs asks the same question forty times.
 */
const queueRows: any[] = anyQueued
  ? await db
      .selectFrom('runner_queues')
      .innerJoin('runner_pools', 'runner_pools.id', '=', 'runner_queues.runner_pool_id')
      .select([
        'runner_queues.id as id',
        'runner_queues.name as name',
        'runner_queues.state as state',
        'runner_queues.paused_reason as paused_reason',
        'runner_pools.id as pool_id',
        'runner_pools.name as pool_name',
      ])
      .execute()
  : []

const poolRepositoryRows: any[] = queueRows.length > 0
  ? await db.selectFrom('runner_pool_repositories').select(['runner_pool_id', 'repository_id']).execute()
  : []

const queuesById = new Map<number, any>(queueRows.map((row: any) => [Number(row.id), {
  id: Number(row.id),
  name: String(row.name),
  state: String(row.state),
  poolId: Number(row.pool_id),
  poolName: String(row.pool_name),
  pausedReason: row.paused_reason ? String(row.paused_reason) : null,
  repositoryIds: poolRepositoryRows
    .filter((entry: any) => Number(entry.runner_pool_id) === Number(row.pool_id))
    .map((entry: any) => Number(entry.repository_id)),
}]))

const runnerFacts = anyQueued
  ? (await db.selectFrom('runners').select(['id', 'state', 'scope_type', 'scope_id', 'labels']).execute())
      .map(runner => ({
        id: Number(runner.id),
        state: String(runner.state),
        scopeType: String(runner.scope_type),
        scopeId: runner.scope_id === null ? null : Number(runner.scope_id),
        labels: String(runner.labels ?? '').split('\n').map(line => line.trim()).filter(Boolean),
        queue: queuesById.get(Number(runner.runner_queue_id ?? 0)) ?? null,
      }))
  : []

/**
 * A gate's prompt and fields, out of the settings column.
 *
 * Unreadable settings mean a gate with no fields rather than a page that
 * fails: the gate is the point, and a field list this cannot parse should not
 * be the reason nobody can approve a deployment.
 */
function gateOf(settings: unknown): { prompt: string, fields: any[] } {
  try {
    const parsed = JSON.parse(String(settings ?? '{}'))

    return {
      prompt: typeof parsed?.prompt === 'string' ? parsed.prompt : 'Continue?',
      fields: Array.isArray(parsed?.fields) ? parsed.fields : [],
    }
  }
  catch {
    return { prompt: 'Continue?', fields: [] }
  }
}

/*
 * Who opened each gate, by handle.
 *
 * "Who approved this deployment" is a question asked while looking at the run,
 * so the answer is on the row rather than in an audit log somewhere else.
 */
const approverIds = [...new Set(jobRows.map(job => Number(job.approved_by_id ?? 0)).filter(Boolean))]

const approvers = new Map<number, string>(
  approverIds.length > 0
    ? (await db.selectFrom('users').select(['id', 'handle']).where('id', 'in', approverIds).execute())
        .map((row: any) => [Number(row.id), String(row.handle)])
    : [],
)

const canApprove = Boolean(repoAccess?.can?.('workflow:approve'))

/*
 * The runs this one triggered, by number.
 *
 * A trigger job whose only trace is an id is a dead end on a screen: the point
 * of the kind is that it started something, and the reader wants to open it.
 */
const triggeredIds = [...new Set(jobRows.map(job => Number(job.triggered_run_id ?? 0)).filter(Boolean))]

const triggeredNumbers = new Map<number, number>(
  triggeredIds.length > 0
    ? (await db.selectFrom('workflow_runs').select(['id', 'number']).where('id', 'in', triggeredIds).execute())
        .map((row: any) => [Number(row.id), Number(row.number)])
    : [],
)

const jobs = jobRows.map((job) => {
  const needs = String(job.needs ?? '').split('\n').map(line => line.trim()).filter(Boolean)

  return {
    jobId: String(job.job_id),
    name: job.name ? String(job.name) : String(job.job_id),
    state: String(job.state),
    label: runLabel(String(job.state)),
    tone: runTone(String(job.state)),
    needs,
    // Said out loud rather than left for the reader to infer from a state.
    waitingOn: String(job.state) === 'blocked' && needs.length > 0 ? needs.join(', ') : '',
    /*
     * Why a queued job has not started.
     *
     * The most expensive screen in a forge is a run that sits at "queued" with
     * a spinner: it looks like the instance is thinking, so people wait, and
     * the instance knew the answer the whole time. Computed from the same rules
     * the dispatcher uses, so the page cannot explain a decision nobody made.
     */
    waitingBecause: String(job.state) === 'queued'
      ? explainWaiting({
          id: Number(job.id),
          state: String(job.state),
          runsOn: String(job.runs_on ?? '').split('\n').map(line => line.trim()).filter(Boolean),
          repositoryId: Number(repoRow?.id ?? 0),
          ownerId: Number(repoRow?.owner_id ?? 0),
          runnerId: job.runner_id ? Number(job.runner_id) : null,
          leaseExpiresAt: job.lease_expires_at ?? null,
        }, runnerFacts)
      : null,
    /*
     * Why this job is in the state it is, when the state alone does not say.
     *
     * A skipped job has no logs, no steps and no runner - the reason its `if:`
     * decided that is written at dispatch or it is gone - and a *cancelled* job
     * with nothing else on the row reads as "somebody pressed cancel", which is
     * wrong when it was `fail-fast` or a timeout that stopped it.
     */
    reason: job.condition_reason ? String(job.condition_reason) : '',
    /*
     * What kind of job this is. `command` is the only one a machine runs; the
     * rest are the control plane's own work and read differently on a screen -
     * a gate with no logs is waiting for somebody, not stuck.
     */
    kind: String(job.kind ?? 'command'),
    // "attempt 2" is a fact about this row, and a job that quietly ran twice
    // is a flaky test nobody ever fixes.
    attempt: Number(job.attempt ?? 1),
    group: job.group_label ? String(job.group_label) : '',
    /*
     * A gate's prompt and fields, flattened onto the job rather than nested.
     *
     * `@foreach (job.gate.fields as field)` inside `@foreach (jobs as job)`
     * renders nothing: stx resolves a *property* of a loop variable but not a
     * path through one, and the failure is an empty region rather than an
     * error. One level is the shape that works.
     */
    gatePrompt: String(job.kind ?? '') === 'block' ? gateOf(job.settings).prompt : '',
    gateFields: String(job.kind ?? '') === 'block' ? gateOf(job.settings).fields : [],
    /** Only a gate that is actually waiting, and only for somebody who may open it. */
    openable: String(job.state) === 'paused' && canApprove,
    approvedBy: approvers.get(Number(job.approved_by_id ?? 0)) ?? '',
    triggeredRun: job.triggered_run_id ? Number(job.triggered_run_id) : 0,
    triggeredRunNumber: triggeredNumbers.get(Number(job.triggered_run_id ?? 0)) ?? 0,
    /*
     * The summary, rendered here rather than in the template.
     *
     * It is markdown from a step, which is to say from whoever can push to the
     * repository, so it goes through the same constructed-HTML renderer every
     * issue body does - nothing is sanitized, the HTML is built tag by tag from
     * a closed set. Rendering in the template would mean markup assembled where
     * nobody escaped it.
     */
    summaryHtml: summaryByName.has(job.name ? String(job.name) : String(job.job_id))
      ? renderMarkdown(summaryByName.get(job.name ? String(job.name) : String(job.job_id))!, {
          owner: ownerHandle,
          repository: repositoryName,
          // Headings come from a step's markdown, and an id is a global name on
          // the page: without a prefix a summary titled "files" could steal the
          // page's own anchor.
          headingIdPrefix: `summary-${Number(job.id)}-`,
        })
      : '',
    /*
     * A red job on a green run, said out loud.
     *
     * `continue-on-error` is the one case where a failed job is not a problem,
     * and a screen that shows the failure without the permission has somebody
     * hunting a broken build that the workflow expected.
     */
    allowedToFail: job.continue_on_error === true && String(job.state) === 'failed',
    runsOn: String(job.runs_on ?? '').split('\n').map(line => line.trim()).filter(Boolean).join(', '),
    runner: job.runner_id ? String(job.runner_id) : '',
    duration: runDuration(job.started_at, job.finished_at),
    /*
     * How long it waited for a machine, kept separate from how long it ran.
     *
     * A slow run is usually a queue problem, and one combined number cannot
     * say which - "eleven minutes" reads as a slow job whether the job took
     * eleven minutes or waited nine of them. A job still waiting measures
     * against now on purpose: on a live run the wait is the thing growing, and
     * that is exactly what somebody staring at this page wants to see.
     */
    queueTime: job.queued_at
      ? runDuration(job.queued_at, job.started_at ?? null)
      : '',
    // Trimmed of trailing blank lines only: everything else is what the job
    // printed, and a log this screen edited is a log nobody can trust.
    log: (logByJob.get(Number(job.id)) ?? '').replace(/\s+$/, ''),
    /*
     * The rendered log: groups a reader can fold, colour a test runner meant,
     * links that are links. Built here rather than in the template because it
     * is markup, and markup assembled in a template is markup nobody escaped.
     */
    logHtml: renderLog(
      eventsByJob.get(Number(job.id))
      ?? eventsFromText((logByJob.get(Number(job.id)) ?? '').replace(/\s+$/, '')),
      { failed: String(job.state) === 'failed' },
    ),
    // The row id the log endpoint is keyed on, and where this page's copy of
    // the output ends.
    id: Number(job.id),
    cursor: cursorByJob.get(Number(job.id)) ?? 0,
    // A job that has finished has nothing more to say, so nothing follows it.
    live: !['succeeded', 'failed', 'cancelled', 'skipped'].includes(String(job.state)),
    steps: (stepsByJob.get(Number(job.id)) ?? []).map(step => ({
      name: step.name ? String(step.name) : `Step ${Number(step.position) + 1}`,
      state: String(step.state),
      label: runLabel(String(step.state)),
      tone: runTone(String(step.state)),
      attempts: Number(step.attempts ?? 0),
    })),
  }
})

/*
 * The heading each group prints once.
 *
 * Computed as a pass over the jobs in their declared order rather than by
 * grouping them into containers: a run screen that re-sorts jobs disagrees with
 * the file it came from, and the order is what a reader is checking against.
 */
let lastGroup = ''

for (const job of jobs) {
  job.groupHeading = job.group && job.group !== lastGroup ? job.group : ''
  lastGroup = job.group || lastGroup
}

const ref = String(run?.event_ref ?? '')
const branch = ref.startsWith('refs/heads/')
  ? ref.slice('refs/heads/'.length)
  : ref.startsWith('refs/tags/') ? ref.slice('refs/tags/'.length) : ref

const headSha = run?.head_sha ? String(run.head_sha) : ''
const definitionSha = run?.definition_sha ? String(run.definition_sha) : ''
const definitionDiffers = Boolean(headSha && definitionSha && headSha !== definitionSha)

const base = `/${ownerHandle}/${repositoryName}`
</script>

@layout('app')

@section('content')
  <div class="shell" style="padding-top: 22px; padding-bottom: 64px;">
    @if (!repoRow || !run)
      <div class="panel" style="padding: 32px; text-align: center;">
        <h1 style="font-size: 20px;">No such workflow run</h1>
        <p class="muted" style="margin-top: 8px;">
          <a href="{{ base }}/runs">All runs</a>
        </p>
      </div>
    @else
      <header class="repo-head">
        <h1 class="repo-title">
          <a href="/{{ ownerHandle }}">{{ ownerHandle }}</a><span class="muted">/</span><a href="{{ base }}">{{ repositoryName }}</a>
        </h1>
      </header>

      <RepoTabs owner="{{ ownerHandle }}" repository="{{ repositoryName }}" active="runs" />

      <div class="panel run-head">
        <div class="run-head-main">
          <h2 class="run-title">
            {{ workflow ? workflow.name : 'Workflow' }} <span class="muted">#{{ run.number }}</span>
          </h2>

          <p class="muted run-head-meta">
            <span class="run-dot run-{{ runTone(String(run.state)) }}" aria-hidden="true"></span>
            {{ runLabel(String(run.state)) }}
            · {{ run.event }}
            @if (branch)
              · {{ branch }}
            @endif
            @if (headSha)
              · <code>{{ shortSha(headSha) }}</code>
            @endif
            @if (runDuration(run.started_at, run.finished_at))
              · {{ runDuration(run.started_at, run.finished_at) }}
            @endif
          </p>

          @if (run.conclusion_reason)
            <p class="muted" style="margin-top: 8px; font-size: 13px;">{{ run.conclusion_reason }}</p>
          @endif
        </div>
      </div>

      @if (definitionDiffers)
        <div class="panel notice">
          The workflow that ran came from <code>{{ shortSha(definitionSha) }}</code>, not from the
          commit under test. That is how a pull request from a fork runs: the definition is the base
          branch's, so a fork cannot supply its own.
        </div>
      @endif

      @if (!run.trusted)
        <div class="panel notice">
          This run is untrusted, so it gets no secrets. A run from a fork stays untrusted until
          somebody with write access approves the exact commit.
        </div>
      @endif

      {{-- Reports, never rewrites: see the note in the component. --}}
      @if (!runIsFinished(String(run.state)))
        <RunLive owner="{{ ownerHandle }}" repository="{{ repositoryName }}" number="{{ runNumber }}" />
      @endif

      <div class="jobs">
        @foreach (jobs as job)
          {{--
            A group heading, when this job's group differs from the one before
            it. A run of two hundred jobs reads as eight things this way, and
            the jobs stay in the order the file declared rather than being
            re-sorted into containers - which would make a run screen disagree
            with the file it came from.
          --}}
          @if (job.groupHeading)
            <h3 class="job-group">{{ job.groupHeading }}</h3>
          @endif

          <article class="panel job">
            <header class="job-head">
              <span class="run-dot run-{{ job.tone }}" aria-hidden="true"></span>
              <h3 class="job-name">{{ job.name }}</h3>
              <span class="muted job-state">{{ job.label }}@if (job.attempt > 1) · attempt {{ job.attempt }}@endif</span>
              {{--
                Waited, then ran. Two numbers rather than one, because a run
                that is slow because nothing could take its jobs is a different
                afternoon's work from one that is slow because the jobs are.
              --}}
              @if (job.queueTime)
                <span class="muted job-time">waited {{ job.queueTime }}</span>
              @endif
              @if (job.duration)
                <span class="muted job-time">{{ job.queueTime ? 'ran' : '' }} {{ job.duration }}</span>
              @endif
            </header>

            {{--
              Why a queued job has not started. The instance knows - no runner
              has `macos-14`, or the only one that matches was switched off this
              morning - and a spinner is what it says instead when nobody
              writes this paragraph.
            --}}
            @if (job.waitingBecause && job.waitingBecause.kind !== 'ready')
              <p class="job-waiting">{{ job.waitingBecause.summary }}</p>

              {{--
                And what to do about it, to the people who can. Everybody
                deserves to know why a run is stuck; only somebody who
                administers the instance can act on "run this command", and a
                shell command shown to every visitor is noise.
              --}}
              @if (canAdminister && job.waitingBecause.fix)
                <p class="job-waiting job-fix">{{ job.waitingBecause.fix }}</p>
              @endif
            @endif

            {{--
              And why a job that will never run, or was stopped by something
              other than a person, ended where it did.
            --}}
            @if (job.reason)
              <p class="job-waiting">{{ job.reason }}</p>
            @endif

            @if (job.allowedToFail)
              <p class="job-waiting">This job failed and the workflow allows it to: continue-on-error is set, so the run is not failed by it.</p>
            @endif

            <p class="muted job-meta">
              @if (job.waitingOn)
                Waiting for {{ job.waitingOn }}
              @elseif (job.runsOn)
                Runs on {{ job.runsOn }}
              @endif
              @if (job.runner)
                · {{ job.runner }}
              @endif
            </p>

            {{--
              What the job wrote about itself, before what it printed. A run
              page that shows ten thousand lines of output and not the
              paragraph the job wrote to be read has the two the wrong way
              round.
            --}}
            @if (job.summaryHtml)
              <section class="job-summary">
                {!! job.summaryHtml !!}
              </section>
            @endif

            {{--
              A gate waiting for a person, and the form that opens it. Posted
              to the same public action the API calls, like the cancel control
              above it.
            --}}
            @if (job.gatePrompt && job.state === 'paused')
              <div class="job-gate">
                <p class="job-gate-prompt">{{ job.gatePrompt }}</p>

                @if (job.openable)
                  <form method="post" action="/api/repos/workflow-runs/approve" class="job-gate-form">
                    <CsrfField />
                    <input type="hidden" name="owner" value="{{ ownerHandle }}">
                    <input type="hidden" name="repo" value="{{ repositoryName }}">
                    <input type="hidden" name="number" value="{{ runNumber }}">
                    <input type="hidden" name="job" value="{{ job.jobId }}">

                    @foreach (job.gateFields as field)
                      <label class="job-gate-field">
                        <span>{{ field.label }}</span>

                        @if (field.type === 'select')
                          <select name="{{ field.key }}">
                            @foreach (field.options as option)
                              <option value="{{ option }}">{{ option }}</option>
                            @endforeach
                          </select>
                        @elseif (field.type === 'boolean')
                          <select name="{{ field.key }}">
                            <option value="false">false</option>
                            <option value="true">true</option>
                          </select>
                        @else
                          <input type="text" name="{{ field.key }}" value="{{ field.default ?? '' }}">
                        @endif
                      </label>
                    @endforeach

                    <button class="button" type="submit">Approve</button>
                  </form>
                @else
                  <p class="muted job-gate-note">Somebody with write access to this repository can open this.</p>
                @endif
              </div>
            @endif

            @if (job.approvedBy)
              <p class="muted job-meta">Opened by {{ job.approvedBy }}</p>
            @endif

            @if (job.triggeredRun)
              <p class="muted job-meta">
                Started <a href="/{{ ownerHandle }}/{{ repositoryName }}/run/{{ job.triggeredRunNumber }}">run #{{ job.triggeredRunNumber }}</a>
              </p>
            @endif

            @if (job.log || job.live)
              <details class="log"@if (job.live) open @endif>
                <summary>Output</summary>
                {{-- `pre` and nothing else. This text came off a machine
                     running somebody's build, so it is escaped and shown, never
                     interpreted. --}}
                @if (job.logHtml)
                  {{--
                    Already escaped: every piece of text in here went through
                    the ANSI renderer, which escapes before it decorates. The
                    bytes came off a machine running somebody's build, and a log
                    that can write a tag owns the page it is shown on.
                  --}}
                  <div class="log-body">{!! job.logHtml !!}</div>
                @elseif (job.log)
                  <pre class="log-body">{{ job.log }}</pre>
                @endif

                {{-- Everything printed after this page loaded, appended rather
                     than replacing what is above: the reader may be mid-line in
                     it. --}}
                @if (job.live)
                  <JobTail
                    owner="{{ ownerHandle }}"
                    repository="{{ repositoryName }}"
                    job="{{ job.id }}"
                    after="{{ job.cursor }}"
                  />
                @endif
              </details>
            @endif

            @if (job.steps.length > 0)
              <ol class="steps">
                @foreach (job.steps as step)
                  <li class="step">
                    <span class="run-dot run-{{ step.tone }}" aria-hidden="true"></span>
                    <span class="step-name">{{ step.name }}</span>
                    <span class="muted step-state">
                      {{ step.label }}@if (step.attempts > 1) · attempt {{ step.attempts }}@endif
                    </span>
                  </li>
                @endforeach
              </ol>
            @endif
          </article>
        @endforeach
      </div>

      @if (artifactList.length > 0)
        <section class="panel artifacts">
          <h2 class="artifacts-heading">Artifacts</h2>
          <ul class="artifact-list">
            @foreach (artifactList as artifact)
              <li class="artifact">
                <a href="/api/repos/workflow-runs/artifact?owner={{ ownerHandle }}&repo={{ repositoryName }}&id={{ artifact.id }}">{{ artifact.name }}</a>
                <span class="muted artifact-size">{{ artifact.size }}</span>
                @if (artifact.expires)
                  <span class="muted artifact-expiry">until {{ artifact.expires }}</span>
                @endif
              </li>
            @endforeach
          </ul>
        </section>
      @endif

      @if (!runIsFinished(String(run.state)))
        <div class="run-foot">
          <p class="muted run-note">
            Nothing on this instance executes a run. Jobs wait here until a runner you provide takes
            them.
          </p>

          {{--
            Posted to the same public action the API and the CLI call, rather
            than to a route that exists for this page. A control the interface
            has and the API does not is how a product grows a second, undocumented
            way to change its own state.
          --}}
          @if (canCancel)
            <form method="post" action="/api/repos/workflow-runs/cancel" class="run-cancel">
              <CsrfField />
              <input type="hidden" name="owner" value="{{ ownerHandle }}">
              <input type="hidden" name="repo" value="{{ repositoryName }}">
              <input type="hidden" name="number" value="{{ runNumber }}">
              <button class="button" type="submit">Cancel run</button>
            </form>
          @endif
        </div>
      @endif
    @endif
  </div>
@endsection

<style>
  .run-head { padding: 18px 20px; margin-top: 16px; }
  .run-head-main { display: flex; flex-direction: column; gap: 4px; }
  .run-title { font-size: 18px; font-weight: 600; margin: 0; }
  .run-head-meta { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; font-size: 13px; margin: 0; }

  .notice {
    padding: 12px 16px;
    margin-top: 12px;
    font-size: 13px;
    border-color: var(--warn, #bf8700);
  }

  /* The log, when a runner sent structure. `pre` still styles the plain half. */
  .log-line { display: flex; gap: 10px; white-space: pre-wrap; word-break: break-word; }
  .log-time { color: var(--muted); flex: none; font-variant-numeric: tabular-nums; }
  .log-text { flex: 1; }
  .log-stderr .log-text { color: var(--bad); }

  .log-group { margin: 2px 0; }
  .log-group-name { cursor: pointer; font-weight: 600; }
  .log-group-body { padding-left: 14px; border-left: 1px solid var(--line); margin-top: 4px; }

  /* A build's own colours. Named rather than hardcoded, so a theme decides what
     "red" is on the background the reader actually has. */
  .ansi-black { color: #555; }
  .ansi-red, .ansi-bright-red { color: var(--bad); }
  .ansi-green, .ansi-bright-green { color: var(--ok); }
  .ansi-yellow, .ansi-bright-yellow { color: var(--warn); }
  .ansi-blue, .ansi-bright-blue { color: var(--accent, #2f6feb); }
  .ansi-magenta, .ansi-bright-magenta { color: #a371f7; }
  .ansi-cyan, .ansi-bright-cyan { color: #1b7c83; }
  .ansi-white, .ansi-bright-white { color: var(--fg); }
  .ansi-bold { font-weight: 700; }
  .ansi-dim { opacity: 0.7; }
  .ansi-italic { font-style: italic; }
  .ansi-underline { text-decoration: underline; }

  .artifacts { padding: 15px 17px; margin-top: 16px; }
  .artifacts-heading { font-size: 14px; font-weight: 600; margin: 0; }
  .artifact-list { margin-top: 10px; display: flex; flex-direction: column; gap: 7px; }
  .artifact { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; font-size: 13.5px; }
  .artifact-size, .artifact-expiry { font-size: 12.5px; }

  .run-dot { width: 9px; height: 9px; border-radius: 999px; flex: none; background: var(--muted); display: inline-block; }
  .run-good { background: var(--ok); }
  .run-bad { background: var(--bad); }
  .run-warn { background: var(--warn); }
  .run-running { background: var(--accent); }

  .jobs { display: grid; gap: 10px; margin-top: 14px; }

  .run-foot {
    display: flex;
    gap: 14px;
    align-items: center;
    justify-content: space-between;
    margin-top: 14px;
    flex-wrap: wrap;
  }

  .run-note { font-size: 12.5px; margin: 0; }
  .run-cancel { margin: 0; }

  /* Closed by default: a run with six jobs is a page of scrollback otherwise,
    and the reader opening this usually wants the one that failed. */
  .log { margin-top: 10px; }

  .job-summary {
    margin: 10px 0 0;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface-2, var(--surface));
    font-size: 14px;
    line-height: 1.55;
    overflow-x: auto;
  }

  .job-summary > :first-child { margin-top: 0; }
  .job-summary > :last-child { margin-bottom: 0; }
  .job-summary table { border-collapse: collapse; }
  .job-summary th, .job-summary td { border: 1px solid var(--border); padding: 4px 8px; text-align: left; }

  .job-fix { opacity: 0.85; }

  .job-group {
    margin: 22px 0 2px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .job-gate {
    margin: 10px 0 0;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .job-gate-prompt { margin: 0 0 10px; font-weight: 600; }
  .job-gate-form { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 10px; }
  .job-gate-field { display: flex; flex-direction: column; gap: 4px; font-size: 13px; }
  .job-gate-note { margin: 0; font-size: 13px; }

  .log > summary {
    cursor: pointer;
    font-size: 12.5px;
    color: var(--muted);
    padding: 4px 0;
  }

  .log > summary:hover { color: var(--text); }

  .log-body {
    margin: 6px 0 0;
    padding: 10px 12px;
    max-height: 420px;
    overflow: auto;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.55;
    /* Wrapped rather than scrolled sideways: a build line is long because a
      path is long, and reading it should not be a horizontal errand. */
    white-space: pre-wrap;
    word-break: break-word;
  }
  .job { padding: 14px 18px; }

  .job-head { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
  .job-name { font-size: 15px; font-weight: 550; margin: 0; }
  .job-state { font-size: 12.5px; }

  .job-waiting {
    margin: 10px 0 0;
    padding: 8px 12px;
    font-size: 12.5px;
    border-left: 2px solid var(--warn);
    background: var(--panel-2, transparent);
  }
  .job-time { font-size: 12.5px; margin-left: auto; }
  .job-meta { font-size: 12.5px; margin: 6px 0 0; }

  .steps { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 6px; }

  .step {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 6px 10px;
    border: 1px solid var(--line);
    border-radius: var(--r-field, 10px);
    font-size: 13px;
  }

  .step-name { flex: 1; min-width: 0; }
  .step-state { font-size: 12px; }
</style>
