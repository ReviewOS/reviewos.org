<script server>
/**
 * One commit: who wrote it, what it says, and what it changed.
 *
 * The file list only, with counts - not the patch. A commit touching four
 * hundred files would otherwise render the whole diff into one page, and the
 * review screen is where a diff belongs anyway.
 *
 * Same division as every other browse screen: reading is
 * `app/Actions/Browse/load`, shaping is `resources/functions/browse`, and this
 * lays it out.
 */
import { repositoryForView, repositoryHeaderActions, verifySignature } from '../../../../functions/repo'
import { commitDetail, relativeTime, shortSha, signatureBadge } from '../../../../functions/browse'
// Asked for here rather than through a helper: `setResponseStatus` is a
// context binding, in scope only inside this script. See the note in
// `resources/components/RepoBrowser.stx`.
const setStatus = typeof setResponseStatus === 'function' ? setResponseStatus : () => {}

const ownerHandle = String(params.owner)
const repositoryName = String(params.repository)
const revision = String(params.sha ?? '')

// Resolved and permission-checked together. A repository the reader may not
// see comes back null, exactly as one that does not exist does, so a private
// repository does not announce itself by answering differently.
/**
 * The request, when there is one, without naming a binding that may not exist.
 *
 * stx declares `__stxServeContext` on the path that serves a request and on no
 * other, and an *undeclared* identifier is a ReferenceError - which optional
 * chaining does not save, because `x?.y` throws on `x` before the chain is
 * reached. It throws inside the server script's IIFE, so it takes every other
 * variable in this file down with it and the page renders its not-found branch
 * as though the answer were no.
 *
 * The globalThis mirror is not the fix: it is shared between concurrent
 * requests, so reading cookies off it could hand one reader another reader's
 * session.
 */
const serveContext = __stxServeContext

const repoAccess = await repositoryForView(ownerHandle, repositoryName, serveContext?.cookies)
const repoRow: any = repoAccess?.repository ?? null
// Star and watch, for the header. One line here rather than each screen
// re-deriving the viewer, the counts and the labels - see
// `app/Actions/Repo/standing.ts`.
const repoActions = await repositoryHeaderActions(repoAccess, ownerHandle, repositoryName)


// A page that renders "no such repository" under a 200 tells a crawler, a
// cache and an uptime check that the page is fine. Only the render knows.
if (!repoRow)
  setStatus(404)

const commit = repoRow ? await commitDetail(String(repoAccess?.diskPath ?? ''), revision) : null

// And the same for the commit itself, which had the argument above written
// over it and only half applied: a repository that exists and a revision that
// does not still answered 200, and a forty-character hex string is a space a
// crawler can walk forever.
if (repoRow && !commit)
  setStatus(404)

const base = `/${ownerHandle}/${repositoryName}`
const files = commit?.files ?? []

// One commit, one gpg process. Affordable here and not in a list of thirty,
// which is why the history has no badge - see `app/Actions/Git/signatures.ts`.
// Never throws: a page that renders a commit must not fail because a key is
// malformed or gpg is missing, and both of those are `unavailable`.
const signed = commit ? await verifySignature(String(repoAccess?.diskPath ?? ''), commit.sha) : null
const signature = signatureBadge(signed?.verification.status ?? 'unsigned', signed?.signer?.name ?? null)
</script>

@layout('app')

@section('title', `Commit ${String(params.sha ?? '').slice(0, 7)} · ${params.owner}/${params.repository}`)
@section('description', `One commit in ${params.owner}/${params.repository}: its message, its parents, and the diff it introduced.`)

@section('content')
  <div class="page">
    @if (!repoRow)
      <PageEmpty
        title="No such repository"
        detail="Nothing is published at {{ ownerHandle }}/{{ repositoryName }}."
        linksJson="{{ JSON.stringify([{ href: `/${ownerHandle}`, label: `Back to ${ownerHandle}` }, { href: '/explore', label: 'Explore' }]) }}"
      />
    @elseif (!commit)
      <PageEmpty
        title="No such commit"
        detail="Nothing in this repository is called {{ revision }}."
      />
    @else
      {{-- `RepoHeader`, like every other repository screen. This one drew a
          bare title: no visibility pill, no description, no clone URL. --}}
      <RepoHeader
        owner="{{ ownerHandle }}"
        repository="{{ repositoryName }}"
        visibility="{{ repoRow.visibility }}"
        description="{{ repoRow.description ?? '' }}"
        refName=""
        size=""
        sizeKb="0"
        commits=""
        :actions="repoActions"
        :branches="[]"
        :tags="[]" />

      <RepoTabs owner="{{ ownerHandle }}" repository="{{ repositoryName }}" active="code" />

      <article class="commit-card panel">
        <h2 class="commit-subject">{{ commit.subject }}</h2>

        @if (commit.body)
          <pre class="commit-body">{{ commit.body }}</pre>
        @endif

        <div class="commit-by">
          <span>{{ commit.authorName }}</span>
          <SignatureBadge :badge="signature" />
          <span class="muted">authored {{ relativeTime(commit.authoredAt) }}</span>
          @if (commit.committerName !== commit.authorName)
            <span class="muted">&middot; {{ commit.committerName }} committed {{ relativeTime(commit.committedAt) }}</span>
          @endif
        </div>

        <dl class="commit-refs">
          <dt class="muted">commit</dt>
          <dd class="mono">{{ commit.sha }}</dd>

          @if (commit.parents.length > 0)
            <dt class="muted">{{ commit.parents.length === 1 ? 'parent' : 'parents' }}</dt>
            <dd>
              @foreach (commit.parents as parent)
                <a class="mono" href="{{ base }}/commit/{{ parent }}">{{ shortSha(parent) }}</a>
              @endforeach
            </dd>
          @endif
        </dl>
      </article>

      <div class="commit-summary">
        <span>{{ files.length }} {{ files.length === 1 ? 'file' : 'files' }} changed</span>
        <span class="add">+{{ commit.additions }}</span>
        <span class="del">&minus;{{ commit.deletions }}</span>

        {{--
          Said out loud rather than left for somebody to notice. A merge is
          diffed against its first parent, so the numbers here are what arrived
          on this branch - not the combined diff, which would be a different and
          much larger answer.
        --}}
        @if (commit.isMerge)
          <span class="muted">against the first parent</span>
        @endif
      </div>

      @if (files.length === 0)
        <div class="panel" style="padding: 28px; text-align: center;">
          <p class="muted">This commit changed no files.</p>
        </div>
      @else
        <ul class="files panel">
          @foreach (files as file)
            <li class="file-row">
              <span class="status status-{{ file.status }}" title="{{ file.status }}">{{ file.status.slice(0, 1).toUpperCase() }}</span>

              <span class="file-path mono">
                @if (file.from)
                  <span class="muted">{{ file.from }}</span> &rarr; <a href="{{ base }}/tree/{{ commit.sha }}/{{ file.path }}">{{ file.path }}</a>
                @else
                  <a href="{{ base }}/tree/{{ commit.sha }}/{{ file.path }}">{{ file.path }}</a>
                @endif
              </span>

              @if (file.binary)
                <span class="counts muted">binary</span>
              @else
                <span class="counts">
                  <span class="add">+{{ file.additions }}</span>
                  <span class="del">&minus;{{ file.deletions }}</span>
                </span>
              @endif
            </li>
          @endforeach
        </ul>
      @endif
    @endif
  </div>
@endsection

<style>
  .commit-card { padding: 18px 20px; margin-top: 16px; }
  .commit-subject { font-size: 17px; font-weight: 600; margin: 0; }

  .commit-body {
    margin: 10px 0 0;
    font-family: inherit;
    font-size: 13.5px;
    line-height: 1.55;
    white-space: pre-wrap;
    color: var(--muted);
  }

  .commit-by { margin-top: 14px; font-size: 13px; display: flex; gap: 6px; flex-wrap: wrap; }

  .commit-refs {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 14px;
    margin: 14px 0 0;
    font-size: 12.5px;
  }

  .commit-refs dt { margin: 0; }
  .commit-refs dd { margin: 0; }
  .commit-refs dd a { margin-right: 8px; }

  .commit-summary {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 20px 0 10px;
    font-size: 13px;
  }

  .files { overflow: hidden; }

  .file-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 15px;
    border-bottom: 1px solid var(--line);
  }

  .file-row:last-child { border-bottom: 0; }
  .file-path { flex: 1; min-width: 0; font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .counts { flex: none; font-size: 12.5px; display: flex; gap: 6px; }

  .add { color: var(--add, #1a7f37); }
  .del { color: var(--del, #b3261e); }

  /*
   * One letter, in a box, the way git itself writes a status. Colour carries
   * the same information a second time rather than on its own, so it still
   * reads for somebody who cannot tell the two greens apart.
   */
  .status {
    flex: none;
    width: 18px;
    height: 18px;
    display: inline-grid;
    place-items: center;
    border-radius: 4px;
    border: 1px solid var(--line);
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
  }

  .status-added { color: var(--add, #1a7f37); }
  .status-deleted { color: var(--del, #b3261e); }
  .status-renamed { color: var(--accent); }
</style>
