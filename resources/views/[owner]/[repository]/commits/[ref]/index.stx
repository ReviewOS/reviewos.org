<script server>
/**
 * Commit history for a ref.
 *
 * Same division as the browse screen: reading is `app/Actions/Browse/load`,
 * shaping is `resources/functions/browse`, and this lays it out.
 */
import { repositoryForView } from '../../../../../functions/repo'
import { commitHistory, relativeTime, shortSha } from '../../../../../functions/browse'

const ownerHandle = String(params.owner)
const repositoryName = String(params.repository)
const ref = String(params.ref ?? 'HEAD')

// Resolved and permission-checked together. A repository the reader may not
// see comes back null, exactly as a repository that does not exist does, so a
// private one does not announce itself by answering differently.
const repoAccess = await repositoryForView(ownerHandle, repositoryName, __stxServeContext?.cookies)
const repoRow: any = repoAccess?.repository ?? null

// A page that renders "no such repository" under a 200 tells a crawler, a
// cache and an uptime check that the page is fine. Only the render knows.
if (!repoRow)
  setResponseStatus(404)

// The absolute path from the resolver. `disk_path` on the row is relative to
// the repository root, so git resolved it against the server's own working
// directory, found nothing, and this page said the repository had no commits.
const commits = repoRow ? await commitHistory(String(repoAccess?.diskPath ?? ''), ref, '', 50) : []
</script>

@layout('app')

@section('content')
  <div class="shell" style="padding-top: 22px; padding-bottom: 64px;">
    @if (!repoRow)
      <div class="panel" style="padding: 32px; text-align: center;">
        <h1 style="font-size: 20px;">No such repository</h1>
      </div>
    @else
      <header class="repo-head">
        <h1 class="repo-title">
          <a href="/{{ ownerHandle }}">{{ ownerHandle }}</a><span class="muted">/</span><a href="/{{ ownerHandle }}/{{ repositoryName }}">{{ repositoryName }}</a>
        </h1>
        <p class="muted" style="margin-top: 6px;">Commits on <span class="mono">{{ ref }}</span></p>
      </header>

      @if (commits.length === 0)
        <div class="panel" style="padding: 28px; text-align: center; margin-top: 16px;">
          <p class="muted">No commits on this ref.</p>
        </div>
      @else
        <div class="panel commits">
          <ul>
            @foreach (commits as commit)
              <li class="commit-row">
                <div class="commit-main">
                  {{-- The subject is the link, because that is what somebody reads and then wants to open. --}}
                  <a class="commit-subject" href="/{{ ownerHandle }}/{{ repositoryName }}/commit/{{ commit.sha }}">{{ commit.subject }}</a>
                  <span class="muted commit-meta">{{ commit.authorName }} committed {{ relativeTime(commit.when) }}</span>
                </div>
                <a class="mono muted commit-sha" href="/{{ ownerHandle }}/{{ repositoryName }}/commit/{{ commit.sha }}">{{ shortSha(commit.sha) }}</a>
              </li>
            @endforeach
          </ul>
        </div>
      @endif
    @endif
  </div>
@endsection

<style>
  .commits { margin-top: 14px; overflow: hidden; }
  .commit-row { display: flex; align-items: center; gap: 14px; padding: 11px 15px; border-bottom: 1px solid var(--line); }
  .commit-row:last-child { border-bottom: 0; }
  .commit-main { flex: 1; min-width: 0; }
  .commit-subject { display: block; color: inherit; text-decoration: none; font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .commit-meta { display: block; margin-top: 2px; font-size: 12.5px; }
  .commit-sha { flex: none; font-size: 12.5px; }
</style>
