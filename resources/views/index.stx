<script server>
/**
 * ReviewOS marketing page.
 *
 * Design read: developer-tool landing for engineers evaluating a self-hosted
 * forge, with a precise technical language, leaning toward a minimalist
 * editorial-tech system on the Stacks stack.
 * Dials: VARIANCE 6 / MOTION 3 / DENSITY 5. A skeptical technical audience
 * distrusts spectacle, so the page argues rather than performs.
 *
 * Accent: one deep teal, everywhere. Green, red, and orange are reserved for
 * review states inside the product, so the brand cannot borrow them.
 */
const siteUrl = 'https://reviewos.org'

const siteDescription = 'An open source, self-hostable git forge built around code review. Stacked pull requests, review threads that survive a force-push, and a diff that stays fast at a hundred files.'

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      '@id': `${siteUrl}/#app`,
      name: 'ReviewOS',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Linux, macOS',
      description: siteDescription,
      license: 'https://opensource.org/licenses/MIT',
      url: `${siteUrl}/`,
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'ReviewOS',
      url: `${siteUrl}/`,
    },
  ],
})

// The bento. Exactly as many cells as entries, with three distinct surface
// treatments so it does not read as one white card repeated six times.
const capabilities = [
  {
    title: 'Review threads that hold their place',
    text: 'A thread anchors to a path, a line, a side, and the commit it was written against. Rebase the branch and it follows the line, or marks itself outdated and stays readable.',
    icon: 'i-hugeicons-comment-01',
    size: 'wide',
    tone: 'accent',
    points: [],
  },
  {
    title: 'Stacked pull requests',
    text: 'Dependent changes that merge in order. Each one diffs against its parent, so it shows only its own work.',
    icon: 'i-hugeicons-layers-01',
    size: 'tall',
    tone: 'tint',
    points: [
      'Merging a parent retargets its children',
      'Merge the whole stack in one action',
      'Detected from branch topology on push',
    ],
  },
  {
    title: 'Diffs against the merge base',
    text: 'Not against the base tip. The difference is every change you did not make, quietly added to your review.',
    icon: 'i-hugeicons-git-compare',
    points: [],
  },
  {
    title: 'Rendered on the server',
    text: 'The browser receives HTML, not a diff library and a JSON payload. A hundred files stays usable.',
    icon: 'i-hugeicons-flash',
    points: [],
  },
  {
    title: 'Ordinary bare repositories',
    text: 'Driven by the git binary, on your disk. Nothing about your history is locked inside this application.',
    icon: 'i-hugeicons-folder-01',
    tone: 'tint',
    points: [],
  },
  {
    title: 'One Postgres, one process',
    text: 'No queue cluster to operate before the first repository exists. Scale the parts that need it, later.',
    icon: 'i-hugeicons-database',
    size: 'wide',
    points: [],
  },
]

// The core path and the two tracks immediately after it. Counts mirror
// docs/todo/index.md; the full roadmap continues there.
const phases = [
  { number: '00', name: 'Bootstrap', state: 'done' },
  { number: '01', name: 'Foundation', state: 'done' },
  { number: '02', name: 'Git hosting', state: 'done' },
  { number: '03', name: 'Issues', state: 'done' },
  { number: '04', name: 'Pull requests and reviews', state: 'done' },
  { number: '05', name: 'Notifications and webhooks', state: 'done' },
  { number: '06', name: 'Search and explore', state: 'next', status: '20/21 complete' },
  { number: '07', name: 'Marketing and docs', state: 'next', status: '21/45 complete' },
]

const nots = [
  { title: 'A package registry', text: 'Not until the forge itself is good.' },
  { title: 'A wiki', text: 'Markdown in the repository covers most of it.' },
  { title: 'Projects and boards', text: 'Issues, labels, and milestones come first.' },
  { title: 'A hosted CI execution plane', text: 'Self-hosted runners work now. Running untrusted code on instance-managed infrastructure still needs a reviewed isolation model.' },
]
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>ReviewOS - a git forge built around review</title>
    <meta name="description" content="{{ siteDescription }}">
    <link rel="canonical" href="https://reviewos.org/">

    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0c1113" media="(prefers-color-scheme: dark)">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="ReviewOS">
    <meta property="og:url" content="https://reviewos.org/">
    <meta property="og:title" content="ReviewOS - a git forge built around review">
    <meta property="og:description" content="{{ siteDescription }}">
    {{-- Absolute, because a receiver resolving a relative image against its own
        host is how a card renders as a broken square. Committed at
        `public/images/og.png` and regenerated by `buddy social:card`. --}}
    <meta property="og:image" content="https://reviewos.org/images/og.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="ReviewOS: a git forge built around review">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="ReviewOS - a git forge built around review">
    <meta name="twitter:description" content="{{ siteDescription }}">
    <meta name="twitter:image" content="https://reviewos.org/images/og.png">
    <meta name="twitter:image:alt" content="ReviewOS: a git forge built around review">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap">

    <script type="application/ld+json">{!! jsonLd !!}</script>

    <style>
      /*
       * One system, two themes, driven by the operating system preference.
       *
       * Radius: panels 14px, buttons and fields 10px, status pills only are
       * fully round. Nothing else rounds.
       *
       * Accent is a single deep teal in both themes. Review states inside the
       * product own green, red, and amber, so the brand stays clear of them.
       */
      :root {
        color-scheme: light;
        --bg: #fbfbfa;
        --surface: #ffffff;
        --surface-tint: #f2f4f4;
        --line: #e2e4e3;
        --line-strong: #cdd1d0;
        --text: #12191b;
        --muted: #5d6b6e;
        --accent: #0f6d72;
        --accent-quiet: #e2f0f0;
        --accent-text: #0b565a;
        --on-accent: #ffffff;
        --pill-text: #4c585b;
        --state-done: #14663c;
        --state-done-bg: #e4f3ea;

        --r-panel: 14px;
        --r-control: 10px;
        --shadow: 0 1px 2px rgb(18 25 27 / 0.05);
      }

      @media (prefers-color-scheme: dark) {
        :root {
          color-scheme: dark;
          --bg: #0c1113;
          --surface: #121a1c;
          --surface-tint: #162023;
          --line: #222e31;
          --line-strong: #334247;
          --text: #eef2f2;
          --muted: #9aa9ac;
          --accent: #4ec5c9;
          --accent-quiet: #14292b;
          --accent-text: #7fd8db;
          --on-accent: #08201f;
          --pill-text: #a7b5b8;
          --state-done: #55c48a;
          --state-done-bg: #15291f;
          --shadow: none;
        }
      }

      * { box-sizing: border-box; }

      html { -webkit-text-size-adjust: 100%; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: Geist, ui-sans-serif, system-ui, sans-serif;
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      a { color: inherit; }

      h1, h2, h3 {
        margin: 0;
        letter-spacing: -0.025em;
        line-height: 1.1;
        font-weight: 600;
      }

      p { margin: 0; }
      ul { margin: 0; padding: 0; list-style: none; }

      .shell {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 24px;
      }

      /* Navigation: one line, 72px, no dropdowns. */
      .nav {
        position: sticky;
        top: 0;
        z-index: 20;
        display: flex;
        align-items: center;
        gap: 32px;
        height: 72px;
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 24px;
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: blur(8px);
      }

      .nav-brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        font-weight: 600;
        letter-spacing: -0.02em;
      }

      .nav-mark {
        width: 18px;
        height: 18px;
        border-radius: 5px;
        background: var(--accent);
        position: relative;
      }

      .nav-mark::after {
        content: '';
        position: absolute;
        inset: 5px 4px auto 4px;
        height: 2px;
        border-radius: 1px;
        background: var(--on-accent);
        box-shadow: 0 4px 0 var(--on-accent);
      }

      .nav-links {
        display: none;
        gap: 28px;
        margin-right: auto;
        font-size: 15px;
        color: var(--muted);
      }

      .nav-links a { text-decoration: none; }
      .nav-links a:hover { color: var(--text); }

      .nav-cta { margin-left: auto; }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 42px;
        padding: 0 18px;
        border-radius: var(--r-control);
        border: 1px solid transparent;
        font-size: 15px;
        font-weight: 500;
        text-decoration: none;
        white-space: nowrap;
      }

      .button-solid { background: var(--accent); color: var(--on-accent); }
      .button-solid:hover { background: var(--accent-text); }

      .button-quiet {
        background: var(--surface);
        border-color: var(--line-strong);
        color: var(--text);
      }
      .button-quiet:hover { border-color: var(--muted); }

      /* Hero */
      .hero {
        padding: 72px 0 80px;
      }

      .hero-title {
        font-size: clamp(2.6rem, 6.4vw, 4.4rem);
        max-width: 15ch;
      }

      .hero-title em {
        font-style: italic;
        line-height: 1.1;
        padding-bottom: 2px;
        color: var(--accent-text);
      }

      .hero-lede {
        margin-top: 22px;
        max-width: 56ch;
        font-size: clamp(1.05rem, 2vw, 1.2rem);
        color: var(--muted);
      }

      .hero-actions {
        margin-top: 34px;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      /* Terminal: real commands, not a drawn screenshot. */
      .terminal {
        margin-top: 56px;
        border: 1px solid var(--line);
        border-radius: var(--r-panel);
        background: var(--surface);
        box-shadow: var(--shadow);
        overflow: hidden;
        position: relative;
      }

      /*
       * The review of your double-click.
       *
       * Somebody double-clicking a terminal on a landing page is trying to
       * select text, which is a reasonable thing to want and is left working.
       * This sits above it and says nothing until then, in the shape of a
       * review comment - which is the joke, and also the shortest possible
       * demonstration of what this product is.
       */
      .verdict {
        position: absolute;
        top: 10px;
        right: 12px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: var(--bg);
        box-shadow: var(--shadow);
        font-size: 13px;
        line-height: 1;
        color: var(--text);
        opacity: 0;
        transform: translateY(-4px);
        transition: opacity 160ms ease, transform 160ms ease;
        pointer-events: none;
      }

      .verdict.is-shown {
        opacity: 1;
        transform: translateY(0);
      }

      .verdict-who {
        color: var(--muted);
      }

      @media (prefers-reduced-motion: reduce) {
        .verdict { transition: none; transform: none; }
        .verdict.is-shown { transform: none; }
      }

      .terminal-bar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 16px;
        border-bottom: 1px solid var(--line);
        color: var(--muted);
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 12.5px;
      }

      .terminal pre {
        margin: 0;
        padding: 18px 16px 20px;
        overflow-x: auto;
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 13.5px;
        line-height: 1.85;
      }

      .terminal .prompt { color: var(--accent-text); }
      .terminal .comment { color: var(--muted); }

      /* Section rhythm */
      .section { padding: 80px 0; }
      .section-sep { border-top: 1px solid var(--line); }

      .eyebrow {
        margin-bottom: 14px;
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 12px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent-text);
      }

      .section-title {
        font-size: clamp(1.9rem, 3.6vw, 2.6rem);
        max-width: 22ch;
      }

      .section-lede {
        margin-top: 16px;
        max-width: 62ch;
        color: var(--muted);
      }

      /* Thesis: a single argument, given room. */
      .thesis-quote {
        margin-top: 40px;
        display: grid;
        gap: 28px;
      }

      .thesis-quote p {
        font-size: clamp(1.3rem, 2.6vw, 1.7rem);
        line-height: 1.45;
        letter-spacing: -0.02em;
        max-width: 34ch;
      }

      .thesis-list {
        display: grid;
        gap: 18px;
        align-content: start;
        color: var(--muted);
      }

      .thesis-list li {
        display: grid;
        grid-template-columns: 20px 1fr;
        gap: 12px;
        align-items: start;
      }

      .thesis-list i {
        margin-top: 4px;
        width: 18px;
        height: 18px;
        color: var(--accent);
      }

      /* Bento */
      .bento {
        margin-top: 44px;
        display: grid;
        grid-template-columns: 1fr;
        gap: 14px;
      }

      .cell {
        border: 1px solid var(--line);
        border-radius: var(--r-panel);
        background: var(--surface);
        padding: 26px;
        display: grid;
        gap: 12px;
        align-content: start;
      }

      .cell-tint { background: var(--surface-tint); }

      .cell-accent {
        background: var(--accent-quiet);
        border-color: color-mix(in srgb, var(--accent) 28%, transparent);
      }

      .cell i {
        width: 22px;
        height: 22px;
        color: var(--accent);
      }

      .cell h3 { font-size: 1.12rem; }

      .cell p {
        color: var(--muted);
        font-size: 15px;
      }

      .cell-accent p { color: color-mix(in srgb, var(--text) 78%, transparent); }

      .cell-points {
        margin-top: 4px;
        display: grid;
        gap: 9px;
        font-size: 14px;
        color: var(--muted);
      }

      .cell-points li {
        padding-left: 15px;
        position: relative;
      }

      .cell-points li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 9px;
        width: 6px;
        height: 1px;
        background: var(--accent);
      }

      /* Roadmap */
      .phases {
        margin-top: 40px;
        border: 1px solid var(--line);
        border-radius: var(--r-panel);
        background: var(--surface);
        overflow: hidden;
      }

      .phase {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 16px;
        align-items: center;
        padding: 16px 22px;
        font-size: 15px;
      }

      .phase + .phase { border-top: 1px solid var(--line); }

      .phase-number {
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 13px;
        color: var(--muted);
      }

      .pill {
        border-radius: 999px;
        padding: 3px 11px;
        font-size: 12.5px;
        font-weight: 500;
        background: var(--surface-tint);
        /* Its own foreground: --muted on the tinted surface lands at 4.4:1,
          which is under AA at this size. */
        color: var(--pill-text);
      }

      .pill-done { background: var(--state-done-bg); color: var(--state-done); }
      .pill-next { background: var(--accent-quiet); color: var(--accent-text); }

      .phase-note {
        margin-top: 16px;
        color: var(--muted);
        font-size: 14px;
      }

      .phase-note a { color: var(--accent-text); font-weight: 500; }

      /* Not doing */
      .nots {
        margin-top: 40px;
        display: grid;
        gap: 30px 44px;
        grid-template-columns: 1fr;
      }

      .nots h3 {
        font-size: 1.02rem;
        display: flex;
        align-items: center;
        gap: 9px;
      }

      .nots i {
        width: 17px;
        height: 17px;
        color: var(--muted);
      }

      .nots p {
        margin-top: 7px;
        color: var(--muted);
        font-size: 15px;
        max-width: 42ch;
      }

      /* Self-host */
      .host {
        display: grid;
        gap: 34px;
        align-items: center;
      }

      .host-reqs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 22px;
      }

      .chip {
        border: 1px solid var(--line-strong);
        border-radius: var(--r-control);
        padding: 5px 12px;
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 12.5px;
        color: var(--muted);
      }

      /* Footer */
      .footer {
        border-top: 1px solid var(--line);
        padding: 60px 24px 40px;
      }

      .footer-inner {
        max-width: 1180px;
        margin: 0 auto;
        display: grid;
        gap: 40px;
        grid-template-columns: 1fr;
      }

      .footer-note {
        margin-top: 14px;
        color: var(--muted);
        font-size: 14.5px;
        max-width: 38ch;
      }

      .footer-heading {
        font-size: 13px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--muted);
        font-weight: 500;
        margin-bottom: 14px;
      }

      .footer-col li + li { margin-top: 9px; }

      .footer-col a {
        text-decoration: none;
        font-size: 15px;
        color: var(--text);
      }

      .footer-col a:hover { color: var(--accent-text); }

      .footer-legal {
        max-width: 1180px;
        margin: 44px auto 0;
        color: var(--muted);
        font-size: 13.5px;
      }

      /* Motion is restrained on purpose: a settle on entry, nothing looping.
        Gated on the reduced-motion preference. */
      @media (prefers-reduced-motion: no-preference) {
        .settle {
          animation: settle 520ms cubic-bezier(0.22, 0.8, 0.3, 1) both;
        }

        @keyframes settle {
          from { opacity: 0; transform: translateY(10px); }
          to { opacity: 1; transform: none; }
        }
      }

      @media (min-width: 768px) {
        .nav-links { display: flex; }
        .hero { padding-top: 96px; }
        .thesis-quote { grid-template-columns: 1.05fr 1fr; gap: 56px; }
        .nots { grid-template-columns: 1fr 1fr; }
        .host { grid-template-columns: 1fr 1fr; gap: 56px; }
        .footer-inner { grid-template-columns: 2fr 1fr 1fr; }
      }

      @media (min-width: 1024px) {
        .bento { grid-template-columns: repeat(3, 1fr); }
        .cell-wide { grid-column: span 2; }
        .cell-tall { grid-row: span 2; }
      }
    </style>
  </head>

  <body>
    <MarketingNav />

    <main>
      <section class="hero shell">
        <h1 class="hero-title settle">
          The forge that takes <em>review</em> seriously
        </h1>

        <p class="hero-lede settle">
          Most forges treat review as a tab on a pull request. ReviewOS is built around it, on
          hardware you own.
        </p>

        <div class="hero-actions settle">
          <a class="button button-solid" href="/docs/todo/">Read the roadmap</a>
          <a class="button button-quiet" href="https://github.com/ReviewOS/reviewos.org">
            <i class="i-hugeicons-github" aria-hidden="true"></i>
            Browse the source
          </a>
        </div>

        <div
          class="settle terminal"
          x-data="{ reviews: 0, verdicts: ['Approved.', 'Approved again. Nothing changed.', 'Requesting changes: consider one click.', 'Nit: this is a terminal, not a button.', 'LGTM. Shipping it.', 'Reviewed six times. Adding you to CODEOWNERS.'] }"
          @dblclick="reviews = reviews + 1"
        >
          <div class="verdict" x-class="{ 'is-shown': reviews > 0 }" role="status" aria-live="polite">
            <span class="verdict-who">reviewos</span>
            <span>{{ reviews > 0 ? verdicts[(reviews < verdicts.length ? reviews : verdicts.length) - 1] : '' }}</span>
          </div>
          <div class="terminal-bar">
            <i class="i-hugeicons-command-line" aria-hidden="true"></i>
            reviewos.localhost
          </div>
          <pre><code><span class="comment"># Bun, PostgreSQL and git are installed and started for you</span>
<span class="prompt">$</span> ./buddy setup
<span class="prompt">$</span> ./buddy dev

<span class="comment"># then push the way you already do</span>
<span class="prompt">$</span> git remote add origin https://reviewos.localhost/you/project.git
<span class="prompt">$</span> git push -u origin main</code></pre>
        </div>
      </section>

      <section class="section section-sep shell">
        <h2 class="section-title">Review is where the time goes, and where the tools give up</h2>

        <div class="thesis-quote">
          <p>
            A hundred-file diff loads slowly, a rebase drops half the conversation, and a large
            change arrives as one unreviewable lump because splitting it is more work than
            explaining it.
          </p>

          <ul class="thesis-list">
            <li>
              <i class="i-hugeicons-checkmark-circle-02" aria-hidden="true"></i>
              <span>Threads anchored to a commit, so a rebase moves them instead of losing them.</span>
            </li>
            <li>
              <i class="i-hugeicons-checkmark-circle-02" aria-hidden="true"></i>
              <span>Stacks as a first class object, so a big change can arrive in reviewable pieces.</span>
            </li>
            <li>
              <i class="i-hugeicons-checkmark-circle-02" aria-hidden="true"></i>
              <span>Server-rendered diffs, so the size of the change is the reviewer's problem and not the browser's.</span>
            </li>
          </ul>
        </div>
      </section>

      <section class="section section-sep shell">
        <h2 class="section-title">What that means concretely</h2>
        <p class="section-lede">
          The decisions below are the ones that make review better or worse. Everything else follows
          from them.
        </p>

        <div class="bento">
          @foreach (capabilities as item)
            <article class="cell @if (item.size === 'wide')cell-wide@endif @if (item.size === 'tall')cell-tall@endif @if (item.tone === 'tint')cell-tint@endif @if (item.tone === 'accent')cell-accent@endif">
              <i class="{{ item.icon }}" aria-hidden="true"></i>
              <h3>{{ item.title }}</h3>
              <p>{{ item.text }}</p>
              @if (item.points)
                <ul class="cell-points">
                  @foreach (item.points as point)
                    <li>{{ point }}</li>
                  @endforeach
                </ul>
              @endif
            </article>
          @endforeach
        </div>
      </section>

      <section class="section section-sep shell">
        <p class="eyebrow">Where it is</p>
        <h2 class="section-title">The core forge is here</h2>
        <p class="section-lede">
          Repositories, issues, pull requests, reviews, notifications, and webhooks are implemented.
          Search, discovery, and the public site are the current open tracks.
        </p>

        <div class="phases">
          @foreach (phases as phase)
            <div class="phase">
              <span class="phase-number">{{ phase.number }}</span>
              <span>{{ phase.name }}</span>
              @if (phase.state === 'done')
                <span class="pill pill-done">Done</span>
              @elseif (phase.state === 'next')
                <span class="pill pill-next">{{ phase.status }}</span>
              @else
                <span class="pill">Planned</span>
              @endif
            </div>
          @endforeach
        </div>

        <p class="phase-note">
          Diff performance, mirroring, pipelines, and the remaining work stay visible in the
          <a href="/docs/todo/">full roadmap</a>.
        </p>
      </section>

      <section class="section section-sep shell">
        <h2 class="section-title">Deliberately not doing</h2>
        <p class="section-lede">
          Saying so keeps these from being re-proposed every few weeks, and keeps the roadmap
          readable.
        </p>

        <div class="nots">
          @foreach (nots as item)
            <div>
              <h3>
                <i class="i-hugeicons-minus-sign-circle" aria-hidden="true"></i>
                {{ item.title }}
              </h3>
              <p>{{ item.text }}</p>
            </div>
          @endforeach
        </div>
      </section>

      <section class="section section-sep shell">
        <div class="host">
          <div>
            <p class="eyebrow">Self-hosting</p>
            <h2 class="section-title">One command, on your own machine</h2>
            <p class="section-lede">
              Pantry installs and starts the toolchain, creates the database from your environment
              file, and runs the migrations. Nothing needs to be installed first.
            </p>

            <div class="host-reqs">
              <span class="chip">Bun 1.3.14</span>
              <span class="chip">PostgreSQL 17</span>
              <span class="chip">git 2.47</span>
              <span class="chip">MIT</span>
            </div>
          </div>

          <div class="terminal" style="margin-top: 0">
            <div class="terminal-bar">
              <i class="i-hugeicons-source-code" aria-hidden="true"></i>
              install
            </div>
            <pre><code><span class="prompt">$</span> git clone https://github.com/ReviewOS/reviewos.org.git
<span class="prompt">$</span> cd reviewos.org
<span class="prompt">$</span> ./buddy setup

<span class="comment"># PostgreSQL started, database created, migrations applied</span>
<span class="prompt">$</span> ./buddy dev</code></pre>
          </div>
        </div>
      </section>
    </main>

    <MarketingFooter />
  </body>
</html>
