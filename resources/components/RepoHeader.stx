{{--
  Who owns this, what it is, and which ref you are on.

  The same three facts every repository page opens with, so every repository
  page draws them from here rather than from a copy of them. The clone URL is
  in the header rather than beside the file list because an empty repository is
  where it matters most: there is nothing to browse yet, and the URL is what
  somebody pushes their first commit to.
--}}
<header class="repo-head">
  <div class="repo-title-row">
    <h1 class="repo-title">
      <a href="/{{ owner }}">{{ owner }}</a><span class="muted">/</span><a href="/{{ owner }}/{{ repository }}">{{ repository }}</a>
    </h1>
    <span class="pill pill-{{ visibility }}">{{ visibility }}</span>
    <CloneUrlBox owner="{{ owner }}" repository="{{ repository }}" />

    {{-- Star and watch, pushed to the far end. Null on a screen that has not
        read the reader's standing yet, and then nothing is drawn - a control
        that cannot say whether it has been pressed is worse than none. --}}
    @if (actions)
      <div class="repo-head-actions">
        <RepoActions
          :signedIn="actions.signedIn"
          owner="{{ actions.owner }}"
          repository="{{ actions.repository }}"
          next="{{ actions.next }}"
          signInHref="{{ actions.signInHref }}"
          :star="actions.star"
          watchers="{{ actions.watchers }}"
          watchLabel="{{ actions.watchLabel }}"
          :watching="actions.watching"
          watchTitle="{{ actions.watchTitle }}"
          :choices="actions.choices" />
      </div>
    @endif
  </div>

  @if (description)
    <p class="muted repo-description">{{ description }}</p>
  @endif

  {{-- Only where refs were read. The issue and pull-request lists are database
      pages that touch no git at all, and loading branches, a commit count and a
      size for the chrome above them would be three git processes for a line
      nobody came for. They render the identity block and stop. --}}
  @if (branches.length > 0)
  <div class="muted repo-meta">
    <BranchPicker :branches="branches" :tags="tags" current="{{ refName }}" />

    @if (branches.length > 1)
      <span>&middot; {{ branches.length }} branches</span>
    @endif

    {{-- The count, when the ref has one. The line used to read
        `main · 2 branches · commits · 0 B`: a row of counts with a bare word
        in the middle, which reads as a number that failed to render. --}}
    <span>&middot; <a href="/{{ owner }}/{{ repository }}/commits/{{ refName }}">{{ commits ? `${commits} ${Number(commits) === 1 ? 'commit' : 'commits'}` : 'Commits' }}</a></span>

    {{-- Only when somebody has measured it. `size_kb` is 0 on every repository
        nothing has counted yet, and "0 B" beside a page full of files is the
        header stating something false rather than staying quiet. --}}
    @if (Number(sizeKb ?? 0) > 0)
      <span>&middot; {{ size }}</span>
    @endif
  </div>
  @endif
</header>

<style>
  .repo-head { padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .repo-title-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

  /* `auto` on the left margin rather than `space-between` on the row: the
    title, the visibility pill and the clone box stay grouped, and the controls
    go to the far end without the gap between the first three growing. */
  .repo-head-actions { margin-left: auto; }
  .repo-title { font-size: 20px; font-weight: 600; }
  .repo-title a { text-decoration: none; }
  .repo-title a:hover { text-decoration: underline; }
  .repo-description { margin-top: 6px; font-size: 14px; }
  .repo-meta { margin-top: 8px; font-size: 13px; display: flex; gap: 6px; align-items: center; }
</style>
