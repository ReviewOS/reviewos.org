<script server>
/**
 * The landing page footer.
 *
 * Where Use cases and Compare live now. They came off the top bar because they
 * are read once, before deciding, and the bar has to carry the things a
 * returning reader uses - Discover, the source, the docs. Demoting them is not
 * hiding them: every page in both catalogs is linked here, which is more than
 * the mega menus showed, since those capped at what fitted in a panel.
 *
 * Built from the one catalog in resources/functions/marketing, so a page that
 * exists and a link to it cannot drift apart.
 */
import { COMPARISONS, USE_CASES } from '../functions/marketing'
import { SOURCE_ISSUES_PATH, SOURCE_PATH, UPSTREAM_URL } from '../functions/site'

const columns = [
  {
    heading: 'Use cases',
    links: USE_CASES.map(useCase => ({ label: useCase.name, href: `/for/${useCase.slug}` })),
  },
  {
    heading: 'Compare',
    links: COMPARISONS.map(comparison => ({ label: comparison.name, href: `/compare/${comparison.slug}` })),
  },
  {
    heading: 'Project',
    links: [
      { label: 'Discover', href: '/discover' },
      { label: 'Roadmap', href: '/docs/todo/' },
      { label: 'Documentation', href: '/docs' },
      // Ours first. The GitHub mirror is still listed, one line down and
      // labelled as a mirror, because it is where releases are cut and where
      // most people will arrive from - but a forge should not send a reader
      // somewhere else to read its own code.
      { label: 'Source', href: SOURCE_PATH },
      { label: 'Issues', href: SOURCE_ISSUES_PATH },
      { label: 'GitHub mirror', href: UPSTREAM_URL },
    ],
  },
  {
    heading: 'Built with',
    links: [
      { label: 'Stacks', href: 'https://stacksjs.com' },
      { label: 'Bun', href: 'https://bun.sh' },
      { label: 'PostgreSQL', href: 'https://www.postgresql.org' },
      { label: 'git', href: 'https://git-scm.com' },
    ],
  },
]
</script>

<template>
  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <a class="nav-brand" href="/" aria-label="ReviewOS home">
          <span class="nav-mark" aria-hidden="true"></span>
          <span class="nav-name">ReviewOS</span>
        </a>
        <p class="footer-note">
          An open source git forge built around code review. MIT licensed, yours to run.
        </p>
      </div>

      @foreach (columns as column)
        <div class="footer-col">
          <h2 class="footer-heading">{{ column.heading }}</h2>
          <ul>
            @foreach (column.links as link)
              <li><a href="{{ link.href }}">{{ link.label }}</a></li>
            @endforeach
          </ul>
        </div>
      @endforeach
    </div>

    <p class="footer-legal">Released under the MIT License.</p>
  </footer>
</template>

<style>
  /* Five columns now rather than three, and the two catalogs are long. The
     landing page's own `.footer-inner` grid sets the columns; this only stops
     them collapsing to one line each on a narrow screen. */
  .footer-col ul { display: grid; gap: 6px; }
</style>
