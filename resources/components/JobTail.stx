<script server>
const scopeKey = String(scope)
const ownerHandle = String(owner)
const repositoryName = String(repository)
const jobId = Number(job)
const initialCursor = Number(after)
const initialAttempt = Number(typeof attempt === 'undefined' ? 1 : attempt)
</script>
<script client>
import { watchJobLog } from '../functions/runlive'
const runView = useStore('workflow-run')
const tail = state('')
const jobState = state('')
function appendOutput(text) {
  const combined = tail() + text
  tail.set(combined.length > 2_097_152 ? '[Earlier live output omitted. Reload to read the retained log.]\n' + combined.slice(-2_097_000) : combined)
}
onMount(() => {
  let handle = null
  let previous = 0
  const stopWatching = watch(() => Number(runView.job(scopeKey, jobId)?.attempt ?? initialAttempt), (attempt) => {
    if (attempt === previous) return
    handle?.stop()
    if (previous) appendOutput('\nAttempt ' + attempt + '\n')
    previous = attempt
    handle = watchJobLog({ owner: ownerHandle, repository: repositoryName, job: jobId, after: attempt === initialAttempt ? initialCursor : 0, attempt, onOutput: appendOutput, onState: next => jobState.set(next) })
  }, { immediate: true })
  onDestroy(() => { stopWatching(); handle?.stop() })
})
</script>
<div class="jobtail">
  <pre class="jobtail-body log-body" :if="tail()" x-text="tail()"></pre>
  <p class="jobtail-note muted" :if="['succeeded','failed','cancelled','skipped'].includes(jobState())">This job <span x-text="jobState()"></span>. Steps and timings update above.</p>
</div>
<style>
.jobtail-body { margin-top: 0; border-top: 0; }
.jobtail-note { font-size: 12.5px; margin: 6px 0 0; }
</style>
