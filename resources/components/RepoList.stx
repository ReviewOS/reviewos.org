<script server>
/**
 * The pull request and issue lists for a repository.
 *
 * One component for both, because the two differ only in which table they read
 * and what a row links to. Two nearly-identical templates would drift, and the
 * place they would drift first is the state pill, which is the one thing on the
 * row a reader actually scans for.
 *
 * Every rule comes from `app/Actions/Browse/lists`, via `resources/functions/browse`:
 * what a filter means, how a page is bounded, how a state reads. Rules in a
 * template cannot be tested.
 */
import { repositoryForView, repositoryHeaderActions } from '../functions/repo'
import { authorIsLocal, authorLabel, countLabel, filterHref, lastPage, listFilter, pageHref, pageNumber, pageOffset, PAGE_SIZE, relativeTime, stateLabel, statePill, statesFor } from '../functions/browse'
import { labelColor, labelTextColor } from '../functions/issues'

const ownerHandle = String(owner)
const repositoryName = String(repository)
// 'pulls' or 'issues'. The component reads one table or the other; everything
// else on the page is the same.
const kind = String(sort ?? 'pulls') === 'issues' ? 'issues' : 'pulls'

// The filter and page arrive as props rather than being read here: a component
// receives only what it is passed, and the query string belongs to the request
// the view is answering.
const filter = listFilter(filterState)
const page = pageNumber(pageNumberParam)
const states = statesFor(filter, kind)

// The owner is a user or an organization and both have handles, so resolving it
// first is what stops `/someone/stacks` finding a repository owned by somebody
// else.
// Resolved and permission-checked in one place. A component reaching for the
// table itself is how the owner check gets skipped in one of them and the
// visibility check in all of them.
/**
 * The request, when there is one, without naming a binding that may not exist.
 *
 * stx declares `__stxServeContext` on the path that serves a request and on no
 * other, and an *undeclared* identifier is a ReferenceError - which optional
 * chaining does not save, because `x?.y` throws on `x` before the chain is
 * reached. It throws inside the server script's IIFE, so it takes every other
 * variable in this file down with it and the page renders its not-found branch
 * as though the answer were no.
 *
 * The globalThis mirror is not the fix: it is shared between concurrent
 * requests, so reading cookies off it could hand one reader another reader's
 * session.
 */
const serveContext = __stxServeContext

const repoAccess = await repositoryForView(ownerHandle, repositoryName, serveContext?.cookies)
const repoRow: any = repoAccess?.repository ?? null
// Star and watch, for the header. One line here rather than each screen
// re-deriving the viewer, the counts and the labels - see
// `app/Actions/Repo/standing.ts`.
const repoActions = await repositoryHeaderActions(repoAccess, ownerHandle, repositoryName)

/*
 * Whether the reader can actually triage.
 *
 * The bulk bar was rendered to everybody, so a signed-out visitor was offered
 * Close, Reopen and a label box on a repository they cannot write to - and the
 * only way to learn otherwise was to tick a box, press Close, and be refused
 * by the endpoint. The checkboxes beside each row go with it: a selection that
 * cannot be acted on is a column of furniture.
 *
 * `can` comes from `repositoryForView`, which is the same permission the bulk
 * endpoint asks `authorizeRepository` for - see `app/Actions/Issue/bulk.ts`,
 * where close and reopen want `issue:close` and the label buttons want
 * `issue:label`.
 */
const mayClose = Boolean(repoAccess?.can?.('issue:close'))
const mayLabel = Boolean(repoAccess?.can?.('issue:label'))
const mayTriage = mayClose || mayLabel


const table = kind === 'issues' ? 'issues' : 'pull_requests'
const repositoryId = repoRow ? Number(repoRow.id) : 0

function scoped() {
  let q = db.selectFrom(table).where('repository_id', '=', repositoryId)
  // Issues and pull requests share a number sequence and the issues table
  // carries both, so the flag is what keeps a pull request off the issue list.
  if (kind === 'issues') q = q.where('is_pull_request', '=', false)
  return q
}

// The counts on the tabs are the whole set, not the current page, because the
// question they answer is "how much is there", not "how much am I looking at".
const openCount = repoRow
  ? Number((await scoped().select(db.fn.count('id').as('n')).where('state', '=', 'open').executeTakeFirst())?.n ?? 0)
  : 0

const totalCount = repoRow
  ? Number((await scoped().select(db.fn.count('id').as('n')).executeTakeFirst())?.n ?? 0)
  : 0

const closedCount = totalCount - openCount

const filteredCount = filter === 'open' ? openCount : (filter === 'closed' ? closedCount : totalCount)

let rowQuery = repoRow ? scoped() : null
if (rowQuery && states) rowQuery = rowQuery.where('state', 'in', states)

const rows = rowQuery
  ? await rowQuery
      // A LEFT join: a mirrored row has no local author, and an inner join
      // would drop it from the list without saying so.
      .leftJoin('users', 'users.id', '=', `${table}.author_id`)
      .select([
        `${table}.id as id`,
        `${table}.number as number`,
        `${table}.title as title`,
        `${table}.state as state`,
        `${table}.created_at as created_at`,
        `${table}.external_author as external_author`,
        'users.handle as handle',
        // Only issues have one, so it is asked for only when reading them.
        ...(kind === 'issues' ? [`${table}.comments_count as comments_count`] : []),
      ])
      .orderBy(`${table}.number`, 'desc')
      .limit(PAGE_SIZE)
      .offset(pageOffset(page))
      .execute()
  : []

// `draft` only exists on pull requests, and selecting it for issues would be a
// column that is not there.
const draftById = new Map()
if (kind === 'pulls' && rows.length > 0) {
  const draftRows = await db
    .selectFrom('pull_requests')
    .select(['id', 'draft'])
    .where('id', 'in', rows.map((row) => Number(row.id)))
    .execute()
  for (const row of draftRows) draftById.set(Number(row.id), Boolean(row.draft))
}

const base = `/${ownerHandle}/${repositoryName}/${kind}`
const finalPage = lastPage(filteredCount)

// Offered as suggestions on the bulk toolbar. A free text field would work,
// because the action resolves by name, but nobody remembers exactly how a
// label was spelled.
const labelRows: any[] = kind === 'issues' && repositoryId
  ? await db
      .selectFrom('repository_labels')
      .select(['name'])
      .where('repository_id', '=', repositoryId)
      .orderBy('name', 'asc')
      .execute()
  : []

const labelNames = labelRows.map(row => String(row.name))

// The labels *on* the rows, in one query for the page rather than one per row.
// A label is the second thing people scan a list by, after the state, and a
// list that hides them makes somebody open twenty issues to find the one about
// the crash.
// Issues only: `issue_labels.issue_id` names a row in `issues`, and a pull
// request id happens to be a number in the same range. Asking for them would
// silently attach one issue's labels to an unrelated pull request.
const appliedRows: any[] = kind === 'issues' && rows.length > 0
  ? await db
      .selectFrom('issue_labels')
      .innerJoin('repository_labels', 'repository_labels.id', '=', 'issue_labels.label_id')
      .select([
        'issue_labels.issue_id as issue_id',
        'repository_labels.name as name',
        'repository_labels.color as color',
      ])
      .where('issue_labels.issue_id', 'in', rows.map((row: any) => Number(row.id)))
      .execute()
  : []

const labelsByIssue = new Map()
for (const row of appliedRows) {
  const id = Number(row.issue_id)
  const name = String(row.name)
  const existing = labelsByIssue.get(id) ?? []

  // By name, because the join table has no unique constraint on the pair and a
  // label applied twice renders as the same pill twice. The row is what a
  // reader scans, and a repeated pill on it reads as a bug in the label rather
  // than in the row that carries it.
  if (existing.some((label: any) => label.name === name))
    continue

  existing.push({
    name,
    color: labelColor(row.color),
    textColor: labelTextColor(labelColor(row.color)),
  })

  labelsByIssue.set(id, existing)
}

const noun = kind === 'issues' ? ['issue', 'issues'] : ['pull request', 'pull requests']
const detailPath = kind === 'issues' ? 'issue' : 'pull'

// Shaped here rather than in the row component, which cannot import anything
// and so cannot ask what a state reads as or how long ago something happened.
const listRows = rows.map((row: any) => ({
  id: Number(row.id),
  number: Number(row.number),
  title: String(row.title),
  href: `/${ownerHandle}/${repositoryName}/${detailPath}/${row.number}`,
  statePill: statePill(String(row.state), draftById.get(Number(row.id)) === true),
  stateLabel: stateLabel(String(row.state), draftById.get(Number(row.id)) === true),
  when: relativeTime(String(row.created_at ?? '')),
  author: authorLabel(row.handle, row.external_author),
  authorHref: authorIsLocal(row.handle) ? `/${row.handle}` : null,
  // Only issues carry one. `pull_requests` has no `comments_count` column, and
  // selecting it for both would be a column that is not there.
  comments: kind === 'issues' ? Number(row.comments_count ?? 0) : 0,
  labels: labelsByIssue.get(Number(row.id)) ?? [],
}))

const notFound = !repoRow
</script>

  <div class="shell" style="padding-top: 22px; padding-bottom: 64px;">
    @if (notFound)
      <div class="panel" style="padding: 32px; text-align: center;">
        <h1 style="font-size: 20px;">No such repository</h1>
        <p class="muted" style="margin-top: 6px;">
          Nothing is hosted at {{ ownerHandle }}/{{ repositoryName }}.
        </p>
      </div>
    @else
      {{-- `RepoHeader`, the same one the code screen draws. This page carried a
          cut-down copy of it: the name and the visibility pill, without the
          description or the clone URL, so a repository changed shape depending
          on which tab you were standing on. The refs are left empty because
          this page reads no git - the header renders its identity block and
          leaves the branch line out. --}}
      <RepoHeader
        owner="{{ ownerHandle }}"
        repository="{{ repositoryName }}"
        visibility="{{ repoRow.visibility }}"
        description="{{ repoRow.description ?? '' }}"
        refName=""
        size=""
        sizeKb="0"
        commits=""
        :actions="repoActions"
        :branches="[]"
        :tags="[]" />

      <RepoTabs owner="{{ ownerHandle }}" repository="{{ repositoryName }}" active="{{ kind }}" />

      {{-- Filters. Plain links rather than a scripted control, so they work
          before any JavaScript runs and each one is a real url someone can
          share. --}}
      <nav class="list-filters" aria-label="Filter">
        <a class="list-filter {{ filter === 'open' ? 'is-current' : '' }}" href="{{ filterHref(base, 'open') }}">
          {{ countLabel(openCount, 'open ' + noun[0], 'open ' + noun[1]) }}
        </a>
        <a class="list-filter {{ filter === 'closed' ? 'is-current' : '' }}" href="{{ filterHref(base, 'closed') }}">
          {{ countLabel(closedCount, 'closed ' + noun[0], 'closed ' + noun[1]) }}
        </a>
        <a class="list-filter {{ filter === 'all' ? 'is-current' : '' }}" href="{{ filterHref(base, 'all') }}">
          All
        </a>

        {{-- Labels and milestones belong to the repository rather than to this
            list, and this is the only place anybody looks for them. Pull
            requests carry the same labels, so the links show on both. --}}
        <span class="list-filters-end">
          <a class="list-filter" href="/{{ ownerHandle }}/{{ repositoryName }}/labels">Labels</a>
          <a class="list-filter" href="/{{ ownerHandle }}/{{ repositoryName }}/milestones">Milestones</a>
          @if (kind === 'issues')
            <a class="list-filter list-filter-primary" href="/{{ ownerHandle }}/{{ repositoryName }}/issues/new">New issue</a>
          @endif
        </span>
      </nav>

      @if (rows.length === 0)
        <div class="panel" style="padding: 40px; text-align: center;">
          <p class="muted">Nothing here yet.</p>
        </div>
      @else
        {{-- Triage is a bulk activity: somebody works down a list applying the
            same label to eight things, and doing that one page load at a time
            is why it does not get done. One form wraps the rows, so the
            checkboxes and the toolbar are the same submission with no client
            script holding them together. --}}
        <form method="post" action="/api/repos/issues/bulk">
          <CsrfField />
        <input type="hidden" name="owner" value="{{ ownerHandle }}">
        <input type="hidden" name="repo" value="{{ repositoryName }}">

        @if (kind === 'issues' && mayTriage)
          <div class="bulk-bar panel">
            <span class="bulk-hint muted">With the selected issues:</span>
            @if (mayClose)
              <button class="bulk-btn" type="submit" name="operation" value="close">Close</button>
              <button class="bulk-btn" type="submit" name="operation" value="reopen">Reopen</button>
            @endif
            @if (mayLabel)
              <label class="visually-hidden" for="bulk-label">Label</label>
              <input class="bulk-input" id="bulk-label" name="label" placeholder="Label name" list="bulk-labels">
              <datalist id="bulk-labels">
                @foreach (labelNames as name)
                  <option value="{{ name }}"></option>
                @endforeach
              </datalist>
              <button class="bulk-btn" type="submit" name="operation" value="label">Add</button>
              <button class="bulk-btn" type="submit" name="operation" value="unlabel">Remove</button>
            @endif
          </div>
        @endif

        <ul class="list-rows panel" data-list>
          @foreach (listRows as row)
            <IssueListItem :row="row" :selectable="kind === 'issues' && mayTriage" />
          @endforeach
        </ul>
        </form>

        {{-- The shortcuts, listed rather than hidden behind a `?` panel nobody
            finds. Six lines of text at the bottom of a list is cheaper than a
            modal, and it is how somebody learns the keys exist. --}}
        <p class="list-keys muted" data-keys hidden>
          <kbd>j</kbd> <kbd>k</kbd> move &middot;
          <kbd>Enter</kbd> open &middot;
          {{-- `x` is only listed to somebody who has something to select: the
              checkboxes go with the bulk bar, so advertising the key to a
              reader who cannot triage is teaching a shortcut that does
              nothing. --}}
          @if (kind === 'issues' && mayTriage)
            <kbd>x</kbd> select &middot;
          @endif
          @if (kind === 'issues')
            <kbd>c</kbd> new issue &middot;
          @endif
          <kbd>Esc</kbd> leave
        </p>

        @if (finalPage > 1)
          <nav class="list-pager" aria-label="Pagination">
            @if (page > 1)
              <a class="list-page" href="{{ pageHref(base, filter, page - 1) }}">Newer</a>
            @else
              <span class="list-page is-disabled">Newer</span>
            @endif

            <span class="muted">Page {{ page }} of {{ finalPage }}</span>

            @if (page < finalPage)
              <a class="list-page" href="{{ pageHref(base, filter, page + 1) }}">Older</a>
            @else
              <span class="list-page is-disabled">Older</span>
            @endif
          </nav>
        @endif
      @endif
    @endif
  </div>

{{-- Keyboard navigation, and the second script in the product.

    People who live in issues navigate by keyboard, and there is no way to do
    it without one: moving focus is a DOM operation, and stx reactivity drives
    what a page *contains* rather than where the caret is.

    So it is contained the same way the diagram loader is. The list works
    completely without it - every row is a link, Tab already walks them, and
    the checkboxes are ordinary checkboxes - and this only makes the walking
    faster. Nothing here is the only way to do anything.

    Typing is checked first on every key. A shortcut that fires while somebody
    is filling in the bulk-label box is not a shortcut, it is a bug that eats
    text. --}}
<script type="module">
  const list = document.querySelector('[data-list]')

  if (list) {
    const keys = document.querySelector('[data-keys]')
    if (keys)
      keys.hidden = false

    const rows = () => [...list.querySelectorAll('.list-row')]
    const focused = () => rows().findIndex(row => row.contains(document.activeElement))

    const move = (by) => {
      const all = rows()
      if (all.length === 0)
        return

      const at = focused()
      // From nowhere, `j` starts at the top and `k` at the bottom, which is
      // what every list that does this has taught people to expect.
      const next = at < 0
        ? (by > 0 ? 0 : all.length - 1)
        : Math.min(Math.max(at + by, 0), all.length - 1)

      all[next].focus()
      all[next].scrollIntoView({ block: 'nearest' })
    }

    document.addEventListener('keydown', (event) => {
      if (event.metaKey || event.ctrlKey || event.altKey)
        return

      const active = document.activeElement
      const typing = active
        && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' || active.tagName === 'SELECT'
          || active.isContentEditable)

      // Escape leaves whatever field somebody is in, which is what makes the
      // rest of these reachable again without a mouse.
      if (event.key === 'Escape' && typing) {
        active.blur()
        event.preventDefault()
        return
      }

      if (typing)
        return

      const at = focused()
      const row = at >= 0 ? rows()[at] : null

      switch (event.key) {
        case 'j':
          move(1)
          break

        case 'k':
          move(-1)
          break

        case 'x': {
          const box = row?.querySelector('input[type="checkbox"]')
          if (!box)
            return

          box.checked = !box.checked
          break
        }

        case 'c': {
          const open = document.querySelector('.list-filter-primary')
          if (!open)
            return

          window.location.assign(open.href)
          break
        }

        case 'Enter': {
          const link = row?.querySelector('.list-row-title')
          if (!link)
            return

          window.location.assign(link.href)
          break
        }

        default:
          return
      }

      event.preventDefault()
    })
  }
</script>

<style>
  .list-filters-end { margin-left: auto; display: flex; gap: 14px; align-items: center; }

  .list-keys { margin-top: 14px; text-align: center; font-size: 12px; }
  .list-keys kbd {
    padding: 1px 5px;
    font-family: var(--mono);
    font-size: 11px;
    border: 1px solid var(--line-strong);
    border-bottom-width: 2px;
    border-radius: 4px;
    background: var(--surface);
  }

  .bulk-bar { display: flex; align-items: center; gap: 8px; padding: 10px 14px; margin-bottom: 10px; flex-wrap: wrap; }
  .bulk-hint { font-size: 12.5px; }
  .bulk-input {
    padding: 5px 9px;
    font: inherit;
    font-size: 12.5px;
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-control);
    min-width: 130px;
  }
  .bulk-btn {
    padding: 5px 10px;
    font: inherit;
    font-size: 12.5px;
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-control);
    cursor: pointer;
  }
  .bulk-btn:hover { border-color: var(--fg); }
  .list-filter-primary {
    padding: 5px 11px;
    color: var(--bg);
    background: var(--fg);
    border-radius: var(--r-control);
  }

  .list-filters {
    display: flex;
    gap: 4px;
    margin: 18px 0 12px;
  }

  .list-filter {
    padding: 6px 12px;
    border-radius: 7px;
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
  }

  .list-filter:hover { background: var(--surface-tint); }
  .list-filter.is-current { background: var(--surface-tint); color: var(--text); font-weight: 500; }

  /* The row itself is styled by `IssueListItem`, which owns it. What is left
    here is the list around the rows. */
  .list-rows { list-style: none; margin: 0; padding: 0; }

  .list-pager {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 18px;
    font-size: 13px;
  }

  .list-page {
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 7px;
    text-decoration: none;
    color: var(--text);
  }

  .list-page:hover { background: var(--surface-tint); }
  .list-page.is-disabled { color: var(--muted); opacity: 0.5; }
</style>
