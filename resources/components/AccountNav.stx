<script server>
/**
 * The right-hand end of the product's navigation: who you are, or how to
 * become somebody.
 *
 * This replaces `SettingsLink`, which solved half the problem. It showed a
 * Settings link to a reader who was signed in, and rendered nothing at all to
 * a reader who was not - so every page in the product offered a signed-out
 * visitor no way to sign in. `/login` and `/register` both existed and worked;
 * nothing in the chrome pointed at either. That is the same failure the
 * settings link was written to fix, one step further out: a page that exists
 * and nothing links to.
 *
 * A component rather than a branch in the layout, for the reason written at
 * length in `ReviewQueueBadge.stx`: an stx server script that throws renders
 * its page with every variable undefined and says nothing, so a script added
 * to the shared layout is one mistake away from blanking the whole product.
 * Everything here sits inside a guard that cannot throw. A failed read renders
 * the signed-out pair, which is the safe wrong answer - it offers a working
 * link rather than nothing, and signing in again is cheap.
 *
 * `next` carries the current path, so somebody who signs in from a pull
 * request lands back on it rather than on a dashboard having lost their place.
 */
import { cookieJarFromHeader, viewerFromCookies } from '../functions/identity'

const serveContext = __stxServeContext
const headerBag = typeof headers === 'undefined' ? undefined : headers

let viewer = null
try {
  viewer = await viewerFromCookies(serveContext?.cookies ?? cookieJarFromHeader(headerBag?.cookie))
}
catch {
  viewer = null
}

/*
 * Where to come back to.
 *
 * A path on this host only, and never one that is already an auth page:
 * signing in and being returned to the sign-in form reads as a failed sign-in
 * even when it worked.
 */
const here = String(serveContext?.path ?? '/')
const returnable = here.startsWith('/') && !here.startsWith('//')
  && !here.startsWith('/login') && !here.startsWith('/register')
const next = returnable ? here : '/reviews'
const signInHref = `/login?next=${encodeURIComponent(next)}`

/*
 * The pair minus whichever half is already on screen.
 *
 * Standing on `/login`, the bar offered Sign in - a link to the form directly
 * below it, which reads either as a second, better sign-in or as the first one
 * having failed. The other half stays: the two questions "I have an account"
 * and "I do not" are asked by different people, and the answer to the second
 * is still one click away.
 */
const onSignIn = here.startsWith('/login')
const onRegister = here.startsWith('/register')
</script>

@if (viewer)
  {{-- One control rather than three.

      The bar used to carry a settings gear, the handle, and a sign-out icon
      side by side: three items competing for the same corner, two of them
      unlabelled icons, and the sign-out sitting one mis-click from the gear.
      They are all the same kind of thing - things you do to your own account -
      so they belong behind the thing that names the account.

      A plain `<details>`, for the reason `BranchPicker.stx` gives: it opens
      before any JavaScript has run, which is the point of rendering on the
      server. It is also the only option that keeps the sign-out working, since
      that control is a form post and this product runs no client-side script
      to drive a menu with.

      What it does not do, and `BranchPicker` does not either: close on an
      outside click or on Escape. Both want a listener. Clicking the summary
      again closes it, and any link inside navigates away, which covers every
      way out of this particular menu. --}}
  <details class="account-menu">
    {{-- The handle beside the face, not instead of it. A bar that shows only
        an avatar makes "am I signed in as the right account" a hover away, and
        on a forge people do keep two. It is also the menu's accessible name,
        which is why the initial is hidden from it: "chris" reads better than
        "C chris". --}}
    <summary class="account-you">
      <span class="account-face" aria-hidden="true">{{ String(viewer.handle).charAt(0).toUpperCase() }}</span>
      <span class="account-handle">{{ viewer.handle }}</span>
      <span class="account-caret i-hugeicons-arrow-down-01" aria-hidden="true"></span>
    </summary>

    <div class="account-panel">
      {{-- The profile first, because it is the one item here that is about
          what other people see rather than about settings. The handle used to
          link straight here; now that the handle opens the menu, this is where
          that link went. --}}
      <a class="account-item" href="/{{ viewer.handle }}">
        <span class="i-hugeicons-user" aria-hidden="true"></span>
        Your profile
      </a>
      <a class="account-item" href="/settings/profile">
        <span class="i-hugeicons-settings-01" aria-hidden="true"></span>
        Settings
      </a>

      {{-- And a way back out, which the product did not have before this
          component existed. `POST /api/auth/logout` had worked the whole time,
          revoking the token rather than just dropping the cookie, and
          `review logout` called it from the CLI. Nothing in the interface did.

          A form, not a link, because the action is POST only and for a good
          reason it documents: an `<img src="/logout">` in a comment would sign
          out every reader of that page on GET. It needs no script either: the
          action answers an HTML request with a 303 to `/` and the cleared
          cookie, so the browser does the whole thing natively.

          Last, and behind a rule, because it is the one item here that cannot
          be undone by pressing back. --}}
      <form class="account-out" method="post" action="/api/auth/logout">
        {{-- Without this the button is a 403. The CSRF middleware is
            double-submit and this product runs no client-side JavaScript, so
            the token has to travel in the body; `CsrfField.stx` is the one
            place that knows how to read it. Its own comment puts it best: a
            form that forgets it is a button that silently does nothing. --}}
        <CsrfField />
        <button class="account-item" type="submit" aria-label="Sign out">
          <span class="i-hugeicons-logout-03" aria-hidden="true"></span>
          Sign out
        </button>
      </form>
    </div>
  </details>
@else
  @if (!onSignIn)
    <a class="account-link account-signin" href="{{ signInHref }}">Sign in</a>
  @endif
  @if (!onRegister)
    <a class="account-cta" href="/register">Sign up</a>
  @endif
@endif

<style>
  /* The signed-out half of the bar, which is still two plain controls. */
  .account-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    padding: 0 10px;
    border-radius: var(--r-control, 8px);
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .account-link:hover { color: var(--text); background: var(--surface-tint); }

  .account-menu { position: relative; display: inline-block; }

  /* `list-style: none` and the webkit marker rule are both needed, and for
     different browsers: without them the summary carries a disclosure triangle
     next to an avatar, which reads as a tree rather than a menu. */
  .account-you {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 32px;
    padding: 0 8px 0 6px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
    cursor: pointer;
    list-style: none;
  }

  .account-you::-webkit-details-marker { display: none; }
  .account-you:hover { background: var(--surface-tint); }

  /* Open is a state worth showing: the panel can be mistaken for part of the
     page below it, and this ties the two together. */
  .account-menu[open] > .account-you { background: var(--surface-tint); }

  /* The initial rather than a gravatar. Nothing about somebody reading their
     own navigation bar should be a request to a third party. */
  .account-face {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface-tint);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--muted);
  }

  /* The affordance. Without it the handle looks like the link it used to be,
     and the first click is a surprise either way. */
  .account-caret {
    font-size: 14px;
    color: var(--muted);
    transition: transform 120ms ease;
  }

  .account-menu[open] .account-caret { transform: rotate(180deg); }

  @media (prefers-reduced-motion: reduce) {
    .account-caret { transition: none; }
  }

  .account-panel {
    position: absolute;
    z-index: 20;
    top: calc(100% + 6px);
    /* Right rather than left: this sits at the right end of the bar, and a
       panel hanging off the left edge would run past the window. */
    right: 0;
    min-width: 200px;
    padding: 5px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-control);
    background: var(--surface);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
  }

  /* One rule for the two links and the button, because they are the same kind
     of control and the button is the one that would otherwise arrive with a
     browser's own chrome, font and alignment. */
  .account-item {
    display: flex;
    align-items: center;
    gap: 9px;
    width: 100%;
    padding: 7px 9px;
    border: 0;
    border-radius: var(--r-control);
    background: none;
    color: var(--text);
    font-family: inherit;
    font-size: 13.5px;
    text-align: left;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .account-item:hover { background: var(--accent-quiet); }
  .account-item [class^='i-'] { font-size: 16px; color: var(--muted); }

  /* The sign-out is the one item here that pressing back does not undo, so it
     is last and behind a rule rather than loose among the others. */
  .account-out {
    display: block;
    margin-top: 5px;
    padding-top: 5px;
    border-top: 1px solid var(--line);
  }

  /* The one accented item in the bar when signed out. Review state (green,
     red, amber) is reserved for the diff, so this borrows the brand accent
     rather than a status colour. */
  .account-cta {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 14px;
    border-radius: var(--r-control, 8px);
    background: var(--accent);
    /* `--on-accent` is what this palette actually calls it. The name here was
       `--accent-on`, which is nothing, so the fallback ran and the label was
       white on a light teal button for every reader in dark mode. */
    color: var(--on-accent, #fff);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .account-cta:hover { filter: brightness(1.08); }

  /* When the bar stops fitting, the button is the half that survives: signing
     in is one tap inside the page it leads to, registering is not. */
  @media (max-width: 640px) {
    .account-signin { display: none; }
  }

  /* The face without the name, on a phone. The handle is 12 characters of a
    bar that has 375 of them, and it was being printed over the item beside
    it; the initial still answers "which account is this". The caret goes with
    it: a chevron on its own beside an avatar is noise, and the panel is still
    one tap away. */
  @media (max-width: 600px) {
    .account-handle, .account-caret { display: none; }
    .account-you { padding: 0 4px; }
  }
</style>
