<script server>
/**
 * The right-hand end of the product's navigation: who you are, or how to
 * become somebody.
 *
 * This replaces `SettingsLink`, which solved half the problem. It showed a
 * Settings link to a reader who was signed in, and rendered nothing at all to
 * a reader who was not - so every page in the product offered a signed-out
 * visitor no way to sign in. `/login` and `/register` both existed and worked;
 * nothing in the chrome pointed at either. That is the same failure the
 * settings link was written to fix, one step further out: a page that exists
 * and nothing links to.
 *
 * A component rather than a branch in the layout, for the reason written at
 * length in `ReviewQueueBadge.stx`: an stx server script that throws renders
 * its page with every variable undefined and says nothing, so a script added
 * to the shared layout is one mistake away from blanking the whole product.
 * Everything here sits inside a guard that cannot throw. A failed read renders
 * the signed-out pair, which is the safe wrong answer - it offers a working
 * link rather than nothing, and signing in again is cheap.
 *
 * `next` carries the current path, so somebody who signs in from a pull
 * request lands back on it rather than on a dashboard having lost their place.
 */
import { cookieJarFromHeader, viewerFromCookies } from '../functions/identity'

const serveContext = __stxServeContext
const headerBag = typeof headers === 'undefined' ? undefined : headers

let viewer = null
try {
  viewer = await viewerFromCookies(serveContext?.cookies ?? cookieJarFromHeader(headerBag?.cookie))
}
catch {
  viewer = null
}

/*
 * Where to come back to.
 *
 * A path on this host only, and never one that is already an auth page:
 * signing in and being returned to the sign-in form reads as a failed sign-in
 * even when it worked.
 */
const here = String(serveContext?.path ?? '/')
const returnable = here.startsWith('/') && !here.startsWith('//')
  && !here.startsWith('/login') && !here.startsWith('/register')
const next = returnable ? here : '/reviews'
const signInHref = `/login?next=${encodeURIComponent(next)}`

/*
 * The pair minus whichever half is already on screen.
 *
 * Standing on `/login`, the bar offered Sign in - a link to the form directly
 * below it, which reads either as a second, better sign-in or as the first one
 * having failed. The other half stays: the two questions "I have an account"
 * and "I do not" are asked by different people, and the answer to the second
 * is still one click away.
 */
const onSignIn = here.startsWith('/login')
const onRegister = here.startsWith('/register')
</script>

@if (viewer)
  <a class="account-link" href="/settings/profile" title="Settings" aria-label="Settings">
    <span class="i-hugeicons-settings-01" aria-hidden="true"></span>
  </a>
  {{-- The handle beside the face, not instead of it. A bar that shows only an
      avatar makes "am I signed in as the right account" a hover away, and on a
      forge people do keep two. --}}
  <a class="account-you" href="/{{ viewer.handle }}">
    <span class="account-face" aria-hidden="true">{{ String(viewer.handle).charAt(0).toUpperCase() }}</span>
    <span class="account-handle">{{ viewer.handle }}</span>
  </a>
@else
  @if (!onSignIn)
    <a class="account-link account-signin" href="{{ signInHref }}">Sign in</a>
  @endif
  @if (!onRegister)
    <a class="account-cta" href="/register">Sign up</a>
  @endif
@endif

<style>
  .account-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    padding: 0 10px;
    border-radius: var(--r-control, 8px);
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .account-link:hover { color: var(--text); background: var(--surface-tint); }
  .account-link [class^='i-'] { font-size: 17px; }

  .account-you {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 32px;
    padding: 0 10px 0 6px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .account-you:hover { background: var(--surface-tint); }

  /* The initial rather than a gravatar. Nothing about somebody reading their
     own navigation bar should be a request to a third party. */
  .account-face {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface-tint);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--muted);
  }

  /* The one accented item in the bar when signed out. Review state (green,
     red, amber) is reserved for the diff, so this borrows the brand accent
     rather than a status colour. */
  .account-cta {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 14px;
    border-radius: var(--r-control, 8px);
    background: var(--accent);
    /* `--on-accent` is what this palette actually calls it. The name here was
       `--accent-on`, which is nothing, so the fallback ran and the label was
       white on a light teal button for every reader in dark mode. */
    color: var(--on-accent, #fff);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .account-cta:hover { filter: brightness(1.08); }

  /* When the bar stops fitting, the button is the half that survives: signing
     in is one tap inside the page it leads to, registering is not. */
  @media (max-width: 640px) {
    .account-signin { display: none; }
  }

  /* The face without the name, on a phone. The handle is 12 characters of a
    bar that has 375 of them, and it was being printed over the item beside
    it; the initial still answers "which account is this". */
  @media (max-width: 600px) {
    .account-handle { display: none; }
    .account-you { padding: 0 4px; }
  }
</style>
