<script server>
/**
 * The landing page navigation.
 *
 * Carries the Features menu, built from the one catalog in
 * resources/functions/marketing so a page and its menu entry cannot drift
 * apart.
 *
 * **Use cases and Compare are not here, deliberately.** They are the two menus
 * a reader opens once, before deciding, and never again - which makes them
 * footer material. Giving them the same weight as the product pushed Discover,
 * the one item that shows this instance has real work on it, off the bar
 * entirely. A forge whose navigation offers three marketing menus and no way
 * to see a repository is arguing rather than demonstrating. Both still exist,
 * with every page linked, in `MarketingFooter`.
 *
 * The menu is a `<details>` element: no JavaScript, it works before any
 * hydration, and the keyboard already knows how a disclosure behaves.
 */
import { FEATURE_GROUPS, featuresIn } from '../functions/marketing'
import { SOURCE_PATH } from '../functions/site'
import { cookieJarFromHeader, viewerFromCookies } from '../functions/identity'

const serveContext = typeof __stxServeContext === 'undefined' ? undefined : __stxServeContext
const headerBag = typeof headers === 'undefined' ? undefined : headers

/*
 * Who is reading, if anybody.
 *
 * Inside a guard that cannot throw, for the reason written at length in
 * `ReviewQueueBadge.stx`: an stx server script that throws renders its page
 * with every variable undefined and says nothing, so a failed session read
 * here would blank the landing page rather than show a signed-out nav.
 */
let viewer = null
try {
  viewer = await viewerFromCookies(serveContext?.cookies ?? cookieJarFromHeader(headerBag?.cookie))
}
catch {
  viewer = null
}
</script>

<template>
  {{-- The bar is the window's width; the row inside it is the page's.
      
      They used to be one element, so the sticky background - and its blur -
      stopped at the 1180px column: scrolling put a floating band over the page
      with the content visible either side of it, which is not a bar. --}}
  <header class="nav-bar">
   <div class="nav">
    <a class="nav-brand" href="/" aria-label="ReviewOS home">
      <span class="nav-mark" aria-hidden="true"></span>
      <span class="nav-name">ReviewOS</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      <details class="mega">
        <summary>Features <span class="mega-chevron" aria-hidden="true"></span></summary>
        <div class="mega-features mega-panel">
          <div class="mega-grid">
            @foreach (FEATURE_GROUPS as group)
              <div>
                <p class="mega-group-title">{{ group }}</p>
                @foreach (featuresIn(group) as feature)
                  <a class="mega-item" href="/features/{{ feature.slug }}">
                    <span class="mega-item-name">{{ feature.name }}</span>
                    <span class="mega-item-text">{{ feature.summary }}</span>
                  </a>
                @endforeach
              </div>
            @endforeach
          </div>
          <div class="mega-foot">
            <span class="mega-foot-note">Every feature, in one place.</span>
            <a class="mega-foot-link" href="/features">All features</a>
          </div>
        </div>
      </details>

      {{-- Second, and above the docs. Discover is the only item on this bar
          that answers "is anybody actually using this", and the answer is a
          page of real repositories rather than a paragraph claiming there
          are some. --}}
      <a href="/discover">Discover</a>
      <a href="{{ SOURCE_PATH }}">Source</a>
      <a href="/docs/todo/">Roadmap</a>
      <a href="/docs">Docs</a>
    </nav>

    {{-- Sign in and sign up, which the landing page did not offer at all: the
        only call to action was "self-host it", so somebody who wanted an
        account on *this* instance had to guess the URL. Signed in, the pair
        collapses to one link into the product, because offering to sign in a
        reader who already is says the session is not working. --}}
    <div class="nav-auth">
      @if (viewer)
        <a class="button button-solid nav-cta" href="/reviews">Open ReviewOS</a>
      @else
        <a class="nav-signin" href="/login">Sign in</a>
        <a class="button button-solid nav-cta" href="/register">Sign up</a>
      @endif
    </div>
   </div>
  </header>
</template>

<style>
  /* The landing page owns the nav shell; these are only the menus. */
  .mega { position: relative; }

  .mega > summary {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    cursor: pointer;
    list-style: none;
  }

  .mega > summary::-webkit-details-marker { display: none; }

  .mega-chevron {
    width: 6px;
    height: 6px;
    margin-left: 2px;
    border-right: 1.25px solid currentColor;
    border-bottom: 1.25px solid currentColor;
    transform: translateY(-1px) rotate(45deg);
    opacity: 0.55;
  }

  .mega-panel {
    position: absolute;
    top: calc(100% + 14px);
    left: -12px;
    z-index: 60;
    padding: 18px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-panel);
    box-shadow: 0 12px 32px rgb(18 25 27 / 0.10);
    text-align: left;
  }

  @media (prefers-color-scheme: dark) {
    .mega-panel { box-shadow: 0 12px 32px rgb(0 0 0 / 0.45); }
  }

  .mega-features { width: min(860px, calc(100vw - 48px)); }
  .mega-cases { width: min(480px, calc(100vw - 48px)); }

  .mega-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
  .mega-grid-single { grid-template-columns: minmax(0, 1fr); gap: 4px; }

  @media (max-width: 900px) {
    .mega-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mega-grid-single { grid-template-columns: minmax(0, 1fr); }
  }

  .mega-group-title {
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 8px;
  }

  .mega-item {
    display: block;
    padding: 8px 9px;
    border-radius: var(--r-control);
    text-decoration: none;
  }

  .mega-item:hover { background: var(--surface-tint); }
  .mega-item-name { display: block; font-size: 14px; font-weight: 500; color: var(--text); }
  .mega-item-text { display: block; font-size: 12.5px; color: var(--muted); line-height: 1.45; }

  .mega-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 13.5px;
  }

  .mega-foot-note { color: var(--muted); }
  .mega-foot-link { color: var(--accent-text); font-weight: 500; text-decoration: none; }

  .nav-auth { display: flex; align-items: center; gap: 14px; }

  .nav-signin {
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-signin:hover { color: var(--accent-text); }

  /* Below the point where the bar stops fitting, the CTA is the one that has
     to survive: somebody on a phone who wants an account still needs the
     button, and "Sign in" is one tap further inside the page it leads to. */
  @media (max-width: 640px) {
    .nav-signin { display: none; }
  }
</style>
