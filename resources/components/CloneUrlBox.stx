<script server>
/**
 * The URL somebody clones with.
 *
 * Built from the host the page was served on rather than from configuration,
 * because the two disagree exactly when it matters: behind a proxy, on a
 * second domain, or on a port a developer picked. A clone URL that is right in
 * production and wrong on the machine you are standing at is a clone URL
 * nobody trusts, and the request already knows which host it arrived on.
 *
 * SSH appears only when an operator has said where the daemon answers, never
 * because the code for it exists. A clone URL that cannot connect is worse than
 * one fewer: somebody copies it, waits for a timeout, and concludes the forge
 * is broken rather than that a feature is off.
 */
import { cloneUrlFor, sshCloneUrlFor } from '../functions/repo'

const ownerHandle = String(owner)
const repositoryName = String(repository)

// The rule lives in `app/Actions/Repo/cloneUrl.ts` and is tested there. What
// this file knows is where a request is: the URL if the render was given one,
// the Host header otherwise, and the configured URL only when neither exists.
/**
 * The request, when there is one, without naming a binding that may not exist.
 *
 * stx declares `__stxServeContext` on the path that serves a request and on no
 * other, and an *undeclared* identifier is a ReferenceError - which optional
 * chaining does not save, because `x?.y` throws on `x` before the chain is
 * reached. It throws inside the server script's IIFE, so it takes every other
 * variable in this file down with it and the page renders its not-found branch
 * as though the answer were no.
 *
 * The globalThis mirror is not the fix: it is shared between concurrent
 * requests, so reading cookies off it could hand one reader another reader's
 * session.
 */
const serveContext = __stxServeContext

const cloneUrl = cloneUrlFor(serveContext, ownerHandle, repositoryName, process.env.APP_URL)
const sshUrl = sshCloneUrlFor(serveContext, ownerHandle, repositoryName, process.env)

// Interpolated into an attribute, where `null` would arrive as the four
// characters `null` rather than as nothing. The `@if` below hides the button
// either way, but a state object holding the string "null" is the kind of thing
// that is true for months and then surfaces somewhere else.
const sshValue = sshUrl ?? ''

// Ordinary `{{ }}` inside the `x-data` string literals, which is only correct
// as of stx 0.2.156. Before it, an interpolation inside a string literal was
// spliced as `JSON.stringify(value)` - so `'{{ url }}'` reached the runtime
// scope as `'"https://…"'`, quoted by the template and quoted again by the
// encoder. Nothing threw: the page rendered, the binding updated, and the copy
// button copied a URL with two quote characters in it.
</script>

<details class="clone-box">
  <summary class="btn clone-summary">
    <span class="i-hugeicons-source-code" aria-hidden="true"></span>
    Clone
  </summary>

  <div class="clone-panel" x-data="{ https: '{{ cloneUrl }}', ssh: '{{ sshValue }}', scheme: 'https' }">
    @if (sshUrl)
      {{--
        Two buttons rather than a select: there are two of them, they fit, and a
        select needs a click to find out what the other option even is.
      --}}
      <div class="clone-schemes" role="group" aria-label="Clone protocol">
        <button
          type="button"
          class="clone-scheme"
          :class="{ 'is-on': scheme === 'https' }"
          :aria-pressed="scheme === 'https'"
          @click="scheme = 'https'">HTTPS</button>
        <button
          type="button"
          class="clone-scheme"
          :class="{ 'is-on': scheme === 'ssh' }"
          :aria-pressed="scheme === 'ssh'"
          @click="scheme = 'ssh'">SSH</button>
      </div>
    @endif

    <label class="clone-label" for="clone-url-{{ repositoryName }}">
      Clone with <span x-text="scheme === 'ssh' ? 'SSH' : 'HTTPS'">HTTPS</span>
    </label>

    {{--
      Readonly rather than disabled: a disabled field cannot be selected, and
      selecting the text by hand is the fallback for every browser that refuses
      the clipboard, every page served over plain HTTP, and anybody who has
      turned the permission off.
    --}}
    <div class="clone-row">
      <input
        id="clone-url-{{ repositoryName }}"
        class="clone-input mono"
        type="text"
        readonly
        spellcheck="false"
        :value="scheme === 'ssh' ? ssh : https"
        value="{{ cloneUrl }}"
        aria-label="Clone URL">

      <button
        type="button"
        class="btn clone-copy"
        @click="copyCloneUrl(scheme === 'ssh' ? ssh : https)"
        aria-label="Copy the clone URL">
        <span class="i-hugeicons-copy-01" aria-hidden="true"></span>
      </button>
    </div>

    {{--
      One hint covering both, rather than one per scheme behind an `x-show`.
      The toggle above needs JavaScript by its nature; the sentence explaining
      how to authenticate does not, and a reader with scripts off would
      otherwise see both hints at once or neither.
    --}}
    @if (sshUrl)
      <p class="clone-hint muted">
        HTTPS pushes with an <a href="/settings/tokens">access token</a> in place of a
        password. SSH uses a key you have added under <a href="/settings/keys">SSH keys</a>.
      </p>
    @else
      <p class="clone-hint muted">
        Push over the same URL. A password will not work: create a token under
        <a href="/settings/tokens">access tokens</a> and use it in place of one.
      </p>
    @endif
  </div>
</details>

<script client>
import { useClipboard } from '@stacksjs/stx/composables'

const clipboard = useClipboard()

/**
 * Copying is best effort. The clipboard is refused on an insecure origin and
 * behind a permission prompt, and there is nothing useful to say when it is -
 * the URL is on screen, selectable, and that is the path people who hit this
 * take anyway.
 */
function copyCloneUrl(url) {
  clipboard.copy(url).catch(() => {})
}
</script>

<style>
  .clone-box { position: relative; display: inline-block; }

  .clone-summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    list-style: none;
  }

  .clone-summary::-webkit-details-marker { display: none; }

  .clone-panel {
    position: absolute;
    right: 0;
    z-index: 20;
    width: min(360px, calc(100vw - 32px));
    margin-top: 6px;
    padding: 14px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--r-panel, 12px);
    box-shadow: 0 10px 30px rgb(0 0 0 / 12%);
  }

  .clone-label {
    display: block;
    font-size: 12.5px;
    font-weight: 500;
    margin-bottom: 6px;
  }

  .clone-row { display: flex; gap: 6px; }

  .clone-input {
    flex: 1;
    min-width: 0;
    padding: 7px 9px;
    font-size: 12.5px;
    color: var(--text);
    background: var(--bg-subtle, var(--bg));
    border: 1px solid var(--line);
    border-radius: var(--r-field, 10px);
  }

  .clone-copy { padding: 7px 9px; }

  .clone-hint {
    margin-top: 10px;
    font-size: 12px;
    line-height: 1.45;
  }

  /* `--surface` and `--bg`, both of which the theme defines. The obvious pair
    was `--bg-subtle` over `--bg`, and `--bg-subtle` does not exist here: the
    fallback made the track and the selected pill the same colour, so the only
    thing marking the selection was the text weight. A selected state you have
    to squint at is one nobody sees.

    A CSS comment rather than an stx one: stx does not strip its own comment
    syntax inside a `<style>` block, so the version of this note written that
    way reached the browser verbatim and took the rule after it with it. */
  .clone-schemes {
    display: inline-flex;
    margin-bottom: 10px;
    padding: 2px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-control, 10px);
  }

  .clone-scheme {
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 500;
    color: var(--muted, var(--text));
    background: none;
    border: 0;
    border-radius: calc(var(--r-control, 10px) - 3px);
    cursor: pointer;
    transition: color 120ms ease, background-color 120ms ease;
  }

  .clone-scheme:hover { color: var(--text); }

  .clone-scheme.is-on {
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--line);
    padding: 3px 11px;
  }

</style>
