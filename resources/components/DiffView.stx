{{--
  One file's diff.

  Rendered on the server as a table, which is the decision the whole review
  screen rests on: a hundred-file diff sent as JSON and assembled in the browser
  is where every forge gets slow, and it is slowest exactly when the review
  matters most. HTML arrives ready to read.

  The gutters carry both line numbers, because a review comment anchors to a
  line, a side, and a commit — a reader who cannot see the old number cannot
  tell which side an outdated thread was written against.

  Props: file (a DiffFile from app/Actions/Pull/diff.ts), threads (already
  re-anchored), and collapsed.
--}}
<section class="diff-file panel" id="file-{{ file.path }}">
  <header class="diff-head">
    <button
      type="button"
      class="diff-toggle"
      aria-expanded="{{ collapsed ? 'false' : 'true' }}"
      aria-controls="body-{{ file.path }}"
    >
      <span class="i-hugeicons-arrow-down-01" aria-hidden="true"></span>
    </button>

    <span class="diff-path mono">
      @if (file.previousPath && file.previousPath !== file.path)
        <span class="muted">{{ file.previousPath }}</span>
        <span class="muted" aria-hidden="true">→</span>
      @endif
      {{ file.path }}
    </span>

    <span class="diff-status pill pill-{{ file.status }}">{{ file.status }}</span>

    <span class="diff-counts mono" aria-label="{{ file.additions }} added, {{ file.deletions }} removed">
      <span class="count-add">+{{ file.additions }}</span>
      <span class="count-del">-{{ file.deletions }}</span>
    </span>
  </header>

  {{--
    Collapsed through a class rather than the `hidden` attribute. `hidden` is a
    boolean attribute, so the browser hides the element whenever it is present
    whatever the value, and `hidden="{{ collapsed }}"` rendered `hidden="false"`
    and hid every diff on the page. A directive inside the attribute list is not
    processed by stx, so the conditional is in the value where it does work.
  --}}
  <div id="body-{{ file.path }}" class="diff-body{{ collapsed ? ' is-collapsed' : '' }}">
    @if (file.binary)
      <p class="diff-note muted">Binary file. Nothing to show line by line.</p>
    @elseif (file.hunks.length === 0)
      <p class="diff-note muted">
        @if (file.oldMode && file.newMode)
          Mode changed from {{ file.oldMode }} to {{ file.newMode }}. The contents are unchanged.
        @else
          No changes to show.
        @endif
      </p>
    @else
      <table class="diff-table">
        <caption class="visually-hidden">Changes to {{ file.path }}</caption>
        <tbody>
          @foreach (file.hunks as hunk)
            <tr class="hunk-head">
              <td class="gutter" colspan="2"></td>
              <td class="hunk-label mono">
                @@ -{{ hunk.oldStart }},{{ hunk.oldLines }} +{{ hunk.newStart }},{{ hunk.newLines }} @@
                @if (hunk.heading)
                  <span class="muted">{{ hunk.heading }}</span>
                @endif
              </td>
            </tr>

            @foreach (hunk.lines as line)
              <tr class="line line-{{ line.origin }}">
                <td class="gutter num">{{ line.oldLine ?? '' }}</td>
                <td class="gutter num">{{ line.newLine ?? '' }}</td>
                {{--
                  All on one line, deliberately. The cell is `white-space: pre`
                  so that code keeps its own indentation, which means the
                  template's indentation would be printed too and every line
                  would start a dozen columns in.
                --}}
                <td class="code mono"><span class="marker" aria-hidden="true">{{ line.origin === 'added' ? '+' : (line.origin === 'removed' ? '-' : ' ') }}</span>@foreach (line.tokens as token)<span class="t-{{ token.type }}">{{ token.content }}</span>@endforeach</td>
              </tr>

              {{-- Threads sit under the line they were written about, in the
                   flow, so scrolling never separates a comment from its code. --}}
              @foreach (line.threads as thread)
                <tr class="thread-row">
                  <td class="gutter" colspan="2"></td>
                  <td class="thread-cell">
                    <ReviewThread thread="{{ thread }}" />
                  </td>
                </tr>
              @endforeach
            @endforeach
          @endforeach
        </tbody>
      </table>
    @endif
  </div>
</section>

<style>
  /* The diff's own styles live in the app layout, not here.

     The same markup is produced twice: by this component for the first screen,
     and by `app/Actions/Pull/rows.ts` for every row streamed to the virtualized
     list. Two copies of the stylesheet would drift the way two renderers do,
     and the drift would show as the diff changing appearance halfway down the
     page. One copy, in the shell both paths render into. */
</style>
