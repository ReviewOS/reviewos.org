<script server>
/**
 * The repository browse screen: tree, file, README.
 *
 * Everything decided here comes from tested modules - `resources/functions/browse`
 * for shaping and `app/Actions/Browse/load` for reading git. The view reads
 * those and lays them out; no rules live in this file, because rules in a
 * template cannot be tested.
 *
 * Server-rendered, like the review screen, so a repository with thousands of
 * files costs the browser nothing.
 */
import { mirrorFor, repositoryForView, summarizeMirror } from '../functions/repo'
import { aliasTarget, pathUnderOwner } from '../functions/aliases'
import { breadcrumbs, childPath, commitCount, findReadme, formatSize, headCommitRow, isMarkdown, joinRefAndPath, lastCommit, listTree, readBlob, readBlobWindow, BLOB_WINDOW_LINES, refLinks, relativeTime, shortSha, sortEntries, splitRefAndPath, treeRows, branchNames, tagNames, highlightLines, languageFor, languageRulesFor, declaredLanguage } from '../functions/browse'
import { renderMarkdownHighlighted } from '../functions/markdown'
/**
 * The status this page wants, asked for where the binding actually exists.
 *
 * `setResponseStatus` is a *context binding*: the host builds the server
 * script's scope out of the keys it supplies, so the name is in scope here and
 * nowhere else. A module the script imports cannot see it, whatever it does
 * with `typeof` - which is what `functions/http.ts` was, so every page in this
 * codebase that meant to answer 404 answered 200, on every host, and the
 * not-found branch it rendered read as exactly the answer it intended.
 *
 * The `typeof` guard stays because an *undeclared* identifier is a
 * ReferenceError, and it would be thrown inside this script's IIFE - taking
 * every other binding in the file down with it and rendering the page blank.
 */
const setStatus = typeof setResponseStatus === 'function' ? setResponseStatus : () => {}
const setHeader = typeof setResponseHeader === 'function' ? setResponseHeader : () => {}

// Props arrive as attribute strings, so everything is normalised here rather
// than at each use site.
const ownerHandle = String(owner)
const repositoryName = String(repository)

// The owner is a user or an organization, and both live in their own table, so
// the handle is looked up in each. Resolving the owner first is what stops
// `/someone/stacks` finding a repository that belongs to somebody else.
// Resolved and permission-checked in one place. A component reaching for the
// table itself is how the owner check gets skipped in one of them and the
// visibility check in all of them.
/**
 * The request, when there is one, without naming a binding that may not exist.
 *
 * stx declares `__stxServeContext` on the path that serves a request and on no
 * other, and an *undeclared* identifier is a ReferenceError - which optional
 * chaining does not save, because `x?.y` throws on `x` before the chain is
 * reached. It throws inside the server script's IIFE, so it takes every other
 * variable in this file down with it and the page renders its not-found branch
 * as though the answer were no.
 *
 * The globalThis mirror is not the fix: it is shared between concurrent
 * requests, so reading cookies off it could hand one reader another reader's
 * session.
 */
const serveContext = __stxServeContext

const repoAccess = await repositoryForView(ownerHandle, repositoryName, serveContext?.cookies)
const repoRow: any = repoAccess?.repository ?? null

// The absolute path, from the resolver rather than from the row: `disk_path`
// is relative to the repository root, and passing it to git resolves against
// the server's working directory instead - which found nothing and rendered
// this page's empty branch on repositories that were full.
const diskPath = String(repoAccess?.diskPath ?? '')

// The refs, read before anything uses one, because the URL cannot be split
// without them. `/tree/fix/rounding/src` is a branch called `fix/rounding`
// holding `src`, or a branch called `fix` holding `rounding/src`, and only the
// ref list says which - see `app/Actions/Browse/splitRef.ts`.
const branches = repoRow ? await branchNames(diskPath) : []
const allTags = repoRow ? await tagNames(diskPath) : []

const addressed = splitRefAndPath(joinRefAndPath(String(refName ?? ''), String(path ?? '')), [...branches, ...allTags])
const requestedPath = addressed.path
const ref = String(addressed.ref || (repoRow ? (repoRow.default_branch ?? 'HEAD') : 'HEAD'))

// Try the path as a directory. When git says it is not one, it is a file, and
// that is the ordinary way to tell them apart without a second round trip.
const listing = repoRow ? await listTree(diskPath, ref, requestedPath) : { ok: false, entries: [], error: null, truncated: false }
const isDirectory = listing.ok

const isFile = Boolean(repoRow && requestedPath && !isDirectory)
const wantsMarkdown = isFile && isMarkdown(requestedPath)

/*
 * A window of the file, not the file.
 *
 * `readBlob` refuses anything over half a megabyte and hands back every line of
 * whatever it does read - so a 700 KB file could not be looked at at all, and a
 * 400 KB one arrived as thirty thousand table rows in one document, which is
 * the failure the diff engine exists to avoid, sitting untouched on the other
 * half of the product. `readBlobWindow` counts the lines as git writes them and
 * keeps only the ones being shown.
 *
 * `from` is a line number carried in the query, so a link into the middle of a
 * large file lands there - a plain link, which is what keeps the rest of the
 * file reachable with no script running.
 *
 * Markdown still reads whole: it is rendered as a document rather than as
 * numbered lines, and half a document is not a window into it.
 */
/*
 * `typeof` rather than `fromLine ?? '1'`, and the difference is the whole page.
 *
 * A prop nobody passed is an *undeclared* identifier here, not an undefined
 * one, so naming it throws a ReferenceError inside the server script's IIFE -
 * which takes every other variable with it and renders the not-found branch of
 * a page that is perfectly fine. `index.stx` renders this component without a
 * line number, and that is a legitimate way to call it.
 */
const windowFrom = Number(typeof fromLine === 'undefined' ? '1' : String(fromLine || '1'))
const source = (isFile && !wantsMarkdown)
  ? await readBlobWindow(diskPath, ref, requestedPath, { from: Number.isFinite(windowFrom) ? windowFrom : 1 })
  : null

const blob = wantsMarkdown ? await readBlob(diskPath, ref, requestedPath) : null

const entries = isDirectory ? sortEntries(listing.entries) : []
const crumbs = breadcrumbs(repositoryName, requestedPath)

// The README renders under the tree, the way every forge does it, but only in a
// directory - inside a file the file is the subject.
const readmeEntry = isDirectory ? findReadme(entries) : null
const readme = readmeEntry
  ? await readBlob(diskPath, ref, childPath(requestedPath, readmeEntry.name))
  : null

// Highlighting happens here, not in the browser: a large file tokenised
// client-side is jank exactly when someone is trying to read code.
const sourceLines = (source && !source.error && !source.binary && !source.tooLarge) ? source.lines : []

/*
 * What the repository says this file is, before what its name suggests.
 *
 * `.gitattributes` at this ref, through `linguist-language` - the attribute
 * every repository that has ever cared already carries. It is the only source
 * that knows rather than infers: a `.h` that is C++, a house extension, a
 * generated directory that should read as plain text.
 */
const languageRules = sourceLines.length > 0 ? await languageRulesFor(diskPath, ref, readBlob) : []
const declared = sourceLines.length > 0 ? declaredLanguage(languageRules, requestedPath) : null

const highlighted = sourceLines.length > 0 ? await highlightLines(sourceLines, requestedPath, { language: declared }) : []
const language = sourceLines.length > 0 ? (declared ?? languageFor(requestedPath)) : null

const head = repoRow ? await lastCommit(diskPath, ref, requestedPath) : null

// For the header line, which listed branches and a size around a bare word.
const commits = repoRow ? await commitCount(diskPath, ref) : null
// Tags are capped for the picker: a repository with a release per week has
// hundreds, and a picker that lists them all is a scroll, not a chooser. The
// split above sees all of them, because a tag missing from that list is a tag
// whose URL resolves to the wrong thing.
const tags = allTags.slice(0, 30)

// Rendered here rather than in the template. The `@markdown` directive runs
// before interpolation, so wrapping `{!! readme.text !!}` in it markdown-renders
// the literal token and then drops the file's text into the page untouched -
// which for a mirrored repository means whatever HTML its README contains.
/*
 * `ref` and `directory` are what make a README's own images appear.
 *
 * Relative references in repository text are relative to *the file*, and a
 * browser left to resolve them resolves them against this page's URL - so
 * `./docs/arch.png` in the README at the root asks for `/{owner}/docs/arch.png`,
 * which belongs to nobody. Every image in every mirrored README was broken this
 * way. See `app/Actions/Markdown/urls.ts`.
 *
 * The README's directory is the one being listed; a markdown file's is the
 * directory it is in, which is its path with the filename taken off.
 */
const readmeHtml = readme?.ok && readme.text !== null && !readme.binary
  ? await renderMarkdownHighlighted(readme.text, { owner: ownerHandle, repository: repositoryName, ref, directory: requestedPath })
  : ''
const blobMarkdownHtml = (blob?.ok && blob.text !== null && !blob.binary && !blob.tooLarge && isMarkdown(requestedPath))
  ? await renderMarkdownHighlighted(blob.text, { owner: ownerHandle, repository: repositoryName, ref, directory: requestedPath.split('/').slice(0, -1).join('/') })
  : ''

const notFound = !repoRow

/*
 * Whether this is a mirror, and whether what is on screen can be believed.
 *
 * The reader's question is not "is mirroring enabled" - it is whether the code
 * they are about to review is current. So the banner leads with when it last
 * synced, and `mirrorHealth` decides whether that is recent enough to say so
 * plainly or to warn.
 */
const mirror = repoRow ? await mirrorFor(Number(repoRow.id)) : null
const mirrorStatus = summarizeMirror(mirror)
const maySyncNow = Boolean(mirrorStatus) && Boolean(repoAccess?.can?.('repository:settings'))

// The base every link on this page hangs off. One string, so a page that links
// to a file and a page that links to a branch cannot disagree about it.
const base = `/${ownerHandle}/${repositoryName}`

/*
 * The "last changed" bar, with the two links it was missing.
 *
 * It drew a sha, a subject and a name, and none of them went anywhere - so the
 * commit it named, and the history behind it, were both one hop away and
 * neither was reachable from the screen that named them. Shaped in
 * `app/Actions/Browse/rows.ts` like every other link on this page, because a
 * link built in a template is a link no test can reach.
 */
const headRow = head ? headCommitRow(head, base, ref, requestedPath, relativeTime, shortSha) : null

// Rows and links, shaped where they can be tested. What the components below
// receive is already decided: a name, a link or none, and one piece of text.
/*
 * Where the neighbouring windows of a large file live.
 *
 * A plain URL with a line number in it, so the rest of the file is reachable
 * with nothing running - and so a link *into* a file lands where it says. Built
 * here because this is where the ref and the path have already been resolved
 * out of one another.
 */
const windowUrl = `${base}/tree/${joinRefAndPath(ref, requestedPath)}`

/*
 * The window's numbers as strings, here rather than in the attribute.
 *
 * `String(...)` in an interpolation is a helper that is not in template scope:
 * it throws, and the attribute it was in disappears into an HTML comment. The
 * component then sees no `total`, decides the file is not windowed, and renders
 * two thousand rows of a twelve thousand line file with nothing saying so -
 * which is the exact failure this feature exists to prevent, produced by the
 * feature itself.
 */
const sourceFrom = `${source?.from ?? 1}`
const sourceTotal = `${source?.total ?? 0}`

/*
 * Where the browser asks for another window.
 *
 * Built here, with the encoding done in the script: `encodeURIComponent` in an
 * interpolation is a helper that is not in template scope, and the block it
 * appears in disappears - which is how the mode bar on the review screen went
 * missing once already.
 */
const blobRowsUrl = isFile
  ? `/api/repos/blob/rows?owner=${encodeURIComponent(ownerHandle)}&repo=${encodeURIComponent(repositoryName)}`
    + `&ref=${encodeURIComponent(ref)}&path=${encodeURIComponent(requestedPath)}`
  : ''

const rows = treeRows(entries, base, ref, requestedPath, formatSize, shortSha)
const branchLinks = refLinks(branches, base, ref, requestedPath)
const tagLinks = refLinks(tags, base, ref, requestedPath)

// Which of the ways a file is not shown applies, decided once. The template
// asking `!blob || !blob.ok` and then `blob.binary` in sequence is the same
// decision spread over four branches, and the fourth one is easy to leave out.
const read = source ?? blob
const fileState = !read || ('error' in read && read.error) || ('ok' in read && !read.ok)
  ? 'missing'
  : read.binary
    ? 'binary'
    : read.tooLarge
      ? 'too-large'
      : wantsMarkdown ? 'markdown' : 'source'

// A page that renders "no such repository" under a 200 tells a crawler, a
// cache and an uptime check that the page is fine. Only the render knows, so
// only the render can say - a private repository answers the same way a
// missing one does, which is the whole point of the check above.
/*
 * A repository under a handle that has moved.
 *
 * Same rule as the profile page, and it matters more here: the links people
 * actually keep are deep ones - an issue, a pull request, a file at a path -
 * and a redirect that only understood `/{owner}` would drop everything the
 * link was clicked for. `pathUnderOwner` replaces the first segment and keeps
 * the rest.
 *
 * Only on a miss, so a live owner always wins.
 */
const movedTo = notFound ? await aliasTarget(owner) : null

/*
 * The whole path, not just the repository.
 *
 * A deep link is the kind people keep - an issue, a pull request, a file at a
 * path - so a redirect that drops everything after the repository name throws
 * away the reason the link was clicked.
 *
 * `__stxServeContext` was being filtered out on the way into every component,
 * along with every other `__`-prefixed key. stx 0.2.192 fixes that for its own
 * `serve()`; this application is mounted by bun-router's file-based routing
 * instead, which reaches components through a different path that still loses
 * it - verified by probing the component scope on 0.2.192, where the page sees
 * the request and the component does not. So `serveContext?.path` is still
 * empty here and the fallback is what runs.
 *
 * The fallback sends a deep link to the repository under the canonical owner:
 * one click from where the reader was going rather than a 404. Reconstructing
 * the path from props is not the answer - it is right for `tree` and silently
 * wrong for `commit`, `compare` and `blob`. When bun-router carries the
 * context into a component, this line starts preserving the whole path with no
 * change needed.
 */
/*
 * The request, read from the global the host publishes for exactly this.
 *
 * `__stxServeContext` is bound as an identifier for a page and not for a
 * component, so the local `serveContext` above is undefined here. The serve
 * sets `globalThis.__stxServeContext` alongside it on every render - that line
 * exists so code outside the render context can still reach the request - and
 * that is what this reads. Same object, same request, just the accessor that
 * is actually in scope.
 *
 * Preferred in order: the local binding if a host ever provides it, then the
 * global, then the repository root for a render with no request behind it at
 * all, such as a static build.
 */
const ambient = (globalThis as any).__stxServeContext
const requestPath = String(serveContext?.path ?? ambient?.path ?? '')
const movedPath = movedTo ? pathUnderOwner(requestPath || `/${owner}/${repository}`, movedTo) : ''

/*
 * A real redirect, and it matters more here than on the profile page: the
 * links people actually keep are deep ones - an issue, a pull request, a file
 * at a path - and `pathUnderOwner` carries all of that across. See the note on
 * the profile page for why this could not be a 301 until stx 0.2.190.
 */
if (movedTo) {
  setStatus(301)
  setHeader('Location', movedPath)
  setHeader('Cache-Control', 'public, max-age=3600')
}
else if (notFound) {
  setStatus(404)
}
const emptyRepository = Boolean(repoRow) && !isDirectory && !read && !requestedPath
</script>

  <div class="shell" style="padding-top: 22px; padding-bottom: 64px;">
    @if (movedTo)
      <div class="panel" style="padding: 32px; text-align: center;">
        <h1 style="font-size: 20px;">Moved</h1>
        <p class="muted" style="margin-top: 6px;">
          <code>{{ owner }}</code> is now <a href="{{ movedPath }}">{{ movedTo }}</a>.
        </p>
      </div>
    @elseif (notFound)
      <div class="panel" style="padding: 32px; text-align: center;">
        <h1 style="font-size: 20px;">No such repository</h1>
        <p class="muted" style="margin-top: 6px;">
          Nothing is hosted at {{ ownerHandle }}/{{ repositoryName }}.
        </p>
      </div>
    @else
      <RepoHeader
        owner="{{ ownerHandle }}"
        repository="{{ repositoryName }}"
        visibility="{{ repoRow.visibility }}"
        description="{{ repoRow.description ?? '' }}"
        refName="{{ ref }}"
        size="{{ formatSize(Number(repoRow.size_kb ?? 0) * 1024) }}"
        sizeKb="{{ Number(repoRow.size_kb ?? 0) }}"
        commits="{{ commits === null ? '' : String(commits) }}"
        :branches="branchLinks"
        :tags="tagLinks" />

      <RepoTabs owner="{{ ownerHandle }}" repository="{{ repositoryName }}" active="code" />

      {{--
        A mirror says so, and says when it last synced.

        Above the code rather than below it, because the reader's question -
        "can I trust what I am about to read?" - is one they have before they
        start reading, not after. "Synced 3 minutes ago" answers it; "mirror
        enabled" answers a different question.
      --}}
      @if (mirrorStatus)
        <div class="mirror-banner mirror-{{ mirrorStatus.health }}">
          <span class="i-hugeicons-copy-01 mirror-icon" aria-hidden="true"></span>

          <div class="mirror-main">
            <p class="mirror-line">
              Mirrored from
              @if (mirrorStatus.remoteUrl)
                <a href="{{ mirrorStatus.remoteUrl }}" rel="noreferrer noopener">{{ mirrorStatus.remote }}</a>
              @else
                <span class="mono">{{ mirrorStatus.remote }}</span>
              @endif
              @if (mirrorStatus.health === 'never')
                &middot; not synced yet
              @elseif (mirrorStatus.health === 'disabled')
                &middot; syncing is switched off
              @elseif (mirrorStatus.lastSyncedAt)
                &middot; synced {{ relativeTime(mirrorStatus.lastSyncedAt) }}
              @endif
            </p>

            {{--
              Only when there is something to act on. `problem` is null while a
              mirror is simply syncing, so this never renders an empty warning.
            --}}
            @if (mirrorStatus.problem)
              <p class="mirror-problem">{{ mirrorStatus.problem }}</p>
            @endif
          </div>

          @if (maySyncNow)
            {{--
              For the person who does not want to wait for the interval. Behind
              `repository:settings`, the same rung that configures the mirror -
              a sync is a write against somebody else's rate limit, so it is not
              a button for every reader.
            --}}
            <form method="post" action="/api/mirrors/sync" class="mirror-sync">
              <CsrfField />
              <input type="hidden" name="owner" value="{{ ownerHandle }}">
              <input type="hidden" name="repository" value="{{ repositoryName }}">
              <button type="submit" class="btn">Sync now</button>
            </form>
          @endif
        </div>
      @endif

      @if (emptyRepository)
        <div class="panel" style="padding: 32px; text-align: center; margin-top: 18px;">
          <h2 style="font-size: 17px;">This repository is empty</h2>
          <p class="muted" style="margin-top: 6px;">Push a commit and it will appear here.</p>
        </div>
      @else
        {{-- Where you are, and the way back. --}}
        <nav class="crumbs" aria-label="Breadcrumb">
          @foreach (crumbs as crumb)
            @if (crumb.current)
              <span class="crumb crumb-current">{{ crumb.name }}</span>
            @else
              <a class="crumb" href="/{{ ownerHandle }}/{{ repositoryName }}/tree/{{ joinRefAndPath(ref, crumb.path) }}">{{ crumb.name }}</a>
            @endif
            @if (!crumb.current)
              <span class="crumb-sep" aria-hidden="true">/</span>
            @endif
          @endforeach
        </nav>

        @if (headRow)
          <div class="last-commit panel">
            <a class="last-commit-sha mono muted" href="{{ headRow.href }}">{{ headRow.short }}</a>
            <a class="last-commit-subject" href="{{ headRow.href }}">{{ headRow.subject }}</a>
            <span class="last-commit-author muted">{{ headRow.authorName }}</span>
            @if (headRow.when)
              <span class="last-commit-when muted">{{ headRow.when }}</span>
            @endif

            {{--
              The history behind what is on screen, scoped to the path being
              looked at. The commit list has existed since the browse screen
              did, behind a URL nothing linked to from here.
            --}}
            <a class="last-commit-history" href="{{ headRow.historyHref }}" title="Commit history">
              <span class="i-hugeicons-clock-01" aria-hidden="true"></span>
              <span>History</span>
            </a>
          </div>
        @endif

        @if (isDirectory)
          @if (listing.truncated)
            <p class="muted" style="margin: 8px 0;">This directory has more entries than the page can list. The listing below is incomplete.</p>
          @endif

          <FileTree :rows="rows" />

          @if (readmeHtml)
            <MarkdownContent title="{{ readmeEntry.name }}" :html="readmeHtml" />
          @endif
        @else
          <CodeView
            path="{{ requestedPath }}"
            refName="{{ ref }}"
            language="{{ language ?? '' }}"
            size="{{ formatSize(read?.size ?? null) }}"
            state="{{ fileState }}"
            :lines="highlighted"
            from="{{ sourceFrom }}"
            total="{{ sourceTotal }}"
            rowsUrl="{{ blobRowsUrl }}"
            windowUrl="{{ windowUrl }}"
            :markdownHtml="blobMarkdownHtml" />
        @endif
      @endif
    @endif
  </div>

<style>
  .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; margin: 16px 0 10px; font-size: 14px; }
  .crumb { text-decoration: none; }
  .crumb:hover { text-decoration: underline; }
  .crumb-current { font-weight: 600; }
  .crumb-sep { color: var(--muted); }

  .last-commit { display: flex; align-items: center; gap: 10px; padding: 10px 14px; font-size: 13px; }
  .last-commit-sha { flex: none; text-decoration: none; }
  .last-commit-sha:hover { text-decoration: underline; }

  .last-commit-subject {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: inherit;
    text-decoration: none;
  }

  .last-commit-subject:hover { text-decoration: underline; }
  .last-commit-when { flex: none; }

  /* Pushed to the far end and drawn as a control, because it is the one thing
    on this bar that goes somewhere other than the commit. */
  .last-commit-history {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }

  .last-commit-history:hover { border-color: var(--accent); color: var(--accent); }
</style>
