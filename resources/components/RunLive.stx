<script server>
const scopeKey = String(scope)
const initialRun = initial
const liveOwner = String(owner)
const liveRepository = String(repository)
const liveNumber = Number(number)
</script>
<script client>
import { watchRun } from '../functions/runlive'
const runView = useStore('workflow-run')
const active = state(true)
const connectionText = derived(() => ({ connecting: 'Connecting to live updates…', live: 'Live updates connected', retrying: 'Connection interrupted. Retrying…', complete: 'Run finished. Updates are current.' }[runView.connection()] || 'Connecting…'))
const lastUpdate = derived(() => runView.updatedAt() ? new Date(runView.updatedAt()).toLocaleTimeString() : '')
onMount(() => {
  runView.initialize(scopeKey, initialRun)
  const handle = watchRun({ owner: liveOwner, repository: liveRepository, number: liveNumber,
    onRun: next => runView.accept(scopeKey, next),
    onConnection: next => { if (runView.scope() === scopeKey) runView.connection.set(next) },
  })
  onDestroy(() => { active.set(false); handle.stop() })
})
</script>
<div class="runlive" :class="runView.connection() === 'retrying' ? 'runlive is-disconnected' : 'runlive'" x-cloak>
  <span class="runlive-label" role="status" aria-live="polite" x-text="connectionText()">Connecting…</span>
  <span class="muted" :if="lastUpdate()" x-text="'Last updated ' + lastUpdate()"></span>
</div>
<style>
.runlive { display: flex; flex-wrap: wrap; gap: 12px; margin: 10px 0; font-size: 12px; color: var(--muted); }
.runlive-label { color: var(--accent-text); }
.runlive.is-disconnected .runlive-label { color: var(--warn); }
</style>
