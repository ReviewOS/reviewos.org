<script server>
/**
 * The navigation item for creating a repository, shown only to somebody signed
 * in.
 *
 * `/new` existed and nothing in the chrome pointed at it, which is the same
 * failure `AccountNav.stx` was written for: a page that exists and nothing
 * links to. Creating a repository is the first thing anybody does on a forge,
 * and typing a URL to reach it is not a thing people guess.
 *
 * A component rather than a branch in the layout, for the reason written at
 * length in `ReviewQueueBadge.stx`: an stx server script that throws renders
 * its page with every variable undefined and says nothing, so a script added to
 * the shared layout is one mistake away from blanking the whole product.
 * Everything here sits inside a guard that cannot throw, and any failure
 * renders no link - which is what a signed-out reader gets on purpose.
 */
import { cookieJarFromHeader, viewerFromCookies } from '../functions/identity'

const serveContext = __stxServeContext
const headerBag = typeof headers === 'undefined' ? undefined : headers

let signedIn = false
try {
  signedIn = Boolean(await viewerFromCookies(serveContext?.cookies ?? cookieJarFromHeader(headerBag?.cookie)))
}
catch {
  signedIn = false
}
</script>

@if (signedIn)
  <a class="new-repository" href="/new">
    <span aria-hidden="true">+</span>
    <span class="new-repository-word">New</span>
  </a>
@endif

<style>
  /* An outlined control rather than a link, because it is the one item in the
    bar that makes something rather than going somewhere. The solid button is
    spoken for: it is how a signed-out reader registers, and two filled buttons
    in a 56px bar is two things claiming to be the point. */
  .new-repository {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-control, 8px);
    color: var(--text);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .new-repository:hover { background: var(--surface-tint); }

  /* On a narrow bar the plus carries it alone, which is the one place in this
    product where an icon without its word is unambiguous. */
  @media (max-width: 720px) {
    .new-repository { padding: 0 10px; }
    .new-repository-word { display: none; }
  }
</style>
