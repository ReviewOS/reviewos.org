{{--
  Whether a commit's signature checked out.

  The badge arrives ready, from `signatureBadge` in
  `app/Actions/Browse/rows.ts`, because deciding what to say about a signature
  is a judgement rather than a formatting step - "unverified" and "invalid" are
  different claims and only one of them accuses somebody.

  Nothing is drawn for an unsigned commit. Most commits are unsigned, and a mark
  on nearly every row teaches people to ignore the mark - which is the same mark
  that has to mean something on the day a signature really is bad.

  Passed with `:badge="…"` rather than `badge="{{ … }}"`: the interpolation form
  is string interpolation into an attribute, so an object arrives as
  `[object Object]`.
--}}
@if (badge.show)
  <span class="sig sig-{{ badge.tone }}" title="{{ badge.detail }}">
    <span class="{{ badge.icon }}" aria-hidden="true"></span>
    <span>{{ badge.label }}</span>
    {{-- The tooltip is not reachable without a pointer, so the sentence is
        carried for a screen reader too rather than only on hover. --}}
    <span class="sr-only">. {{ badge.detail }}</span>
  </span>
@endif

<style>
  .sig {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 8px;
    font-size: 11.5px;
    font-weight: 500;
    line-height: 1.6;
    border: 1px solid var(--line);
    border-radius: 999px;
    white-space: nowrap;
  }

  /* Colour is never the only signal: each tone has its own word and its own
    icon, so the badge still reads on a monochrome display and to anybody who
    does not distinguish the hues. */
  .sig-good { color: var(--ok); border-color: var(--ok); background: var(--ok-bg); }
  .sig-bad { color: var(--bad); border-color: var(--bad); background: var(--bad-bg); }
  .sig-quiet { color: var(--muted); }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
