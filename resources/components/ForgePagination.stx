<script server>
const offset = Number($props.offset ?? 0)
const size = Number($props.pageSize ?? 100)
const query = Object.fromEntries(Object.entries($props.query ?? {}).filter(([, value]) => value !== undefined && value !== null && value !== '').map(([key, value]) => [key, String(value)]))
const address = start => `${String($props.base)}?${new URLSearchParams({ ...query, offset: String(start) })}`
export const backLink = offset > 0 ? address(Math.max(0, offset - size)) : ''
export const nextLink = $props.nextOffset !== null && $props.nextOffset !== undefined ? address(Number($props.nextOffset)) : ''
</script>
@if (backLink || nextLink)
  <nav class="flex flex-wrap gap-3 justify-between mt-6" aria-label="Pagination">
    @if (backLink)<a class="btn" href="{{ backLink }}">Previous</a>@endif
    @if (nextLink)<a class="btn" href="{{ nextLink }}">Next</a>@endif
  </nav>
@endif
