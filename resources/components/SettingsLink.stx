<script server>
/**
 * The navigation item for settings, shown only to somebody signed in.
 *
 * There were six settings pages and nothing in the chrome pointed at any of
 * them - profile, keys, tokens, notifications, and now organizations, all
 * reachable only by typing the URL. The same failure as fourteen links to a
 * profile page that did not exist, in the other direction: a page that exists
 * and nothing links to.
 *
 * A component rather than a branch in the layout, for the reason written at
 * length in `ReviewQueueBadge.stx`: an stx server script that throws renders
 * its page with every variable undefined and says nothing, so a script added to
 * the shared layout is one mistake away from blanking the whole product.
 * Everything here sits inside a guard that cannot throw, and any failure
 * renders no link - which is what a signed-out reader gets on purpose.
 */
import { cookieJarFromHeader, viewerFromCookies } from '../functions/identity'

const serveContext = typeof __stxServeContext === 'undefined' ? undefined : __stxServeContext
const headerBag = typeof headers === 'undefined' ? undefined : headers

let signedIn = false
try {
  signedIn = Boolean(await viewerFromCookies(serveContext?.cookies ?? cookieJarFromHeader(headerBag?.cookie)))
}
catch {
  signedIn = false
}
</script>

@if (signedIn)
  <a class="muted" style="text-decoration: none;" href="/settings/profile">Settings</a>
@endif
