{{--
  One row of an issue or pull request list.

  The row is what people scan, so what it carries is a decision rather than a
  layout: a state pill on the left because that is the first question, the title
  on one line because a wrapped two-hundred-character title pushes every row
  below it off the screen, and the labels *after* the title rather than under it
  because a label is a property of the row and not a second line of it.

  `selectable` is the bulk-triage checkbox, and it is off for pull requests
  because the bulk endpoint is an issue endpoint. The whole list is one form, so
  the checkbox here and the toolbar above are the same submission with no client
  script holding them together.
--}}
{{-- Focusable as a row, not only through the link inside it. `j` and `k` move
     focus here, `x` ticks the checkbox in the focused row, and Enter follows
     its title - none of which has anywhere to land if the row itself cannot
     hold focus. Tab still walks the links inside, which is what somebody with
     no JavaScript gets and what a screen reader announces. --}}
<li class="list-row" tabindex="0">
  @if (selectable)
    <input
      class="list-check"
      type="checkbox"
      name="numbers"
      value="{{ row.number }}"
      aria-label="Select {{ row.number }}"
    >
  @endif

  <span class="pill pill-{{ row.statePill }}">{{ row.stateLabel }}</span>

  <div class="list-row-main">
    <div class="list-row-title-line">
      <a class="list-row-title" href="{{ row.href }}">{{ row.title }}</a>

      @foreach (row.labels as label)
        <LabelPill :label="label" />
      @endforeach
    </div>

    <p class="muted list-row-meta">
      #{{ row.number }} opened {{ row.when }} by
      @if (row.authorHref)
        <a href="{{ row.authorHref }}">{{ row.author }}</a>
      @else
        {{-- No local account to link to. The name is still shown, because the
             author being unlinked is a fact about this forge, not about them. --}}
        <span>{{ row.author }}</span>
      @endif

      @if (row.comments > 0)
        &middot; {{ row.comments }} {{ row.comments === 1 ? 'comment' : 'comments' }}
      @endif
    </p>
  </div>
</li>

<style>
  .list-row {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
  }

  .list-row:last-child { border-bottom: 0; }

  /* Focus is visible on the row, not only on the checkbox inside it: somebody
     moving down the list with the keyboard needs to see where they are. */
  .list-row:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .list-check { margin-top: 3px; flex: 0 0 auto; }
  .list-row-main { min-width: 0; flex: 1 1 auto; }

  .list-row-title-line {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
    min-width: 0;
  }

  .list-row-title {
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    /* One line: a wrapped title pushes every row below it off the screen, and
       the number plus the first few words is what people scan by. */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }

  .list-row-title:hover { color: var(--accent-text); }
  .list-row-meta { margin-top: 3px; font-size: 12px; }
</style>
