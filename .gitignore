# Dev tooling
# (put individual local dev tooling stuff here)

# Environment files
.env
.env.local
.env.keys
*.local
.env.keys

# Encrypted, safe to commit
!.env.production
!.env.staging
!.env.ci

# Dependencies
node_modules
/pantry
*.tgz
# Commit both lockfiles. Pantry owns the complete machine and project graph;
# Bun's lock remains the runtime package-manager lock used by Bun commands.

# QA
test-results
tests/unit/coverage
dist*

# IDE files
.fleet
.idea
.vscode
.cursor
.zed

# Git files
!.gitkeep

# Database files
database/stacks_testing.sqlite
database/stacks.sqlite
database/*.sqlite-wal
database/*.sqlite-shm

# OS files
.DS_Store
.DS_STORE

# Build files
.cache
temp
.temp
data.ms
generated/*
.stx-serve
custom-cli
*bun-build
discovered-packages.json

# Runtime state. It all lives under storage/ now:
#   storage/framework/stx      stx build cache + generated route manifest
#   storage/framework/runtime  migration lock, temp bundles, CLI scratch
#   storage/cloud              cloud driver state + dashboard credentials
#   storage/repos              the bare git repositories this instance hosts
#   storage/attachments        files people attached to issues
storage/framework/stx/
storage/framework/runtime/
storage/cloud/

# Model snapshots for dialects this project does not use. The postgres one is
# committed on purpose - it is what `generate:migrations` diffs against - but a
# `bun test` run exercises fixtures on other dialects and drops their snapshots
# here too. A stray mysql snapshot is worse than untidy: the dialect-mismatch
# guard sees postgres with no snapshot and mysql with one, concludes the
# environment is misconfigured, and refuses to generate migrations at all.
storage/framework/database/model-snapshot.mysql.json
storage/framework/database/model-snapshot.sqlite.json

# The repositories themselves. These are user data on a running instance and
# machine-local scratch in development (`buddy seed:demo` writes one), and a
# bare repository committed inside this one confuses every tool that walks the
# tree, git included.
storage/repos/

# Files people attached to issues. User data on a running instance, exactly as
# the repositories above are, and each one has a row in `attachments` that says
# which repository it belongs to and therefore who may read it.
storage/attachments/

# What jobs published: build output, coverage, screenshots from a failed test.
# Content-addressed and written by the artifact endpoint on a running instance,
# and by any test that exercises it - the same kind of state as the attachments
# above, and never a thing to commit.
storage/artifacts/

# The write-ahead log's bundles: one per push, plus a full checkpoint per
# repository. This is a backup of user data on a running instance and pure
# machine-local scratch in development, and the rows in `git_wal_entries` are
# what make them meaningful anyway - a bundle in this repository would be a
# packfile of somebody else's repository, committed.
storage/wal/

# Cached packfiles, keyed on the tips a clone asked for. Regenerable by
# definition: a miss is a slower clone rather than a lost anything, and the
# whole directory can be deleted at any time.
storage/packs/

# Generated archives, cached per commit. Regenerable in the same way, and for
# the same reason.
storage/archives/

# LFS objects. User data, addressed by the hash of their content, and the
# reason a repository uses LFS at all is that these are too large to belong in
# a git repository - including this one.
storage/lfs/

# Dependency cache snapshots: a tar of somebody's workspace after its install.
# Rebuildable by definition - the whole point is that losing one costs a slow
# job rather than data - and large enough that nothing wants them committed.
storage/caches/

# Release assets: the binaries attached to a release. User data on a running
# instance, and often the largest single files an instance holds.
storage/release-assets/

# The shared git hooks. Generated from `app/Actions/Git/hooks.ts` on every
# repository creation, because they carry the URL and the endpoint paths this
# instance answers on - a committed copy would be a copy that is wrong on every
# deployment except the one it was written from.
storage/git-hooks/

# The SSH daemon's host key. A private key, and one per instance: it is what
# clients pin, so committing one would publish the private half of the identity
# every deployment of this forge then claims to have.
storage/ssh/

# Pre-relocation names of the three directories above. stx and ts-cloud each
# take their state directory from config now (`stateDir` in config/ui.ts and
# config/cloud.ts), so nothing is left in the project root - but a checkout that
# predates the move still has these until `ensureRuntimeDirectories()` migrates
# them, and they should never be committed in the meantime.
/.stx
/.ts-cloud
/.stacks

# Opt-in convenience symlink to storage/framework, created by
# `buddy generate:core-symlink`. Core developers only.
/.framework

# AI coding-agent setup, scaffolded by `buddy setup:ai` from the templates in
# storage/framework/defaults/ai. Which agent you use is a personal choice, so
# everything it generates stays out of the repo. AGENTS.md is the exception: it
# is shared guidance every agent reads, so it is authored and committed, and
# `setup:ai` only ever seeds it when it is missing.
/.claude
/.codex
/.gemini
/CLAUDE.md
/GEMINI.md
/.github/copilot-instructions.md

# Stub workspace packages (temporary)
/ts-auth
/ts-cloud
/ts-craft
/ts-md
/ts-open-api
/ts-pantry
/ts-security-crypto
/bun-queue
/headwind
/bun-plugin-stx
pantry

# Build artifact directory used by docs/build steps — never tracked.
storage/framework/cache/

# Persisted by `buddy update` to remember whether the project is following the
# `stable` or `canary` channel. Local preference only — the channel choice
# doesn't need to be shared across team members or CI.
.stacks-channel

# Persisted by `buddy update`: last-synced channel + commit sha for the
# up-to-date short-circuit. Local-only — like the channel, it's per-checkout.
.stacks-version

# Temp directory used during a `buddy update` GitHub fetch. Cleaned up by the
# upgrade action on success but listed here to keep stray copies (e.g. from a
# kill -9'd run) out of commits.
.tmp-upgrade/
/storage/framework/frontend-dist
/storage/framework/desktop-dist

# Mail previews the local mail driver writes when a test sends anything. They
# are the rendered email, one file per send, and a test run produces dozens.
logs/mail/

# Per-package runtime logs created when building a core package in place
storage/framework/core/**/storage/logs/
storage/framework/**/storage/logs/

# @stacksjs/defaults copies resources + app from storage/framework/defaults at build time
# @stacksjs/defaults is a publish wrapper. Its generated scaffold is rebuilt
# from storage/framework/defaults by core/defaults/build.ts.
storage/framework/core/defaults/*
!storage/framework/core/defaults/README.md
!storage/framework/core/defaults/build.ts
!storage/framework/core/defaults/package.json
!storage/framework/core/defaults/tests/
!storage/framework/core/defaults/tests/**

# Generated protocol evidence is retained by CI, not committed.
/.github/protocol/reports/
/storage/lfs
/storage/typesense

# Throwaway probe scripts. One got swept into a commit already.
scratch-*.ts
