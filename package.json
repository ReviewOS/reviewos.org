{
  "name": "reviewos",
  "type": "module",
  "version": "0.1.4",
  "private": true,
  "description": "An open source, self-hostable git forge built around code review.",
  "author": "your-name <your-email>",
  "contributors": [
    "Chris Breuer <chris@stacksjs.org>"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/chrisbbreuer",
  "homepage": "https://reviewos.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReviewOS/reviewos.org.git"
  },
  "bugs": {
    "url": "https://github.com/ReviewOS/reviewos.org/issues"
  },
  "scripts": {
    "build:reset": "rm -rf node_modules && pantry install && ./buddy generate:types && ./buddy lint:fix && cd storage/framework && bun run build && cd ../../",
    "buddy": "./buddy",
    "stacks": "./buddy",
    "setup": "./bootstrap",
    "fresh": "./buddy fresh",
    "clean": "./buddy clean",
    "upgrade": "./buddy upgrade",
    "dev": "./buddy dev",
    "development": "./buddy dev",
    "build": "./buddy build",
    "prod": "./buddy build",
    "deploy": "./buddy deploy",
    "lint": "./buddy lint",
    "lint:fix": "./buddy lint:fix",
    "format": "./buddy format",
    "format:check": "./buddy format:check",
    "serve": "./buddy serve",
    "make": "./buddy make",
    "make:component": "./buddy make:component",
    "make:function": "./buddy make:function",
    "make:database": "./buddy make:migration",
    "make:migration": "./buddy make:migration",
    "make:notification": "./buddy make:notification",
    "make:factory": "./buddy make:factory",
    "make:lang": "./buddy make:lang",
    "make:stack": "./buddy make:stack",
    "key:generate": "./buddy key:generate",
    "commit": "./buddy commit",
    "release": "./buddy release",
    "release:patch": "./buddy release --bump patch",
    "release:minor": "./buddy release --bump minor",
    "release:major": "./buddy release --bump major",
    "changelog": "./buddy changelog",
    "generate": "./buddy generate",
    "typecheck": "./buddy typecheck",
    "typecheck:clean": "bunx --bun rimraf storage/framework/.cache/typescript",
    "types:check": "bun run typecheck",
    "types:fix": "./buddy types:fix",
    "test": "./buddy test",
    "test:ui": "./buddy test:ui",
    "test:coverage": "./buddy test:coverage",
    "test:types": "./buddy test:types",
    "deps:lockfile:check": "bun .github/scripts/check-lockfile-version.ts",
    "bud": "./buddy",
    "stx": "./buddy",
    "typecheck:framework": "bun x --bun tsc --noEmit -p storage/framework/tsconfig.framework.json --pretty false"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@stacksjs/actions": "^0.72.50",
    "@stacksjs/api": "^0.72.50",
    "@stacksjs/buddy": "^0.72.50",
    "@stacksjs/bunpress": "^0.2.8",
    "@stacksjs/database": "^0.72.50",
    "@stacksjs/docs": "^0.72.50",
    "@stacksjs/env": "^0.72.50",
    "@stacksjs/events": "^0.72.50",
    "@stacksjs/faker": "^0.72.50",
    "@stacksjs/orm": "^0.72.50",
    "@stacksjs/queue": "^0.72.50",
    "@stacksjs/search-engine": "^0.72.50",
    "@stacksjs/router": "^0.72.50",
    "@stacksjs/server": "^0.72.50",
    "@stacksjs/stx": "^0.2.199",
    "@stacksjs/ts-ssh": "^0.1.1",
    "buddy-bot": "^0.10.5",
    "bun-query-builder": "0.2.60",
    "mermaid": "^11.16.1",
    "pickier": "^0.1.57",
    "stacks": "^0.72.50",
    "ts-git-lfs": "^0.1.3",
    "ts-images": "^0.2.12",
    "ts-pantry": "^0.11.38",
    "ts-syntax-highlighter": "^0.2.17"
  },
  "workspaces": [
    "storage/framework",
    "storage/framework/libs/*",
    "storage/framework/views/*"
  ],
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bun x --bun pickier lint --fix"
      }
    },
    "commit-msg": "bun x gitlint --edit \"$1\""
  },
  "devDependencies": {
    "@stacksjs/image": "^0.72.50",
    "better-dx": "^0.2.22"
  },
  "overrides": {
    "bun-query-builder": "^0.2.60",
    "@stacksjs/bun-router": "^0.0.27",
    "@stacksjs/stx": "^0.2.199",
    "@stacksjs/ts-ssh": "^0.1.0",
    "stx-router": "^0.2.193",
    "bun-plugin-stx": "^0.2.199",
    "@stacksjs/components": "^0.2.193",
    "@stacksjs/ts-cloud": "^0.9.4",
    "@stacksjs/buddy": "^0.72.50"
  }
}
